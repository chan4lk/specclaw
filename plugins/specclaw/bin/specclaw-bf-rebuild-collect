#!/usr/bin/env bash
# specclaw-bf-rebuild-collect — deterministic fact-collection AND rendering for
# /specclaw:bf-rebuild-plan
#
# Two responsibilities, split like specclaw-bf-clarify (not like the plugin's
# other analysis bin scripts, which only collect facts for an agent to write
# the final file): this command now has the same hard invariant clarify
# solved for — a living backlog whose BL-NNN IDs, and any human-added status
# note a person typed into an item, must survive every --refresh untouched.
# That is safer enforced deterministically in bash than trusted to an LLM's
# judgment across repeated runs, so bash owns the final file; the
# rebuild-planner agent only ever drafts NEW or REVISED item content to a
# transient draft file.
#
#   collect  — pre-agent step. Checks the four analysis documents, detects
#              which optional inputs (decisions.md, clarifications.md,
#              baseline/manifest.json, baseline/scenarios.md) are present,
#              refuses to proceed on a second run without --refresh, and (on
#              --refresh) parses the existing rebuild-backlog.md's BL-NNN
#              items. Extracts only ID-level facts (booleans, short ID
#              strings) — never prose; the agent reads the documents
#              directly for content, same "bash collects, agent interprets"
#              split as every sibling analysis command.
#
#   render   — post-agent step. Re-parses every input document fresh (does
#              not trust collect's JSON, which may be stale by the time the
#              agent finishes), merges the agent's draft with every
#              preserved existing item, computes Gate/Verification/
#              dependency-and-readiness ordering for every active item from
#              scratch, computes the refresh change report by diffing
#              against the old file's own stored Gate/Verification lines,
#              archives the prior file, and writes the new one.
#
# Bash + coreutils only (jq optional, used for output validation with a
# best-effort fallback — same tolerant pattern as every sibling script).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ─── Help ─────────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: specclaw-bf-rebuild-collect <subcommand> [options]

Subcommands:
  collect  <specclaw_dir> [--refresh] [--module MOD-###]
           Checks that all five .specclaw/analysis/*.md documents exist
           (exits non-zero naming exactly which are missing, as before) —
           the four analysis documents plus module-map.md, the module
           hierarchy every backlog item is grouped under. Detects which
           optional inputs are present: decisions.md, clarifications.md,
           .specclaw/baseline/manifest.json, .specclaw/baseline/scenarios.md.
           If .specclaw/analysis/rebuild-backlog.md already exists and
           --refresh was not passed, exits non-zero instructing the user to
           re-run with --refresh (or archive/delete it manually). Emits one
           JSON object to stdout, including the module roster (id, name,
           status, rules, dependencies) and the map's own PROPOSED/CONFIRMED
           status.

           --module MOD-### scopes the run to one module: the agent drafts
           only that module's items, and every other module's items are
           preserved untouched. The id must exist in module-map.md.

  render   <specclaw_dir> <draft_file> [--module MOD-###]
           Post-agent step. <draft_file> contains STRIKE:/DEFER:/
           UNVERIFIABLE: directive lines (if any) followed by zero or more
           ### BL-NNN item blocks (new items on a first-ever run; new or
           revised items on --refresh — untouched existing items need not
           appear in the draft at all), optionally followed by
           ## Sequencing Rationale and ## Coverage Check sections. Archives
           the prior rebuild-backlog.md (if any), merges the draft with every
           preserved existing item, computes Gate/Verification/ordering for
           every active item, groups items under ## MOD-### headings in
           module dependency order, computes the per-module coverage rollup
           and the recommended next module, renders the change report
           (refresh only), and writes .specclaw/analysis/rebuild-backlog.md.
           Deletes <draft_file> on success.

           Pass the same --module MOD-### the collect step was given, so the
           draft's Coverage Check replaces only that module's coverage lines
           instead of the whole section.

  module-status <specclaw_dir>
           Read-only status VIEW. Writes .specclaw/analysis/module-status.md:
           one row per module — backlog items planned/total, baseline
           scenarios captured/designed, the latest module-scoped replay
           verdict with its run date, and the count of open questions naming
           that module. Computed entirely from existing artifacts
           (module-map, backlog, scenarios, manifest, retained run metadata,
           pending-questions/clarifications); modifies nothing else.

           Regenerated in full every invocation and deliberately EXEMPT from
           archive-then-replace: it holds no finding of its own, only a
           rendering of documents whose own history is already archived.
           Exits non-zero only when module-map.md is missing.

  bypass-check <specclaw_dir> <BL-###|--title "<item title>">
           For /specclaw:propose. Classifies each of an item's "Depends on:"
           entries so a human can be asked about the unmet ones: per
           dependency, its module, whether it is same-module, whether its
           own Status notes carry a declared "BUILT:" line, and whether an
           ACTIVE/RETIRING stub already substitutes it. Emits JSON.

           Also reports every non-COMPLETE item split on this item, under
           "splits", so a re-proposed item RESUMES instead of starting over —
           with what was implemented, its change/PR/replay evidence, what
           remains deferred, and which blocked-until items are now built. A
           dependency an active split already deferred is classified
           "deferred-by-split" and must NOT be re-elicited.

           DECIDES NOTHING. It never picks a strategy and never concludes a
           bypass is warranted — those are human acts (CONTRACT.md (m.2)).

           Exits 0 with {"applicable": false} when there is no backlog, or
           no resolvable BL-### — the inert path for a non-brownfield
           change. An ambiguous --title is REPORTED, never resolved by
           picking a candidate.

  stub-append <specclaw_dir> --substitutes <BL-###|MOD-###> --strategy <s>
              --consumed-by <BL-###[,...]> --chosen-by "<name>, <date>"
              --summary "<one line>" [--fakes ...] [--implementation ...]
              [--mock-seed <path>]
           Appends one ### ST-### entry to .specclaw/analysis/module-stubs.md
           (creating it from the template on first use), allocating the next
           free id. Strategy must be one of the three FAKING strategies:
           stub-interface, mock-data, feature-flag. Prints the new id.

           item-split is REFUSED here, naming split-append: it fakes nothing,
           so it taints nothing and retires nothing, and an ST entry has no
           field for what was deferred or what unblocks it.

           Refuses to write a malformed entry: no chooser, no consuming
           item, or an unknown strategy is an error, not a blank field — an
           entry that cannot be joined or traced looks like tracking without
           being it.

  stub-update <specclaw_dir> <ST-###> [--status ACTIVE|RETIRING|RETIRED]
              [--fakes ...] [--implementation ...] [--mock-seed ...]
              [--retirement ...] [--consumed-by-add BL-###]
           Edits named fields of one existing entry IN PLACE. Never rewrites
           the document and never deletes an entry — retirement is a Status
           flip (CONTRACT.md (m.1)).

  split-append <specclaw_dir> --item BL-### --reason ... --unmet-deps ...
               --implemented-now ... --deferred ...
               --rules-implemented <DR-###,...> --rules-deferred <DR-###,...>
               --layers-implemented ... --layers-deferred ...
               --blocked-until <BL-###,...> --chosen-by "<name>, <date>"
               --summary "<one line>" [--module MOD-###] [--change <name>]
               [--layer-removal-confirmed-by "<name>, <date>"]
           Appends one ### IS-### entry to .specclaw/analysis/item-splits.md
           (creating it from the template on first use). Prints the new id.

           TWO GUARDS AGAINST A SPLIT SILENTLY WIDENING:
             1. The rule partition — --rules-implemented and --rules-deferred
                must together account for EVERY DR-### in the item's own
                acceptance basis, with no overlap. A rule in neither half is
                scope belonging to nobody.
             2. Layer removal — a split that defers the whole `ui` layer from
                a SCREEN-BEARING item is refused unless
                --layer-removal-confirmed-by names a human.

  split-update <specclaw_dir> <IS-###>
               [--status ACTIVE|READY-TO-RESUME|COMPLETE] [--change ...]
               [--evidence ...] [--replay-evidence ...] [--resumed-by ...]
               [--completion ...]
           Edits named fields of one existing entry IN PLACE. Never rewrites
           the document and never deletes an entry (CONTRACT.md (o.1)).
           Refuses COMPLETE straight from ACTIVE: the deferred scope's own
           blockers are not all built, so it cannot honestly have been built
           against them.

Options:
  -h, --help    Show this help message
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

die() { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARN: $*" >&2; }

# ─── Generic JSON helpers (copied verbatim from specclaw-bf-analyze-codebase —
# no shared lib, per repo convention) ─────────────────────────────────────────

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

json_array_from_lines() {
  local item first=true out=""
  while IFS= read -r item; do
    [ -z "$item" ] && continue
    if $first; then first=false; else out="${out}, "; fi
    out="${out}\"$(json_escape "$item")\""
  done
  printf '%s' "$out"
}

emit_json() {
  local output="$1"
  if command -v jq &>/dev/null; then
    if printf '%s' "$output" | jq . >/dev/null 2>&1; then
      printf '%s\n' "$output"
    else
      warn "JSON validation failed, outputting best-effort"
      printf '%s\n' "$output"
    fi
  else
    printf '%s\n' "$output"
  fi
}

# ─── Config reading (copied verbatim from specclaw-bf-clarify / specclaw-validate-
# change — no shared lib, per repo convention) ────────────────────────────────

yaml_val() {
  local file="$1" key="$2"
  local section field
  if [[ "$key" == *.* ]]; then
    section="${key%%.*}"
    field="${key#*.}"
  else
    section=""
    field="$key"
  fi

  local in_section=false value=""
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// /}" ]] && continue

    if [[ -z "$section" ]]; then
      if [[ "$line" =~ ^${field}:[[:space:]]*(.*) ]]; then
        value="${BASH_REMATCH[1]}"
        break
      fi
    else
      if [[ "$line" =~ ^[a-zA-Z_] ]]; then
        if [[ "$line" =~ ^${section}: ]]; then
          in_section=true
        else
          in_section=false
        fi
        continue
      fi
      if $in_section; then
        if [[ "$line" =~ ^[[:space:]]+${field}:[[:space:]]*(.*) ]]; then
          value="${BASH_REMATCH[1]}"
          break
        fi
      fi
    fi
  done < "$file"

  if [[ "$value" =~ ([[:space:]]+#) ]]; then
    value="${value%%"${BASH_REMATCH[1]}"*}"
  fi
  if [[ "$value" =~ [[:space:]]+$ ]]; then
    value="${value%"${BASH_REMATCH[0]}"}"
  fi
  value="${value#\"}"
  value="${value%\"}"
  value="${value#\'}"
  value="${value%\'}"
  echo "$value"
}

project_title() {
  local project_root="$1"
  local config_file="$project_root/.specclaw/config.yaml"
  local name=""
  if [ -f "$config_file" ]; then
    name="$(yaml_val "$config_file" "project.name")"
  fi
  if [ -z "$name" ]; then
    name="$(basename "$project_root")"
  fi
  printf '%s' "$name"
}

# ─── Template substitution (copied verbatim from specclaw-bf-clarify) ──────────

substitute() {
  # NOT "${content//"$token"/$value}" — bash's pattern-substitution
  # replacement string treats a literal & as "insert the whole match" (a
  # sed-style backreference, undocumented but real: `${x/foo/a&b}` inserts
  # foo between a and b). Any drafted or preserved prose containing a bare
  # & — which real content does, e.g. "Meetings & Notes" — silently gets
  # that & replaced with the token's own literal text. Split-and-concat via
  # %%/# never treats $value as a replacement string, so it can't trigger
  # this at all, at the cost of only replacing the first occurrence (fine
  # here — every template token appears exactly once).
  local content="$1" token="$2" value="$3"
  local prefix="${content%%"$token"*}"
  local suffix="${content#*"$token"}"
  printf '%s' "${prefix}${value}${suffix}"
}

# split_blocks captures every line up to (not including) the next heading —
# for a preserved item that has no Gate:/Verification: lines yet (e.g. its
# very first refresh) there is nothing for the skip-based field stripper to
# anchor on, so the "---" separator that sits between this block and the
# next one in the source document survives as this block's own trailing
# content. Strip it here as a final, unconditional pass: drop trailing
# blank lines, then one trailing "---" line if that's what's left, then any
# blank lines that preceded it.
strip_trailing_separator() {
  awk '
    { buf[NR] = $0 }
    END {
      n = NR
      while (n > 0 && buf[n] ~ /^[[:space:]]*$/) n--
      if (n > 0 && buf[n] ~ /^---$/) {
        n--
        while (n > 0 && buf[n] ~ /^[[:space:]]*$/) n--
      }
      for (i = 1; i <= n; i++) print buf[i]
    }
  '
}

# ─── Generic block splitting, keyed by a "### <PREFIX>-NNN" heading ──────────
# Same technique specclaw-bf-clarify uses for CQ-NNN and specclaw-bf-baseline uses
# for GM-NNN, generalized to a caller-supplied prefix/heading-pattern so this
# one script can split BL-NNN (rebuild-backlog.md), CQ-NNN (clarifications.md),
# and GM-NNN (scenarios.md) blocks with one function.

split_blocks() {
  # Must stop capturing at the NEXT level-2 "## " heading, not only at the
  # next "### <PREFIX>-NNN" one — otherwise the LAST block in the document
  # silently absorbs every trailing section (e.g. rebuild-backlog.md's
  # "## Sequencing Rationale"/"## Coverage Check" after "## Backlog", or
  # scenarios.md's "## No Legacy Behaviour Exists"/"## Rule Coverage Check"
  # after "## Scenarios") into its own block file. That pollution then
  # rides along wherever that block's content gets reused (e.g. a
  # preserved item's body ends up literally containing the sequencing
  # narrative, duplicating it once the dedicated placeholder ALSO renders
  # the same text correctly elsewhere in the document).
  local file="$1" outdir="$2" prefix="$3"
  [ -f "$file" ] || return 0
  awk -v dir="$outdir" -v prefix="$prefix" '
    $0 ~ ("^### " prefix "-[0-9]+") {
      match($0, prefix "-[0-9]+")
      id = substr($0, RSTART, RLENGTH)
      outfile = dir "/" id ".md"
    }
    $0 ~ /^## / && $0 !~ ("^### " prefix "-[0-9]+") { id = "" }
    id != "" { print $0 >> outfile }
  ' "$file"
}

block_id() { basename "$1" .md; }

block_title_after_dash() {
  # First line, text after the ID and its separating " — " (or " - ").
  # NB: the separator alternation must NOT be a bracket expression ([—-]) —
  # under a byte-oriented locale/sed build (observed on this toolchain even
  # with LC_CTYPE=C.UTF-8), a POSIX bracket class treats a multi-byte UTF-8
  # character as its individual raw bytes, silently eating only the first
  # byte of the em dash and corrupting every title that follows it.
  head -1 "$1" | sed -E 's/^### [A-Z]+-[0-9]+[[:space:]]*(—|-)[[:space:]]*//'
}

block_single_field() {
  # Matches both clarifications.md's bulleted "- **Label:**" convention and
  # rebuild-backlog.md's bare "**Label:**" convention — the leading "- "
  # must be an optional GROUP in the strip pattern too (not just optional on
  # the space after a mandatory dash), or the bare form's label survives
  # unstripped.
  local file="$1" label="$2"
  { grep -m1 -- "^- \*\*${label}:\*\*\|^\*\*${label}:\*\*" "$file" 2>/dev/null \
    | sed -E "s/^(- )?\*\*${label}:\*\* *//" | sed -E 's/[[:space:]]+$//'; } || true
}

# All DR-NNN tokens found anywhere in a file, deduped, in first-seen order.
# Guarded against pipefail: a file with zero matches is the common case
# (an item with no numbered-rule acceptance basis, an unanswered CQ with no
# rule citation yet), not an error — grep's exit-1 must never propagate.
extract_dr_ids() {
  { grep -oE 'DR-[0-9]{3}' "$1" 2>/dev/null | awk '!seen[$0]++'; } || true
}

# All BL-NNN tokens found anywhere in a file, deduped, in first-seen order.
extract_bl_ids() {
  { grep -oE 'BL-[0-9]{3}' "$1" 2>/dev/null | awk '!seen[$0]++'; } || true
}

# A "Depends on:" field's real dependency ids, as a comma-joined string.
# Only the leading id list — up to the first "(" — is a dependency claim;
# anything in the parenthetical explanation after it is prose and may
# incidentally name a DIFFERENT item for context (e.g. "None substantively
# — ... though it is conventionally part of the same shell built in item
# BL-012" — BL-012 there is not a real dependency). A leading "None" (with
# or without its own explanatory parenthetical) always means zero
# dependencies, regardless of what the explanation happens to mention.
depends_on_ids() {
  # NB: \b (word boundary) is not reliably supported by this toolchain's
  # bash regex engine — use an explicit space-or-end alternation instead.
  local line="$1" leading
  leading="${line%%(*}"
  if [[ "$leading" =~ ^[[:space:]]*[Nn]one([[:space:]]|$) ]]; then
    return 0
  fi
  printf '%s' "$leading" | { grep -oE 'BL-[0-9]{3}' | awk '!seen[$0]++' | paste -sd, -; } || true
}

ids_to_json_array() {
  local ids="$1" out="" first=true id
  while IFS= read -r id; do
    [ -z "$id" ] && continue
    if $first; then first=false; else out="${out}, "; fi
    out="${out}\"$(json_escape "$id")\""
  done <<< "$ids"
  printf '%s' "$out"
}

# ─── UI fidelity inputs (the optional /specclaw:bf-ui workstream) ───────────
#
# Everything here is inert unless SQ-013 (UI fidelity policy) has actually
# been decided FAITHFUL or THEME-ONLY. A project that answered REINTERPRET —
# or hasn't answered at all — gets no UI line on any item, no UI coverage
# section, and no warning: the whole workstream costs it nothing.
#
# The policy is read MECHANICALLY from decisions.md's literal structure, the
# same discipline specclaw-bf-replay's sanction-check uses: a decision is
# proved by a literal "### SQ-013 —" heading (headings only ever appear under
# "## Decisions" in that document's real structure, never under "##
# Outstanding Questions") plus one of the three literal policy tokens inside
# that block. Anything else is UNDECIDED — never inferred, and never
# defaulted to the least-work option.

FIDELITY_SQ_ID="SQ-013"

read_fidelity_policy() {
  local decisions_file="$1"
  [ -f "$decisions_file" ] || { printf 'UNDECIDED'; return 0; }
  local block
  block="$(awk -v id="$FIDELITY_SQ_ID" '
    $0 ~ ("^### " id "[[:space:]]") { cap=1; next }
    cap && /^### / { cap=0 }
    cap { print }
  ' "$decisions_file" 2>/dev/null || true)"
  [ -n "$block" ] || { printf 'UNDECIDED'; return 0; }
  local decision
  decision="$(printf '%s\n' "$block" | grep -m1 -- '^- \*\*Decision:\*\*' | sed -E 's/^- \*\*Decision:\*\* *//' || true)"
  [ -n "$decision" ] || { printf 'UNDECIDED'; return 0; }
  case "$decision" in
    *THEME-ONLY*)  printf 'THEME-ONLY' ;;
    *FAITHFUL*)    printf 'FAITHFUL' ;;
    *REINTERPRET*) printf 'REINTERPRET' ;;
    *)             printf 'UNDECIDED' ;;
  esac
}

# Every screen in ui-inventory.md, as "SCR-NNN<TAB><title>". A REMOVED
# tombstone entry is skipped — it is not a screen anyone can be held to.
ui_scr_entries() {
  local inventory="$1"
  [ -f "$inventory" ] || return 0
  local line id title
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    id="$(printf '%s' "$line" | grep -oE 'SCR-[0-9]+' | head -1 || true)"
    [ -n "$id" ] || continue
    title="$(printf '%s' "$line" | sed -E 's/^### SCR-[0-9]+[[:space:]]*(—|-)[[:space:]]*//')"
    case "$title" in REMOVED*) continue ;; esac
    printf '%s\t%s\n' "$id" "$title"
  done < <(grep -E '^### SCR-[0-9]+' "$inventory" 2>/dev/null || true)
}

# Every token group in design-tokens.json, as "TK-NNN<TAB><name><TAB><scope>".
ui_tk_entries() {
  local tokens_file="$1"
  [ -f "$tokens_file" ] || return 0
  if command -v jq &>/dev/null && jq -e . "$tokens_file" >/dev/null 2>&1; then
    jq -r '.token_groups[]? | [.tk_id, (.name // ""), (.scope // "global")] | @tsv' "$tokens_file" 2>/dev/null | tr -d '\r' || true
  else
    warn "jq not found (or design-tokens.json is not valid JSON) — token-group scopes cannot be read; every group will be treated as global"
    grep -oE '"tk_id"[[:space:]]*:[[:space:]]*"TK-[0-9]+"' "$tokens_file" 2>/dev/null \
      | grep -oE 'TK-[0-9]+' | awk '{print $0"\t\tglobal"}' || true
  fi
}

extract_scr_ids() {
  { grep -oE 'SCR-[0-9]{3}' "$1" 2>/dev/null | awk '!seen[$0]++'; } || true
}

# ─── Known analysis documents (hard prerequisites) ──────────────────────────
#
# module-map.md joins the original four as a hard prerequisite: every backlog
# item declares the MOD-### it belongs to, items are grouped and sequenced by
# the map's own module dependency order, and the recommended-next-module
# computation reads nothing else. A backlog rendered without it would have to
# either invent a grouping or silently drop the hierarchy — so it fails
# loudly, naming the producing command, exactly like the other four.

DOC_SPECS=(
  "codebase-report.md|bf-analyze"
  "architecture.md|bf-architecture"
  "domain-model.md|bf-domain"
  "functional-spec.md|bf-domain"
  "module-map.md|bf-domain"
)

# ─── Module map parsing (.specclaw/analysis/module-map.md) ──────────────────
#
# Blocks split with the same generic split_blocks above (prefix "MOD"), which
# already stops at the next "## " heading — module-map.md has several
# sections after "## Modules" and the last module block would otherwise
# swallow all of them.

# The map's own Status line: "PROPOSED — awaiting human confirmation", or
# "CONFIRMED by <name>, <date>". Reported verbatim and never normalized: a
# proposed grouping is a starting point for a conversation, and every command
# that groups by it says on its face which one it read.
read_module_map_status() {
  local map_file="$1"
  [ -f "$map_file" ] || { printf ''; return 0; }
  { grep -m1 -- '^\*\*Status:\*\*' "$map_file" 2>/dev/null \
    | sed -E 's/^\*\*Status:\*\* *//' | sed -E 's/[[:space:]]+$//'; } || true
}

# MOD-### tokens in a "Depends on:" field, comma-joined. Same leading-id-list
# discipline depends_on_ids applies to BL items: only the id list before the
# first "(" is a dependency claim, and a leading "None" means zero regardless
# of what the parenthetical explanation happens to name.
mod_depends_on_ids() {
  local line="$1" leading
  leading="${line%%(*}"
  if [[ "$leading" =~ ^[[:space:]]*[Nn]one([[:space:]]|$) ]]; then
    return 0
  fi
  printf '%s' "$leading" | { grep -oE 'MOD-[0-9]{3}' | awk '!seen[$0]++' | paste -sd, -; } || true
}

# ─── Stub registry parsing (.specclaw/analysis/module-stubs.md) ─────────────
#
# The dependency-bypass registry, per templates/CONTRACT.md (m). Split with
# the same generic split_blocks (prefix "ST"); fields read with the same
# block_single_field the backlog and clarifications use.
#
# ABSENCE IS A NORMAL STATE. Most projects never bypass anything, so a missing
# registry is an empty registry — silently. Nothing here warns about it, and
# no caller degrades because of it.

# The three FAKING strategies. `item-split` is deliberately NOT here any more:
# it fakes nothing, so it taints nothing and retires nothing, and giving it an
# ST-### alongside the three that do fake something is what let a split's actual
# scope live only in a free-text summary nobody downstream could read. It has
# its own registry (ITEM_SPLIT_LAYERS below, templates/item-splits.md), and
# stub-append refuses it by name.
STUB_STRATEGIES="stub-interface mock-data feature-flag"

# Accepted for reading only: entries recorded before item-splits.md existed.
# ST ids are permanent and entries are never deleted (CONTRACT.md (c)), so these
# stay where they are forever — excluded from taint and from the retirement
# block, and named once by rebuild-plan with the manual step.
STUB_STRATEGIES_LEGACY="item-split"

stubs_file_path() { printf '%s/analysis/module-stubs.md' "$1"; }

# An entry's status normalized to exactly one of ACTIVE / RETIRING / RETIRED.
# Only the FIRST token of the Status field is read — the rest is the date and
# the clearing run id, which are prose to every mechanical reader. An
# unrecognized value is reported as-is by the caller rather than coerced to
# ACTIVE: silently treating a typo as "taints everything" or as "taints
# nothing" are both wrong, and the caller can say which it saw.
stub_status_of() {
  local raw="$1" first
  first="$(printf '%s' "$raw" | awk '{print toupper($1)}')"
  case "$first" in
    ACTIVE|RETIRING|RETIRED) printf '%s' "$first" ;;
    *) printf '%s' "${first:-MISSING}" ;;
  esac
}

# Next free ST-### id. Scans for the highest assigned number and adds one —
# ids are permanent (CONTRACT.md (c)) and never reused, so a retired or
# malformed entry still holds its number.
next_stub_id() {
  local stubs_file="$1" max=0 n
  if [ -f "$stubs_file" ]; then
    while IFS= read -r n; do
      [ -z "$n" ] && continue
      n=$((10#$n))
      [ "$n" -gt "$max" ] && max="$n"
    done < <({ grep -oE '^### ST-[0-9]+' "$stubs_file" 2>/dev/null | grep -oE '[0-9]+'; } || true)
  fi
  printf 'ST-%03d' $((max + 1))
}

# ─── The declared BUILT: signal ─────────────────────────────────────────────
#
# specclaw records NO built state for a backlog item. The only thing that can
# stand in for one is a human saying so — and the only mechanically safe way
# to read that is a declared token, not prose.
#
# So: a line beginning "BUILT:" (optionally bulleted) inside an item's own
# "**Status notes (human-added):**" block, and nothing else. "done last week",
# "shipped in #42", "✅" — none of these are parsed, deliberately. Inferring
# completion from free text is exactly the guess the whole bypass mechanism
# exists to prevent, and a false positive here silently skips the elicitation
# that would otherwise have caught an unmet dependency.
#
# Prints the text after "BUILT:" when the signal is present; prints nothing
# and returns 1 when it is not.
built_signal_of() {
  local block_file="$1" line
  line="$(awk '
    /^\*\*Status notes \(human-added\):\*\*/ { intail=1 }
    intail && /^(- )?BUILT:/ { sub(/^(- )?BUILT:[[:space:]]*/, ""); print; exit }
  ' "$block_file" 2>/dev/null || true)"
  [ -n "$line" ] || return 1
  printf '%s' "$line"
}

# ─── The item-split registry (.specclaw/analysis/item-splits.md) ────────────
#
# CONTRACT.md (o). Deliberately a SEPARATE registry from module-stubs.md: the
# other three bypass strategies fake a dependency, so what they put in question
# is whether the thing under test was real. A split fakes nothing — it defers
# real scope — so what it puts in question is whether the ITEM IS FINISHED.
# Different question, different states, different vocabulary, no taint.
#
# Parsed with the same generic split_blocks/block_single_field the backlog,
# clarifications and stub registry use, with prefix "IS". ABSENCE IS A NORMAL
# STATE: most projects never split an item, and a missing registry is an empty
# one, silently.

# Closed vocabulary for the layer fields. Role names, never technologies — the
# same discipline CONTRACT.md holds for seam layers and bootstrap pillars.
# `ui` is the load-bearing one: it is what makes "this split removes the whole
# UI from a screen-bearing item" a mechanical check rather than a prose reading.
ITEM_SPLIT_LAYERS="ui api domain persistence integration auth-integration reporting background-jobs"

splits_file_path() { printf '%s/analysis/item-splits.md' "$1"; }

# An entry's status, normalized to exactly one of ACTIVE / READY-TO-RESUME /
# COMPLETE. Only the FIRST token is read; the rest is the date and the clearing
# run id, which are prose to every mechanical reader. An unrecognized value is
# reported as-is rather than coerced — silently reading a typo as COMPLETE
# (nothing is deferred) or as ACTIVE (everything is) are both wrong, and the
# caller can say which it saw. Same discipline as stub_status_of.
split_status_of() {
  local raw="$1" first
  first="$(printf '%s' "$raw" | awk '{print toupper($1)}')"
  case "$first" in
    ACTIVE|READY-TO-RESUME|COMPLETE) printf '%s' "$first" ;;
    *) printf '%s' "${first:-MISSING}" ;;
  esac
}

# Next free IS-### id. Ids are permanent (CONTRACT.md (c)) and never reused, so
# a COMPLETE or malformed entry still holds its number.
next_split_id() {
  local splits_file="$1" max=0 n
  if [ -f "$splits_file" ]; then
    while IFS= read -r n; do
      [ -z "$n" ] && continue
      n=$((10#$n))
      [ "$n" -gt "$max" ] && max="$n"
    done < <({ grep -oE '^### IS-[0-9]+' "$splits_file" 2>/dev/null | grep -oE '[0-9]+'; } || true)
  fi
  printf 'IS-%03d' $((max + 1))
}

# Does this backlog item render a screen? Declared data only, and exactly the
# two signals /specclaw:bf-rebuild-plan itself uses: the item's own SCR-###
# citations, plus a rendered `**UI fidelity:**` line (which render only ever
# writes for a screen-bearing item, whether it learned that from the citations
# or from the planner agent's SCREEN-BEARING directive).
#
# This is the input to the layer-removal guard. It never guesses from a title:
# "View/Search the Patient Grid" obviously renders a screen to a human reader,
# and inferring that from prose is exactly the kind of judgement that belongs
# to declared data instead.
item_is_screen_bearing() {
  local block_file="$1"
  [ -f "$block_file" ] || return 1
  grep -qE '\bSCR-[0-9]{3}\b' "$block_file" 2>/dev/null && return 0
  grep -qE '^\*\*UI fidelity:\*\*' "$block_file" 2>/dev/null && return 0
  return 1
}

# Normalize a comma/space-separated id list to a canonical comma-joined,
# deduped, first-seen-order string. Used for the DR partition and the
# blocked-until list, so "DR-002,DR-014" and "DR-002, DR-014 " compare equal.
normalize_id_list() {
  local raw="$1" pattern="$2"
  printf '%s' "$raw" | { grep -oE "$pattern" | awk '!seen[$0]++' | paste -sd, -; } || true
}

# ─── Quality remediation (optional; inert without .specclaw/analysis/quality.json) ──
#
# /specclaw:bf-quality measures the legacy tree and registers each hotspot it
# finds as a permanent QI-###. Annotating a module's rollup line with that
# measurement — which this command already did — tells a reader which module is
# in the worst shape. It does not make the REBUILD answerable for any of it.
#
# These helpers are the input side of the item that does. Every one of them
# degrades to producing nothing when quality.json is absent, jq is not on PATH,
# or the JSON does not parse, which is what keeps the whole feature optional:
# a project that never runs /specclaw:bf-quality renders a byte-identical
# backlog to one rendered before this existed.
#
# WHAT IS DELIBERATELY NOT HERE: any read of the legacy source, any
# re-derivation of a metric, any threshold comparison of its own. Every
# severity and status below was computed once, by the quality collector, and is
# read back verbatim. See that script's "WHY BASH OWNS THE VERDICTS".

# The three bands, ranked, so "at or above the floor" is one integer compare.
# An unrecognized or absent severity ranks -1 and therefore qualifies for
# nothing: a quality_issues[] entry with a null severity is the shape a RESOLVED
# record has, and resolved hotspots are not what a rebuild is held to.
# EVERY jq READ BELOW IS PIPED THROUGH `tr -d '\r'`, and that is not cosmetic.
# jq on Windows writes its output in text mode, so each line arrives CRLF-
# terminated and the CR lands on the LAST field of the row. It is invisible in
# every printf and every diff, and it makes an exact string compare fail: a
# dimension classified "regressed\r" tested unequal to "regressed", so a
# regressing target was reported as merely still-above-threshold and a module
# with a regression contributed no regression note at all. The same guard is
# already applied to every other jq read in this file.
#
# The four dimensions quality-delta.json compares, in its own order. Named once
# here so the "no hotspot left to retire" branch checks the same set the delta
# reports rather than a list restated at the point of use.
QR_DIMENSIONS="complexity function_length duplication file_length"

qr_severity_rank() {
  case "$(printf '%s' "${1:-}" | tr '[:lower:]' '[:upper:]')" in
    HIGH) printf '2' ;;
    WARN) printf '1' ;;
    PASS) printf '0' ;;
    *)    printf -- '-1' ;;
  esac
}

# The severity floor, from the SAME config block the quality thresholds live in
# (PD-03 — no inline magic value). Deliberately independent of that section's
# register_severity: one decides which hotspots get a permanent id, this decides
# which of them the rebuild must clear.
read_remediation_floor() {
  local config_file="$1" v=""
  [ -f "$config_file" ] && v="$(yaml_val "$config_file" "quality.remediation_severity_floor")"
  case "$(printf '%s' "${v:-}" | tr '[:lower:]' '[:upper:]')" in
    HIGH|"") printf 'HIGH' ;;
    WARN)    printf 'WARN' ;;
    *)
      warn "config.yaml quality.remediation_severity_floor must be HIGH or WARN ('${v}') — using HIGH."
      printf 'HIGH' ;;
  esac
}

# Open hotspots at or above the floor, one row each:
#   module_id  qi_id  metric  file  function  value  severity
#
# UNIT-SEPARATED (\x1f), NOT TAB-SEPARATED, and that is load-bearing. A tab is
# an IFS whitespace character, so `read` collapses a run of them into ONE
# delimiter and every empty field in the middle of a row silently disappears.
# A hotspot with no function — file_length, duplication — has exactly that
# shape, and its severity landed in its value column.
# Sorted by id so the rendered list is stable across runs — an item whose
# hotspot list reordered itself every refresh would show a diff on every run
# and idempotency would be unprovable.
quality_qualifying_qis() {
  local qj="$1" floor="$2"
  [ -f "$qj" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  jq -r --arg floor "$floor" '
    def rank: {"PASS":0,"WARN":1,"HIGH":2}[. // ""] // -1;
    [ .quality_issues[]?
      | select(.status == "open")
      | select((.severity | rank) >= ($floor | rank)) ]
    | sort_by(.id)[]
    | [ (.module_id // "MOD-UNASSIGNED"), (.id // ""), (.metric // "unknown"),
        (.file // ""), (.function // ""),
        (if .value == null then "" else (.value | tostring) end),
        (.severity // "") ]
    | join("\u001f")
  ' "$qj" 2>/dev/null | tr -d '\r' || true
}

# Registered hotspots the quality scan no longer MEASURES, one row each:
#   module_id  qi_id
#
# These are QI-### entries whose file fell outside the configured scan scope on
# the last measurement. They are not open — they generate no backlog item and
# appear in no rollup — but they are emphatically not resolved either, and the
# difference is the whole point of reading them separately.
#
# A remediation item's ledger records a hotspot leaving it as "Retired — no
# longer open at or above the floor", which reads as "somebody fixed it". For a
# hotspot that stopped being measured that sentence is false, and it is false in
# the flattering direction: the module looks like it improved because the scan
# stopped looking. So this feeds a distinct, dated SCOPE CHANGE line instead.
#
# Same degradation contract as every helper here: absent file, absent jq or
# unreadable JSON all produce nothing, and the backlog renders as though the
# feature did not exist.
quality_excluded_by_scope_qis() {
  local qj="$1"
  [ -f "$qj" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  jq -r '
    [ .quality_issues[]? | select(.status == "excluded-by-scope") ]
    | sort_by(.id)[]
    | [ (.module_id // "MOD-UNASSIGNED"), (.id // "") ]
    | join("\u001f")
  ' "$qj" 2>/dev/null | tr -d '\r' || true
}

# The exclusion config hash the last measurement scoped itself with, for citing
# in a scope-change note. Empty when the snapshot predates scan scoping.
quality_scope_hash() {
  local qj="$1"
  [ -f "$qj" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  jq -r '.exclusions.config_hash // empty' "$qj" 2>/dev/null | tr -d '\r' || true
}

# How many of a module's OPEN hotspots sit below the floor — the advisory count
# (PD-03). These generate no item on purpose: registering an id for a WARN is a
# decision about record-keeping, holding a rebuild to it is a decision about
# scope, and they are not the same decision.
quality_below_floor_count() {
  local qj="$1" floor="$2" mid="$3"
  [ -f "$qj" ] || { printf '0'; return 0; }
  command -v jq >/dev/null 2>&1 || { printf '0'; return 0; }
  jq -r --arg floor "$floor" --arg m "$mid" '
    def rank: {"PASS":0,"WARN":1,"HIGH":2}[. // ""] // -1;
    [ .quality_issues[]?
      | select(.status == "open" and .module_id == $m)
      | select((.severity | rank) >= 0 and (.severity | rank) < ($floor | rank)) ]
    | length
  ' "$qj" 2>/dev/null | tr -d '\r' || printf '0'
}

# quality-delta.json's per-dimension verdicts, one unit-separated row each:
#   module_id  metric  target_status  classification
#
# WHERE THIS FILE COMES FROM. /specclaw:bf-quality --target measures the rebuilt
# tree and --compare writes the delta, and BOTH write into the same
# .specclaw/analysis/ directory this command already reads quality.json from —
# --target changes which tree is measured, never where the artifact lands. So
# there is no second location to look in and no copy-back step to get wrong.
quality_delta_rows() {
  local dj="$1"
  [ -f "$dj" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  jq -r '
    .deltas[]?
    | [ (.module_id // ""), (.metric // ""),
        (.target_status // "NOT-MEASURED"), (.classification // "NOT-COMPARABLE") ]
    | join("\u001f")
  ' "$dj" 2>/dev/null | tr -d '\r' || true
}

# The delta's own generation timestamp, for citing in the computed state. Empty
# when there is no delta — every caller treats that as "not measured yet".
quality_delta_stamp() {
  local dj="$1"
  [ -f "$dj" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  jq -r '.generated_at // empty' "$dj" 2>/dev/null | tr -d '\r' || true
}

# ─── Subcommand: collect ─────────────────────────────────────────────────────

cmd_collect() {
  local specclaw_dir="$1"; shift
  local is_refresh=false module_scope=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --refresh) is_refresh=true ;;
      --module)
        shift
        [ $# -gt 0 ] || die "--module requires a MOD-### id (e.g. --module MOD-002)."
        module_scope="$1"
        ;;
      --module=*) module_scope="${1#--module=}" ;;
      *) die "Unknown option for collect: $1" ;;
    esac
    shift
  done
  if [ -n "$module_scope" ] && ! [[ "$module_scope" =~ ^MOD-[0-9]{3}$ ]]; then
    die "--module expects a MOD-### id (three digits, e.g. MOD-002); got '${module_scope}'."
  fi

  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"

  local specclaw_dir_abs project_root analysis_dir baseline_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  analysis_dir="$specclaw_dir_abs/analysis"
  baseline_dir="$specclaw_dir_abs/baseline"

  # Hard prerequisite: the four analysis documents (unchanged from before).
  local spec doc_name producing_cmd missing=""
  for spec in "${DOC_SPECS[@]}"; do
    doc_name="${spec%%|*}"
    producing_cmd="${spec##*|}"
    if [ ! -f "$analysis_dir/$doc_name" ]; then
      missing="${missing}  - .specclaw/analysis/${doc_name} (run /specclaw:${producing_cmd})
"
    fi
  done
  if [ -n "$missing" ]; then
    echo "ERROR: missing analysis document(s) — run the producing command first:" >&2
    printf '%s' "$missing" >&2
    exit 1
  fi

  local docs_json="" first=true rel_path lines
  for spec in "${DOC_SPECS[@]}"; do
    doc_name="${spec%%|*}"
    rel_path=".specclaw/analysis/${doc_name}"
    lines="$(wc -l < "$analysis_dir/$doc_name" | tr -d '[:space:]')"
    if $first; then first=false; else docs_json="${docs_json},"; fi
    docs_json="${docs_json}
    {\"path\": \"$(json_escape "$rel_path")\", \"lines\": ${lines}}"
  done

  # Refuse-without-refresh gate.
  local backlog_file="$analysis_dir/rebuild-backlog.md"
  local mode="first-run"
  if [ -f "$backlog_file" ]; then
    if ! $is_refresh; then
      die "$(cat <<'EOF'
.specclaw/analysis/rebuild-backlog.md already exists.

/specclaw:bf-rebuild-plan no longer regenerates an existing backlog from
scratch — that would destroy in-flight status (Gate/Verification, struck/
deferred items, human-added status notes). Run /specclaw:bf-rebuild-plan
--refresh to update it in place, or archive/delete the file manually first
if you genuinely want a from-scratch run.
EOF
)"
    fi
    mode="refresh"
  fi

  # ── Module roster (hard input — DOC_SPECS above already proved it exists) ─
  local map_path="$analysis_dir/module-map.md"
  local map_status modules_json="" mfirst=true
  map_status="$(read_module_map_status "$map_path")"
  local -a known_mods=()
  {
    local workdir; workdir="$(mktemp -d)"
    split_blocks "$map_path" "$workdir" "MOD"
    local f mid mname mstatus mrules_json mdeps_json
    for f in "$workdir"/MOD-*.md; do
      [ -f "$f" ] || continue
      mid="$(block_id "$f")"
      mname="$(block_title_after_dash "$f")"
      # A withdrawn module keeps its id claimed forever but is never a
      # grouping target — reported so a reader (and the agent) can see the
      # tombstone rather than wonder where the id went.
      case "$mname" in WITHDRAWN*) mstatus="withdrawn" ;; *) mstatus="active"; known_mods+=("$mid") ;; esac
      mrules_json="$(ids_to_json_array "$(extract_dr_ids "$f")")"
      mdeps_json="$(ids_to_json_array "$(mod_depends_on_ids "$(block_single_field "$f" "Depends on")" | tr ',' '\n')")"
      if $mfirst; then mfirst=false; else modules_json="${modules_json},"; fi
      modules_json="${modules_json}
    {\"mod_id\": \"$(json_escape "$mid")\", \"name\": \"$(json_escape "$mname")\", \"status\": \"${mstatus}\", \"rules\": [${mrules_json}], \"depends_on\": [${mdeps_json}]}"
    done
    rm -rf "$workdir"
  }

  # A --module id that names no active module in the map is a hard failure,
  # not a run that quietly plans nothing: the whole point of the flag is to
  # scope work to a real module, and a typo would otherwise render a backlog
  # in which that module's items were silently left unplanned.
  if [ -n "$module_scope" ]; then
    local found=false m
    for m in ${known_mods[@]+"${known_mods[@]}"}; do
      [ "$m" = "$module_scope" ] && { found=true; break; }
    done
    if ! $found; then
      die "--module ${module_scope} names no active module in .specclaw/analysis/module-map.md. Active modules: ${known_mods[*]:-none}. (A WITHDRAWN module cannot be planned — its id stays claimed as a tombstone.)"
    fi
  fi

  # Optional inputs.
  local decisions_path="$analysis_dir/decisions.md"
  local clar_path="$analysis_dir/clarifications.md"
  local manifest_path="$baseline_dir/manifest.json"
  local scenarios_path="$baseline_dir/scenarios.md"

  local decisions_present=false clar_present=false manifest_present=false scenarios_present=false
  [ -f "$decisions_path" ] && decisions_present=true
  [ -f "$clar_path" ] && clar_present=true
  [ -f "$manifest_path" ] && manifest_present=true
  [ -f "$scenarios_path" ] && scenarios_present=true

  # CQs: id, type, blocking (bool), answered (bool), rules[], items[].
  local cqs_json="" cfirst=true
  if $clar_present; then
    local workdir; workdir="$(mktemp -d)"
    split_blocks "$clar_path" "$workdir" "CQ"
    local f id qtype blocking_txt blocking answered
    for f in "$workdir"/CQ-*.md; do
      [ -f "$f" ] || continue
      id="$(block_id "$f")"
      qtype="$(block_single_field "$f" "Type")"
      blocking_txt="$(block_single_field "$f" "Blocking")"
      case "$blocking_txt" in [Yy][Ee][Ss]*) blocking=true ;; *) blocking=false ;; esac
      local answer_txt
      answer_txt="$(awk '
        /^- \*\*Answer:\*\*/ { sub(/^- \*\*Answer:\*\* */, ""); if (length($0)>0) started=1; capturing=1; buf=$0; next }
        /^- \*\*Decided by:\*\*/ { capturing=0 }
        capturing { buf = buf "\n" $0; next }
        END { print buf }
      ' "$f" | tr -d '[:space:]')"
      if [ -n "$answer_txt" ]; then answered=true; else answered=false; fi
      local rules_json items_json
      rules_json="$(ids_to_json_array "$(extract_dr_ids "$f")")"
      items_json="$(ids_to_json_array "$(extract_bl_ids "$f")")"
      if $cfirst; then cfirst=false; else cqs_json="${cqs_json},"; fi
      cqs_json="${cqs_json}
    {\"id\": \"$(json_escape "$id")\", \"type\": \"$(json_escape "$qtype")\", \"blocking\": ${blocking}, \"answered\": ${answered}, \"rules\": [${rules_json}], \"items\": [${items_json}]}"
    done
    rm -rf "$workdir"
  fi

  # decisions.md: which CQ ids have a recorded decision.
  local decided_json=""
  if $decisions_present; then
    decided_json="$(grep -oE '^### CQ-[0-9]+' "$decisions_path" 2>/dev/null \
      | sed -E 's/^### //' | json_array_from_lines || true)"
  fi

  # Baseline: prefer manifest.json (captured fixtures); scenarios.md always
  # read too, when present, for the full scenario roster (captured or not)
  # and the raw "No Legacy Behaviour Exists" text.
  local scenarios_json="" sfirst=true fixtures_json="" ffirst=true
  local no_legacy_present=false
  if $scenarios_present; then
    grep -q '^## No Legacy Behaviour Exists' "$scenarios_path" 2>/dev/null && no_legacy_present=true
    local workdir; workdir="$(mktemp -d)"
    split_blocks "$scenarios_path" "$workdir" "GM"
    local f id rules_json item_id
    for f in "$workdir"/GM-*.md; do
      [ -f "$f" ] || continue
      id="$(block_id "$f")"
      rules_json="$(ids_to_json_array "$(extract_dr_ids "$f")")"
      item_id="$(extract_bl_ids "$f" | head -1)"
      if $sfirst; then sfirst=false; else scenarios_json="${scenarios_json},"; fi
      scenarios_json="${scenarios_json}
    {\"id\": \"$(json_escape "$id")\", \"rules\": [${rules_json}], \"item\": \"$(json_escape "$item_id")\"}"
    done
    rm -rf "$workdir"
  fi
  if $manifest_present; then
    if command -v jq &>/dev/null; then
      while IFS=$'\t' read -r sid rules item sha; do
        [ -z "$sid" ] && continue
        local rules_json item_id
        rules_json="$(ids_to_json_array "$(printf '%s' "$rules" | { grep -oE 'DR-[0-9]{3}' | awk '!seen[$0]++'; } || true)")"
        item_id="$(printf '%s' "$item" | { grep -oE 'BL-[0-9]{3}' | head -1; } || true)"
        if $ffirst; then ffirst=false; else fixtures_json="${fixtures_json},"; fi
        fixtures_json="${fixtures_json}
    {\"scenario_id\": \"$(json_escape "$sid")\", \"rules\": [${rules_json}], \"item\": \"$(json_escape "$item_id")\", \"legacy_commit_sha\": \"$(json_escape "$sha")\"}"
      done < <({ jq -r '.fixtures[] | [.scenario_id, .business_rules_pinned, .verifies_backlog_item, .legacy_commit_sha] | @tsv' "$manifest_path" 2>/dev/null | tr -d '\r'; } || true)
    else
      warn "jq not found — falling back to scenarios.md's roster for baseline facts (manifest.json's own per-fixture text is not parsed without jq)"
    fi
  fi

  # Refresh: parse existing rebuild-backlog.md's items (facts only).
  local existing_json="" efirst=true next_num=1
  if [ "$mode" = "refresh" ]; then
    local workdir; workdir="$(mktemp -d)"
    split_blocks "$backlog_file" "$workdir" "BL"
    local f id title depends_json rules_json status old_gate old_verification num item_module
    for f in "$workdir"/BL-*.md; do
      [ -f "$f" ] || continue
      id="$(block_id "$f")"
      num="${id#BL-}"; num=$((10#$num))
      [ "$num" -ge "$next_num" ] && next_num=$((num + 1))
      title="$(block_title_after_dash "$f")"
      status="active"
      grep -qE '^\*\*Status:\*\* Deferred' "$f" && status="deferred"
      [[ "$title" == STRUCK* ]] && status="struck"
      depends_json="$(ids_to_json_array "$(depends_on_ids "$(block_single_field "$f" "Depends on")" | tr ',' '\n')")"
      rules_json="$(ids_to_json_array "$(extract_dr_ids "$f")")"
      old_gate="$(block_single_field "$f" "Gate")"
      old_verification="$(block_single_field "$f" "Verification")"
      # An item written before the module hierarchy existed carries no
      # Module field; that reads back as "" and is reported as unassigned
      # rather than guessed at from the item's rules.
      item_module="$(printf '%s' "$(block_single_field "$f" "Module")" | { grep -oE 'MOD-[0-9]{3}' | head -1; } || true)"
      if $efirst; then efirst=false; else existing_json="${existing_json},"; fi
      existing_json="${existing_json}
    {\"id\": \"$(json_escape "$id")\", \"title\": \"$(json_escape "$title")\", \"module\": \"$(json_escape "$item_module")\", \"depends_on\": [${depends_json}], \"rules\": [${rules_json}], \"status\": \"${status}\", \"old_gate\": \"$(json_escape "${old_gate%% —*}")\", \"old_verification\": \"$(json_escape "${old_verification%% —*}")\"}"
    done
    rm -rf "$workdir"
  fi
  local next_bl_id; next_bl_id="$(printf 'BL-%03d' "$next_num")"

  # ── UI fidelity inputs (optional; inert unless SQ-013 is decided
  # FAITHFUL/THEME-ONLY — see the helpers above) ──────────────────────────
  local ui_dir="$specclaw_dir_abs/ui"
  local ui_inventory="$ui_dir/ui-inventory.md"
  local ui_tokens="$ui_dir/design-tokens.json"
  local ui_manifest="$ui_dir/ui-manifest.json"
  local ui_inv_present=false ui_tok_present=false ui_man_present=false ui_screens_present=false
  [ -f "$ui_inventory" ] && ui_inv_present=true
  [ -f "$ui_tokens" ] && ui_tok_present=true
  [ -f "$ui_manifest" ] && ui_man_present=true
  [ -d "$ui_dir/screens" ] && ui_screens_present=true

  local fidelity_policy
  fidelity_policy="$(read_fidelity_policy "$decisions_path")"

  local ui_screens_json="" uifirst=true scr_id scr_title
  while IFS=$'\t' read -r scr_id scr_title; do
    [ -z "$scr_id" ] && continue
    if $uifirst; then uifirst=false; else ui_screens_json="${ui_screens_json},"; fi
    ui_screens_json="${ui_screens_json}
    {\"scr_id\": \"$(json_escape "$scr_id")\", \"title\": \"$(json_escape "$scr_title")\"}"
  done < <(ui_scr_entries "$ui_inventory")

  local ui_tokens_json="" utfirst=true tk_id tk_name tk_scope
  while IFS=$'\t' read -r tk_id tk_name tk_scope; do
    [ -z "$tk_id" ] && continue
    if $utfirst; then utfirst=false; else ui_tokens_json="${ui_tokens_json},"; fi
    ui_tokens_json="${ui_tokens_json}
    {\"tk_id\": \"$(json_escape "$tk_id")\", \"name\": \"$(json_escape "$tk_name")\", \"scope\": \"$(json_escape "${tk_scope:-global}")\"}"
  done < <(ui_tk_entries "$ui_tokens")

  local output
  output=$(cat <<ENDJSON
{
  "project_root": "$(json_escape "$project_root")",
  "mode": "${mode}",
  "module_scope": $(if [ -n "$module_scope" ]; then printf '"%s"' "$(json_escape "$module_scope")"; else printf 'null'; fi),
  "module_map": {
    "path": ".specclaw/analysis/module-map.md",
    "status": "$(json_escape "$map_status")",
    "confirmed": $(case "$map_status" in CONFIRMED*) printf 'true' ;; *) printf 'false' ;; esac),
    "modules": [${modules_json}
    ]
  },
  "docs": [${docs_json}
  ],
  "optional_inputs": {
    "decisions_md": {"present": ${decisions_present}, "path": ".specclaw/analysis/decisions.md"},
    "clarifications_md": {"present": ${clar_present}, "path": ".specclaw/analysis/clarifications.md"},
    "manifest_json": {"present": ${manifest_present}, "path": ".specclaw/baseline/manifest.json"},
    "scenarios_md": {"present": ${scenarios_present}, "path": ".specclaw/baseline/scenarios.md"}
  },
  "cqs": [${cqs_json}
  ],
  "decided_cq_ids": [${decided_json}],
  "scenarios": [${scenarios_json}
  ],
  "fixtures": [${fixtures_json}
  ],
  "no_legacy_behaviour_present": ${no_legacy_present},
  "ui_fidelity": {
    "policy": "${fidelity_policy}",
    "policy_source": ".specclaw/analysis/decisions.md (${FIDELITY_SQ_ID})",
    "grounding_required": $(case "$fidelity_policy" in FAITHFUL|THEME-ONLY) printf 'true' ;; *) printf 'false' ;; esac),
    "inputs": {
      "ui_inventory_md": {"present": ${ui_inv_present}, "path": ".specclaw/ui/ui-inventory.md"},
      "design_tokens_json": {"present": ${ui_tok_present}, "path": ".specclaw/ui/design-tokens.json"},
      "screens_dir": {"present": ${ui_screens_present}, "path": ".specclaw/ui/screens"},
      "ui_manifest_json": {"present": ${ui_man_present}, "path": ".specclaw/ui/ui-manifest.json"}
    },
    "screens": [${ui_screens_json}
    ],
    "token_groups": [${ui_tokens_json}
    ]
  },
  "existing_items": [${existing_json}
  ],
  "next_bl_id": "$(json_escape "$next_bl_id")"
}
ENDJSON
)
  emit_json "$output"
}

# ─── Deterministic Gate/Verification/ordering engine (shared by render) ─────
#
# All of the functions below operate on a workdir containing:
#   $workdir/items/BL-NNN.md   — final static body text for every ACTIVE item
#                                  (preserved, revised, or newly drafted —
#                                  origin doesn't matter once we're here)
#   $workdir/cqs/CQ-NNN.md     — every clarifications.md block, verbatim
#   $workdir/scenarios/GM-NNN.md — every scenarios.md block, verbatim (if any)
# plus plain files: $workdir/fixtures.tsv (scenario_id<TAB>rules-csv<TAB>item<TAB>sha)
# and $workdir/unverifiable.tsv (item_id<TAB>cq_id<TAB>reason)

cq_touches_item() {
  # Args: cq_rules_csv cq_items_csv item_id item_rules_csv
  local cq_rules="$1" cq_items="$2" item_id="$3" item_rules="$4"
  local r
  IFS=',' read -ra _cr <<< "$cq_rules"
  for r in "${_cr[@]}"; do
    [ -z "$r" ] && continue
    [[ ",${item_rules}," == *",${r},"* ]] && return 0
  done
  [[ ",${cq_items}," == *",${item_id},"* ]] && return 0
  return 1
}

# ─── Subcommand: render ──────────────────────────────────────────────────────

cmd_render() {
  local specclaw_dir="$1" draft_file="$2"; shift 2
  local module_scope=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --module)
        shift
        [ $# -gt 0 ] || die "--module requires a MOD-### id (e.g. --module MOD-002)."
        module_scope="$1"
        ;;
      --module=*) module_scope="${1#--module=}" ;;
      *) die "Unknown option for render: $1" ;;
    esac
    shift
  done
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"
  [ -f "$draft_file" ] || die "draft file not found: $draft_file"

  local specclaw_dir_abs project_root analysis_dir baseline_dir archive_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  analysis_dir="$specclaw_dir_abs/analysis"
  baseline_dir="$specclaw_dir_abs/baseline"
  archive_dir="$analysis_dir/archive"

  local backlog_file="$analysis_dir/rebuild-backlog.md"
  local clar_file="$analysis_dir/clarifications.md"
  local decisions_file="$analysis_dir/decisions.md"
  local manifest_file="$baseline_dir/manifest.json"
  local scenarios_file="$baseline_dir/scenarios.md"
  local map_file="$analysis_dir/module-map.md"
  [ -f "$map_file" ] || die "No .specclaw/analysis/module-map.md found — every backlog item is grouped under a MOD-### module and this document declares them. Run /specclaw:bf-domain first."

  local is_refresh=false
  [ -f "$backlog_file" ] && is_refresh=true

  local workdir; workdir="$(mktemp -d)"
  mkdir -p "$workdir/items" "$workdir/cqs" "$workdir/scenarios" "$workdir/existing"

  # ── Parse the agent's draft: directives + item blocks ──────────────────
  local strike_file="$workdir/strike.tsv" defer_file="$workdir/defer.tsv" unverif_file="$workdir/unverifiable.tsv"
  local provisional_file="$workdir/provisional.tsv"
  : > "$strike_file"; : > "$defer_file"; : > "$unverif_file"; : > "$provisional_file"
  grep -E '^STRIKE:' "$draft_file" 2>/dev/null | sed -E 's/^STRIKE:[[:space:]]*//' | \
    awk -F'\\|' '{gsub(/^[ \t]+|[ \t]+$/,"",$1); gsub(/^[ \t]+|[ \t]+$/,"",$2); print $1"\t"$2}' >> "$strike_file" || true
  grep -E '^DEFER:' "$draft_file" 2>/dev/null | sed -E 's/^DEFER:[[:space:]]*//' | \
    awk -F'\\|' '{gsub(/^[ \t]+|[ \t]+$/,"",$1); gsub(/^[ \t]+|[ \t]+$/,"",$2); print $1"\t"$2}' >> "$defer_file" || true
  grep -E '^UNVERIFIABLE:' "$draft_file" 2>/dev/null | sed -E 's/^UNVERIFIABLE:[[:space:]]*//' | \
    awk -F'\\|' '{gsub(/^[ \t]+|[ \t]+$/,"",$1); gsub(/^[ \t]+|[ \t]+$/,"",$2); gsub(/^[ \t]+|[ \t]+$/,"",$3); print $1"\t"$2"\t"$3}' >> "$unverif_file" || true
  # PROVISIONAL: BL-NNN | CQ-NNN | <reason> — the semantic half of Ask,
  # Don't Guess soft-blocking (Behaviour 5). Re-derived fresh every run,
  # like UNVERIFIABLE — never persisted from a prior refresh's own file, so
  # a question's answer under decisions.md clears it automatically the
  # next time the planner agent doesn't re-issue the directive.
  grep -E '^PROVISIONAL:' "$draft_file" 2>/dev/null | sed -E 's/^PROVISIONAL:[[:space:]]*//' | \
    awk -F'\\|' '{gsub(/^[ \t]+|[ \t]+$/,"",$1); gsub(/^[ \t]+|[ \t]+$/,"",$2); gsub(/^[ \t]+|[ \t]+$/,"",$3); print $1"\t"$2"\t"$3}' >> "$provisional_file" || true
  # SCREEN-BEARING: BL-NNN | SCR-NNN,... (or "none") | <reason> — the
  # semantic half of the UI fidelity wiring. Bash cannot tell on its own
  # whether an item renders a screen: when /specclaw:bf-ui has never run
  # there is no SCR-### token anywhere to join on, so the judgment has to
  # come from the planner agent reading functional-spec.md, and is then
  # applied mechanically here. Same tier as UNVERIFIABLE:/PROVISIONAL: —
  # re-derived fresh every run, never persisted from a prior refresh.
  # SCR-OUT-OF-SCOPE: SCR-NNN | <reason> — an explicit, reasoned exclusion
  # of a screen from the backlog, so the coverage check can distinguish
  # "deliberately not rebuilt" from "silently dropped".
  local screenbearing_file="$workdir/screenbearing.tsv" scrscope_file="$workdir/scr-out-of-scope.tsv"
  : > "$screenbearing_file"; : > "$scrscope_file"
  grep -E '^SCREEN-BEARING:' "$draft_file" 2>/dev/null | sed -E 's/^SCREEN-BEARING:[[:space:]]*//' | \
    awk -F'\\|' '{gsub(/^[ \t]+|[ \t]+$/,"",$1); gsub(/^[ \t]+|[ \t]+$/,"",$2); gsub(/^[ \t]+|[ \t]+$/,"",$3); print $1"\t"$2"\t"$3}' >> "$screenbearing_file" || true
  grep -E '^SCR-OUT-OF-SCOPE:' "$draft_file" 2>/dev/null | sed -E 's/^SCR-OUT-OF-SCOPE:[[:space:]]*//' | \
    awk -F'\\|' '{gsub(/^[ \t]+|[ \t]+$/,"",$1); gsub(/^[ \t]+|[ \t]+$/,"",$2); print $1"\t"$2}' >> "$scrscope_file" || true

  split_blocks "$draft_file" "$workdir/items" "BL"

  # ── Parse existing rebuild-backlog.md (if refresh): preserved static
  # bodies (Gate:/Verification:/Settled constraints:/Status notes: lines
  # stripped), the human-added Status-notes tail (verbatim), old Gate/
  # Verification (for the change report), and struck/deferred status. ──
  declare -A EXIST_TITLE EXIST_STATIC EXIST_TAIL EXIST_STATUS EXIST_OLD_GATE EXIST_OLD_VERIF
  # Quality-remediation items already in the document, recognised by their own
  # declared "**Item type:**" field and NEVER by their title or their position.
  # QR_ID_OF[MOD-###] is what makes ID permanence work across a refresh: a
  # module that already has an item reuses that id forever, and only a module
  # that has none is ever assigned a new number.
  declare -A QR_ID_OF QR_IS_REM QR_PRIOR_QIS QR_LEDGER QR_PRIOR_BODY
  QR_ID_OF[__init__]=1; unset 'QR_ID_OF[__init__]'
  QR_IS_REM[__init__]=1; unset 'QR_IS_REM[__init__]'
  QR_PRIOR_QIS[__init__]=1; unset 'QR_PRIOR_QIS[__init__]'
  QR_LEDGER[__init__]=1; unset 'QR_LEDGER[__init__]'
  QR_PRIOR_BODY[__init__]=1; unset 'QR_PRIOR_BODY[__init__]'
  local existing_ids=""
  if $is_refresh; then
    split_blocks "$backlog_file" "$workdir/existing" "BL"
    local f id
    for f in "$workdir/existing"/BL-*.md; do
      [ -f "$f" ] || continue
      id="$(block_id "$f")"
      existing_ids="${existing_ids} ${id}"
      EXIST_TITLE[$id]="$(block_title_after_dash "$f")"
      if [[ "${EXIST_TITLE[$id]}" == STRUCK* ]]; then
        EXIST_STATUS[$id]="struck"
      elif grep -qE '^\*\*Status:\*\* Deferred' "$f"; then
        EXIST_STATUS[$id]="deferred"
      else
        EXIST_STATUS[$id]="active"
      fi
      EXIST_OLD_GATE[$id]="$(block_single_field "$f" "Gate")"
      EXIST_OLD_VERIF[$id]="$(block_single_field "$f" "Verification")"
      # ── A quality-remediation item, recognised by its declared type ───────
      # Its body is bash-written in full and re-derived every run, so unlike
      # every other item nothing of it is preserved as static text — except two
      # things that ARE history and could not be recomputed: the dated ⊕/⊖
      # ledger of hotspots added or retired since it was created, and (for the
      # case where quality.json has since been removed) the whole prior body,
      # which is then kept verbatim rather than regenerated from nothing.
      if grep -qE '^\*\*Item type:\*\* QUALITY-REMEDIATION' "$f"; then
        QR_IS_REM[$id]=1
        local qr_mod
        qr_mod="$(printf '%s' "$(block_single_field "$f" "Module")" | { grep -oE 'MOD-[0-9]{3}' | head -1; } || true)"
        [ -n "$qr_mod" ] && QR_ID_OF[$qr_mod]="$id"
        QR_PRIOR_QIS[$id]="$(normalize_id_list "$(grep -E '^- QI-[0-9]+ —' "$f" 2>/dev/null || true)" 'QI-[0-9]+')"
        QR_LEDGER[$id]="$(grep -E '^[⊕⊖] \*\*' "$f" 2>/dev/null || true)"
        QR_PRIOR_BODY[$id]="$(tail -n +2 "$f" | awk '
          /^\*\*Gate:\*\*/ { skip=1; next }
          /^\*\*Verification:\*\*/ { skip=1; next }
          /^\*\*Quality state:\*\*/ { skip=1; next }
          /^\*\*Status notes \(human-added\):\*\*/ { intail=1; next }
          intail { next }
          skip && /^\*\*/ { skip=0 }
          skip { next }
          { print }
        ' | strip_trailing_separator)"
      fi
      # LEADING BLANK LINES ARE DROPPED (the `sed '/./,$!d'` below, the same
      # idiom the Sequencing/Coverage reads use), and that fixes a real,
      # unbounded drift rather than tidying whitespace.
      #
      # render writes an item as "heading, blank, body". `tail -n +2` therefore
      # hands this parse a body whose FIRST line is that blank, the next render
      # prepends its own, and the item grows one blank line under its heading on
      # every single --refresh, forever. Four refreshes, four blank lines. It is
      # invisible in review and it never stops.
      #
      # The blank between heading and body belongs to the RENDERER, so the body
      # must not carry a copy of it. The same strip is applied on the draft path
      # for the same reason, so a first render and every refresh after it agree.
      # Static head = every line except the heading itself, the two fields
      # bash recomputes from scratch every run (Gate:/Verification:), and
      # the Deferred status marker/Status-notes tail (handled separately
      # below). "Settled constraints" is deliberately NOT stripped here —
      # it is agent-authored content (which decisions apply, in what
      # words), not a bash-derivable fact, so once drafted it must persist
      # as ordinary static body content across every future refresh that
      # doesn't re-touch this item, exactly like Merge rationale does.
      # split_blocks captures every line up to (not including) the NEXT
      # "### BL-" heading — which, when this item has no Gate:/Verification:
      # lines yet to anchor on (e.g. its very first refresh), means the
      # trailing "---" separator that belongs BETWEEN items ends up as this
      # block's own last captured line. Strip it explicitly rather than
      # relying on the Gate:/Verification: anchor alone.
      # skip, once set by Gate:/Verification:/Status:Deferred, deliberately
      # stays set through everything that follows (blank lines, the "---"
      # separator split_blocks leaves attached to this block, bulleted
      # continuations) — it is only ever cleared by a NEW "**" field
      # (Settled constraints, the one thing allowed to follow Gate/
      # Verification and still be preserved). An earlier version reset
      # skip on the first blank line, which let the trailing "---" fall
      # through to the catch-all print rule.
      # The "⚠ " lines are the RECOMPUTED-EVERY-RUN markers rendered directly
      # under the heading (PROVISIONAL, STUB-BACKED, PARTIALLY BUILT). They
      # MUST be stripped here.
      #
      # This was a real, shipped defect. Without this rule a preserved item's
      # prior marker landed in its own static body and render then prepended a
      # freshly computed one on top — so the marker DOUBLED on every --refresh
      # and, once the underlying condition cleared (a stub retired, a CQ
      # answered), the stale copies stayed forever. Both documented claims —
      # "recomputed fresh from nothing every run, never persisted from a prior
      # refresh's own rendered marker" and "retiring a stub clears every marker
      # automatically" — were false in practice for exactly the items a refresh
      # does not re-draft.
      #
      # Anchored on "⚠ " at line start, which is what every marker renders as
      # and what nothing else in an item body legitimately starts with.
      EXIST_STATIC[$id]="$(tail -n +2 "$f" | awk '
        /^\*\*Gate:\*\*/ { skip=1; next }
        /^\*\*Verification:\*\*/ { skip=1; next }
        /^\*\*UI fidelity:\*\*/ { skip=1; next }
        /^\*\*Quality state:\*\*/ { skip=1; next }
        /^⚠ / { next }
        /^\*\*Status:\*\* Deferred/ { skip=1; next }
        /^\*\*Status notes \(human-added\):\*\*/ { intail=1; next }
        intail { next }
        /^\*\*Settled constraints/ { skip=0 }
        skip { next }
        { print }
      ' | sed '/./,$!d' | strip_trailing_separator)"
      EXIST_TAIL[$id]="$(awk '
        /^\*\*Status notes \(human-added\):\*\*/ { intail=1 }
        intail { print }
      ' "$f" | strip_trailing_separator)"
    done
  fi

  # ── Parse clarifications.md (fresh) ─────────────────────────────────────
  declare -A CQ_BLOCKING CQ_ANSWERED CQ_RULES CQ_ITEMS CQ_TITLE CQ_PQ_SOURCED
  local cq_ids=""
  if [ -f "$clar_file" ]; then
    split_blocks "$clar_file" "$workdir/cqs" "CQ"
    local f id blocking_txt answer_txt
    for f in "$workdir/cqs"/CQ-*.md; do
      [ -f "$f" ] || continue
      id="$(block_id "$f")"
      cq_ids="${cq_ids} ${id}"
      CQ_TITLE[$id]="$(block_title_after_dash "$f")"
      blocking_txt="$(block_single_field "$f" "Blocking")"
      case "$blocking_txt" in [Yy][Ee][Ss]*) CQ_BLOCKING[$id]=1 ;; *) CQ_BLOCKING[$id]=0 ;; esac
      answer_txt="$(awk '
        /^- \*\*Answer:\*\*/ { sub(/^- \*\*Answer:\*\* */, ""); capturing=1; buf=$0; next }
        /^- \*\*Decided by:\*\*/ { capturing=0 }
        capturing { buf = buf "\n" $0; next }
        END { print buf }
      ' "$f" | tr -d '[:space:]')"
      if [ -n "$answer_txt" ]; then CQ_ANSWERED[$id]=1; else CQ_ANSWERED[$id]=0; fi
      CQ_RULES[$id]="$(extract_dr_ids "$f" | paste -sd, - 2>/dev/null || true)"
      CQ_ITEMS[$id]="$(extract_bl_ids "$f" | paste -sd, - 2>/dev/null || true)"
      # Mechanical half of Ask, Don't Guess: a pending-question-originated
      # CQ is identifiable purely by this literal string in its own Source
      # field — see agents/bf-clarify-extractor.md's Mode: ingest.
      if grep -qF 'Promoted from PQ-' "$f" 2>/dev/null; then
        CQ_PQ_SOURCED[$id]=1
      else
        CQ_PQ_SOURCED[$id]=0
      fi
    done
  fi

  # ── Parse scenarios.md (fresh, if present) ──────────────────────────────
  declare -A GM_RULES GM_ITEM
  local gm_ids=""
  if [ -f "$scenarios_file" ]; then
    split_blocks "$scenarios_file" "$workdir/scenarios" "GM"
    local f id
    for f in "$workdir/scenarios"/GM-*.md; do
      [ -f "$f" ] || continue
      id="$(block_id "$f")"
      gm_ids="${gm_ids} ${id}"
      GM_RULES[$id]="$(extract_dr_ids "$f" | paste -sd, - 2>/dev/null || true)"
      GM_ITEM[$id]="$(extract_bl_ids "$f" | head -1)"
    done
  fi

  # ── Parse manifest.json (fresh, if present): which GM ids are captured ──
  declare -A FIXTURE_SHA
  local fixture_ids=""
  if [ -f "$manifest_file" ] && command -v jq &>/dev/null; then
    local sid sha
    while IFS=$'\t' read -r sid sha; do
      [ -z "$sid" ] && continue
      fixture_ids="${fixture_ids} ${sid}"
      FIXTURE_SHA[$sid]="$sha"
    done < <({ jq -r '.fixtures[] | [.scenario_id, .legacy_commit_sha] | @tsv' "$manifest_file" 2>/dev/null | tr -d '\r'; } || true)
  elif [ -f "$manifest_file" ]; then
    warn "jq not found — treating manifest.json as present but unreadable; Verification will fall back to scenarios.md's roster (PENDING CAPTURE, not VERIFIABLE)"
  fi

  # ── Parse module-map.md (fresh, like everything else render computes) ────
  declare -A MOD_NAME MOD_DEPS
  MOD_NAME[__init__]=1; unset 'MOD_NAME[__init__]'
  MOD_DEPS[__init__]=1; unset 'MOD_DEPS[__init__]'
  local mod_ids="" map_status
  map_status="$(read_module_map_status "$map_file")"
  mkdir -p "$workdir/mods"
  split_blocks "$map_file" "$workdir/mods" "MOD"
  for f in "$workdir/mods"/MOD-*.md; do
    [ -f "$f" ] || continue
    id="$(block_id "$f")"
    MOD_NAME[$id]="$(block_title_after_dash "$f")"
    # A WITHDRAWN module keeps its id claimed forever (nothing may reuse it)
    # but is never a grouping target, so it stays out of mod_ids.
    case "${MOD_NAME[$id]}" in
      WITHDRAWN*) ;;
      *) mod_ids="${mod_ids} ${id}" ;;
    esac
    MOD_DEPS[$id]="$(mod_depends_on_ids "$(block_single_field "$f" "Depends on")")"
  done
  if [ -n "$module_scope" ] && [[ " ${mod_ids} " != *" ${module_scope} "* ]]; then
    die "--module ${module_scope} names no active module in .specclaw/analysis/module-map.md."
  fi

  # ── Module dependency rank (fixed point, same shape as the BL rank below).
  # A cycle is REPORTED, not silently ordered: the iteration cap would
  # otherwise leave an arbitrary ranking behind and someone would migrate in
  # whatever order fell out of it. ────────────────────────────────────────
  declare -A MOD_RANK
  MOD_RANK[__init__]=1; unset 'MOD_RANK[__init__]'
  local m
  for m in $mod_ids; do MOD_RANK[$m]=0; done
  local mpass mchanged=1 mmaxpass=30
  for ((mpass=0; mpass<mmaxpass && mchanged; mpass++)); do
    mchanged=0
    for m in $mod_ids; do
      local mdep mmaxdep=-1
      IFS=',' read -ra _mdeps <<< "${MOD_DEPS[$m]:-}"
      for mdep in ${_mdeps[@]+"${_mdeps[@]}"}; do
        [ -z "$mdep" ] && continue
        [[ " ${mod_ids} " == *" ${mdep} "* ]] || continue
        local mdr="${MOD_RANK[$mdep]:-0}"
        [ "$mdr" -gt "$mmaxdep" ] && mmaxdep=$mdr
      done
      local mwant=0
      [ "$mmaxdep" -ge 0 ] && mwant=$((mmaxdep + 1))
      if [ "${MOD_RANK[$m]}" -ne "$mwant" ]; then MOD_RANK[$m]=$mwant; mchanged=1; fi
    done
  done
  local mod_cycle=""
  if [ "$mchanged" -eq 1 ]; then
    mod_cycle="module dependency ranking did not converge after ${mmaxpass} passes — module-map.md's 'Depends on' fields describe a cycle. Modules are still grouped and rendered, but their order below is not a valid dependency order until the cycle is broken."
    warn "$mod_cycle"
  fi

  # ── UI fidelity inputs (fresh every run, like everything else bash
  # computes here). All of this stays inert unless SQ-013 is decided
  # FAITHFUL or THEME-ONLY. ───────────────────────────────────────────────
  local ui_dir="$specclaw_dir_abs/ui"
  local ui_inventory="$ui_dir/ui-inventory.md"
  local ui_tokens_file="$ui_dir/design-tokens.json"
  local ui_manifest_file="$ui_dir/ui-manifest.json"
  local fidelity_policy
  fidelity_policy="$(read_fidelity_policy "$decisions_file")"
  local ui_grounding_required=false
  case "$fidelity_policy" in FAITHFUL|THEME-ONLY) ui_grounding_required=true ;; esac

  # Two different questions, deliberately kept apart.
  #
  # ui_grounding_required — does an item inherit a VISUAL FIDELITY obligation
  # from the legacy screen it renders? Only under FAITHFUL/THEME-ONLY. Under
  # REINTERPRET the legacy look is reference material and no item is held to
  # it; that is the whole content of that decision.
  #
  # screen_mapping_required — does the backlog record WHICH SCREENS an item
  # renders at all? That is a different fact, and REINTERPRET needs it more
  # than the other policies do, not less: the redesign has to map every new
  # screen to the legacy screen it replaces, and prototype readiness is
  # measured against exactly this set. Conflating the two left a REINTERPRET
  # backlog with no SCR citations anywhere, which made the prototype gate
  # vacuous — it would have found nothing to require approval for.
  local screen_mapping_required=false
  case "$fidelity_policy" in FAITHFUL|THEME-ONLY|REINTERPRET) screen_mapping_required=true ;; esac

  declare -A SCR_TITLE TK_FOR_SCR
  SCR_TITLE[__init__]=1; unset 'SCR_TITLE[__init__]'
  TK_FOR_SCR[__init__]=1; unset 'TK_FOR_SCR[__init__]'
  local scr_all="" sid stitle
  while IFS=$'\t' read -r sid stitle; do
    [ -z "$sid" ] && continue
    SCR_TITLE[$sid]="$stitle"
    scr_all="${scr_all} ${sid}"
  done < <(ui_scr_entries "$ui_inventory")

  # The group's human-readable name is not read here — only its id and scope
  # matter for the per-item join; the name is for a human reading
  # design-tokens.json itself.
  local tk_global="" tkid tkscope
  while IFS=$'\t' read -r tkid _ tkscope; do
    [ -z "$tkid" ] && continue
    case "${tkscope:-global}" in
      global|"") tk_global="${tk_global}${tk_global:+, }${tkid}" ;;
      *) TK_FOR_SCR[$tkscope]="${TK_FOR_SCR[$tkscope]:+${TK_FOR_SCR[$tkscope]}, }${tkid}" ;;
    esac
  done < <(ui_tk_entries "$ui_tokens_file")

  # Which artifacts the decided policy needs and this repo doesn't have.
  # Named individually — a warning that says "UI artifacts are missing"
  # without saying which is a warning nobody can act on.
  local ui_missing=""
  if $ui_grounding_required; then
    [ -f "$ui_inventory" ]     || ui_missing="${ui_missing}${ui_missing:+, }.specclaw/ui/ui-inventory.md"
    [ -f "$ui_tokens_file" ]   || ui_missing="${ui_missing}${ui_missing:+, }.specclaw/ui/design-tokens.json"
    [ -d "$ui_dir/screens" ]   || ui_missing="${ui_missing}${ui_missing:+, }.specclaw/ui/screens/"
    [ -f "$ui_manifest_file" ] || ui_missing="${ui_missing}${ui_missing:+, }.specclaw/ui/ui-manifest.json"
  fi

  # ── Screen-bearing / out-of-scope directives from the draft ─────────────
  declare -A SB_SCRS SB_REASON SCR_OOS
  SB_SCRS[__init__]=1; unset 'SB_SCRS[__init__]'
  SB_REASON[__init__]=1; unset 'SB_REASON[__init__]'
  SCR_OOS[__init__]=1; unset 'SCR_OOS[__init__]'
  local sb_id sb_scrs sb_reason
  while IFS=$'\t' read -r sb_id sb_scrs sb_reason; do
    [ -z "$sb_id" ] && continue
    SB_SCRS[$sb_id]="$sb_scrs"
    SB_REASON[$sb_id]="$sb_reason"
  done < "$screenbearing_file"
  while IFS=$'\t' read -r sid sb_reason; do
    [ -z "$sid" ] && continue
    SCR_OOS[$sid]="$sb_reason"
  done < "$scrscope_file"

  # ── Unverifiable overrides from the draft ───────────────────────────────
  declare -A UNVERIF_CQ UNVERIF_REASON
  while IFS=$'\t' read -r iid cqid reason; do
    [ -z "$iid" ] && continue
    UNVERIF_CQ[$iid]="$cqid"
    UNVERIF_REASON[$iid]="$reason"
  done < "$unverif_file"

  # ── Semantic PROVISIONAL overrides from the draft (Behaviour 5) — an
  # item can have more than one; accumulate CQ ids comma-joined. ─────────
  declare -A PROVISIONAL_SEMANTIC_CQS
  while IFS=$'\t' read -r iid cqid _reason; do
    [ -z "$iid" ] && continue
    PROVISIONAL_SEMANTIC_CQS[$iid]="${PROVISIONAL_SEMANTIC_CQS[$iid]:+${PROVISIONAL_SEMANTIC_CQS[$iid]},}${cqid}"
  done < "$provisional_file"

  # ── Struck / deferred sets (draft directives ∪ items already marked so
  # in the existing file, so a status set on a prior refresh persists even
  # when this run's draft doesn't re-mention it) ──────────────────────────
  # Bash 5.2 quirk (observed on this toolchain): "${#arr[@]}" on a
  # `declare -A` array that has never had a single element assigned throws
  # "unbound variable" under `set -u`, even though the array itself is
  # declared. Force it into the "has been assigned to" state up front so
  # ${#STRIKE_REASON[@]}/${#DEFER_REASON[@]} are safe later even when this
  # run strikes/defers nothing.
  declare -A STRIKE_REASON DEFER_REASON
  STRIKE_REASON[__init__]=1; unset 'STRIKE_REASON[__init__]'
  DEFER_REASON[__init__]=1; unset 'DEFER_REASON[__init__]'
  while IFS=$'\t' read -r iid reason; do
    [ -z "$iid" ] && continue
    STRIKE_REASON[$iid]="$reason"
  done < "$strike_file"
  while IFS=$'\t' read -r iid reason; do
    [ -z "$iid" ] && continue
    DEFER_REASON[$iid]="$reason"
  done < "$defer_file"
  local eid
  for eid in $existing_ids; do
    if [ "${EXIST_STATUS[$eid]:-active}" = "struck" ] && [ -z "${STRIKE_REASON[$eid]:-}" ]; then
      STRIKE_REASON[$eid]="${EXIST_TITLE[$eid]#STRUCK — }"
    fi
    if [ "${EXIST_STATUS[$eid]:-active}" = "deferred" ] && [ -z "${DEFER_REASON[$eid]:-}" ]; then
      DEFER_REASON[$eid]="carried forward from prior refresh"
    fi
  done

  # ── Build the final active item set: draft items ∪ preserved existing
  # items not struck/deferred/superseded, each with its final static body
  # and (for preserved/revised existing ids) its reattached human tail. ──
  declare -A FINAL_BODY FINAL_TAIL FINAL_TITLE
  local active_ids="" new_ids="" revised_ids=""
  local f id
  for f in "$workdir/items"/BL-*.md; do
    [ -f "$f" ] || continue
    id="$(block_id "$f")"
    [ -n "${STRIKE_REASON[$id]:-}" ] && continue
    [ -n "${DEFER_REASON[$id]:-}" ] && continue
    FINAL_TITLE[$id]="$(block_title_after_dash "$f")"
    FINAL_BODY[$id]="$(tail -n +2 "$f" | sed '/./,$!d' | strip_trailing_separator)"
    if [[ " ${existing_ids} " == *" ${id} "* ]]; then
      FINAL_TAIL[$id]="${EXIST_TAIL[$id]:-}"
      revised_ids="${revised_ids} ${id}"
    else
      FINAL_TAIL[$id]=""
      new_ids="${new_ids} ${id}"
    fi
    active_ids="${active_ids} ${id}"
  done
  for eid in $existing_ids; do
    [[ " ${active_ids} " == *" ${eid} "* ]] && continue
    [ -n "${STRIKE_REASON[$eid]:-}" ] && continue
    [ -n "${DEFER_REASON[$eid]:-}" ] && continue
    FINAL_TITLE[$eid]="${EXIST_TITLE[$eid]}"
    FINAL_BODY[$eid]="${EXIST_STATIC[$eid]}"
    FINAL_TAIL[$eid]="${EXIST_TAIL[$eid]:-}"
    active_ids="${active_ids} ${eid}"
  done

  # ── Per-item rules[] / depends_on[] / module extracted from the final body ─
  declare -A ITEM_RULES ITEM_DEPS ITEM_SCRS ITEM_MOD
  ITEM_SCRS[__init__]=1; unset 'ITEM_SCRS[__init__]'
  ITEM_MOD[__init__]=1; unset 'ITEM_MOD[__init__]'
  local unassigned_items="" unknown_mod_items=""
  for id in $active_ids; do
    printf '%s\n' "${FINAL_BODY[$id]}" > "$workdir/body.tmp"
    ITEM_RULES[$id]="$(extract_dr_ids "$workdir/body.tmp" | paste -sd, - 2>/dev/null || true)"
    ITEM_DEPS[$id]="$(depends_on_ids "$(block_single_field "$workdir/body.tmp" "Depends on")")"
    # The item's own declared module — read from its body, never derived from
    # its rules. Deriving one would be a silent assignment, and the map's DR
    # ownership disagreeing with an item's placement is exactly the
    # inconsistency /specclaw:bf-baseline record reports at record time.
    ITEM_MOD[$id]="$(printf '%s' "$(block_single_field "$workdir/body.tmp" "Module")" | { grep -oE 'MOD-[0-9]{3}' | head -1; } || true)"
    if [ -z "${ITEM_MOD[$id]}" ]; then
      unassigned_items="${unassigned_items}${unassigned_items:+, }${id}"
    elif [[ " ${mod_ids} " != *" ${ITEM_MOD[$id]} "* ]]; then
      unknown_mod_items="${unknown_mod_items}${unknown_mod_items:+, }${id} (declares ${ITEM_MOD[$id]})"
      ITEM_MOD[$id]=""
      unassigned_items="${unassigned_items}${unassigned_items:+, }${id}"
    fi
    # SCR citations the item's own acceptance basis carries, unioned with
    # this run's SCREEN-BEARING directive. The textual citation in the body
    # is the join key /specclaw:bf-ui --checklist keys against later, the
    # same way DR-NNN is the join key for Gate/Verification — so a citation
    # that exists only in a directive is not enough on its own to ground an
    # item, and the coverage check below reports that gap.
    ITEM_SCRS[$id]="$(extract_scr_ids "$workdir/body.tmp" | paste -sd, - 2>/dev/null || true)"
    local dscr
    for dscr in $(printf '%s' "${SB_SCRS[$id]:-}" | tr ',' ' '); do
      case "$dscr" in SCR-[0-9][0-9][0-9]) ;; *) continue ;; esac
      [[ ",${ITEM_SCRS[$id]}," == *",${dscr},"* ]] || \
        ITEM_SCRS[$id]="${ITEM_SCRS[$id]:+${ITEM_SCRS[$id]},}${dscr}"
    done
  done
  rm -f "$workdir/body.tmp"

  # ── Quality remediation items ────────────────────────────────────────────
  #
  # THE GAP THIS CLOSES. Until now a measured hotspot changed exactly one thing
  # about the rebuild: a suffix on a coverage-rollup line telling a reader which
  # legacy module is in the worst shape. Nothing in the backlog made the
  # REBUILT module's health an acceptance condition, so a faithful reproduction
  # of a 1400-line function passed every check this document can compute.
  #
  # ONE ITEM PER MODULE, NEVER ONE PER HOTSPOT. A large legacy tree registers
  # hundreds of QI-###; an item each would bury the functional backlog under
  # them. The module is already the migration and acceptance unit here
  # (MOD-### -> BL-0## -> DR-### -> GM-###), and it is also the finest grain the
  # target-side measurement can actually be taken at.
  #
  # ACCEPTANCE IS MEASURED, NEVER LITERAL. The item never asks anyone to edit a
  # named legacy file — that file is not part of the target and will not exist
  # there. The QI ids are the evidence for WHY the item exists; the proof that
  # it is done is quality-delta.json.
  #
  # INERT WITHOUT quality.json. No file, no jq, unreadable JSON, or no hotspot
  # at or above the floor and nothing below produces anything, and the rendered
  # document is byte-identical to one rendered before this existed.
  local qr_json="$analysis_dir/quality.json"
  local qr_delta="$analysis_dir/quality-delta.json"
  local qr_floor qr_today qr_delta_stamp
  qr_floor="$(read_remediation_floor "$specclaw_dir_abs/config.yaml")"
  qr_today="$(date +%Y-%m-%d)"
  qr_delta_stamp="$(quality_delta_stamp "$qr_delta")"

  declare -A QR_MOD QR_METRICS
  QR_MOD[__init__]=1; unset 'QR_MOD[__init__]'
  QR_METRICS[__init__]=1; unset 'QR_METRICS[__init__]'

  # Qualifying hotspots, grouped per module: the rendered bullet lines, the id
  # list (for the ledger diff), and the distinct metrics (for the delta join).
  declare -A QR_LINES_OF QR_QIS_OF QR_METRICS_OF
  QR_LINES_OF[__init__]=1; unset 'QR_LINES_OF[__init__]'
  QR_QIS_OF[__init__]=1; unset 'QR_QIS_OF[__init__]'
  QR_METRICS_OF[__init__]=1; unset 'QR_METRICS_OF[__init__]'
  local qr_qualifying_mods="" qr_offmap_qis=""
  local qmod qqi qmetric qfile qfunc qvalue qsev qwhere
  while IFS=$'\x1f' read -r qmod qqi qmetric qfile qfunc qvalue qsev; do
    [ -n "$qqi" ] || continue
    # A hotspot in a module module-map.md does not define cannot become an item:
    # it would have no module to be grouped under, no functional items to wait
    # on, and no target-side rollup to be measured against. Reported, never
    # folded into a real module by guesswork — the same rule an item with an
    # unknown **Module:** field gets.
    if [[ " ${mod_ids} " != *" ${qmod} "* ]]; then
      qr_offmap_qis="${qr_offmap_qis}${qr_offmap_qis:+, }${qqi} (${qmod})"
      continue
    fi
    case " ${qr_qualifying_mods} " in
      *" ${qmod} "*) ;;
      *) qr_qualifying_mods="${qr_qualifying_mods} ${qmod}" ;;
    esac
    qwhere="$qfile"
    [ -n "$qfunc" ] && qwhere="${qwhere:+${qwhere}::}${qfunc}"
    [ -n "$qwhere" ] || qwhere="module-wide"
    QR_LINES_OF[$qmod]="${QR_LINES_OF[$qmod]:-}- ${qqi} — ${qmetric}, ${qwhere}, measured ${qvalue:-n/a}, ${qsev}
"
    QR_QIS_OF[$qmod]="${QR_QIS_OF[$qmod]:+${QR_QIS_OF[$qmod]},}${qqi}"
    # ── the metric this hotspot will be MEASURED on, which is not always the
    # metric it is REPORTED as ────────────────────────────────────────────────
    #
    # QR_METRICS_OF feeds one thing only: the join against quality-delta.json,
    # which is keyed "<module>|<dimension>" over the four dimensions the delta
    # actually carries. A metric with no dimension there can never match a row,
    # and the completion check reads a missing row as "no entry in the delta" —
    # so the item would report OPEN forever, however good the rebuild is. A
    # permanently unsatisfiable acceptance criterion is worse than none.
    #
    # `duplication-clone` is such a metric. It is a real, separately-registered
    # hotspot — a specific pair of duplicated blocks — but the delta measures
    # duplication per module, as a percentage, and that percentage IS the proof
    # that the clone was not carried into the rebuild. So it is folded to
    # `duplication` HERE, for the join only. Everywhere the hotspot is reported
    # — the item body, the registry, the report — it keeps its own name.
    local qdim="$qmetric"
    [ "$qdim" = "duplication-clone" ] && qdim="duplication"
    case ",${QR_METRICS_OF[$qmod]:-}," in
      *",${qdim},"*) ;;
      *) QR_METRICS_OF[$qmod]="${QR_METRICS_OF[$qmod]:+${QR_METRICS_OF[$qmod]},}${qdim}" ;;
    esac
  done < <(quality_qualifying_qis "$qr_json" "$qr_floor")
  [ -z "$qr_offmap_qis" ] || warn "these open quality hotspots name a module module-map.md does not define and generate no remediation item: ${qr_offmap_qis}"

  # Hotspots the scan STOPPED MEASURING, per module. Read into a flat lookup so
  # the ledger below can tell a hotspot that was fixed from one whose file left
  # the scan scope. Both leave the item's basis list; only one of them is an
  # improvement, and the item must not imply the wrong one.
  declare -A QR_SCOPED_SET
  QR_SCOPED_SET[__init__]=1; unset 'QR_SCOPED_SET[__init__]'
  local qr_scope_hash qsmod qsqi
  qr_scope_hash="$(quality_scope_hash "$qr_json")"
  while IFS=$'\x1f' read -r qsmod qsqi; do
    [ -n "$qsqi" ] || continue
    QR_SCOPED_SET[$qsqi]="$qsmod"
  done < <(quality_excluded_by_scope_qis "$qr_json")

  # Next free BL number. Read from the rendered document AND this run's draft,
  # so a struck tombstone, a deferred item and a brand-new draft item all hold
  # their numbers — ids are permanent and are never reused (CONTRACT.md (c)).
  local qr_next=1 qr_seen
  while IFS= read -r qr_seen; do
    [ -n "$qr_seen" ] || continue
    qr_seen=$((10#$qr_seen))
    [ "$qr_seen" -ge "$qr_next" ] && qr_next=$((qr_seen + 1))
  done < <({ grep -hoE '^### BL-[0-9]{3}' "$backlog_file" "$draft_file" 2>/dev/null | grep -oE '[0-9]{3}'; } || true)

  # Every module that gets an item this run: one with a qualifying hotspot,
  # unioned with every module that ALREADY has one. The union is what makes the
  # id permanent — a module whose hotspots were all resolved keeps its item and
  # its number rather than having them silently disappear.
  local qr_target_mods="" qm
  for qm in $qr_qualifying_mods; do
    qr_target_mods="${qr_target_mods} ${qm}"
  done
  for qm in ${QR_ID_OF[@]+"${!QR_ID_OF[@]}"}; do
    case " ${qr_target_mods} " in
      *" ${qm} "*) ;;
      *) qr_target_mods="${qr_target_mods} ${qm}" ;;
    esac
  done

  local qr_id qr_is_new qr_deps qr_fid qr_ledger qr_basis
  for qm in $(printf '%s' "$qr_target_mods" | tr ' ' '\n' | sort -u); do
    [ -n "$qm" ] || continue
    qr_id="${QR_ID_OF[$qm]:-}"
    qr_is_new=false
    if [ -z "$qr_id" ]; then
      qr_id="$(printf 'BL-%03d' "$qr_next")"
      qr_next=$((qr_next + 1))
      qr_is_new=true
    fi

    # A --module run re-plans one module and leaves every other module's items
    # untouched — including this one's body. Nothing is minted for an
    # out-of-scope module either: a new id assigned by a run that was told not
    # to plan that module would be an item nobody asked for.
    if [ -n "$module_scope" ] && [ "$qm" != "$module_scope" ]; then
      if $qr_is_new; then
        qr_next=$((qr_next - 1))
      else
        QR_MOD[$qr_id]="$qm"
        QR_METRICS[$qr_id]="${QR_METRICS_OF[$qm]:-}"
      fi
      continue
    fi

    QR_MOD[$qr_id]="$qm"
    QR_METRICS[$qr_id]="${QR_METRICS_OF[$qm]:-}"

    # quality.json is gone (or unreadable) but the item exists: keep the body
    # that was written when it COULD be measured, verbatim. Regenerating an
    # empty hotspot list from a file that is not there would erase the record of
    # what was found, which is the one thing a permanent id exists to hold.
    if [ ! -f "$qr_json" ] && [ -n "${QR_PRIOR_BODY[$qr_id]:-}" ]; then
      FINAL_TITLE[$qr_id]="${EXIST_TITLE[$qr_id]:-${qm} quality remediation}"
      FINAL_BODY[$qr_id]="${QR_PRIOR_BODY[$qr_id]}"
      ITEM_MOD[$qr_id]="$qm"
      ITEM_RULES[$qr_id]=""
      ITEM_SCRS[$qr_id]=""
      continue
    fi

    # ── The functional items this module's health will be measured on ───────
    # Every active item declaring this module that is not itself a remediation
    # item. They become the "Depends on" list (so the item sorts last within its
    # own module) and the gating set below.
    qr_deps=""
    for qr_fid in $(printf '%s' "$active_ids" | tr ' ' '\n' | sort -u); do
      [ "${ITEM_MOD[$qr_fid]:-}" = "$qm" ] || continue
      [ -n "${QR_IS_REM[$qr_fid]:-}" ] && continue
      qr_deps="${qr_deps}${qr_deps:+, }${qr_fid}"
    done

    # ── The dated ledger ────────────────────────────────────────────────────
    # A re-measured quality.json that turns up a new qualifying hotspot APPENDS
    # it to this module's existing item — it never creates a second item and it
    # never renumbers anything. The append is recorded here, dated, because the
    # hotspot list itself is regenerated from scratch every run and so cannot
    # carry its own history. A hotspot that stops qualifying is recorded the
    # same way rather than silently vanishing.
    #
    # An unchanged quality.json produces neither kind of line, which is what
    # makes a second --refresh a no-op for this item.
    qr_ledger="${QR_LEDGER[$qr_id]:-}"
    if ! $qr_is_new && [ -n "${QR_PRIOR_QIS[$qr_id]:-}" ]; then
      local qr_added="" qr_gone="" qr_scoped="" qr_tok
      for qr_tok in $(printf '%s' "${QR_QIS_OF[$qm]:-}" | tr ',' ' '); do
        [ -n "$qr_tok" ] || continue
        case ",${QR_PRIOR_QIS[$qr_id]}," in
          *",${qr_tok},"*) ;;
          *) qr_added="${qr_added}${qr_added:+, }${qr_tok}" ;;
        esac
      done
      # A hotspot that left the basis list left it for one of two reasons, and
      # they are recorded separately because they mean opposite things. It
      # stopped exceeding its threshold (someone did something), or its file
      # stopped being measured (nobody did anything and the scan moved). Folding
      # the second into the "Retired" line would credit the rebuild with an
      # improvement that consists entirely of not looking.
      for qr_tok in $(printf '%s' "${QR_PRIOR_QIS[$qr_id]}" | tr ',' ' '); do
        [ -n "$qr_tok" ] || continue
        case ",${QR_QIS_OF[$qm]:-}," in
          *",${qr_tok},"*) continue ;;
        esac
        if [ -n "${QR_SCOPED_SET[$qr_tok]:-}" ]; then
          qr_scoped="${qr_scoped}${qr_scoped:+, }${qr_tok}"
        else
          qr_gone="${qr_gone}${qr_gone:+, }${qr_tok}"
        fi
      done
      if [ -n "$qr_added" ]; then
        qr_ledger="${qr_ledger}${qr_ledger:+
}⊕ **Added ${qr_today}:** ${qr_added} — measured after this item was created, and appended to it rather than given an item of their own."
      fi
      if [ -n "$qr_gone" ]; then
        qr_ledger="${qr_ledger}${qr_ledger:+
}⊖ **Retired ${qr_today}:** ${qr_gone} — no longer open at or above the ${qr_floor} floor in quality.json. Recorded permanently; the id is never reused."
      fi
      if [ -n "$qr_scoped" ]; then
        qr_ledger="${qr_ledger}${qr_ledger:+
}⊘ **Scope change ${qr_today}:** ${qr_scoped} — no longer MEASURED: the file each names is outside the configured scan scope${qr_scope_hash:+ (exclusion config ${qr_scope_hash})}. Nothing was fixed and nothing was deleted — the hotspot left this item because the scan stopped looking at it, the \`QI-###\` keeps its id and its first-seen date, and this item keeps its number."
      fi
    fi

    qr_basis="${QR_LINES_OF[$qm]:-}"
    if [ -n "$qr_basis" ]; then
      qr_basis="$(printf '%s' "$qr_basis" | strip_trailing_separator)"
    else
      qr_basis="- _None open at or above the ${qr_floor} floor in this snapshot. The item keeps its id and its acceptance criterion regardless: a module that measures clean in the legacy tree can still be rebuilt into one that does not._"
    fi

    FINAL_TITLE[$qr_id]="${qm} quality remediation"
    FINAL_BODY[$qr_id]="**Module:** ${qm}
**Item type:** QUALITY-REMEDIATION — generated from measured hotspots in \`.specclaw/analysis/quality.json\`, not from a functional capability. Bash writes this item in full on every run; only the dated ledger below and any human status note survive a \`--refresh\`.
**Maps to capability:** none — this item carries no capability bullet and is counted in no coverage line. It exists so that the rebuilt module's measured health is an acceptance condition rather than a hope.
**Depends on:** ${qr_deps:-None}
**Acceptance basis (.specclaw/analysis/quality.json, classified against \`config.yaml\`'s \`quality:\` thresholds at a \`remediation_severity_floor\` of ${qr_floor}):**
${qr_basis}${qr_ledger:+

${qr_ledger}}

**Acceptance criterion — MEASURED, never literal:** the REBUILT ${qm} measures within the configured thresholds on every dimension listed above and regresses on none, as evidenced by \`.specclaw/analysis/quality-delta.json\`. The \`QI-###\` ids above are the evidence for WHY this item exists; the delta is the proof that it is done. Nothing here asks anyone to change the legacy implementation: that implementation is not part of the target, and the files named above will not exist there.

**Grain of the proof:** a listed hotspot counts as retired when the delta's entry for its module and its metric measures below the ${qr_floor} floor and is not classified \`regressed\`. Module × metric is the finest grain the delta can carry — a hotspot's identity names a legacy file and function, and neither exists in the rebuilt tree to be measured a second time.

**Verification inputs needed:**
- A measured target snapshot and a comparison: \`/specclaw:bf-quality --target <path to the rebuilt tree>\`, then \`/specclaw:bf-quality --compare\`. Nothing else — this item needs no golden-master capture and no stakeholder decision."
    ITEM_MOD[$qr_id]="$qm"
    ITEM_RULES[$qr_id]=""
    ITEM_SCRS[$qr_id]=""
    ITEM_DEPS[$qr_id]="$(printf '%s' "$qr_deps" | tr -d ' ')"
    QR_IS_REM[$qr_id]=1
    if $qr_is_new; then
      FINAL_TAIL[$qr_id]=""
      active_ids="${active_ids} ${qr_id}"
      new_ids="${new_ids} ${qr_id}"
      warn "generated ${qr_id} — ${qm} quality remediation (${QR_QIS_OF[$qm]:-no qualifying hotspot}). Its id is permanent and is never renumbered."
    fi
  done

  # ── Dependency rank via fixed-point iteration (small, shallow DAG) ──────
  declare -A RANK
  for id in $active_ids; do RANK[$id]=0; done
  local pass changed=1 maxpass=30
  for ((pass=0; pass<maxpass && changed; pass++)); do
    changed=0
    for id in $active_ids; do
      local dep maxdep=-1
      IFS=',' read -ra _deps <<< "${ITEM_DEPS[$id]}"
      for dep in "${_deps[@]}"; do
        [ -z "$dep" ] && continue
        [[ " ${active_ids} " == *" ${dep} "* ]] || continue
        local dr="${RANK[$dep]:-0}"
        [ "$dr" -gt "$maxdep" ] && maxdep=$dr
      done
      local want=0
      [ "$maxdep" -ge 0 ] && want=$((maxdep + 1))
      if [ "${RANK[$id]}" -ne "$want" ]; then RANK[$id]=$want; changed=1; fi
    done
  done

  # ── Gate + Verification per active item ─────────────────────────────────
  declare -A GATE VERIF GATE_RANK VERIF_RANK PROVISIONAL UI_FIDELITY STUB_BACKED PARTIAL_BUILT

  # ── Item splits (CONTRACT.md (o)) — read fresh, never persisted ──────────
  #
  # Same tier as PROVISIONAL and STUB-BACKED: the per-item marker is recomputed
  # from nothing every run, so a split reaching COMPLETE clears it with no
  # cleanup and no directive.
  #
  # This block also performs the ONE registry write any rendering command makes:
  # ACTIVE -> READY-TO-RESUME, when every id in an entry's `Blocked until`
  # carries a declared BUILT: note. That transition is a pure function of
  # declared data — the same trust model, and the same narrow BUILT: trigger, as
  # stub retirement — so bash owns it. Leaving it to a manual flip would make a
  # stale ACTIVE indistinguishable from "nobody got round to it", and a resume
  # cannot afford that ambiguity. Only the Status line is rewritten, one
  # direction only, never back, and no other field is touched.
  declare -A SPLIT_STATUS SPLIT_ITEM SPLIT_DEFERRED SPLIT_BLOCKED SPLIT_RULES_DEF
  declare -A SPLIT_UNBUILT SPLIT_LAYERS_DEF SPLIT_CHANGE SPLIT_EVIDENCE
  local is_ids="" splits_file_r
  splits_file_r="$(splits_file_path "$specclaw_dir_abs")"
  if [ -f "$splits_file_r" ]; then
    mkdir -p "$workdir/splits"
    split_blocks "$splits_file_r" "$workdir/splits" "IS"
    local sfr sidr sitem_r sstat_r sblocked_r sunbuilt_r bb
    for sfr in "$workdir/splits"/IS-*.md; do
      [ -f "$sfr" ] || continue
      sidr="$(block_id "$sfr")"
      sstat_r="$(split_status_of "$(block_single_field "$sfr" "Status")")"
      sitem_r="$(printf '%s' "$(block_single_field "$sfr" "Item")" | { grep -oE 'BL-[0-9]{3}' | head -1; } || true)"
      sblocked_r="$(normalize_id_list "$(block_single_field "$sfr" "Blocked until")" 'BL-[0-9]{3}')"

      # Which blocked-until items still lack a declared BUILT: note. Read from
      # the PRIOR backlog's own blocks (workdir/existing), which is where a
      # human's Status notes live; on a first-ever run there are none, so a
      # split cannot be ready — correct, since there was no item to build.
      sunbuilt_r=""
      for bb in ${sblocked_r//,/ }; do
        [ -z "$bb" ] && continue
        if [ -f "$workdir/existing/${bb}.md" ] && built_signal_of "$workdir/existing/${bb}.md" >/dev/null 2>&1; then
          continue
        fi
        sunbuilt_r="${sunbuilt_r}${sunbuilt_r:+, }${bb}"
      done

      # THE ONE WRITE. Never the reverse direction: a split that became ready
      # does not become unready because someone edited a status note, and
      # silently walking it back would strand a resume already in flight.
      if [ "$sstat_r" = "ACTIVE" ] && [ -z "$sunbuilt_r" ] && [ -n "$sblocked_r" ]; then
        md_set_field "$splits_file_r" "$sidr" "Status" "READY-TO-RESUME $(date +%Y-%m-%d)"
        sstat_r="READY-TO-RESUME"
        warn "${sidr} flipped ACTIVE -> READY-TO-RESUME: every blocked-until item (${sblocked_r//,/, }) now carries a declared BUILT: note. ${sitem_r}'s deferred scope can be proposed."
      fi

      is_ids="${is_ids} ${sidr}"
      SPLIT_STATUS[$sidr]="$sstat_r"
      SPLIT_ITEM[$sidr]="$sitem_r"
      SPLIT_DEFERRED[$sidr]="$(block_single_field "$sfr" "Deferred")"
      SPLIT_BLOCKED[$sidr]="$sblocked_r"
      SPLIT_UNBUILT[$sidr]="$sunbuilt_r"
      SPLIT_RULES_DEF[$sidr]="$(block_single_field "$sfr" "Rules deferred")"
      SPLIT_LAYERS_DEF[$sidr]="$(block_single_field "$sfr" "Layers deferred")"
      SPLIT_CHANGE[$sidr]="$(block_single_field "$sfr" "Change")"
      SPLIT_EVIDENCE[$sidr]="$(block_single_field "$sfr" "Evidence")"
    done
  fi

  # ── Stub registry (CONTRACT.md (m)) — read fresh, never persisted ────────
  # Same tier as PROVISIONAL: a marker recomputed from nothing on every run,
  # so retiring a stub clears every consuming item's marker automatically with
  # no manual cleanup and no directive needed to REMOVE one.
  #
  # Absent registry = no stubs, silently. Most projects never bypass anything.
  declare -A STUB_SUBSTITUTES STUB_STATUS_MAP STUB_STRATEGY_MAP STUB_CONSUMERS
  local st_ids="" stubs_file_r
  stubs_file_r="$(stubs_file_path "$specclaw_dir_abs")"
  if [ -f "$stubs_file_r" ]; then
    mkdir -p "$workdir/stubs"
    split_blocks "$stubs_file_r" "$workdir/stubs" "ST"
    local sf sidr
    for sf in "$workdir/stubs"/ST-*.md; do
      [ -f "$sf" ] || continue
      sidr="$(block_id "$sf")"
      st_ids="${st_ids} ${sidr}"
      STUB_STATUS_MAP[$sidr]="$(stub_status_of "$(block_single_field "$sf" "Status")")"
      STUB_SUBSTITUTES[$sidr]="$(block_single_field "$sf" "Substitutes")"
      STUB_STRATEGY_MAP[$sidr]="$(block_single_field "$sf" "Strategy")"
      STUB_CONSUMERS[$sidr]="$(block_single_field "$sf" "Consumed by")"
    done
  fi
  UI_FIDELITY[__init__]=1; unset 'UI_FIDELITY[__init__]'

  # ── quality-delta.json, read once into two lookups keyed "<mod>|<metric>" ──
  # Absent file, absent jq or unreadable JSON leaves both empty, and every
  # remediation item then reports honestly that nothing has been measured yet
  # rather than defaulting to a verdict either way.
  declare -A QD_TARGET QD_CLASS QD_HAS_MOD QD_REGRESSED
  QD_TARGET[__init__]=1; unset 'QD_TARGET[__init__]'
  QD_CLASS[__init__]=1; unset 'QD_CLASS[__init__]'
  QD_HAS_MOD[__init__]=1; unset 'QD_HAS_MOD[__init__]'
  QD_REGRESSED[__init__]=1; unset 'QD_REGRESSED[__init__]'
  local dmod dmetric dtarget dclass
  while IFS=$'\x1f' read -r dmod dmetric dtarget dclass; do
    if [ -z "$dmod" ] || [ -z "$dmetric" ]; then continue; fi
    QD_TARGET["${dmod}|${dmetric}"]="$dtarget"
    QD_CLASS["${dmod}|${dmetric}"]="$dclass"
    QD_HAS_MOD[$dmod]=1
    if [ "$dclass" = "regressed" ]; then
      QD_REGRESSED[$dmod]="${QD_REGRESSED[$dmod]:-}${QD_REGRESSED[$dmod]:+, }${dmetric} (${dtarget})"
    fi
  done < <(quality_delta_rows "$qr_delta")

  declare -A QUALITY_STATE
  QUALITY_STATE[__init__]=1; unset 'QUALITY_STATE[__init__]'
  local qr_floor_rank; qr_floor_rank="$(qr_severity_rank "$qr_floor")"

  for id in $active_ids; do
    # ── Quality remediation items take every state on this loop from measured
    # data, and take it FIRST. They cite no DR-### rule, map to no GM-### and
    # render no screen, so every join below would run over an empty rule set and
    # arrive at a misleading answer — most damagingly "NO BASELINE DATA", which
    # reads as "somebody forgot to record a fixture" when the truth is that this
    # kind of item is not verified by fixture comparison at all. ──────────────
    if [ -n "${QR_IS_REM[$id]:-}" ]; then
      local qrm="${QR_MOD[$id]:-${ITEM_MOD[$id]:-}}"

      # GATE. Mechanically BLOCKED until every functional item in the module
      # carries a declared BUILT: note in its own Status-notes block — the same
      # narrow, declared trigger stub retirement and item splits use, and for
      # the same reason: specclaw records no built state of its own, and reading
      # "done last week" out of free text would be a guess. You cannot measure
      # the health of code that does not exist yet.
      local qr_unbuilt="" qr_funcs=0 qr_dep
      for qr_dep in $(printf '%s' "${ITEM_DEPS[$id]:-}" | tr ',' ' '); do
        [ -n "$qr_dep" ] || continue
        [[ " ${active_ids} " == *" ${qr_dep} "* ]] || continue
        qr_funcs=$((qr_funcs + 1))
        printf '%s\n' "${FINAL_TAIL[$qr_dep]:-}" > "$workdir/qr-tail.tmp"
        built_signal_of "$workdir/qr-tail.tmp" >/dev/null 2>&1 && continue
        qr_unbuilt="${qr_unbuilt}${qr_unbuilt:+, }${qr_dep}"
      done
      rm -f "$workdir/qr-tail.tmp"
      if [ "$qr_funcs" -eq 0 ]; then
        GATE[$id]="BLOCKED — quality: awaiting functional items (none is planned for ${qrm} yet, so there is no rebuilt module to measure)"
        GATE_RANK[$id]=3
      elif [ -n "$qr_unbuilt" ]; then
        GATE[$id]="BLOCKED — quality: awaiting functional items — no declared \`BUILT:\` note yet on ${qr_unbuilt}"
        GATE_RANK[$id]=3
      else
        GATE[$id]="CLEAR"
        GATE_RANK[$id]=0
      fi

      # VERIFICATION. Its own channel, deliberately not one of the four fixture
      # states: those all answer "is there a recorded legacy output to compare
      # against?", and for this item the honest answer is that the question does
      # not apply. `/specclaw:bf-replay --item` refuses it by name.
      VERIF[$id]="QUALITY-MEASURED — cites no DR-### rule and maps to no GM-### fixture. Acceptance is a measurement, not a recorded output: \`/specclaw:bf-quality --target <rebuilt tree>\` then \`/specclaw:bf-quality --compare\`. \`/specclaw:bf-replay --item ${id}\` refuses this item by design."
      VERIF_RANK[$id]=1

      # COMPLETION, computed from the delta and never asserted. Bash decides;
      # the agent narrates what it decided.
      if [ "${GATE_RANK[$id]}" -eq 3 ]; then
        QUALITY_STATE[$id]="BLOCKED — nothing to measure yet; ${qrm}'s functional items come first."
      elif [ ! -f "$qr_delta" ]; then
        QUALITY_STATE[$id]="OPEN — no \`.specclaw/analysis/quality-delta.json\` exists, so the rebuilt ${qrm} has not been measured. Run \`/specclaw:bf-quality --target <rebuilt tree>\`, then \`/specclaw:bf-quality --compare\`."
      elif [ -z "${QD_HAS_MOD[$qrm]:-}" ]; then
        QUALITY_STATE[$id]="OPEN — \`quality-delta.json\` carries no entry for ${qrm}, so nothing about the rebuilt module has been compared. Re-measure the target with \`/specclaw:bf-quality --target\`."
      else
        local qr_check="${QR_METRICS[$id]:-}" qr_failing="" qr_dim qr_ts qr_cls
        # No qualifying hotspot left to retire reduces the criterion to the
        # other half of it — within thresholds on every dimension, no
        # regression — which is checked across all four rather than none.
        if [ -n "$qr_check" ]; then
          qr_check="${qr_check//,/ }"
        else
          qr_check="$QR_DIMENSIONS"
        fi
        for qr_dim in $qr_check; do
          qr_ts="${QD_TARGET["${qrm}|${qr_dim}"]:-}"
          qr_cls="${QD_CLASS["${qrm}|${qr_dim}"]:-}"
          if [ -z "$qr_cls" ]; then
            qr_failing="${qr_failing}${qr_failing:+; }${qr_dim} (no entry in the delta)"
          elif [ "$qr_cls" = "regressed" ]; then
            qr_failing="${qr_failing}${qr_failing:+; }${qr_dim} regressed to ${qr_ts}"
          elif [ "$qr_cls" = "NOT-COMPARABLE" ]; then
            qr_failing="${qr_failing}${qr_failing:+; }${qr_dim} NOT-COMPARABLE (measured on only one side — an unmeasured dimension is never counted as retired)"
          elif [ "$(qr_severity_rank "$qr_ts")" -ge "$qr_floor_rank" ]; then
            qr_failing="${qr_failing}${qr_failing:+; }${qr_dim} still ${qr_ts} on the target, at or above the ${qr_floor} floor"
          fi
        done
        if [ -n "${QD_REGRESSED[$qrm]:-}" ]; then
          case "$qr_failing" in
            *regressed*) ;;
            *) qr_failing="${qr_failing}${qr_failing:+; }${qrm} regressed on ${QD_REGRESSED[$qrm]}" ;;
          esac
        fi
        if [ -n "$qr_failing" ]; then
          QUALITY_STATE[$id]="OPEN — ${qr_failing}. Per \`quality-delta.json\`${qr_delta_stamp:+ (${qr_delta_stamp})}."
        else
          QUALITY_STATE[$id]="DONE — every listed hotspot's dimension measures below the ${qr_floor} floor on the rebuilt ${qrm} and no dimension regressed, per \`quality-delta.json\`${qr_delta_stamp:+ (${qr_delta_stamp})}."
        fi
      fi
      continue
    fi

    local blocked_by="" open_qs="" cid
    for cid in $cq_ids; do
      cq_touches_item "${CQ_RULES[$cid]}" "${CQ_ITEMS[$cid]}" "$id" "${ITEM_RULES[$id]}" || continue
      [ "${CQ_ANSWERED[$cid]}" -eq 1 ] && continue
      if [ "${CQ_BLOCKING[$cid]}" -eq 1 ]; then
        blocked_by="${blocked_by}${blocked_by:+, }${cid} (${CQ_TITLE[$cid]})"
      else
        open_qs="${open_qs}${open_qs:+, }${cid}"
      fi
    done

    # ── UI fidelity per item. Three inputs, all mechanical: the decided
    # policy, whether this item renders a screen (its own SCR citations, or
    # this run's SCREEN-BEARING directive), and whether the bf-ui artifacts
    # the policy needs actually exist. A REINTERPRET or undecided policy on
    # an item that renders nothing produces no line and no gate effect at
    # all — the zero-extra-work path. ─────────────────────────────────────
    local ui_open="" item_scrs="${ITEM_SCRS[$id]:-}" screen_bearing=false
    { [ -n "$item_scrs" ] || [ -n "${SB_REASON[$id]:-}" ]; } && screen_bearing=true
    if $screen_bearing; then
      if $ui_grounding_required; then
        if [ -n "$ui_missing" ]; then
          UI_FIDELITY[$id]="⚠ UI GROUNDING MISSING — ${fidelity_policy} decided (${FIDELITY_SQ_ID}) but these artifacts are absent: ${ui_missing} — run /specclaw:bf-ui"
          ui_open="${FIDELITY_SQ_ID} decided ${fidelity_policy}, required artifacts missing"
        elif [ -z "$item_scrs" ]; then
          UI_FIDELITY[$id]="⚠ UI GROUNDING MISSING — ${fidelity_policy} decided (${FIDELITY_SQ_ID}) and this item renders a screen, but its acceptance basis cites no SCR-### entry from ui-inventory.md"
          ui_open="${FIDELITY_SQ_ID} decided ${fidelity_policy}, no SCR-### cited by this item"
        else
          local tks="$tk_global" s
          for s in ${item_scrs//,/ }; do
            [ -n "${TK_FOR_SCR[$s]:-}" ] && tks="${tks}${tks:+, }${TK_FOR_SCR[$s]}"
          done
          [ -n "$tks" ] || tks="none recorded in design-tokens.json"
          if [ "$fidelity_policy" = "FAITHFUL" ]; then
            UI_FIDELITY[$id]="FAITHFUL — reproduce the layout structure and token values of: ${item_scrs//,/, } (ui-inventory.md); token groups: ${tks}"
          else
            UI_FIDELITY[$id]="THEME-ONLY — reproduce the token values of: ${tks}; screens for reference only: ${item_scrs//,/, } (layout reinterpreted for the target platform)"
          fi
        fi
      elif [ "$fidelity_policy" = "UNDECIDED" ]; then
        UI_FIDELITY[$id]="UNDECIDED — this item renders a screen and ${FIDELITY_SQ_ID} (UI fidelity policy) has no recorded decision; acceptance cannot state how closely the legacy UI must be reproduced"
        ui_open="${FIDELITY_SQ_ID} (UI fidelity policy) undecided"
      fi
    fi

    if [ -n "$blocked_by" ]; then
      GATE[$id]="BLOCKED — blocked by ${blocked_by}"
      GATE_RANK[$id]=3
    elif [ -n "$open_qs" ] && [ -n "$ui_open" ]; then
      GATE[$id]="OPEN QUESTIONS — risk from unanswered, non-blocking: ${open_qs}; UI fidelity: ${ui_open}"
      GATE_RANK[$id]=2
    elif [ -n "$ui_open" ]; then
      GATE[$id]="OPEN QUESTIONS — UI fidelity: ${ui_open}"
      GATE_RANK[$id]=2
    elif [ -n "$open_qs" ]; then
      GATE[$id]="OPEN QUESTIONS — risk from unanswered, non-blocking: ${open_qs}"
      GATE_RANK[$id]=2
    else
      GATE[$id]="CLEAR"
      GATE_RANK[$id]=0
    fi

    # ── PROVISIONAL (Ask, Don't Guess soft-block) — recomputed fresh every
    # run, never persisted from a prior refresh: mechanical half (an
    # unanswered PQ-sourced CQ joins to this item, same join Gate just
    # used above) union the semantic half (this run's own PROVISIONAL:
    # directive from the planner agent's Behaviour 5). Independent of
    # Gate/Verification — an item can be CLEAR/VERIFIABLE and still
    # PROVISIONAL, or BLOCKED and PROVISIONAL for an unrelated reason. ────
    local prov_cqs=""
    for cid in $cq_ids; do
      cq_touches_item "${CQ_RULES[$cid]}" "${CQ_ITEMS[$cid]}" "$id" "${ITEM_RULES[$id]}" || continue
      [ "${CQ_ANSWERED[$cid]}" -eq 1 ] && continue
      [ "${CQ_PQ_SOURCED[$cid]:-0}" -eq 1 ] || continue
      prov_cqs="${prov_cqs}${prov_cqs:+,}${cid}"
    done
    if [ -n "${PROVISIONAL_SEMANTIC_CQS[$id]:-}" ]; then
      local scid
      IFS=',' read -ra _scids <<< "${PROVISIONAL_SEMANTIC_CQS[$id]}"
      for scid in "${_scids[@]}"; do
        [ -z "$scid" ] && continue
        [[ ",${prov_cqs}," == *",${scid},"* ]] || prov_cqs="${prov_cqs}${prov_cqs:+,}${scid}"
      done
    fi
    if [ -n "$prov_cqs" ]; then
      PROVISIONAL[$id]="⚠ PROVISIONAL — pending ${prov_cqs//,/, }"
    fi

    # ── STUB-BACKED (CONTRACT.md (m.3)) — its own marker line, deliberately
    # NOT folded into the Verification: field. Verification answers "is there
    # a fixture for this?"; taint answers "was the thing under test real?".
    # Orthogonal axes, so this rides alongside Gate/Verification exactly as
    # PROVISIONAL does, and is recomputed from the registry every run — a
    # retired stub clears it with no cleanup.
    local stub_marks="" sid2
    for sid2 in $st_ids; do
      [ "${STUB_STATUS_MAP[$sid2]}" = "ACTIVE" ] || continue
      # A legacy `item-split` ST entry fakes nothing, so nothing it consumed
      # was ever standing on something unreal. Marking those items STUB-BACKED
      # was a real defect: three documents claimed item-split taints nothing,
      # and the code consulted only Status, never Strategy. Excluded here and
      # from the retirement block below; the entry itself stays forever, since
      # ST ids are permanent.
      case " ${STUB_STRATEGIES_LEGACY} " in *" ${STUB_STRATEGY_MAP[$sid2]} "*) continue ;; esac
      case " ${STUB_CONSUMERS[$sid2]//,/ } " in
        *" ${id} "*) ;;
        *) continue ;;
      esac
      stub_marks="${stub_marks}${stub_marks:+; }${sid2} (${STUB_STRATEGY_MAP[$sid2]}, faking ${STUB_SUBSTITUTES[$sid2]})"
    done
    if [ -n "$stub_marks" ]; then
      STUB_BACKED[$id]="⚠ STUB-BACKED — built against ${stub_marks}. Any replay verdict for this item says so until the stub is retired."
    fi

    # ── PARTIALLY BUILT (CONTRACT.md (o.4)) — the completeness marker.
    #
    # Orthogonal to every other axis on the item. Gate answers "can we start?",
    # Verification "is there a fixture?", STUB-BACKED "was the thing under test
    # real?" — and this one answers a question none of them can: IS THIS ITEM
    # FINISHED. An item can be CLEAR, VERIFIABLE, untainted and still be
    # missing half of itself.
    #
    # Recomputed from the registry every run, so reaching COMPLETE clears it by
    # regeneration alone — never by hand-editing the backlog.
    local split_marks="" sid4
    for sid4 in $is_ids; do
      [ "${SPLIT_ITEM[$sid4]}" = "$id" ] || continue
      case "${SPLIT_STATUS[$sid4]}" in ACTIVE|READY-TO-RESUME) ;; *) continue ;; esac
      if [ "${SPLIT_STATUS[$sid4]}" = "READY-TO-RESUME" ]; then
        split_marks="${split_marks}${split_marks:+
}⚠ PARTIALLY BUILT — ${sid4} is READY TO RESUME: every blocked-until item (${SPLIT_BLOCKED[$sid4]//,/, }) now carries a declared \`BUILT:\` note. Still deferred: ${SPLIT_DEFERRED[$sid4]}. Run \`/specclaw:propose ${id}\` to plan the remaining scope only."
      else
        split_marks="${split_marks}${split_marks:+
}⚠ PARTIALLY BUILT — ${sid4}: deferred ${SPLIT_DEFERRED[$sid4]}. Blocked until ${SPLIT_UNBUILT[$sid4]:-${SPLIT_BLOCKED[$sid4]//,/, }} carries a declared \`BUILT:\` note. An \`/specclaw:bf-replay --item ${id}\` run reports PARTIAL and is not this item's final acceptance."
      fi
    done
    [ -n "$split_marks" ] && PARTIAL_BUILT[$id]="$split_marks"

    if [ -n "${UNVERIF_CQ[$id]:-}" ]; then
      VERIF[$id]="UNVERIFIABLE — acceptance must come from a stakeholder decision, not fixture comparison (see ${UNVERIF_CQ[$id]}). ${UNVERIF_REASON[$id]}"
      VERIF_RANK[$id]=1
      continue
    fi

    local matched_fixtures="" matched_scenarios="" gid
    for gid in $gm_ids; do
      local touches=false
      IFS=',' read -ra _gr <<< "${GM_RULES[$gid]}"
      local r
      for r in "${_gr[@]}"; do
        [ -z "$r" ] && continue
        [[ ",${ITEM_RULES[$id]}," == *",${r},"* ]] && touches=true
      done
      [ "${GM_ITEM[$gid]}" = "$id" ] && touches=true
      $touches || continue
      matched_scenarios="${matched_scenarios}${matched_scenarios:+, }${gid}"
      if [[ " ${fixture_ids} " == *" ${gid} "* ]]; then
        matched_fixtures="${matched_fixtures}${matched_fixtures:+, }${gid} (${FIXTURE_SHA[$gid]:-unknown commit})"
      fi
    done

    if [ -n "$matched_fixtures" ]; then
      VERIF[$id]="VERIFIABLE — fixtures: ${matched_fixtures}"
      VERIF_RANK[$id]=0
    elif [ -n "$matched_scenarios" ]; then
      VERIF[$id]="PENDING CAPTURE — scenarios designed, no recorded fixture yet: ${matched_scenarios}"
      VERIF_RANK[$id]=1
    elif [ -f "$scenarios_file" ] || [ -f "$manifest_file" ]; then
      VERIF[$id]="NO BASELINE DATA — baseline has been run, but no scenario in scenarios.md cites this item's rules"
      VERIF_RANK[$id]=1
    else
      VERIF[$id]="NO BASELINE DATA — /specclaw:bf-baseline has not been run at all"
      VERIF_RANK[$id]=1
    fi
  done

  # ── Final ordering: dependency rank, then readiness (Gate rank, then
  # Verification rank) within the same dependency rank, then ID for a
  # stable tiebreak. ───────────────────────────────────────────────────────
  local sortlist="$workdir/sort.tsv"; : > "$sortlist"
  for id in $active_ids; do
    printf '%03d\t%d\t%d\t%s\n' "${RANK[$id]}" "${GATE_RANK[$id]}" "${VERIF_RANK[$id]}" "$id" >> "$sortlist"
  done
  local ordered_ids=""
  while IFS=$'\t' read -r _r _g _v id; do
    ordered_ids="${ordered_ids} ${id}"
  done < <(sort -k1,1n -k2,2n -k3,3n -k4,4 "$sortlist")

  # ── Module group order: module dependency rank, then id for a stable
  # tiebreak — foundations first. Item order WITHIN a module is untouched:
  # it is exactly the ordered_ids sequence computed above (BL dependency
  # rank, then Gate readiness, then Verification readiness, then id). ──────
  local mod_order="" mgroup_sort="$workdir/modsort.tsv"; : > "$mgroup_sort"
  for m in $mod_ids; do
    printf '%03d\t%s\n' "${MOD_RANK[$m]}" "$m" >> "$mgroup_sort"
  done
  while IFS=$'\t' read -r _mr m; do
    mod_order="${mod_order} ${m}"
  done < <(sort -k1,1n -k2,2 "$mgroup_sort")

  # ── Render each active item, grouped under its module ────────────────────
  render_item() {
    local id="$1" entry provisional_block=""
    if [ -n "${PROVISIONAL[$id]:-}" ]; then
      provisional_block="
${PROVISIONAL[$id]}
"
    fi
    if [ -n "${STUB_BACKED[$id]:-}" ]; then
      provisional_block="${provisional_block}
${STUB_BACKED[$id]}
"
    fi
    if [ -n "${PARTIAL_BUILT[$id]:-}" ]; then
      provisional_block="${provisional_block}
${PARTIAL_BUILT[$id]}
"
    fi
    entry="### ${id} — ${FINAL_TITLE[$id]}
${provisional_block}
${FINAL_BODY[$id]}
**Gate:** ${GATE[$id]}
**Verification:** ${VERIF[$id]}"
    if [ -n "${UI_FIDELITY[$id]:-}" ]; then
      entry="${entry}
**UI fidelity:** ${UI_FIDELITY[$id]}"
    fi
    # A THIRD AXIS, not a restatement of the two above. Gate answers "can this
    # start?", Verification "how would it ever be checked?", and this one "has
    # it been checked, and did it pass?" — a question neither of the others can
    # carry, and the one thing a reader of a remediation item actually wants.
    # Recomputed from the delta every run, so it clears by regeneration alone.
    if [ -n "${QUALITY_STATE[$id]:-}" ]; then
      entry="${entry}
**Quality state:** ${QUALITY_STATE[$id]}"
    fi
    if [ -n "${FINAL_TAIL[$id]}" ]; then
      entry="${entry}

${FINAL_TAIL[$id]}"
    fi
    printf '%s' "$entry"
  }

  local backlog_body="" mod_item_counts=""
  for m in $mod_order; do
    local group_body="" gfirst=true n_in_mod=0
    for id in $ordered_ids; do
      [ "${ITEM_MOD[$id]:-}" = "$m" ] || continue
      n_in_mod=$((n_in_mod + 1))
      if $gfirst; then gfirst=false; else group_body="${group_body}

---

"; fi
      group_body="${group_body}$(render_item "$id")"
    done
    mod_item_counts="${mod_item_counts}${m}=${n_in_mod} "
    # A module with no active items is still rendered as a heading with an
    # explicit line. Omitting it would make a module that exists in the map
    # but has nothing planned yet indistinguishable from one that does not
    # exist — which is precisely the gap a module-at-a-time migration needs
    # to see.
    local dep_note="${MOD_DEPS[$m]:-}"
    [ -n "$dep_note" ] && dep_note="${dep_note//,/, }" || dep_note="none"
    # Never print a rank number computed inside a cycle — the fixed point
    # never converged, so whatever the counter stopped at is an artifact of
    # the iteration cap, not a dependency depth.
    local rank_note="Module dependency rank ${MOD_RANK[$m]}"
    [ -n "$mod_cycle" ] && rank_note="module dependency rank undefined — module-map.md describes a dependency cycle"
    backlog_body="${backlog_body}## ${m} — ${MOD_NAME[$m]}

_Depends on: ${dep_note}. ${rank_note}. ${n_in_mod} active item(s)._

"
    if [ "$n_in_mod" -eq 0 ]; then
      backlog_body="${backlog_body}_No active backlog items are assigned to this module yet — run \`/specclaw:bf-rebuild-plan --refresh --module ${m}\` to plan it._

"
    else
      backlog_body="${backlog_body}${group_body}

"
    fi
  done

  # Items whose module could not be determined — never silently folded into
  # a real module. Either they predate the hierarchy, or they declare a
  # MOD-### the map does not define.
  local unassigned_body="" ufirst=true
  for id in $ordered_ids; do
    [ -z "${ITEM_MOD[$id]:-}" ] || continue
    if $ufirst; then ufirst=false; else unassigned_body="${unassigned_body}

---

"; fi
    unassigned_body="${unassigned_body}$(render_item "$id")"
  done
  if [ -n "$unassigned_body" ]; then
    backlog_body="${backlog_body}## Unassigned — no module declared

_These items declare no \`**Module:**\` field, or declare a \`MOD-###\` that module-map.md does not define. They are NOT grouped into a module by guesswork: an item's module is declared, never derived from its rules. Add the field (or fix the id), then re-run \`--refresh\`._

${unassigned_body}

"
  fi

  # ── Struck tombstones (ID order) ─────────────────────────────────────────
  # Under their own "## Struck" heading rather than trailing the last module
  # group: a tombstone appended straight after the final module's items would
  # read as belonging to that module, and a struck item belongs to no module.
  local struck_body=""
  for id in $(printf '%s\n' "${!STRIKE_REASON[@]}" | sort); do
    struck_body="${struck_body}### ${id} — STRUCK — ${STRIKE_REASON[$id]}

"
  done
  if [ -n "$struck_body" ]; then
    backlog_body="${backlog_body}## Struck

_Tombstones. A struck item keeps its BL-### id forever so that anything still citing it fails loudly instead of silently pointing at another item._

${struck_body}"
  fi

  # ── Deferred section (ID order) ──────────────────────────────────────────
  local deferred_body=""
  for id in $(printf '%s\n' "${!DEFER_REASON[@]}" | sort); do
    local title body
    title="${FINAL_TITLE[$id]:-${EXIST_TITLE[$id]:-$id}}"
    body="${FINAL_BODY[$id]:-${EXIST_STATIC[$id]:-}}"
    [ -n "$deferred_body" ] && deferred_body="${deferred_body}

---
"
    deferred_body="${deferred_body}

### ${id} — ${title}

**Status:** Deferred — ${DEFER_REASON[$id]}

${body}"
  done
  [ -z "$deferred_body" ] && deferred_body="None."

  # ── Status header + counts ───────────────────────────────────────────────
  local n_clear=0 n_open=0 n_blocked=0 n_verifiable=0 n_pending=0 n_unverif=0 n_nobaseline=0 n_provisional=0
  local n_qmeasured=0 n_qdone=0
  for id in $active_ids; do
    case "${GATE[$id]}" in
      CLEAR) n_clear=$((n_clear+1)) ;;
      OPEN\ QUESTIONS*) n_open=$((n_open+1)) ;;
      BLOCKED*) n_blocked=$((n_blocked+1)) ;;
    esac
    case "${VERIF[$id]}" in
      VERIFIABLE*) n_verifiable=$((n_verifiable+1)) ;;
      PENDING\ CAPTURE*) n_pending=$((n_pending+1)) ;;
      UNVERIFIABLE*) n_unverif=$((n_unverif+1)) ;;
      NO\ BASELINE\ DATA*) n_nobaseline=$((n_nobaseline+1)) ;;
      QUALITY-MEASURED*) n_qmeasured=$((n_qmeasured+1)) ;;
    esac
    case "${QUALITY_STATE[$id]:-}" in DONE*) n_qdone=$((n_qdone+1)) ;; esac
    [ -n "${PROVISIONAL[$id]:-}" ] && n_provisional=$((n_provisional+1))
  done
  local recommended="None — every item is BLOCKED or no active items remain."
  for id in $ordered_ids; do
    if [ "${GATE_RANK[$id]}" -eq 0 ]; then
      recommended="${id} — ${FINAL_TITLE[$id]}"
      break
    fi
  done

  # ── Per-module readiness + the recommended next module ───────────────────
  #
  # "Dependencies satisfied" is stated honestly: specclaw records no BUILT
  # state for a backlog item (only a human's own status note), so this can
  # never claim a dependency module is finished. What it can compute, from
  # declared data alone, is READINESS — no BLOCKED and no PROVISIONAL item in
  # the module or in anything it depends on — and the rendered line says that
  # is what it means rather than implying completion.
  declare -A MOD_N MOD_BLOCKED MOD_PROV MOD_CLEAR MOD_OPEN
  for m in $mod_order; do
    MOD_N[$m]=0; MOD_BLOCKED[$m]=0; MOD_PROV[$m]=0; MOD_CLEAR[$m]=0; MOD_OPEN[$m]=0
  done
  for id in $active_ids; do
    m="${ITEM_MOD[$id]:-}"
    [ -n "$m" ] || continue
    [[ " ${mod_ids} " == *" ${m} "* ]] || continue
    MOD_N[$m]=$(( MOD_N[$m] + 1 ))
    case "${GATE_RANK[$id]}" in
      0) MOD_CLEAR[$m]=$(( MOD_CLEAR[$m] + 1 )) ;;
      2) MOD_OPEN[$m]=$(( MOD_OPEN[$m] + 1 )) ;;
      3) MOD_BLOCKED[$m]=$(( MOD_BLOCKED[$m] + 1 )) ;;
    esac
    [ -n "${PROVISIONAL[$id]:-}" ] && MOD_PROV[$m]=$(( MOD_PROV[$m] + 1 ))
  done

  local recommended_module="" rec_mod_reason="" first_blocker=""
  # A cycle means no module has a defensible dependency depth, so "which one
  # comes first" has no answer to give. Recommending one anyway — with a rank
  # number the iteration cap happened to stop at — would be the single most
  # misleading line this document could print.
  if [ -n "$mod_cycle" ]; then
    first_blocker="module dependency order is undefined — module-map.md's 'Depends on' fields describe a cycle (see the warning above). Break the cycle, then re-run --refresh"
  else
    for m in $mod_order; do
      [ "${MOD_N[$m]}" -gt 0 ] || continue
      local deps_ok=true unready_dep="" mdep
      IFS=',' read -ra _mdeps <<< "${MOD_DEPS[$m]:-}"
      for mdep in ${_mdeps[@]+"${_mdeps[@]}"}; do
        [ -z "$mdep" ] && continue
        [[ " ${mod_ids} " == *" ${mdep} "* ]] || continue
        if [ "${MOD_BLOCKED[$mdep]:-0}" -gt 0 ] || [ "${MOD_PROV[$mdep]:-0}" -gt 0 ]; then
          deps_ok=false
          unready_dep="${unready_dep}${unready_dep:+, }${mdep} (${MOD_BLOCKED[$mdep]:-0} BLOCKED, ${MOD_PROV[$mdep]:-0} PROVISIONAL)"
        fi
      done
      if [ "${MOD_BLOCKED[$m]}" -eq 0 ] && [ "${MOD_PROV[$m]}" -eq 0 ] && $deps_ok; then
        recommended_module="$m"
        local dep_list="${MOD_DEPS[$m]:-}"
        [ -n "$dep_list" ] && dep_list="${dep_list//,/, }" || dep_list="none"
        rec_mod_reason="dependency rank ${MOD_RANK[$m]}; depends on ${dep_list}; ${MOD_N[$m]} active item(s) — ${MOD_CLEAR[$m]} CLEAR, ${MOD_OPEN[$m]} OPEN QUESTIONS, 0 BLOCKED, 0 PROVISIONAL; every module it depends on is likewise free of BLOCKED and PROVISIONAL items"
        break
      fi
      if [ -z "$first_blocker" ]; then
        if ! $deps_ok; then
          first_blocker="${m} — ${MOD_NAME[$m]} is itself ready, but a module it depends on is not: ${unready_dep}"
        else
          first_blocker="${m} — ${MOD_NAME[$m]} has ${MOD_BLOCKED[$m]} BLOCKED and ${MOD_PROV[$m]} PROVISIONAL item(s); answer the questions those items name first"
        fi
      fi
    done
  fi

  local module_block
  module_block="**Module map:** ${map_status:-status line missing} — $(echo "$mod_ids" | wc -w | tr -d ' ') active module(s)"
  case "$map_status" in
    CONFIRMED*) ;;
    *)
      module_block="${module_block}

> ⚠ **The module map is not confirmed.** Its \`**Status:**\` line reads \`${map_status:-<missing>}\`, so the grouping and sequencing below rest on a proposal no human has signed off. Review \`.specclaw/analysis/module-map.md\` and set its Status to \`CONFIRMED by <name>, <date>\`. Nothing here is blocked by this — the backlog is complete and usable — but a module boundary nobody checked becomes the shape of the whole migration."
      warn "module-map.md is not CONFIRMED (Status: ${map_status:-<missing>}) — module grouping and sequencing rest on an unconfirmed proposal."
      ;;
  esac
  if [ -n "$mod_cycle" ]; then
    module_block="${module_block}

> ⚠ **Module dependency cycle.** ${mod_cycle}"
  fi
  if [ -n "$unassigned_items" ]; then
    module_block="${module_block}

- **Unassigned items:** ${unassigned_items} — no \`**Module:**\` field, or an id the map does not define. Rendered under their own \`## Unassigned\` heading, never folded into a module by guesswork."
    warn "these active items declare no usable module and were left unassigned: ${unassigned_items}"
  fi
  if [ -n "$unknown_mod_items" ]; then
    module_block="${module_block}
- **Unknown module declared:** ${unknown_mod_items} — module-map.md defines no such module (check for a typo, or a module that was withdrawn)."
    warn "these active items declare a MOD-### that module-map.md does not define: ${unknown_mod_items}"
  fi
  if [ -n "$recommended_module" ]; then
    module_block="${module_block}

**Recommended next module to build:** ${recommended_module} — ${MOD_NAME[$recommended_module]}
- **Why:** ${rec_mod_reason}.
- **Readiness, not completion:** specclaw records no \"built\" state for a backlog item, so this is the next module whose work can *start*, not a claim that anything it depends on is finished."
  elif [ -n "$mod_cycle" ]; then
    module_block="${module_block}

**Recommended next module to build:** none — not because any module is unready, but because there is no defensible order to recommend one from.
- **Why:** ${first_blocker}."
  else
    module_block="${module_block}

**Recommended next module to build:** none — no module is currently free of BLOCKED and PROVISIONAL items with all its dependencies likewise clear.
- **Nearest candidate:** ${first_blocker:-no module has any active backlog item yet}."
  fi

  local missing_note_decisions missing_note_clar missing_note_manifest missing_note_scenarios
  missing_note_decisions="present"; [ -f "$decisions_file" ] || missing_note_decisions="missing — run /specclaw:bf-clarify --resolve"
  missing_note_clar="present"; [ -f "$clar_file" ] || missing_note_clar="missing — run /specclaw:bf-clarify"
  missing_note_manifest="present"; [ -f "$manifest_file" ] || missing_note_manifest="missing — run /specclaw:bf-baseline --record"
  missing_note_scenarios="present"; [ -f "$scenarios_file" ] || missing_note_scenarios="missing — run /specclaw:bf-baseline"

  # ── UI fidelity status block. One line when the workstream is inactive
  # (so a reader can see it was considered and costs nothing), and a loud,
  # artifact-naming warning when a decided policy has nothing to stand on. ─
  local n_screen_bearing=0 n_ui_gap=0
  for id in $active_ids; do
    [ -n "${UI_FIDELITY[$id]:-}" ] && n_screen_bearing=$((n_screen_bearing+1))
    case "${UI_FIDELITY[$id]:-}" in ⚠*|UNDECIDED*) n_ui_gap=$((n_ui_gap+1)) ;; esac
  done
  local ui_status_block="**UI fidelity policy:** ${fidelity_policy} (${FIDELITY_SQ_ID})"
  case "$fidelity_policy" in
    REINTERPRET)
      ui_status_block="${ui_status_block} — the legacy UI is reference material only, so no appearance requirement is attached to any item. Screens are still mapped: each item cites the SCR-### it replaces, and /specclaw:bf-prototype requires a named client stakeholder to approve the redesign of every one of them before the new repo is built."
      ;;
    UNDECIDED)
      if [ "$n_screen_bearing" -gt 0 ]; then
        ui_status_block="${ui_status_block} — no recorded decision, and ${n_screen_bearing} item(s) render a screen; those items sit at OPEN QUESTIONS until a human answers ${FIDELITY_SQ_ID} in clarifications.md."
      else
        ui_status_block="${ui_status_block} — no recorded decision; no item is marked as rendering a screen, so nothing is gated on it."
      fi
      ;;
    *)
      ui_status_block="${ui_status_block}
- .specclaw/ui/ui-inventory.md: $([ -f "$ui_inventory" ] && echo present || echo 'missing — run /specclaw:bf-ui')
- .specclaw/ui/design-tokens.json: $([ -f "$ui_tokens_file" ] && echo present || echo 'missing — run /specclaw:bf-ui')
- .specclaw/ui/screens/: $([ -d "$ui_dir/screens" ] && echo present || echo 'missing — a human must capture screenshots per screenshot-checklist.md')
- .specclaw/ui/ui-manifest.json: $([ -f "$ui_manifest_file" ] && echo present || echo 'missing — run /specclaw:bf-ui --record')
- Screen-bearing items: ${n_screen_bearing}, of which ${n_ui_gap} lack UI grounding"
      if [ -n "$ui_missing" ]; then
        ui_status_block="${ui_status_block}

> ⚠ **WARNING — UI fidelity policy ${fidelity_policy} is decided, but the artifacts it requires do not exist:** ${ui_missing}. Every screen-bearing item above is held at OPEN QUESTIONS as a result. Run \`/specclaw:bf-ui\` (and \`--record\`, after a human captures the screenshots) — this backlog cannot state a UI acceptance basis without them, and it will not pretend to."
        warn "UI fidelity policy ${fidelity_policy} is decided but these artifacts are missing: ${ui_missing} — ${n_screen_bearing} screen-bearing item(s) held at OPEN QUESTIONS. Run /specclaw:bf-ui."
      fi
      ;;
  esac

  local status_header
  # Built outside the here-doc: a trailing newline inside a $( ) is stripped
  # by command substitution, which would weld this line to the next one.
  # Present only when this project has quality remediation items at all, so a
  # backlog rendered without quality.json is unchanged down to the byte.
  local qr_status_line=""
  if [ "$n_qmeasured" -gt 0 ]; then
    qr_status_line="
**Quality remediation:** ${n_qmeasured} item(s) on the QUALITY-MEASURED channel, ${n_qdone} computed DONE from \`quality-delta.json\`. Severity floor: ${qr_floor} (\`config.yaml\` \`quality.remediation_severity_floor\`). These cite no DR-### and map to no GM-### — see each item's own **Quality state:** line.
"
  fi
  local scope_line=""
  if [ -n "$module_scope" ]; then
    scope_line="**Scope:** this run re-planned ${module_scope} only — every other module's items, coverage lines, and human-added status notes were preserved untouched.
"
  fi

  status_header="**Date:** $(date +%Y-%m-%d)
${scope_line}**Inputs consumed:**
- decisions.md: ${missing_note_decisions}
- clarifications.md: ${missing_note_clar}
- baseline/manifest.json: ${missing_note_manifest}
- baseline/scenarios.md: ${missing_note_scenarios}

${module_block}

${ui_status_block}

**Gate counts:** CLEAR: ${n_clear}, OPEN QUESTIONS: ${n_open}, BLOCKED: ${n_blocked} (of $(echo "$active_ids" | wc -w | tr -d ' ') active items; ${#STRIKE_REASON[@]} struck, ${#DEFER_REASON[@]} deferred)
**Verification counts:** VERIFIABLE: ${n_verifiable}, PENDING CAPTURE: ${n_pending}, UNVERIFIABLE: ${n_unverif}, NO BASELINE DATA: ${n_nobaseline}
**Provisional (pending a decision):** ${n_provisional} item(s) — independent of Gate/Verification; see each item's own marker
${qr_status_line}
**Recommended next item to propose:** ${recommended}"

  # ── Stub Retirement (CONTRACT.md (m.4)) ──────────────────────────────────
  #
  # For every ACTIVE stub, is the thing it substitutes built yet? The trigger
  # is narrow and declared: a "BUILT:" line in the substituted item's own
  # Status-notes block. Prose is not parsed — specclaw records no built state,
  # and inferring "done last week" from free text would be the guess this
  # whole mechanism exists to prevent.
  #
  # When a stub substitutes a whole MOD-###, every active item of that module
  # must carry the signal: a module is not built because one of its items is.
  local stub_retirement="" ready_block="" waiting_block="" sid3 today_str
  today_str="$(date +%Y-%m-%d)"
  local legacy_split_note=""
  for sid3 in $st_ids; do
    case "${STUB_STATUS_MAP[$sid3]}" in
      ACTIVE|RETIRING) ;;
      *) continue ;;
    esac
    # A legacy item-split entry has no stub code to remove and nothing to
    # re-replay, so every step of the retirement flow is meaningless for it.
    # Named once, with the manual step, rather than migrated — ST ids are
    # permanent and entries are never rewritten (CONTRACT.md (c)).
    case " ${STUB_STRATEGIES_LEGACY} " in
      *" ${STUB_STRATEGY_MAP[$sid3]} "*)
        legacy_split_note="${legacy_split_note}- **${sid3}** — a legacy \`item-split\` entry, recorded before item splits had their own registry. It fakes nothing, so it taints nothing and there is no stub code to retire. It is excluded from the flow above. If you still need resume tracking for that split, record it with \`specclaw-bf-rebuild-collect split-append\` (see \`templates/item-splits.md\`); this entry stays here permanently either way.
"
        continue ;;
    esac
    local subs="${STUB_SUBSTITUTES[$sid3]}" consumers="${STUB_CONSUMERS[$sid3]}"
    local cmds="" replay_cmds="" c
    for c in $(printf '%s' "$consumers" | tr ',' ' '); do
      case "$c" in BL-[0-9][0-9][0-9]) ;; *) continue ;; esac
      cmds="${cmds}${cmds:+ }${c}"
      replay_cmds="${replay_cmds}${replay_cmds:+, }\`/specclaw:bf-replay <the change that built ${c}>\`"
    done

    if [ "${STUB_STATUS_MAP[$sid3]}" = "RETIRING" ]; then
      ready_block="${ready_block}- **${sid3}** — already \`RETIRING\`. Re-replay its consumers (${cmds// /, }) and, on a clean run, flip it to \`RETIRED\` citing that run id. A FAIL sends it back to \`ACTIVE\`.
"
      continue
    fi

    # Which BL items must be built for this stub to be retirable.
    local required="" mod_target
    mod_target="$(printf '%s' "$subs" | { grep -oE 'MOD-[0-9]{3}' | head -1; } || true)"
    local subs_bl; subs_bl="$(printf '%s' "$subs" | { grep -oE 'BL-[0-9]{3}' | head -1; } || true)"
    if [ -n "$subs_bl" ]; then
      required="$subs_bl"
    elif [ -n "$mod_target" ]; then
      local aid
      for aid in $active_ids; do
        [ "${ITEM_MOD[$aid]:-}" = "$mod_target" ] && required="${required}${required:+ }${aid}"
      done
    fi

    local unbuilt=""
    for c in $required; do
      if [ -f "$workdir/existing/${c}.md" ]; then
        built_signal_of "$workdir/existing/${c}.md" >/dev/null 2>&1 && continue
      fi
      unbuilt="${unbuilt}${unbuilt:+, }${c}"
    done

    if [ -z "$required" ]; then
      waiting_block="${waiting_block}- **${sid3}** — substitutes \`${subs}\`, which resolves to no active backlog item. Nothing here can tell whether it is built; check by hand.
"
    elif [ -z "$unbuilt" ]; then
      ready_block="${ready_block}- **${sid3}** — ${subs} is declared BUILT. Retire it:
  1. *(human)* remove or disable the stub code, then \`specclaw-bf-rebuild-collect stub-update .specclaw ${sid3} --status \"RETIRING ${today_str}\"\`
  2. *(Claude)* re-replay each consumer: ${replay_cmds}
  3. *(Claude, on a clean run only)* \`stub-update .specclaw ${sid3} --status \"RETIRED <date>, cleared by run <run_id>\" --retirement \"<date>, run <run_id>, re-replayed ${cmds// /, }\"\`
  4. *(human)* on a FAIL, flip it back to \`ACTIVE\` — the real module does not yet carry these items.
"
    else
      waiting_block="${waiting_block}- **${sid3}** — waiting on ${unbuilt} (no declared \`BUILT:\` note). Consumed by ${cmds// /, }.
"
    fi
  done
  if [ -n "$ready_block" ] || [ -n "$waiting_block" ] || [ -n "$legacy_split_note" ]; then
    stub_retirement="${ready_block:+### Ready to retire

${ready_block}
}${waiting_block:+### Still waiting

${waiting_block}
}${legacy_split_note:+### Legacy item-split entries (nothing to retire)

${legacy_split_note}}"
  else
    stub_retirement="_No active dependency bypass stubs. Every item is being built on the real modules it depends on._"
  fi

  # ── Item Splits (CONTRACT.md (o)) ────────────────────────────────────────
  #
  # Bash-computed every run from item-splits.md, the same tier as the Stub
  # Retirement block. A project with no registry gets one line saying so.
  local item_splits_block="" is_ready_block="" is_waiting_block="" sid5
  for sid5 in $is_ids; do
    case "${SPLIT_STATUS[$sid5]}" in
      READY-TO-RESUME)
        is_ready_block="${is_ready_block}- **${sid5}** — ${SPLIT_ITEM[$sid5]} is partially built and every blocked-until item (${SPLIT_BLOCKED[$sid5]//,/, }) now carries a declared \`BUILT:\` note. Still deferred: ${SPLIT_DEFERRED[$sid5]}.
  1. *(Claude)* \`/specclaw:propose ${SPLIT_ITEM[$sid5]}\` — it resumes, proposing ONLY the deferred scope and citing this entry's own evidence (${SPLIT_CHANGE[$sid5]:-no change recorded}, ${SPLIT_EVIDENCE[$sid5]:-no PR evidence}).
  2. *(Claude)* build and verify the remainder, then \`/specclaw:bf-replay --item ${SPLIT_ITEM[$sid5]}\`.
  3. *(Claude, on a clean run only)* \`split-update .specclaw ${sid5} --status \"COMPLETE <date>, cleared by run <run_id>\" --completion \"<date>, run <run_id>, <what finished it>\"\`.
"
        ;;
      ACTIVE)
        is_waiting_block="${is_waiting_block}- **${sid5}** — ${SPLIT_ITEM[$sid5]} is partially built. Deferred: ${SPLIT_DEFERRED[$sid5]} (rules ${SPLIT_RULES_DEF[$sid5]:-none recorded}; layers ${SPLIT_LAYERS_DEF[$sid5]:-none recorded}). Waiting on ${SPLIT_UNBUILT[$sid5]:-${SPLIT_BLOCKED[$sid5]//,/, }} — no declared \`BUILT:\` note yet. This flips to READY-TO-RESUME automatically on the next \`--refresh\` once those notes exist.
"
        ;;
    esac
  done
  if [ -n "$is_ready_block" ] || [ -n "$is_waiting_block" ]; then
    item_splits_block="${is_ready_block:+### Ready to resume

${is_ready_block}
}${is_waiting_block:+### Still waiting

${is_waiting_block}}"
  elif [ -f "$splits_file_r" ]; then
    item_splits_block="_Every recorded item split is COMPLETE. No backlog item is carrying deferred scope._"
  else
    item_splits_block="_No item splits. Every backlog item is being built whole._"
  fi

  # ── Change report (refresh only) ─────────────────────────────────────────
  local change_report="Not applicable — this is the first-ever run."
  if $is_refresh; then
    local newly_unblocked="" newly_verifiable="" added_list="" revised_list="" struck_list="" deferred_list=""
    for id in $active_ids; do
      [[ " ${existing_ids} " == *" ${id} "* ]] || continue
      local og="${EXIST_OLD_GATE[$id]%% —*}"
      local ov="${EXIST_OLD_VERIF[$id]%% —*}"
      if [ "$og" = "BLOCKED" ] && [ "${GATE_RANK[$id]}" -lt 3 ]; then
        newly_unblocked="${newly_unblocked}${newly_unblocked:+, }${id}"
      fi
      if [ "$ov" != "VERIFIABLE" ] && [ "${VERIF_RANK[$id]}" -eq 0 ]; then
        newly_verifiable="${newly_verifiable}${newly_verifiable:+, }${id}"
      fi
    done
    for id in $(printf '%s\n' "${!STRIKE_REASON[@]}" | sort); do struck_list="${struck_list}${struck_list:+, }${id}"; done
    for id in $(printf '%s\n' "${!DEFER_REASON[@]}" | sort); do deferred_list="${deferred_list}${deferred_list:+, }${id}"; done
    for id in $revised_ids; do revised_list="${revised_list}${revised_list:+, }${id}"; done
    for id in $new_ids; do added_list="${added_list}${added_list:+, }${id}"; done

    change_report="**Newly unblocked:** ${newly_unblocked:-none}
**Newly verifiable:** ${newly_verifiable:-none}
**Struck this run:** ${struck_list:-none}
**Deferred this run:** ${deferred_list:-none}
**Revised this run:** ${revised_list:-none}
**Added this run:** ${added_list:-none}
**Recommended next item to propose:** ${recommended}"
  fi

  # ── Sequencing Rationale / Coverage Check ────────────────────────────────
  #
  # Both are agent-authored narrative bash cannot verify against the source
  # documents, so bash never writes their prose — but it does have to CARRY
  # it. Precedence: this run's draft wins; otherwise the prior file's own
  # section is preserved; otherwise (a first run whose draft omitted the
  # section) a line saying plainly that it is absent and why.
  #
  # Reading the draft here is a fix, not a new feature: the planner agent has
  # always been instructed to emit these two sections, and render always
  # dropped them on the floor — so a first-ever run rendered the "See prior
  # version below" placeholder as if it were content, and every later
  # --refresh faithfully preserved that placeholder forever. The per-module
  # coverage rollup below counts the agent's own coverage lines, which is
  # impossible while those lines never reach the file.
  local draft_sequencing draft_coverage
  draft_sequencing="$(awk '/^## Sequencing Rationale/{flag=1;next}/^## /{flag=0}flag' "$draft_file" | sed '/./,$!d' | strip_trailing_separator)"
  draft_coverage="$(awk '/^## Coverage Check/{flag=1;next}/^## /{flag=0}flag' "$draft_file" | sed '/./,$!d' | strip_trailing_separator)"

  # Strip a leading HTML comment block. The template renders its own explanatory
  # comment BETWEEN a section heading and that section's placeholder, so reading
  # the section back on a refresh picks the comment up as if it were content —
  # and re-rendering it into a template that already contains it appended one
  # more copy on every single --refresh. A shipped defect: four renders produced
  # four stacked copies of the Coverage Check comment, growing the document
  # without bound and burying the actual coverage lines.
  strip_leading_comment() {
    awk '
      NR == 1 && /^[[:space:]]*$/ { next }
      !started && /^<!--/ { incomment = 1 }
      incomment { if (/-->/) { incomment = 0 } ; next }
      { started = 1; print }
    ' | sed '/./,$!d'
  }

  local prior_sequencing="" prior_coverage=""
  if $is_refresh; then
    prior_sequencing="$(awk '/^## Sequencing Rationale/{flag=1;next}/^## /{flag=0}flag' "$backlog_file" | strip_leading_comment)"
    prior_coverage="$(awk '/^## Coverage Check/{flag=1;next}/^## /{flag=0}flag' "$backlog_file" | strip_leading_comment)"
    # Drop any prior run's bash-computed subsections — both are re-derived
    # below, so carrying the old ones forward would render two of each, one
    # stale.
    prior_coverage="$(printf '%s\n' "$prior_coverage" | awk '/^### UI Screen Coverage \(SCR\)/{stop=1} /^### Module Coverage Rollup/{stop=1} !stop' | strip_trailing_separator)"
  fi

  local sequencing_rationale="$prior_sequencing"
  [ -n "$draft_sequencing" ] && sequencing_rationale="$draft_sequencing"
  [ -n "$sequencing_rationale" ] || sequencing_rationale="_Not stated — this run's planner draft carried no \`## Sequencing Rationale\` section. Item order is still fully computed (module dependency rank, then per-item dependency rank, then readiness); this section is the human-readable explanation of it._"

  local coverage_check
  if [ -n "$draft_coverage" ] && [ -n "$module_scope" ] && [ -n "$prior_coverage" ]; then
    # Module-scoped run: replace ONLY this module's coverage lines, keeping
    # every other module's accounting intact. Line-level surgery on the
    # declared grammar, the same surgical discipline /specclaw:bf-clarify
    # applies to a single PQ Status line — a wholesale replace here would
    # silently delete the coverage record of every module this run never
    # looked at.
    coverage_check="$(printf '%s\n' "$prior_coverage" \
      | awk -v mod="- **${module_scope}**" 'index($0, mod) != 1' \
      | strip_trailing_separator)
${draft_coverage}"
  elif [ -n "$draft_coverage" ]; then
    coverage_check="$draft_coverage"
  else
    coverage_check="$prior_coverage"
  fi
  [ -n "$coverage_check" ] || coverage_check="_Not stated — this run's planner draft carried no \`## Coverage Check\` section, and no prior one exists. Capability-bullet coverage is therefore unaccounted for; re-run \`/specclaw:bf-rebuild-plan --refresh\` to have the planner emit it._"

  # ── Module Coverage Rollup (bash-computed) ───────────────────────────────
  # Counted from the planner agent's own declared coverage lines:
  #
  #   - **MOD-002** — "<capability bullet>" → BL-014
  #   - **MOD-002** — "<capability bullet>" → EXCLUDED: <reason>
  #   - **MOD-002** — "<capability bullet>" → ORPHAN
  #
  # Bullet granularity is unchanged — this counts the per-bullet lines, it
  # does not replace them with a coarser unit. An agent declares what it
  # covered; bash counts. When no line matches the grammar the rollup says so
  # rather than reporting a confident 0/0 that reads as "nothing to cover."
  # ── Optional quality annotation ───────────────────────────────────────────
  #
  # /specclaw:bf-quality is entirely optional and nothing here requires it. When
  # .specclaw/analysis/quality.json happens to exist, each module's rollup line
  # gains its measured quality status and open-hotspot count, because "this
  # module has 12 capability bullets covered" and "this module is the worst-
  # measured code in the tree" are the two facts you want side by side when
  # deciding what to rebuild next.
  #
  # ABSENT FILE MEANS EMPTY SUFFIX, so a project that never runs that command
  # gets byte-identical output to a run predating this hook. That is the whole
  # contract of the annotation and it is what the regression suite asserts.
  # Every failure mode degrades to the same empty string: no file, no jq, a
  # module the snapshot never measured, unreadable JSON.
  local quality_json="$analysis_dir/quality.json"
  quality_suffix_for() {
    local mid="$1" base="" below=""
    [ -f "$quality_json" ] || return 0
    command -v jq >/dev/null 2>&1 || return 0
    base="$(jq -r --arg m "$mid" '
      (.modules[]? | select(.module_id == $m)) as $mod
      | "; quality " + $mod.rollup_status
        + " (" + ([.quality_issues[]? | select(.module_id == $m and .status == "open")] | length | tostring)
        + " open QI)"
    ' "$quality_json" 2>/dev/null || true)"
    [ -n "$base" ] || return 0
    # THE ADVISORY HALF of the severity floor. A hotspot below the floor is
    # real and is reported here — it is simply not something the rebuild is
    # held to, so it gets a count on this line instead of a backlog item.
    # Suppressed entirely at zero, which is the state of every project whose
    # floor and register_severity agree, so the line is unchanged for them.
    below="$(quality_below_floor_count "$quality_json" "$qr_floor" "$mid")"
    if [ "${below:-0}" -gt 0 ] 2>/dev/null; then
      base="${base}; ${below} advisory QI below the ${qr_floor} remediation floor (no item generated)"
    fi
    printf '%s' "$base"
  }

  local rollup_lines="" rollup_any=false
  printf '%s\n' "$coverage_check" > "$workdir/cov.tmp"
  for m in $mod_order; do
    local cov_total cov_bl cov_excl cov_orph
    cov_total=$(grep -cE "^- \*\*${m}\*\*[[:space:]]" "$workdir/cov.tmp" 2>/dev/null || true)
    cov_bl=$(grep -E "^- \*\*${m}\*\*[[:space:]]" "$workdir/cov.tmp" 2>/dev/null | grep -c '→ BL-' || true)
    cov_excl=$(grep -E "^- \*\*${m}\*\*[[:space:]]" "$workdir/cov.tmp" 2>/dev/null | grep -c '→ EXCLUDED:' || true)
    cov_orph=$(grep -E "^- \*\*${m}\*\*[[:space:]]" "$workdir/cov.tmp" 2>/dev/null | grep -c '→ ORPHAN' || true)
    [ "$cov_total" -gt 0 ] && rollup_any=true
    rollup_lines="${rollup_lines}- **${m} — ${MOD_NAME[$m]}:** ${cov_bl}/${cov_total} capability bullets covered; ${cov_excl} excluded; ${cov_orph} orphaned$(quality_suffix_for "$m")
"
  done
  rm -f "$workdir/cov.tmp"

  local quality_note=""
  if [ -f "$quality_json" ] && command -v jq >/dev/null 2>&1; then
    local high_mods
    high_mods="$(jq -r '[.modules[]? | select(.rollup_status == "HIGH") | .module_id] | join(", ")' "$quality_json" 2>/dev/null || true)"
    if [ -n "$high_mods" ]; then
      quality_note="
Modules measured HIGH on at least one code-quality dimension warrant extra rebuild attention — their legacy implementation is the hardest to read, so it is the easiest to reproduce a bug from or to under-scope: ${high_mods}."
    fi
  fi
  if $rollup_any; then
    coverage_check="${coverage_check}

### Module Coverage Rollup

_Bash-computed by counting the per-module capability-coverage lines above. Bullet granularity is unchanged — every bullet is still accounted for individually; this only rolls those counts up per module._

${rollup_lines}${quality_note}"
  else
    coverage_check="${coverage_check}

### Module Coverage Rollup

_Not computable — the Coverage Check above carries no per-module coverage lines in the countable form \`- **MOD-### ** — \"<bullet>\" → BL-0## | EXCLUDED: <reason> | ORPHAN\`. Re-run \`/specclaw:bf-rebuild-plan --refresh\` so the planner agent re-emits it; reporting 0/0 here would read as \"nothing to cover\", which is a different claim entirely._"
  fi

  # ── UI Screen Coverage (bash-computed, appended to the Coverage Check).
  # Bullet-granularity, same principle as the capability coverage above: a
  # screen is either cited by at least one active backlog item, or
  # explicitly excluded with a stated reason. Silence is a defect, and it is
  # reported as one rather than left for a reader to notice. Only rendered
  # when a decided FAITHFUL/THEME-ONLY policy makes screens part of the
  # acceptance basis and ui-inventory.md actually exists. ─────────────────
  if $screen_mapping_required && [ -f "$ui_inventory" ]; then
    local scr_cov="" unmapped="" scr_count=0
    for sid in $scr_all; do
      scr_count=$((scr_count+1))
      local citing=""
      for id in $ordered_ids; do
        [[ ",${ITEM_SCRS[$id]:-}," == *",${sid},"* ]] && citing="${citing}${citing:+, }${id}"
      done
      if [ -n "$citing" ]; then
        scr_cov="${scr_cov}- **${sid}** — ${SCR_TITLE[$sid]:-} → ${citing}
"
      elif [ -n "${SCR_OOS[$sid]:-}" ]; then
        scr_cov="${scr_cov}- **${sid}** — ${SCR_TITLE[$sid]:-} → out of scope: ${SCR_OOS[$sid]}
"
      else
        scr_cov="${scr_cov}- **${sid}** — ${SCR_TITLE[$sid]:-} → ⚠ not cited by any active backlog item, and not listed as out of scope
"
        unmapped="${unmapped}${unmapped:+, }${sid}"
      fi
    done
    [ -n "$scr_cov" ] || scr_cov="_No SCR-### entries found in ui-inventory.md._
"
    coverage_check="${coverage_check}

### UI Screen Coverage (SCR)

_Bash-computed from .specclaw/ui/ui-inventory.md against every active item's own SCR-### citations (plus this run's SCR-OUT-OF-SCOPE directives). ${scr_count} screen(s) under UI fidelity policy ${fidelity_policy}._

${scr_cov}
**Unmapped:** ${unmapped:-none}"
    if [ -n "$unmapped" ]; then
      warn "UI screen coverage gap — no active backlog item cites: ${unmapped} (and no SCR-OUT-OF-SCOPE reason was given for them)"
    fi
  fi

  # ── Archive prior file, render, write ────────────────────────────────────
  if [ -f "$backlog_file" ]; then
    mkdir -p "$archive_dir"
    mv "$backlog_file" "$archive_dir/$(date +%Y-%m-%d-%H%M%S)-rebuild-backlog.md"
  fi

  local title_val date_str template_file doc
  title_val="$(project_title "$project_root")"
  date_str="$(date +%Y-%m-%d)"
  template_file="$SCRIPT_DIR/../templates/rebuild-backlog.md"

  doc="$(cat "$template_file")"
  doc="$(substitute "$doc" '{{title}}' "$title_val")"
  doc="$(substitute "$doc" '{{path}}' ".")"
  doc="$(substitute "$doc" '{{date}}' "$date_str")"
  doc="$(substitute "$doc" '{{status_header}}' "$status_header")"
  doc="$(substitute "$doc" '{{backlog_items}}' "$backlog_body")"
  doc="$(substitute "$doc" '{{sequencing_rationale}}' "$sequencing_rationale")"
  doc="$(substitute "$doc" '{{coverage_check}}' "$coverage_check")"
  doc="$(substitute "$doc" '{{deferred_items}}' "$deferred_body")"
  doc="$(substitute "$doc" '{{change_report}}' "$change_report")"
  doc="$(substitute "$doc" '{{stub_retirement}}' "$stub_retirement")"
  doc="$(substitute "$doc" '{{item_splits}}' "$item_splits_block")"

  printf '%s\n' "$doc" > "$backlog_file"
  rm -f "$draft_file"
  rm -rf "$workdir"

  echo "Wrote $backlog_file ($(echo "$active_ids" | wc -w | tr -d ' ') active item(s) across $(echo "$mod_ids" | wc -w | tr -d ' ') module(s), ${#STRIKE_REASON[@]} struck, ${#DEFER_REASON[@]} deferred; per-module item counts: ${mod_item_counts:-none}; recommended next module: ${recommended_module:-none})" >&2
}

# ─── Subcommand: module-status ───────────────────────────────────────────────
#
# A read-only status VIEW. Writes exactly one file
# (.specclaw/analysis/module-status.md), reads everything else, and computes
# every number from artifacts that are themselves archived — so it is
# deliberately EXEMPT from archive-then-replace and regenerated in full on
# every invocation. See templates/module-status.md's own comment for why, and
# for the column definitions.

cmd_module_status() {
  local specclaw_dir="$1"
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"

  local specclaw_dir_abs project_root analysis_dir baseline_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  analysis_dir="$specclaw_dir_abs/analysis"
  baseline_dir="$specclaw_dir_abs/baseline"

  local map_file="$analysis_dir/module-map.md"
  [ -f "$map_file" ] || die "No .specclaw/analysis/module-map.md found — there are no modules to report a status for. Run /specclaw:bf-domain first."

  local backlog_file="$analysis_dir/rebuild-backlog.md"
  local scenarios_file="$baseline_dir/scenarios.md"
  local manifest_file="$baseline_dir/manifest.json"
  local pq_file="$analysis_dir/pending-questions.md"
  local clar_file="$analysis_dir/clarifications.md"

  local workdir; workdir="$(mktemp -d)"
  mkdir -p "$workdir/mods" "$workdir/items" "$workdir/scen" "$workdir/cqs"

  # ── Modules ──────────────────────────────────────────────────────────────
  local map_status; map_status="$(read_module_map_status "$map_file")"
  split_blocks "$map_file" "$workdir/mods" "MOD"
  declare -A MS_NAME MS_DEPS
  MS_NAME[__init__]=1; unset 'MS_NAME[__init__]'
  MS_DEPS[__init__]=1; unset 'MS_DEPS[__init__]'
  local mod_ids="" f id
  for f in "$workdir/mods"/MOD-*.md; do
    [ -f "$f" ] || continue
    id="$(block_id "$f")"
    MS_NAME[$id]="$(block_title_after_dash "$f")"
    case "${MS_NAME[$id]}" in WITHDRAWN*) continue ;; esac
    MS_DEPS[$id]="$(mod_depends_on_ids "$(block_single_field "$f" "Depends on")")"
    mod_ids="${mod_ids} ${id}"
  done

  # ── Backlog items per module: active / struck / deferred ─────────────────
  declare -A MS_PLANNED MS_TOTAL ITEM_MODULE MS_QUALITY
  MS_QUALITY[__init__]=1; unset 'MS_QUALITY[__init__]'
  local m unassigned_n=0
  for m in $mod_ids; do MS_PLANNED[$m]=0; MS_TOTAL[$m]=0; done
  if [ -f "$backlog_file" ]; then
    split_blocks "$backlog_file" "$workdir/items" "BL"
    local itemmod title status
    for f in "$workdir/items"/BL-*.md; do
      [ -f "$f" ] || continue
      title="$(block_title_after_dash "$f")"
      itemmod="$(printf '%s' "$(block_single_field "$f" "Module")" | { grep -oE 'MOD-[0-9]{3}' | head -1; } || true)"
      if [ -z "$itemmod" ] || [[ " ${mod_ids} " != *" ${itemmod} "* ]]; then
        unassigned_n=$((unassigned_n + 1))
        continue
      fi
      ITEM_MODULE[$(block_id "$f")]="$itemmod"
      # A module's quality remediation item, read off the item's own declared
      # type and computed **Quality state:** — never re-derived here. This view
      # computes no verdict of its own; it reports the one rebuild-backlog.md
      # already computed from quality-delta.json.
      if grep -qE '^\*\*Item type:\*\* QUALITY-REMEDIATION' "$f"; then
        MS_QUALITY[$itemmod]="$(printf '%s' "$(block_single_field "$f" "Quality state")" | awk '{print $1}')"
        MS_QUALITY[$itemmod]="${MS_QUALITY[$itemmod]:-OPEN}"
      fi
      status="active"
      grep -qE '^\*\*Status:\*\* Deferred' "$f" && status="deferred"
      [[ "$title" == STRUCK* ]] && status="struck"
      MS_TOTAL[$itemmod]=$(( MS_TOTAL[$itemmod] + 1 ))
      [ "$status" = "active" ] && MS_PLANNED[$itemmod]=$(( MS_PLANNED[$itemmod] + 1 ))
    done
  fi

  # ── Scenarios per module: designed / captured ────────────────────────────
  # A cross-module scenario counts under EVERY module it declares — the same
  # rule /specclaw:bf-replay applies — so these columns deliberately do not
  # sum to the corpus total.
  declare -A MS_DESIGNED MS_CAPTURED
  for m in $mod_ids; do MS_DESIGNED[$m]=0; MS_CAPTURED[$m]=0; done
  local captured_ids=""
  if [ -f "$manifest_file" ] && command -v jq &>/dev/null; then
    captured_ids=" $({ jq -r '.fixtures[].scenario_id' "$manifest_file" 2>/dev/null | tr -d '\r' | paste -sd' ' -; } || true) "
  fi
  if [ -f "$scenarios_file" ]; then
    split_blocks "$scenarios_file" "$workdir/scen" "GM"
    local smods stitle tok
    for f in "$workdir/scen"/GM-*.md; do
      [ -f "$f" ] || continue
      id="$(block_id "$f")"
      stitle="$(head -1 "$f" | sed -E 's/^### GM-[0-9]+[[:space:]]*(—|-)[[:space:]]*//')"
      case "$stitle" in WITHDRAWN*) continue ;; esac
      smods="$(printf '%s' "$(block_single_field "$f" "Modules")" | { grep -oE 'MOD-[0-9]{3}' | awk '!seen[$0]++' | paste -sd, -; } || true)"
      [ -n "$smods" ] || continue
      while IFS= read -r tok; do
        [ -z "$tok" ] && continue
        [[ " ${mod_ids} " == *" ${tok} "* ]] || continue
        MS_DESIGNED[$tok]=$(( MS_DESIGNED[$tok] + 1 ))
        [[ "$captured_ids" == *" ${id} "* ]] && MS_CAPTURED[$tok]=$(( MS_CAPTURED[$tok] + 1 ))
      done < <(printf '%s\n' "$smods" | tr ',' '\n')
    done
  fi

  # ── Latest module-scoped replay verdict per module ────────────────────────
  # Only a --module run records which module it covered (run-metadata.json's
  # own "module" field). A change-scoped or --all run exercises a module's
  # fixtures and its report carries a per-module rollup, but it records no
  # per-module verdict in metadata — so it is reported as absent here rather
  # than borrowing a corpus verdict and presenting it as the module's own.
  declare -A MS_VERDICT MS_VDATE
  if command -v jq &>/dev/null; then
    local meta mmod mverdict mdate mrun
    while IFS= read -r meta; do
      [ -f "$meta" ] || continue
      mmod="$(jq -r '.module // ""' "$meta" 2>/dev/null | tr -d '\r' || true)"
      # An explicit conditional, not `[ … ] && [ … ] || continue`: that form
      # reads as if-then-else but runs the `||` branch whenever EITHER test
      # fails, which is what is wanted here and therefore exactly the
      # ambiguity shellcheck flags (SC2015). Same semantics, stated plainly —
      # skip this run when it recorded no module (a change-scoped or --all
      # run) or when jq handed back the literal string "null".
      if [ -z "$mmod" ] || [ "$mmod" = "null" ]; then continue; fi
      mverdict="$(jq -r '.overall_verdict // "?"' "$meta" 2>/dev/null | tr -d '\r' || true)"
      mdate="$(jq -r '.date // "?"' "$meta" 2>/dev/null | tr -d '\r' || true)"
      mrun="$(jq -r '.run_id // "?"' "$meta" 2>/dev/null | tr -d '\r' || true)"
      # run_id is a sortable timestamp; the newest wins.
      if [ -z "${MS_VDATE[$mmod]:-}" ] || [[ "$mrun" > "${MS_VDATE[$mmod]}" ]]; then
        MS_VDATE[$mmod]="$mrun"
        MS_VERDICT[$mmod]="${mverdict} (${mdate})"
      fi
    done < <(find "$specclaw_dir_abs/replay/evidence" "$specclaw_dir_abs/changes" \
                -type f -name run-metadata.json 2>/dev/null || true)
  fi

  # ── Stub taint per module (CONTRACT.md (m.3)) ────────────────────────────
  #
  # "How many of this module's items have a LATEST verdict that was earned
  # while a bypass stub was standing in for something?"
  #
  # LATEST is the load-bearing word, and it is why this reads bl_items_covered
  # rather than only stub_tainted_items: an item tainted in March and re-run
  # clean in April is no longer tainted, and a column that could not see the
  # April run would keep reporting the March one forever. So for each item,
  # find the newest run that COVERED it (run_id is a sortable timestamp), then
  # ask whether that particular run tainted it.
  #
  # Unlike the verdict column, this counts runs at EVERY scope — change,
  # module, and --all. A change-scoped run records no per-module verdict, but
  # it does record exactly which items it exercised and which of those rested
  # on a stub, and that is a per-item fact no scope distorts.
  declare -A ITEM_LATEST_RUN ITEM_LATEST_TAINTED
  if command -v jq &>/dev/null; then
    local meta mrun line bl
    while IFS= read -r meta; do
      [ -f "$meta" ] || continue
      mrun="$(jq -r '.run_id // ""' "$meta" 2>/dev/null | tr -d '\r' || true)"
      [ -n "$mrun" ] || continue
      while IFS=$'\t' read -r bl tainted; do
        [ -z "$bl" ] && continue
        if [ -z "${ITEM_LATEST_RUN[$bl]:-}" ] || [[ "$mrun" > "${ITEM_LATEST_RUN[$bl]}" ]]; then
          ITEM_LATEST_RUN[$bl]="$mrun"
          ITEM_LATEST_TAINTED[$bl]="$tainted"
        fi
      # `tr -d '\r'`, as everywhere else jq output is read here: this
      # toolchain's jq writes CRLF, which would otherwise land a literal
      # carriage return inside the flag and make every equality test fail
      # silently — the count reads 0 and nothing looks wrong.
      # The item is bound to $b before the membership test: inside
      # `$t | index(.)` the `.` would rebind to $t itself, which is truthy
      # whenever $t is non-empty and would mark every covered item tainted.
      done < <(jq -r '
        (.stub_tainted_items // []) as $t
        | (.bl_items_covered // .stub_tainted_items // [])[] as $b
        | $b + "\t" + (if ($t | index($b)) then "1" else "0" end)
      ' "$meta" 2>/dev/null | tr -d '\r' || true)
    done < <(find "$specclaw_dir_abs/replay/evidence" "$specclaw_dir_abs/changes" \
                -type f -name run-metadata.json 2>/dev/null || true)
  fi

  declare -A MS_TAINTED
  for m in $mod_ids; do MS_TAINTED[$m]=0; done
  local bl_id
  for bl_id in "${!ITEM_LATEST_TAINTED[@]}"; do
    [ "${ITEM_LATEST_TAINTED[$bl_id]}" = "1" ] || continue
    local owner="${ITEM_MODULE[$bl_id]:-}"
    [ -n "$owner" ] || continue
    MS_TAINTED[$owner]=$(( MS_TAINTED[$owner] + 1 ))
  done

  # ── Partially-built items per module (CONTRACT.md (o)) ───────────────────
  # A different question from the tainted count beside it. Tainted asks "was
  # what this module was measured against real?"; this asks "is this module's
  # work even finished?" — a module can be entirely untainted and still be
  # carrying three items that are each missing a layer.
  declare -A MS_PARTIAL
  local ms_split_rows=""
  for m in $mod_ids; do MS_PARTIAL[$m]=0; done
  local splits_file_ms; splits_file_ms="$(splits_file_path "$specclaw_dir_abs")"
  if [ -f "$splits_file_ms" ]; then
    mkdir -p "$workdir/splits"
    split_blocks "$splits_file_ms" "$workdir/splits" "IS"
    local isf isid isitem isstat isowner
    for isf in "$workdir/splits"/IS-*.md; do
      [ -f "$isf" ] || continue
      isstat="$(split_status_of "$(block_single_field "$isf" "Status")")"
      case "$isstat" in ACTIVE|READY-TO-RESUME) ;; *) continue ;; esac
      isid="$(block_id "$isf")"
      isitem="$(printf '%s' "$(block_single_field "$isf" "Item")" | { grep -oE 'BL-[0-9]{3}' | head -1; } || true)"
      [ -n "$isitem" ] || continue
      isowner="${ITEM_MODULE[$isitem]:-}"
      [ -n "$isowner" ] && MS_PARTIAL[$isowner]=$(( ${MS_PARTIAL[$isowner]:-0} + 1 ))
      ms_split_rows="${ms_split_rows}| ${isid} | ${isowner:-unassigned} | ${isitem} | ${isstat} | $(block_single_field "$isf" "Deferred") | $(block_single_field "$isf" "Blocked until") |
"
    done
  fi

  # ── Which stubs fake THIS module for other people's items ────────────────
  # The "who is waiting on the real MOD-005" lookup, in one place. An entry
  # substitutes this module when it names the MOD-### directly, or names a
  # BL item this module owns.
  declare -A MS_FAKED_BY
  local stub_rows="" unbuilt_note_items=""
  local stubs_file; stubs_file="$(stubs_file_path "$specclaw_dir_abs")"
  if [ -f "$stubs_file" ]; then
    mkdir -p "$workdir/stubs"
    split_blocks "$stubs_file" "$workdir/stubs" "ST"
    local sid sstatus ssubs sstrat scons schosen starget consumer
    for f in "$workdir/stubs"/ST-*.md; do
      [ -f "$f" ] || continue
      sid="$(block_id "$f")"
      sstatus="$(stub_status_of "$(block_single_field "$f" "Status")")"
      [ "$sstatus" = "ACTIVE" ] || continue
      ssubs="$(block_single_field "$f" "Substitutes")"
      sstrat="$(block_single_field "$f" "Strategy")"
      scons="$(block_single_field "$f" "Consumed by")"
      schosen="$(block_single_field "$f" "Chosen by")"
      # Which module this entry stands in for: the MOD-### it names, else the
      # module owning the BL item it names. Never guessed from anything else.
      starget="$(printf '%s' "$ssubs" | { grep -oE 'MOD-[0-9]{3}' | head -1; } || true)"
      if [ -z "$starget" ]; then
        local subs_bl; subs_bl="$(printf '%s' "$ssubs" | { grep -oE 'BL-[0-9]{3}' | head -1; } || true)"
        [ -n "$subs_bl" ] && starget="${ITEM_MODULE[$subs_bl]:-}"
      fi
      [ -n "$starget" ] || starget="—"
      MS_FAKED_BY[$starget]="${MS_FAKED_BY[$starget]:-}${MS_FAKED_BY[$starget]:+, }${sid}"
      stub_rows="${stub_rows}| ${sid} | ${starget} | ${ssubs} | ${sstrat} | ${scons} | ${schosen} |
"
      # An item consuming an ACTIVE stub that no run has ever exercised is a
      # different state from a tainted verdict — there is no verdict at all —
      # and rounding it into the count would overstate what has been checked.
      for consumer in $(printf '%s' "$scons" | tr ',' ' '); do
        case "$consumer" in BL-[0-9][0-9][0-9]) ;; *) continue ;; esac
        [ -n "${ITEM_LATEST_RUN[$consumer]:-}" ] && continue
        case " ${unbuilt_note_items} " in *" ${consumer} "*) ;; *) unbuilt_note_items="${unbuilt_note_items}${unbuilt_note_items:+ }${consumer}" ;; esac
      done
    done
  fi

  # ── Open questions naming a module ───────────────────────────────────────
  declare -A MS_QS
  for m in $mod_ids; do MS_QS[$m]=0; done
  if [ -f "$pq_file" ]; then
    local pqwork; pqwork="$(mktemp -d)"
    awk -v dir="$pqwork" '
      /^### PQ-[0-9]+/ { match($0, /PQ-[0-9]+/); id = substr($0, RSTART, RLENGTH); outfile = dir "/" id ".md" }
      id != "" { print $0 >> outfile }
    ' "$pq_file"
    for f in "$pqwork"/PQ-*.md; do
      [ -f "$f" ] || continue
      grep -qE '^- \*\*Status:\*\* OPEN' "$f" || continue
      for m in $mod_ids; do
        grep -qF "$m" "$f" && MS_QS[$m]=$(( MS_QS[$m] + 1 ))
      done
    done
    rm -rf "$pqwork"
  fi
  if [ -f "$clar_file" ]; then
    split_blocks "$clar_file" "$workdir/cqs" "CQ"
    local answer_txt
    for f in "$workdir/cqs"/CQ-*.md; do
      [ -f "$f" ] || continue
      answer_txt="$(awk '
        /^- \*\*Answer:\*\*/ { sub(/^- \*\*Answer:\*\* */, ""); capturing=1; buf=$0; next }
        /^- \*\*Decided by:\*\*/ { capturing=0 }
        capturing { buf = buf "\n" $0; next }
        END { print buf }
      ' "$f" | tr -d '[:space:]')"
      [ -n "$answer_txt" ] && continue
      for m in $mod_ids; do
        grep -qF "$m" "$f" && MS_QS[$m]=$(( MS_QS[$m] + 1 ))
      done
    done
  fi

  # ── Render ───────────────────────────────────────────────────────────────
  local rows="" deps verdict_cell tainted_cell partial_cell quality_cell
  for m in $mod_ids; do
    deps="${MS_DEPS[$m]:-}"
    [ -n "$deps" ] && deps="${deps//,/, }" || deps="none"

    # PASSED* is the whole point of this column pair: a module holding an item
    # whose latest verdict rested on a stub has not been shown to work — part
    # of what it was checked against was a placeholder. The asterisk and the
    # count travel together so neither can be read without the other.
    verdict_cell="${MS_VERDICT[$m]:-no module-scoped run}"
    if [ "${MS_TAINTED[$m]}" -gt 0 ] && [ -n "${MS_VERDICT[$m]:-}" ]; then
      verdict_cell="${verdict_cell/PASS/PASS\*}"
    fi
    if [ "${MS_TAINTED[$m]}" -gt 0 ]; then
      tainted_cell="⚠ ${MS_TAINTED[$m]}"
    else
      tainted_cell="0"
    fi
    # A different axis from the one beside it: tainted asks whether what this
    # module was measured against was real, partial asks whether its work is
    # even finished. A module can be wholly untainted and still be carrying
    # items that are each missing a layer.
    if [ "${MS_PARTIAL[$m]:-0}" -gt 0 ]; then
      partial_cell="⚠ ${MS_PARTIAL[$m]}"
    else
      partial_cell="0"
    fi

    # A module carrying an unfinished quality remediation item is not a
    # finished module, and this column is the only place that shows up as a
    # per-module fact. "—" means no such item exists (the normal state of a
    # project that has never run /specclaw:bf-quality), which is a different
    # thing from one that exists and has not passed.
    quality_cell="${MS_QUALITY[$m]:-—}"
    case "$quality_cell" in
      BLOCKED|OPEN) quality_cell="⚠ ${quality_cell}" ;;
    esac

    rows="${rows}| ${m} | ${MS_NAME[$m]} | ${deps} | ${MS_PLANNED[$m]}/${MS_TOTAL[$m]} | ${MS_CAPTURED[$m]}/${MS_DESIGNED[$m]} | ${verdict_cell} | ${tainted_cell} | ${partial_cell} | ${quality_cell} | ${MS_QS[$m]} |
"
  done
  [ -n "$rows" ] || rows="| — | _No active modules in module-map.md._ | — | — | — | — | — | — | — | — |
"

  local table="| Module | Name | Depends on | Backlog items (planned/total) | Scenarios (captured/designed) | Latest replay verdict | Stub-tainted items | Partially built items | Quality remediation | Open questions |
|---|---|---|---|---|---|---|---|---|---|
${rows}"

  # ── Stubs In Effect By Module ────────────────────────────────────────────
  local stubs_section
  if [ -n "$stub_rows" ]; then
    stubs_section="| Stub | Fakes module | Substitutes | Strategy | Consumed by (items waiting on the real thing) | Chosen by |
|---|---|---|---|---|---|
${stub_rows}"
    if [ -n "$unbuilt_note_items" ]; then
      stubs_section="${stubs_section}
> **${unbuilt_note_items// /, }** consume an ACTIVE stub but no retained replay run has ever exercised them, so they carry no verdict at all — tainted or otherwise. They are counted in no column above: \"not yet checked\" is a different state from \"checked against a placeholder\", and rounding one into the other would overstate what has been verified."
    fi
  else
    stubs_section="_None — no active dependency bypass stubs. Every module is being built on the real modules it depends on._"
  fi

  # ── Item Splits By Module ────────────────────────────────────────────────
  local splits_section
  if [ -n "$ms_split_rows" ]; then
    splits_section="| Split | Module | Item | Status | Deferred | Blocked until |
|---|---|---|---|---|---|
${ms_split_rows}"
  else
    splits_section="_None — no backlog item is carrying deferred scope. Every item is being built whole._"
  fi

  local unassigned_note=""
  if [ "$unassigned_n" -gt 0 ]; then
    unassigned_note="> ⚠ **${unassigned_n} active backlog item(s) declare no usable module** and are counted in no row above — they have no \`**Module:**\` field, or one naming a module \`module-map.md\` does not define. See \`rebuild-backlog.md\`'s own \`## Unassigned\` group; they are never distributed into a module by guesswork."
  fi

  local notes=""
  case "$map_status" in
    CONFIRMED*) ;;
    *) notes="${notes}- **The module map is not confirmed** (\`${map_status:-<missing>}\`). Every boundary below rests on a proposal no human has signed off — confirm it by editing \`module-map.md\`'s \`**Status:**\` line.
" ;;
  esac
  [ -f "$backlog_file" ] || notes="${notes}- \`rebuild-backlog.md\` does not exist — backlog columns read 0/0. Run \`/specclaw:bf-rebuild-plan\`.
"
  [ -f "$scenarios_file" ] || notes="${notes}- \`baseline/scenarios.md\` does not exist — scenario columns read 0/0. Run \`/specclaw:bf-baseline\`.
"
  [ -f "$manifest_file" ] || notes="${notes}- \`baseline/manifest.json\` does not exist — nothing is captured yet. Run the harness, then \`/specclaw:bf-baseline --record\`.
"
  notes="${notes}- A verdict here covers only **module-scoped** replay runs that retained evidence. A change-scoped or \`--all\` run exercises a module's fixtures too, but records no per-module verdict in its metadata — read that run's report's own **Module Rollup** section instead. The **Stub-tainted items** column has no such limitation: it counts runs at every scope, because which items a run exercised and which of those rested on a stub is a per-item fact no scope distorts.
- No number here says a module is *done*: specclaw records no built state for a backlog item, so these are planning, capture, and comparison coverage only."
  local total_partial=0
  for m in $mod_ids; do total_partial=$(( total_partial + ${MS_PARTIAL[$m]:-0} )); done
  if [ "$total_partial" -gt 0 ]; then
    notes="${notes}
- **A partially built item is not a built item.** ${total_partial} item(s) had part of their scope deliberately deferred under an \`IS-###\` split, and the remainder has not landed. A \`/specclaw:bf-replay --item\` run for one of those reports PARTIAL and is not that item's final acceptance. This is a different question from stub taint: taint asks whether what was measured was real, this asks whether the item is finished at all."
  fi
  local total_quality_open=0
  for m in $mod_ids; do
    case "${MS_QUALITY[$m]:-}" in BLOCKED|OPEN) total_quality_open=$(( total_quality_open + 1 )) ;; esac
  done
  if [ "$total_quality_open" -gt 0 ]; then
    notes="${notes}
- **A module with an open quality remediation item is not a done module.** ${total_quality_open} module(s) carry a \`QUALITY-REMEDIATION\` backlog item whose measured acceptance has not been met — either its functional items are not built yet (\`BLOCKED\`) or the rebuilt module has not measured within thresholds without regressing (\`OPEN\`). That verdict is computed in \`rebuild-backlog.md\` from \`.specclaw/analysis/quality-delta.json\`, never here, and it is cleared by re-measuring the target (\`/specclaw:bf-quality --target\`, then \`--compare\`) — never by editing either document."
  fi
  local total_tainted=0
  for m in $mod_ids; do total_tainted=$(( total_tainted + MS_TAINTED[$m] )); done
  if [ "$total_tainted" -gt 0 ]; then
    notes="${notes}
- **A \`PASS*\` is not a PASS you can act on.** ${total_tainted} item(s) have a latest verdict earned while a bypass stub stood in for a module that is not built yet. The comparison ran and matched; part of what it matched against was a placeholder. Those items are re-replayed when the real module lands, and the asterisk clears then — see the stub table below for which stub, and \`.specclaw/analysis/rebuild-backlog.md\`'s **Stub Retirement** section for what it takes to clear each one."
  fi

  local template_file="$SCRIPT_DIR/../templates/module-status.md"
  [ -f "$template_file" ] || die "Template missing: ${template_file}"
  local doc
  doc="$(cat "$template_file")"
  doc="$(substitute "$doc" '{{title}}' "$(project_title "$project_root")")"
  doc="$(substitute "$doc" '{{date}}' "$(date +%Y-%m-%d)")"
  doc="$(substitute "$doc" '{{map_status}}' "${map_status:-<status line missing>}")"
  doc="$(substitute "$doc" '{{module_table}}' "$table")"
  doc="$(substitute "$doc" '{{unassigned_note}}' "$unassigned_note")"
  doc="$(substitute "$doc" '{{stubs_by_module}}' "$stubs_section")"
  doc="$(substitute "$doc" '{{splits_by_module}}' "$splits_section")"
  doc="$(substitute "$doc" '{{notes}}' "$notes")"

  local out_file="$analysis_dir/module-status.md"
  printf '%s\n' "$doc" > "$out_file"
  rm -rf "$workdir"

  echo "Wrote $out_file ($(echo "$mod_ids" | wc -w | tr -d ' ') module(s)${unassigned_n:+, ${unassigned_n} unassigned item(s)}). Status view — regenerated in full every run, never archived." >&2
}

# ─── Subcommand: bypass-check ────────────────────────────────────────────────
#
# Answers ONE question for /specclaw:propose, mechanically: does this backlog
# item depend on anything that is not there yet, and if so, what kind of
# not-there is it?
#
# It decides nothing. It never picks a strategy, never writes a registry
# entry, and never concludes that a bypass is warranted — those are human acts
# (CONTRACT.md (m.2)). All it does is turn "Depends on: BL-014, BL-019" into a
# per-dependency classification a human can be asked about.
#
# INERT BY DEFAULT. No backlog, or no resolvable BL id, exits 0 with
# {"applicable": false} — /specclaw:propose then behaves exactly as it always
# has. A greenfield project never sees any of this.

cmd_bypass_check() {
  local specclaw_dir="$1"; shift
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"

  local want_id="" want_title=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --title) want_title="${2:-}"; shift 2 ;;
      BL-[0-9][0-9][0-9]) want_id="$1"; shift ;;
      *) die "bypass-check: unrecognized argument '$1'. Usage: bypass-check <specclaw_dir> <BL-###|--title \"<item title>\">" ;;
    esac
  done
  [ -n "$want_id" ] || [ -n "$want_title" ] || \
    die "bypass-check: give either a BL-### id or --title \"<item title>\"."

  local specclaw_dir_abs analysis_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  analysis_dir="$specclaw_dir_abs/analysis"
  local backlog_file="$analysis_dir/rebuild-backlog.md"
  local stubs_file; stubs_file="$(stubs_file_path "$specclaw_dir_abs")"

  # ── Inert path 1: no backlog at all. Not an error — this is what every
  # non-brownfield project looks like. ──────────────────────────────────────
  if [ ! -f "$backlog_file" ]; then
    emit_json "{\"applicable\": false, \"reason\": \"no rebuild-backlog.md — this project has no module dependency graph, so there is nothing to bypass\", \"dependencies\": [], \"splits\": [], \"next_stub_id\": null, \"next_split_id\": null}"
    return 0
  fi

  local workdir; workdir="$(mktemp -d)"
  # shellcheck disable=SC2064  # expand workdir now, not at trap time
  trap "rm -rf '$workdir'" RETURN
  mkdir -p "$workdir/items" "$workdir/stubs"
  split_blocks "$backlog_file" "$workdir/items" "BL"

  # ── Resolve the item ─────────────────────────────────────────────────────
  # An id is taken at its word. A title is matched — exactly first, then by
  # substring — and AMBIGUITY IS REPORTED, never broken by picking the first
  # candidate. Guessing which item is being proposed would attach a bypass to
  # the wrong item's dependency graph, which is worse than asking.
  local item_id="" f id t norm_want norm_t
  if [ -n "$want_id" ]; then
    if [ -f "$workdir/items/${want_id}.md" ]; then
      item_id="$want_id"
    else
      emit_json "{\"applicable\": false, \"reason\": \"$(json_escape "${want_id} is not an item in rebuild-backlog.md")\", \"dependencies\": [], \"splits\": [], \"next_stub_id\": null, \"next_split_id\": null}"
      return 0
    fi
  else
    norm_want="$(printf '%s' "$want_title" | tr '[:upper:]' '[:lower:]' | tr -s '[:space:]' ' ' | sed -E 's/^ | $//g')"
    local exact="" partial="" partial_n=0
    for f in "$workdir/items"/BL-*.md; do
      [ -f "$f" ] || continue
      id="$(block_id "$f")"
      t="$(block_title_after_dash "$f")"
      case "$t" in STRUCK*) continue ;; esac
      norm_t="$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]' | tr -s '[:space:]' ' ' | sed -E 's/^ | $//g')"
      if [ "$norm_t" = "$norm_want" ]; then exact="$id"; break; fi
      case "$norm_t" in *"$norm_want"*) partial="${partial}${partial:+, }${id}"; partial_n=$((partial_n + 1)) ;; esac
    done
    if [ -n "$exact" ]; then
      item_id="$exact"
    elif [ "$partial_n" -eq 1 ]; then
      item_id="$partial"
    elif [ "$partial_n" -gt 1 ]; then
      emit_json "{\"applicable\": false, \"reason\": \"$(json_escape "\"${want_title}\" matches more than one backlog item (${partial}) — re-run naming the BL-### id directly. Picking one would attach any bypass to the wrong item's dependencies.")\", \"dependencies\": [], \"splits\": [], \"next_stub_id\": null, \"next_split_id\": null}"
      return 0
    else
      emit_json "{\"applicable\": false, \"reason\": \"$(json_escape "\"${want_title}\" matches no active item in rebuild-backlog.md — this change is not backlog-driven, so no dependency check applies")\", \"dependencies\": [], \"splits\": [], \"next_stub_id\": null, \"next_split_id\": null}"
      return 0
    fi
  fi

  local item_file="$workdir/items/${item_id}.md"
  local item_title item_module item_deps
  item_title="$(block_title_after_dash "$item_file")"
  item_module="$(printf '%s' "$(block_single_field "$item_file" "Module")" | { grep -oE 'MOD-[0-9]{3}' | head -1; } || true)"
  item_deps="$(depends_on_ids "$(block_single_field "$item_file" "Depends on")")"

  # ── Parse the registry (absent = empty, silently) ────────────────────────
  # Indexed by the id each entry substitutes, so a dependency lookup is a
  # direct hit rather than a scan.
  declare -A STUB_STATUS STUB_SUBS STUB_CONSUMED STUB_STRATEGY
  local stub_ids=""
  if [ -f "$stubs_file" ]; then
    split_blocks "$stubs_file" "$workdir/stubs" "ST"
    for f in "$workdir/stubs"/ST-*.md; do
      [ -f "$f" ] || continue
      id="$(block_id "$f")"
      stub_ids="${stub_ids} ${id}"
      STUB_STATUS[$id]="$(stub_status_of "$(block_single_field "$f" "Status")")"
      STUB_SUBS[$id]="$(block_single_field "$f" "Substitutes")"
      STUB_CONSUMED[$id]="$(block_single_field "$f" "Consumed by")"
      STUB_STRATEGY[$id]="$(block_single_field "$f" "Strategy")"
    done
  fi

  # ── Parse the item-split registry, for THIS item (absent = empty) ────────
  #
  # This is what makes a re-proposal a RESUME instead of a fresh start. Before
  # this existed, re-running /specclaw:propose BL-010 behaved as though the
  # item had never been touched: it re-offered four bypass strategies for a
  # dependency an earlier split had already deliberately deferred, and nothing
  # anywhere recalled that part of the item was already built and merged.
  #
  # Every id in a non-COMPLETE split's `Blocked until` is also collected, so a
  # dependency the split already accounts for can be classified
  # deferred-by-split rather than re-elicited.
  local splits_file; splits_file="$(splits_file_path "$specclaw_dir_abs")"
  local splits_json="" split_first=true deferred_dep_ids=""
  local n_active_splits=0 n_ready_splits=0
  if [ -f "$splits_file" ]; then
    mkdir -p "$workdir/splits"
    split_blocks "$splits_file" "$workdir/splits" "IS"
    local sf sid sstatus sitem
    for sf in "$workdir/splits"/IS-*.md; do
      [ -f "$sf" ] || continue
      sid="$(block_id "$sf")"
      sitem="$(printf '%s' "$(block_single_field "$sf" "Item")" | { grep -oE 'BL-[0-9]{3}' | head -1; } || true)"
      [ "$sitem" = "$item_id" ] || continue
      sstatus="$(split_status_of "$(block_single_field "$sf" "Status")")"
      # A COMPLETE split is history, not a live constraint: its deferred scope
      # was built and the full item passed a clean --item run. Reporting it
      # would make propose narrate finished work as outstanding.
      [ "$sstatus" = "COMPLETE" ] && continue

      local s_blocked s_built s_unbuilt b
      s_blocked="$(normalize_id_list "$(block_single_field "$sf" "Blocked until")" 'BL-[0-9]{3}')"
      s_built=""; s_unbuilt=""
      for b in ${s_blocked//,/ }; do
        [ -z "$b" ] && continue
        deferred_dep_ids="${deferred_dep_ids} ${b}"
        if [ -f "$workdir/items/${b}.md" ] && built_signal_of "$workdir/items/${b}.md" >/dev/null 2>&1; then
          s_built="${s_built}${s_built:+, }${b}"
        else
          s_unbuilt="${s_unbuilt}${s_unbuilt:+, }${b}"
        fi
      done

      case "$sstatus" in
        ACTIVE)          n_active_splits=$((n_active_splits + 1)) ;;
        READY-TO-RESUME) n_ready_splits=$((n_ready_splits + 1)) ;;
      esac

      if $split_first; then split_first=false; else splits_json="${splits_json}, "; fi
      splits_json="${splits_json}{\"id\": \"${sid}\", \"status\": \"${sstatus}\", \"summary\": \"$(json_escape "$(block_title_after_dash "$sf")")\", \"reason\": \"$(json_escape "$(block_single_field "$sf" "Reason")")\", \"implemented_now\": \"$(json_escape "$(block_single_field "$sf" "Implemented now")")\", \"deferred\": \"$(json_escape "$(block_single_field "$sf" "Deferred")")\", \"rules_implemented\": [$(printf '%s' "$(block_single_field "$sf" "Rules implemented")" | { grep -oE 'DR-[0-9]{3}'; } | json_array_from_lines)], \"rules_deferred\": [$(printf '%s' "$(block_single_field "$sf" "Rules deferred")" | { grep -oE 'DR-[0-9]{3}'; } | json_array_from_lines)], \"layers_implemented\": \"$(json_escape "$(block_single_field "$sf" "Layers implemented")")\", \"layers_deferred\": \"$(json_escape "$(block_single_field "$sf" "Layers deferred")")\", \"blocked_until\": [$(printf '%s\n' "${s_blocked//,/$'\n'}" | json_array_from_lines)], \"blocked_until_built\": [$(printf '%s\n' "${s_built//, /$'\n'}" | json_array_from_lines)], \"blocked_until_unbuilt\": [$(printf '%s\n' "${s_unbuilt//, /$'\n'}" | json_array_from_lines)], \"resume_ready\": $([ -z "$s_unbuilt" ] && printf 'true' || printf 'false'), \"change\": \"$(json_escape "$(block_single_field "$sf" "Change")")\", \"evidence\": \"$(json_escape "$(block_single_field "$sf" "Evidence")")\", \"replay_evidence\": \"$(json_escape "$(block_single_field "$sf" "Replay evidence")")\", \"chosen_by\": \"$(json_escape "$(block_single_field "$sf" "Chosen by")")\"}"
    done
  fi

  # ── Classify each dependency ─────────────────────────────────────────────
  local deps_json="" first=true dep
  local n_needs=0 n_same=0 n_built=0 n_covered=0 n_unknown=0 n_deferred_split=0
  for dep in $(printf '%s' "$item_deps" | tr ',' ' '); do
    [ -z "$dep" ] && continue
    local dep_file="$workdir/items/${dep}.md"
    local dep_title="" dep_module="" dep_state="active" built_note="" action=""
    local stub_id="null" stub_status="null" stub_strategy="null"

    if [ ! -f "$dep_file" ]; then
      # A dangling dependency is a backlog integrity problem, not a bypass
      # decision. Reported so propose can surface it; never silently treated
      # as either satisfied or unmet.
      action="dependency-unknown"
      n_unknown=$((n_unknown + 1))
    else
      dep_title="$(block_title_after_dash "$dep_file")"
      dep_module="$(printf '%s' "$(block_single_field "$dep_file" "Module")" | { grep -oE 'MOD-[0-9]{3}' | head -1; } || true)"
      case "$dep_title" in STRUCK*) dep_state="struck" ;; esac
      grep -qE '^\*\*Status:\*\* Deferred' "$dep_file" && dep_state="deferred"
      built_note="$(built_signal_of "$dep_file" || true)"

      # Does an ACTIVE/RETIRING entry already substitute this dependency for
      # THIS item? Both halves matter: an entry faking BL-014 for BL-021 says
      # nothing about BL-030 also depending on BL-014.
      local s
      for s in $stub_ids; do
        case "${STUB_STATUS[$s]}" in ACTIVE|RETIRING) ;; *) continue ;; esac
        # Substring is sufficient and unambiguous: ids are fixed-width
        # (BL-014 can never be a prefix of another BL id), and the field's
        # shape is "BL-014 (MOD-005)" or a bare "MOD-007".
        case "${STUB_SUBS[$s]}" in
          *"${dep}"*) ;;
          *) continue ;;
        esac
        stub_id="\"${s}\""; stub_status="\"${STUB_STATUS[$s]}\""
        stub_strategy="\"$(json_escape "${STUB_STRATEGY[$s]}")\""
        case " ${STUB_CONSUMED[$s]//,/ } " in
          *" ${item_id} "*) action="covered-by-active-stub" ;;
          *) action="stub-exists-not-consumed" ;;
        esac
        break
      done

      if [ -z "$action" ]; then
        if [ "$dep_state" = "struck" ]; then
          action="dependency-struck"
        elif [ -n "$built_note" ]; then
          action="ok-built"
        elif [[ " ${deferred_dep_ids} " == *" ${dep} "* ]]; then
          # An active split ALREADY accounts for this dependency: the human
          # deliberately deferred the scope that needed it. Re-offering the
          # four bypass strategies here would ask them to decide again
          # something they already decided, and accepting a second answer
          # would produce two records of one deferral.
          action="deferred-by-split"
        elif [ -n "$item_module" ] && [ "$dep_module" = "$item_module" ]; then
          # NOT bypassable. A same-module dependency is the item's own
          # prerequisite, not a cross-boundary wait — stubbing it would be
          # stubbing part of the thing being built.
          action="same-module-prerequisite"
        else
          action="needs-bypass"
        fi
      fi
    fi

    case "$action" in
      needs-bypass|stub-exists-not-consumed) n_needs=$((n_needs + 1)) ;;
      same-module-prerequisite) n_same=$((n_same + 1)) ;;
      ok-built) n_built=$((n_built + 1)) ;;
      covered-by-active-stub) n_covered=$((n_covered + 1)) ;;
      deferred-by-split) n_deferred_split=$((n_deferred_split + 1)) ;;
    esac

    if $first; then first=false; else deps_json="${deps_json}, "; fi
    deps_json="${deps_json}{\"id\": \"${dep}\", \"title\": \"$(json_escape "$dep_title")\", \"module\": $([ -n "$dep_module" ] && printf '"%s"' "$dep_module" || printf 'null'), \"same_module\": $([ -n "$item_module" ] && [ "$dep_module" = "$item_module" ] && printf 'true' || printf 'false'), \"state\": \"${dep_state}\", \"built_signal\": \"$([ -n "$built_note" ] && printf 'declared' || printf 'unknown')\", \"built_note\": $([ -n "$built_note" ] && printf '"%s"' "$(json_escape "$built_note")" || printf 'null'), \"existing_stub\": ${stub_id}, \"existing_stub_status\": ${stub_status}, \"existing_stub_strategy\": ${stub_strategy}, \"action\": \"${action}\"}"
  done

  emit_json "{
  \"applicable\": true,
  \"item\": {\"id\": \"${item_id}\", \"title\": \"$(json_escape "$item_title")\", \"module\": $([ -n "$item_module" ] && printf '"%s"' "$item_module" || printf 'null'), \"screen_bearing\": $(item_is_screen_bearing "$item_file" && printf 'true' || printf 'false'), \"acceptance_basis_rules\": [$(extract_dr_ids "$item_file" | json_array_from_lines)]},
  \"dependencies\": [${deps_json}],
  \"splits\": [${splits_json}],
  \"summary\": {\"needs_bypass\": ${n_needs}, \"same_module_unmet\": ${n_same}, \"already_built\": ${n_built}, \"covered_by_active_stub\": ${n_covered}, \"unknown_dependency\": ${n_unknown}, \"deferred_by_split\": ${n_deferred_split}, \"active_splits\": ${n_active_splits}, \"splits_ready_to_resume\": ${n_ready_splits}},
  \"registry_exists\": $([ -f "$stubs_file" ] && printf 'true' || printf 'false'),
  \"split_registry_exists\": $([ -f "$splits_file" ] && printf 'true' || printf 'false'),
  \"next_stub_id\": \"$(next_stub_id "$stubs_file")\",
  \"next_split_id\": \"$(next_split_id "$splits_file")\"
}"
}

# ─── Subcommands: stub-append / stub-update ──────────────────────────────────
#
# Bash owns this file, exactly as it owns rebuild-backlog.md — for the same
# reason: an id-stable, append-only corpus is safer enforced deterministically
# than trusted to an LLM rewriting a whole document repeatedly.
#
# stub-append CREATES an entry (allocating the next id); stub-update EDITS
# named fields of an existing one in place. Neither ever rewrites the file
# wholesale, and nothing anywhere deletes an entry (CONTRACT.md (m.1)).

md_set_field() {
  # Replace a field's line inside ONE "### <id>" block of an append/update-in-
  # place registry, inserting it after the block's last field line when it isn't
  # there yet. Shared by module-stubs.md (ST-###) and item-splits.md (IS-###) —
  # one implementation, deliberately, because two lookalike field-setters that
  # disagreed about where a missing field gets inserted is exactly the silent
  # drift CONTRACT.md (g) keeps a single shared primitive to avoid. Value passed via the environment,
  # not `awk -v`, because -v applies backslash-escape processing and would
  # mangle a Windows path or any literal backslash in a citation.
  local file="$1" id="$2" label="$3" value="$4"
  local tmp; tmp="$(mktemp)"
  MD_FIELD_VALUE="$value" awk -v id="$id" -v label="$label" '
    function emit_block(   i, lastfield) {
      if (!done) {
        lastfield = 0
        for (i = 1; i <= n; i++) if (buf[i] ~ /^- \*\*/) lastfield = i
        if (lastfield == 0) lastfield = n
        for (i = 1; i <= n; i++) {
          print buf[i]
          if (i == lastfield) print "- **" label ":** " ENVIRON["MD_FIELD_VALUE"]
        }
      } else {
        for (i = 1; i <= n; i++) print buf[i]
      }
      n = 0
    }
    $0 ~ ("^### " id "([^0-9]|$)") { inblock = 1; n = 0; buf[++n] = $0; next }
    inblock && (/^### / || /^## /) { emit_block(); inblock = 0; print; next }
    inblock {
      if ($0 ~ ("^- \\*\\*" label ":\\*\\*")) { buf[++n] = "- **" label ":** " ENVIRON["MD_FIELD_VALUE"]; done = 1 }
      else buf[++n] = $0
      next
    }
    { print }
    END { if (inblock) emit_block() }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
}

cmd_stub_append() {
  local specclaw_dir="$1"; shift
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"

  local substitutes="" strategy="" consumed_by="" chosen_by="" summary=""
  local fakes="not yet implemented" implementation="not yet implemented" mock_seed=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --substitutes)    substitutes="${2:-}"; shift 2 ;;
      --strategy)       strategy="${2:-}"; shift 2 ;;
      --consumed-by)    consumed_by="${2:-}"; shift 2 ;;
      --chosen-by)      chosen_by="${2:-}"; shift 2 ;;
      --summary)        summary="${2:-}"; shift 2 ;;
      --fakes)          fakes="${2:-}"; shift 2 ;;
      --implementation) implementation="${2:-}"; shift 2 ;;
      --mock-seed)      mock_seed="${2:-}"; shift 2 ;;
      *) die "stub-append: unrecognized argument '$1'." ;;
    esac
  done

  # Every one of these is a refusal to write a malformed entry, not a
  # convenience check. A registry entry that cannot be joined against
  # (no Consumed by), cannot be traced to a person (no Chosen by), or names
  # a strategy nobody defined is worse than no entry: it looks like tracking.
  [ -n "$substitutes" ] || die "stub-append: --substitutes is required (the BL-### dependency, or MOD-### module, being stood in for)."
  case "$substitutes" in *BL-[0-9][0-9][0-9]*|*MOD-[0-9][0-9][0-9]*) ;; *) die "stub-append: --substitutes must name a BL-### item or a MOD-### module (got '${substitutes}')." ;; esac
  [ -n "$strategy" ] || die "stub-append: --strategy is required (one of: ${STUB_STRATEGIES})."
  # item-split is refused HERE rather than accepted and handled downstream,
  # because the two records diverge immediately: an ST entry has no field for
  # deferred scope, no field for what unblocks it, and no state that means
  # "the item is unfinished" — so a split recorded here loses everything a
  # resume would need, and taints fixtures that nothing unreal was ever
  # standing on.
  case " ${STUB_STRATEGIES_LEGACY} " in *" ${strategy} "*)
    die "stub-append: ${strategy} is not a stub strategy and no longer belongs in module-stubs.md.
A split fakes nothing — it defers real scope — so it taints nothing, retires
nothing, and needs fields an ST-### entry does not have (what was deferred,
which rules each half covers, what unblocks it, whether the item is finished).
Record it in its own registry instead:

  specclaw-bf-rebuild-collect split-append .specclaw \\
    --item BL-### --reason \"...\" --unmet-deps \"BL-###, ...\" \\
    --implemented-now \"...\" --deferred \"...\" \\
    --rules-implemented \"DR-###, ...\" --rules-deferred \"DR-###, ...\" \\
    --layers-implemented \"...\" --layers-deferred \"...\" \\
    --blocked-until \"BL-### BUILT, ...\" --chosen-by \"<name>, <YYYY-MM-DD>\" \\
    --summary \"...\"

See templates/item-splits.md and references/split-discipline.md." ;;
  esac
  case " ${STUB_STRATEGIES} " in *" ${strategy} "*) ;; *) die "stub-append: unknown strategy '${strategy}'. The three faking strategies are: ${STUB_STRATEGIES}. Never invent a fourth — if none fits, that is a finding to report, not a field to improvise. (A split is not one of these; see split-append.)" ;; esac
  [ -n "$consumed_by" ] || die "stub-append: --consumed-by is required (the BL-### item(s) built against this stub). It is the join key that makes their fixtures report as stub-tainted; an entry without it tracks nothing."
  case "$consumed_by" in *BL-[0-9][0-9][0-9]*) ;; *) die "stub-append: --consumed-by must name at least one BL-### item (got '${consumed_by}')." ;; esac
  [ -n "$chosen_by" ] || die "stub-append: --chosen-by is required (name, YYYY-MM-DD). A bypass is always an explicit human choice — an entry with no named chooser is malformed, per CONTRACT.md (m.2)."
  [ -n "$summary" ] || die "stub-append: --summary is required (the one-line heading: what is faked, for whom)."
  if [ -n "$mock_seed" ] && [ "$strategy" != "mock-data" ]; then
    die "stub-append: --mock-seed applies only to the mock-data strategy (got '${strategy}')."
  fi

  local specclaw_dir_abs project_root analysis_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  analysis_dir="$specclaw_dir_abs/analysis"
  mkdir -p "$analysis_dir"
  local stubs_file; stubs_file="$(stubs_file_path "$specclaw_dir_abs")"

  local new_id; new_id="$(next_stub_id "$stubs_file")"
  local entry="### ${new_id} — ${summary}

- **Status:** ACTIVE
- **Substitutes:** ${substitutes}
- **Strategy:** ${strategy}
- **Consumed by:** ${consumed_by}
- **Chosen by:** ${chosen_by}
- **Fakes:** ${fakes}
- **Implementation:** ${implementation}"
  [ -n "$mock_seed" ] && entry="${entry}
- **Mock seed:** ${mock_seed}"
  entry="${entry}
- **Retirement:**
"

  if [ ! -f "$stubs_file" ]; then
    local template_file="$SCRIPT_DIR/../templates/module-stubs.md"
    [ -f "$template_file" ] || die "Template missing: ${template_file}"
    local doc
    doc="$(cat "$template_file")"
    doc="$(substitute "$doc" '{{title}}' "$(project_title "$project_root")")"
    doc="$(substitute "$doc" '{{date}}' "$(date +%Y-%m-%d)")"
    doc="$(substitute "$doc" '{{stub_entries}}' "$entry")"
    printf '%s\n' "$doc" > "$stubs_file"
  elif grep -qF '{{stub_entries}}' "$stubs_file"; then
    local doc; doc="$(cat "$stubs_file")"
    doc="$(substitute "$doc" '{{stub_entries}}' "$entry")"
    printf '%s\n' "$doc" > "$stubs_file"
  else
    # APPEND. Never read-modify-write the whole document: another run may have
    # added an entry this process never saw (same invariant as
    # pending-questions.md).
    printf '\n%s\n' "$entry" >> "$stubs_file"
  fi

  echo "${new_id}"
  echo "Appended ${new_id} to ${stubs_file} (${strategy}, substitutes ${substitutes}, consumed by ${consumed_by}). Status ACTIVE — every fixture verifying those items now reports as stub-tainted until it is retired." >&2
}

cmd_stub_update() {
  local specclaw_dir="$1" stub_id="$2"; shift 2
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"
  case "$stub_id" in ST-[0-9][0-9][0-9]) ;; *) die "stub-update: '${stub_id}' is not an ST-### id." ;; esac

  local specclaw_dir_abs; specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  local stubs_file; stubs_file="$(stubs_file_path "$specclaw_dir_abs")"
  [ -f "$stubs_file" ] || die "No stub registry at ${stubs_file} — nothing to update."
  grep -qE "^### ${stub_id}([^0-9]|$)" "$stubs_file" || die "stub-update: ${stub_id} is not in ${stubs_file}."

  local did_any=false consumed_add=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --status)
        case "$(stub_status_of "${2:-}")" in
          ACTIVE|RETIRING|RETIRED) ;;
          *) die "stub-update: --status must be ACTIVE, RETIRING, or RETIRED (got '${2:-}'). See CONTRACT.md (m.4) for why the middle state exists." ;;
        esac
        md_set_field "$stubs_file" "$stub_id" "Status" "${2:-}"; did_any=true; shift 2 ;;
      --fakes)          md_set_field "$stubs_file" "$stub_id" "Fakes" "${2:-}"; did_any=true; shift 2 ;;
      --implementation) md_set_field "$stubs_file" "$stub_id" "Implementation" "${2:-}"; did_any=true; shift 2 ;;
      --mock-seed)      md_set_field "$stubs_file" "$stub_id" "Mock seed" "${2:-}"; did_any=true; shift 2 ;;
      --retirement)     md_set_field "$stubs_file" "$stub_id" "Retirement" "${2:-}"; did_any=true; shift 2 ;;
      --consumed-by-add) consumed_add="${2:-}"; shift 2 ;;
      *) die "stub-update: unrecognized argument '$1'." ;;
    esac
  done

  if [ -n "$consumed_add" ]; then
    case "$consumed_add" in BL-[0-9][0-9][0-9]) ;; *) die "stub-update: --consumed-by-add takes one BL-### id (got '${consumed_add}')." ;; esac
    local workdir; workdir="$(mktemp -d)"
    mkdir -p "$workdir/stubs"
    split_blocks "$stubs_file" "$workdir/stubs" "ST"
    local current; current="$(block_single_field "$workdir/stubs/${stub_id}.md" "Consumed by")"
    rm -rf "$workdir"
    case " ${current//,/ } " in
      # Idempotent, not a no-op-that-errors: re-running propose for an item
      # already listed must succeed quietly, or the skill has to special-case
      # a failure that means "the thing you asked for is already true".
      *" ${consumed_add} "*) echo "${consumed_add} is already listed under ${stub_id}'s Consumed by — left unchanged." >&2 ;;
      *) md_set_field "$stubs_file" "$stub_id" "Consumed by" "${current}${current:+, }${consumed_add}" ;;
    esac
    did_any=true
  fi

  $did_any || die "stub-update: no fields given. Pass at least one of --status / --fakes / --implementation / --mock-seed / --retirement / --consumed-by-add."
  echo "Updated ${stub_id} in ${stubs_file}." >&2
}

# ─── Subcommands: split-append / split-update ────────────────────────────────
#
# The item-split registry's writers (CONTRACT.md (o)). Same shape and same
# reasoning as stub-append/stub-update: bash owns an id-stable, append-only
# corpus because that is safer enforced deterministically than trusted to an
# LLM rewriting a whole document repeatedly.
#
# THE REFUSALS ARE THE FEATURE. Every validation below exists because a split
# recorded without it loses something a resume months later would need — and a
# record that looks like tracking while missing the one field that mattered is
# worse than no record at all.

cmd_split_append() {
  local specclaw_dir="$1"; shift
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"

  local item="" module="" reason="" unmet="" impl_now="" deferred=""
  local rules_impl="" rules_def="" layers_impl="" layers_def=""
  local blocked_until="" chosen_by="" change="" summary="" layer_confirm=""
  local rules_impl_given=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --item)                        item="${2:-}"; shift 2 ;;
      --module)                      module="${2:-}"; shift 2 ;;
      --reason)                      reason="${2:-}"; shift 2 ;;
      --unmet-deps)                  unmet="${2:-}"; shift 2 ;;
      --implemented-now)             impl_now="${2:-}"; shift 2 ;;
      --deferred)                    deferred="${2:-}"; shift 2 ;;
      --rules-implemented)           rules_impl="${2:-}"; rules_impl_given=true; shift 2 ;;
      --rules-deferred)              rules_def="${2:-}"; shift 2 ;;
      --layers-implemented)          layers_impl="${2:-}"; shift 2 ;;
      --layers-deferred)             layers_def="${2:-}"; shift 2 ;;
      --blocked-until)               blocked_until="${2:-}"; shift 2 ;;
      --chosen-by)                   chosen_by="${2:-}"; shift 2 ;;
      --change)                      change="${2:-}"; shift 2 ;;
      --summary)                     summary="${2:-}"; shift 2 ;;
      --layer-removal-confirmed-by)  layer_confirm="${2:-}"; shift 2 ;;
      *) die "split-append: unrecognized argument '$1'." ;;
    esac
  done

  local specclaw_dir_abs project_root analysis_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  analysis_dir="$specclaw_dir_abs/analysis"
  local backlog_file="$analysis_dir/rebuild-backlog.md"
  local splits_file; splits_file="$(splits_file_path "$specclaw_dir_abs")"

  # ── Required fields ──────────────────────────────────────────────────────
  case "$item" in BL-[0-9][0-9][0-9]) ;; *) die "split-append: --item is required and must be a BL-### id (got '${item}')." ;; esac
  [ -n "$reason" ] || die "split-append: --reason is required (why the split was required at all). Months later this is the only record of why the item was not built whole."
  [ -n "$unmet" ] || die "split-append: --unmet-deps is required (the dependency/dependencies that forced the split)."
  case "$unmet" in *BL-[0-9][0-9][0-9]*) ;; *) die "split-append: --unmet-deps must name at least one BL-### item (got '${unmet}')." ;; esac
  [ -n "$impl_now" ] || die "split-append: --implemented-now is required (the scope shipping in this change)."
  [ -n "$deferred" ] || die "split-append: --deferred is required (the scope explicitly NOT shipping). A split with nothing deferred is not a split; and an unrecorded deferral is exactly how a layer disappears."
  [ -n "$blocked_until" ] || die "split-append: --blocked-until is required (the BL-### items that must be BUILT before the deferred part can resume). Without it nothing can ever compute READY-TO-RESUME, so the split would sit ACTIVE forever."
  case "$blocked_until" in *BL-[0-9][0-9][0-9]*) ;; *) die "split-append: --blocked-until must name at least one BL-### item (got '${blocked_until}')." ;; esac
  [ -n "$chosen_by" ] || die "split-append: --chosen-by is required (name, YYYY-MM-DD). A split is always an explicit human choice — an entry with no named chooser is malformed, on the same terms as a bypass's Chosen by (CONTRACT.md (m.2))."
  [ -n "$summary" ] || die "split-append: --summary is required (the one-line heading: which item was split, and what waits)."
  # Required to be PASSED, but legitimately empty: a slice can ship groundwork
  # (middleware, a seam, plumbing) that no acceptance-basis rule covers on its
  # own. Refusing that would force a fake rule assignment, which is worse than
  # an honest "none". Passing it empty is a deliberate statement; omitting it
  # is an oversight, and those are different things.
  $rules_impl_given || die "split-append: --rules-implemented is required (the acceptance-basis DR-### rules the now-slice covers). Pass it empty (--rules-implemented \"\") if this slice genuinely covers none of them — that is a legitimate answer, but it has to be stated rather than left out."
  [ -n "$rules_def" ] || die "split-append: --rules-deferred is required (the acceptance-basis DR-### rules the deferred scope covers)."
  [ -n "$layers_impl" ] || die "split-append: --layers-implemented is required (from: ${ITEM_SPLIT_LAYERS})."
  [ -n "$layers_def" ] || die "split-append: --layers-deferred is required (from: ${ITEM_SPLIT_LAYERS})."

  # ── The item must exist and be active ────────────────────────────────────
  [ -f "$backlog_file" ] || die "split-append: no ${backlog_file#"$project_root"/}. A split is a statement about a backlog item; without the backlog there is no item to split and no acceptance basis to partition."
  local workdir; workdir="$(mktemp -d)"
  # shellcheck disable=SC2064  # expand workdir now, not at trap time
  trap "rm -rf '$workdir'" RETURN
  mkdir -p "$workdir/items"
  split_blocks "$backlog_file" "$workdir/items" "BL"
  local item_file="$workdir/items/${item}.md"
  [ -f "$item_file" ] || die "split-append: ${item} is not an item in ${backlog_file#"$project_root"/}."
  local item_title; item_title="$(block_title_after_dash "$item_file")"
  case "$item_title" in STRUCK*) die "split-append: ${item} is a STRUCK tombstone — an id kept claimed so nothing reuses it, not an item anyone can split." ;; esac

  [ -n "$module" ] || module="$(printf '%s' "$(block_single_field "$item_file" "Module")" | { grep -oE 'MOD-[0-9]{3}' | head -1; } || true)"

  # ── THE DR PARTITION ─────────────────────────────────────────────────────
  # The two rule sets must together account for EVERY rule in the item's own
  # acceptance basis, with no overlap. This is the mechanical form of "a split
  # must never widen beyond what the user selected": a rule in neither half is
  # scope that belongs to nobody, which is precisely how the now-slice quietly
  # grows or shrinks relative to what was agreed.
  #
  # It is also what lets /specclaw:bf-replay --item later say WHICH of the
  # item's fixtures cover built vs deferred scope, instead of an agent reading
  # prose at run time.
  local item_drs; item_drs="$(extract_dr_ids "$item_file" | paste -sd, -)"
  [ -n "$item_drs" ] || die "split-append: ${item}'s acceptance basis cites no DR-### rule, so there is nothing to partition. A split's two halves are defined by which rules each covers; an item with no rule citations cannot be split mechanically — fix the backlog item's acceptance basis first."
  local ri rd
  ri="$(normalize_id_list "$rules_impl" 'DR-[0-9]{3}')"
  rd="$(normalize_id_list "$rules_def" 'DR-[0-9]{3}')"
  [ -n "$ri" ] || warn "This split's now-slice covers NONE of ${item}'s acceptance-basis rules — every one of them is deferred. That is legal (the slice may ship groundwork no rule describes on its own), but it means nothing this change delivers can be verified against a fixture, and an --item replay of ${item} will report every selected fixture as covering deferred scope."
  [ -n "$rd" ] || die "split-append: --rules-deferred names no DR-### rule (got '${rules_def}'). If the deferred scope covers none of the item's acceptance-basis rules, the deferral is invisible to every later check — including the replay run that is supposed to report the item as PARTIAL."

  local overlap="" missing="" extra="" r
  for r in ${ri//,/ }; do
    [[ ",${rd}," == *",${r},"* ]] && overlap="${overlap}${overlap:+, }${r}"
    [[ ",${item_drs}," == *",${r},"* ]] || extra="${extra}${extra:+, }${r}"
  done
  for r in ${rd//,/ }; do
    [[ ",${item_drs}," == *",${r},"* ]] || extra="${extra}${extra:+, }${r}"
  done
  for r in ${item_drs//,/ }; do
    if [[ ",${ri}," != *",${r},"* ]] && [[ ",${rd}," != *",${r},"* ]]; then
      missing="${missing}${missing:+, }${r}"
    fi
  done

  if [ -n "$overlap" ] || [ -n "$missing" ] || [ -n "$extra" ]; then
    local msg="split-append: the rule partition does not account for ${item}'s acceptance basis exactly.
  ${item}'s acceptance basis: ${item_drs}
  --rules-implemented:       ${ri:-<none>}
  --rules-deferred:          ${rd}"
    [ -n "$overlap" ] && msg="${msg}
  IN BOTH HALVES: ${overlap} — a rule cannot be simultaneously built and deferred."
    [ -n "$missing" ] && msg="${msg}
  IN NEITHER HALF: ${missing} — this is scope that belongs to nobody, and it is exactly how a split silently widens or narrows. Put each rule in the half that actually covers it."
    [ -n "$extra" ] && msg="${msg}
  NOT IN THIS ITEM'S BASIS: ${extra} — a split can only partition the rules the item itself cites."
    die "$msg"
  fi

  # ── Layer vocabulary ─────────────────────────────────────────────────────
  local bad_layers="" l
  for l in ${layers_impl//,/ } ${layers_def//,/ }; do
    [ -z "$l" ] && continue
    case " ${ITEM_SPLIT_LAYERS} " in *" ${l} "*) ;; *) bad_layers="${bad_layers}${bad_layers:+, }${l}" ;; esac
  done
  [ -n "$bad_layers" ] && die "split-append: unknown layer token(s): ${bad_layers}. The vocabulary is closed and role-based: ${ITEM_SPLIT_LAYERS}. A layer you cannot name from that list is a signal the split is not a layer split — describe it in --deferred instead."

  # ── THE LAYER-REMOVAL GUARD ──────────────────────────────────────────────
  # This is the guard the BL-010 incident needed and did not have. A
  # screen-bearing item whose split defers the whole UI layer ships as a
  # backend-only implementation — a user-visible feature with nothing a user
  # can see — and that must never happen because nobody was asked.
  #
  # HONEST LIMIT, stated in the docs too: bash can REQUIRE the attestation; it
  # cannot verify that a human typed it. Same trust model as Chosen by
  # (CONTRACT.md (m.2)). What it buys is that the record names who confirmed
  # it, and that the confirmation cannot be skipped silently.
  local removes_ui=false
  case " ${layers_def//,/ } " in *" ui "*) removes_ui=true ;; esac
  local screen_bearing=false
  item_is_screen_bearing "$item_file" && screen_bearing=true

  if $removes_ui && $screen_bearing && [ -z "$layer_confirm" ]; then
    local scrs; scrs="$({ grep -oE 'SCR-[0-9]{3}' "$item_file" | awk '!seen[$0]++' | paste -sd', ' -; } || true)"
    die "split-append: refusing to record a split that removes the ENTIRE UI layer from a screen-bearing item.
  ${item} — ${item_title}
  renders: ${scrs:-a screen (declared via its UI fidelity line)}
  --layers-deferred: ${layers_def}

This split would ship ${item} with no user-visible part at all. That is the
exact failure this guard exists to prevent: a screen-bearing backlog item
silently becoming a backend-only implementation, with its UI acceptance basis
left unmet and nobody asked about it.

Prefer a VERTICAL slice — a thin end-to-end capability, UI through to
persistence, deferring only the specific dependency that is actually missing.
A horizontal stack cut produces an item that looks nearly done and delivers
nothing anyone can use.

If removing the UI layer is genuinely what was chosen, present that
consequence to the human in those terms and re-run with:
  --layer-removal-confirmed-by \"<their name>, <YYYY-MM-DD>\""
  fi

  # A confirmation on a split that removes no layer is a field that would read
  # as an attestation to something nobody was asked about.
  if [ -n "$layer_confirm" ] && [ -z "$layers_def" ]; then
    die "split-append: --layer-removal-confirmed-by was given but --layers-deferred names no layer."
  fi

  # ── Write ────────────────────────────────────────────────────────────────
  mkdir -p "$analysis_dir"
  local new_id; new_id="$(next_split_id "$splits_file")"
  local bu; bu="$(normalize_id_list "$blocked_until" 'BL-[0-9]{3}')"
  local bu_rendered=""
  for l in ${bu//,/ }; do bu_rendered="${bu_rendered}${bu_rendered:+, }${l} BUILT"; done

  local unmet_norm; unmet_norm="$(normalize_id_list "$unmet" 'BL-[0-9]{3}')"
  local entry="### ${new_id} — ${summary}

- **Status:** ACTIVE
- **Item:** ${item}
- **Module:** ${module:-not declared}
- **Reason:** ${reason}
- **Unmet dependencies:** ${unmet_norm}
- **Implemented now:** ${impl_now}
- **Deferred:** ${deferred}
- **Rules implemented:** ${ri:-none}
- **Rules deferred:** ${rd}
- **Layers implemented:** ${layers_impl}
- **Layers deferred:** ${layers_def}
- **Blocked until:** ${bu_rendered}
- **Chosen by:** ${chosen_by}"
  [ -n "$layer_confirm" ] && entry="${entry}
- **Layer removal confirmed by:** ${layer_confirm}"
  entry="${entry}
- **Change:** ${change:-not yet recorded}
- **Evidence:** not yet merged
- **Replay evidence:** not yet replayed
- **Resumed by:**
- **Completion:**
"

  if [ ! -f "$splits_file" ]; then
    local template_file="$SCRIPT_DIR/../templates/item-splits.md"
    [ -f "$template_file" ] || die "Template missing: ${template_file}"
    local doc; doc="$(cat "$template_file")"
    doc="$(substitute "$doc" '{{title}}' "$(project_title "$project_root")")"
    doc="$(substitute "$doc" '{{date}}' "$(date +%Y-%m-%d)")"
    doc="$(substitute "$doc" '{{split_entries}}' "$entry")"
    printf '%s\n' "$doc" > "$splits_file"
  elif grep -qF '{{split_entries}}' "$splits_file"; then
    local doc; doc="$(cat "$splits_file")"
    doc="$(substitute "$doc" '{{split_entries}}' "$entry")"
    printf '%s\n' "$doc" > "$splits_file"
  else
    # APPEND. Never read-modify-write the whole document: another run may have
    # added an entry this process never saw (same invariant as
    # module-stubs.md and pending-questions.md).
    printf '\n%s\n' "$entry" >> "$splits_file"
  fi

  echo "${new_id}"
  echo "Appended ${new_id} to ${splits_file#"$project_root"/} (${item}, deferring ${rd} until ${bu_rendered}). Status ACTIVE — ${item} will render as PARTIALLY BUILT and an --item replay of it will report PARTIAL until the deferred scope lands. Nothing is tainted: a split fakes nothing." >&2
}

cmd_split_update() {
  local specclaw_dir="$1" split_id="$2"; shift 2
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"
  case "$split_id" in IS-[0-9][0-9][0-9]) ;; *) die "split-update: '${split_id}' is not an IS-### id." ;; esac

  local specclaw_dir_abs; specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  local splits_file; splits_file="$(splits_file_path "$specclaw_dir_abs")"
  [ -f "$splits_file" ] || die "No item-split registry at ${splits_file} — nothing to update."
  grep -qE "^### ${split_id}([^0-9]|$)" "$splits_file" || die "split-update: ${split_id} is not in ${splits_file}."

  local current_status
  local workdir; workdir="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$workdir'" RETURN
  mkdir -p "$workdir/splits"
  split_blocks "$splits_file" "$workdir/splits" "IS"
  current_status="$(split_status_of "$(block_single_field "$workdir/splits/${split_id}.md" "Status")")"

  local did_any=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --status)
        local want; want="$(split_status_of "${2:-}")"
        case "$want" in
          ACTIVE|READY-TO-RESUME|COMPLETE) ;;
          *) die "split-update: --status must be ACTIVE, READY-TO-RESUME, or COMPLETE (got '${2:-}'). See CONTRACT.md (o.3)." ;;
        esac
        # COMPLETE is never reachable straight from ACTIVE. ACTIVE means the
        # deferred scope's own blockers are not all built — so the deferred
        # work cannot honestly have been done, and a path that allowed it
        # would let unbuilt scope be marked finished by a typo.
        #
        # A deferral WITHDRAWN from the product (dropped, not built) is
        # handled deliberately and by hand: strike the deferred scope in
        # rebuild-backlog.md and record the withdrawal in this entry's
        # Completion field. There is intentionally no automatic path for it.
        if [ "$want" = "COMPLETE" ] && [ "$current_status" = "ACTIVE" ]; then
          die "split-update: refusing to flip ${split_id} from ACTIVE straight to COMPLETE.
ACTIVE means the deferred scope's Blocked-until items are not all declared
BUILT, so the deferred work cannot have been built against them. The path is
ACTIVE -> READY-TO-RESUME (computed by bash during
/specclaw:bf-rebuild-plan --refresh, from those items' own BUILT: notes) ->
COMPLETE (on a clean /specclaw:bf-replay --item run, citing that run id).

If the deferred scope was WITHDRAWN rather than built, that is a deliberate
manual step: strike it in rebuild-backlog.md and record the withdrawal in
${split_id}'s Completion field."
        fi
        md_set_field "$splits_file" "$split_id" "Status" "${2:-}"; did_any=true; shift 2 ;;
      --change)          md_set_field "$splits_file" "$split_id" "Change" "${2:-}"; did_any=true; shift 2 ;;
      --evidence)        md_set_field "$splits_file" "$split_id" "Evidence" "${2:-}"; did_any=true; shift 2 ;;
      --replay-evidence) md_set_field "$splits_file" "$split_id" "Replay evidence" "${2:-}"; did_any=true; shift 2 ;;
      --resumed-by)      md_set_field "$splits_file" "$split_id" "Resumed by" "${2:-}"; did_any=true; shift 2 ;;
      --completion)      md_set_field "$splits_file" "$split_id" "Completion" "${2:-}"; did_any=true; shift 2 ;;
      *) die "split-update: unrecognized argument '$1'." ;;
    esac
  done

  $did_any || die "split-update: no fields given. Pass at least one of --status / --change / --evidence / --replay-evidence / --resumed-by / --completion."
  echo "Updated ${split_id} in ${splits_file}." >&2
}

# ─── Main ─────────────────────────────────────────────────────────────────────

case "${1:-}" in
  collect)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-rebuild-collect collect <specclaw_dir> [--refresh] [--module MOD-###]"
    shift
    cmd_collect "$@"
    ;;
  render)
    [ $# -ge 3 ] || die "Usage: specclaw-bf-rebuild-collect render <specclaw_dir> <draft_file> [--module MOD-###]"
    shift
    cmd_render "$@"
    ;;
  module-status)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-rebuild-collect module-status <specclaw_dir>"
    cmd_module_status "$2"
    ;;
  bypass-check)
    [ $# -ge 3 ] || die "Usage: specclaw-bf-rebuild-collect bypass-check <specclaw_dir> <BL-###|--title \"<item title>\">"
    shift
    cmd_bypass_check "$@"
    ;;
  stub-append)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-rebuild-collect stub-append <specclaw_dir> --substitutes ... --strategy ... --consumed-by ... --chosen-by ... --summary ..."
    shift
    cmd_stub_append "$@"
    ;;
  stub-update)
    [ $# -ge 3 ] || die "Usage: specclaw-bf-rebuild-collect stub-update <specclaw_dir> <ST-###> [--status ...] [--fakes ...] [--implementation ...] [--mock-seed ...] [--retirement ...] [--consumed-by-add BL-###]"
    shift
    cmd_stub_update "$@"
    ;;
  split-append)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-rebuild-collect split-append <specclaw_dir> --item BL-### --reason ... --unmet-deps ... --implemented-now ... --deferred ... --rules-implemented ... --rules-deferred ... --layers-implemented ... --layers-deferred ... --blocked-until ... --chosen-by ... --summary ... [--module MOD-###] [--change <name>] [--layer-removal-confirmed-by \"<name>, <date>\"]"
    shift
    cmd_split_append "$@"
    ;;
  split-update)
    [ $# -ge 3 ] || die "Usage: specclaw-bf-rebuild-collect split-update <specclaw_dir> <IS-###> [--status ...] [--change ...] [--evidence ...] [--replay-evidence ...] [--resumed-by ...] [--completion ...]"
    shift
    cmd_split_update "$@"
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    die "Unknown subcommand: $1. Run specclaw-bf-rebuild-collect --help for usage."
    ;;
esac
