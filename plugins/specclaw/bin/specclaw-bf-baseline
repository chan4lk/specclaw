#!/usr/bin/env bash
# specclaw-bf-baseline — deterministic fact-collection for /specclaw:bf-baseline
#
# Unlike specclaw-bf-clarify (which owns rendering to protect a hard
# ID-stability/never-overwrite-an-answer invariant), this script follows the
# plugin's standard analysis-command split: bash gathers facts and archives
# prior output, the baseline-designer agent interprets and writes
# .specclaw/baseline/seams.md and scenarios.md itself, per its own Output
# section — there is no partial-answer state across runs to protect here
# (a re-run archives the prior design wholesale and starts fresh, same as
# codebase-report.md/architecture.md/domain-model.md/rebuild-backlog.md).
#
# Bash + coreutils, plus jq — required by the record subcommand, which
# parses fixture JSON structurally (never by text-matching against one
# stack's formatting convention; see CONTRACT.md).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# ─── Help ─────────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: specclaw-bf-baseline <subcommand> [options]

Subcommands:
  collect          <specclaw_dir> [--module MOD-###]
                   Design-mode (Mode A) pre-agent step. Requires
                   .specclaw/analysis/domain-model.md to exist —
                   /specclaw:bf-baseline derives scenarios from its numbered
                   business rules and cannot proceed without it. Reports
                   which supplementary analysis documents
                   (codebase-report.md, architecture.md, functional-spec.md,
                   rebuild-backlog.md) are present, for stack detection and
                   backlog-item linkage. Outputs one JSON object to stdout.
                   Exits non-zero, naming /specclaw:bf-domain, if
                   domain-model.md is missing.

                   Also reports the module map (soft input): its
                   PROPOSED/CONFIRMED status and every module's id, name and
                   owned DR rules, so each scenario can declare the
                   module(s) its pinned rules belong to. When the map is
                   absent, scenarios simply declare no module — the same way
                   they declare no backlog item when rebuild-backlog.md does
                   not exist yet.

                   Also reports the PRIOR scenario roster (gm_id, title,
                   rules, modules, seam layer, active/withdrawn) and the next
                   free GM id, read BEFORE /specclaw:bf-baseline's own
                   archive step. GM-NNN ids are permanent (CONTRACT.md (c)),
                   and once a fixture and a module tag hang off one, a
                   re-design that renumbered them would silently re-point
                   both — so surviving ids are carried forward, not
                   regenerated.

                   --module MOD-### scopes design to one module's rules.
                   Requires module-map.md. The agent drafts only that
                   module's scenarios, and `merge-scenarios` (below) folds
                   them into the existing scenarios.md without disturbing
                   any other module's blocks.

  merge-scenarios  <specclaw_dir> <draft_file> <MOD-###>
                   Module-scoped design merge — fully deterministic, no
                   agent. Requires an existing scenarios.md. Archives it,
                   then rebuilds it: every GM-NNN block the draft supplies
                   replaces its namesake, every block belonging to another
                   module is preserved byte-for-byte, and a block of the
                   scoped module that the draft omits becomes a WITHDRAWN
                   tombstone rather than vanishing — its id stays claimed
                   forever, exactly like a DR-NNN or BL-NNN tombstone.

                   The "No Legacy Behaviour Exists" and "Rule Coverage
                   Check" sections are whole-corpus findings; a module-scoped
                   run does not re-derive them, so they are preserved
                   verbatim with a dated note saying so. Never a silent
                   claim that a corpus-wide check was re-run.

  harness-collect  <specclaw_dir> [--module MOD-###]
                   Harness-mode (--harness) pre-agent step. Requires
                   .specclaw/baseline/seams.md and scenarios.md to already
                   exist (Mode A must run first). Archives any prior
                   .specclaw/baseline/harness/ directory wholesale, creates
                   a fresh empty harness/ and fixtures/ directory, and
                   emits the full list of GM-NNN scenario IDs parsed from
                   scenarios.md — a deterministic checklist the agent must
                   implement one-for-one, not re-derive by reading prose.
                   Outputs one JSON object to stdout.

                   With --module MOD-###, the harness directory is NOT
                   archived and NOT emptied: it emits only that module's
                   scenario IDs plus an inventory of the harness files that
                   already exist, and the agent adds or replaces only those
                   tests. Wiping the harness for a one-module run would
                   delete every other module's generated tests.

  record           <specclaw_dir>
                   Record-mode (--record) step — fully deterministic, no
                   agent involved. Requires scenarios.md to exist. Scans
                   .specclaw/baseline/fixtures/ for a "<scenario_id>.json"
                   file per scenario, hashes each one found (sha256),
                   extracts its capture metadata (captured_at, anchor_date,
                   legacy_commit_sha, runtime_version, normalized_fields,
                   outcome/error_code/threw, seam_layer),
                   cross-references it against scenarios.md's seam/rule/
                   backlog-item fields, archives any prior manifest.json,
                   and writes .specclaw/baseline/manifest.json. Reports
                   scenarios with no fixture yet — this is not a failure,
                   capturing is an iterative, human-run process.

                   VALIDATES, and refuses to write a manifest on any
                   failure (nothing is archived either — the prior
                   manifest survives an invalid run intact):
                     - every scenario declares a valid seam_layer
                       (pure-function|service|http|persistence)
                     - every normalized_fields path resolves against that
                       fixture's own output; a path matching zero fields
                       names the near-miss paths that do exist
                     - every fixture output carries outcome/error_code/threw
                       (CONTRACT.md (b.1))
                     - a REJECTED fixture with a null error_code is only
                       legal when its scenario is marked PROVISIONAL
                     - every non-null error_code has a matching heading in
                       .specclaw/baseline/error-map.md (CONTRACT.md (h))
                     - every MOD-### a scenario declares has a matching
                       heading in .specclaw/analysis/module-map.md, when
                       that document exists — a module tag naming nothing
                       selects nothing in /specclaw:bf-replay --module,
                       silently

                   WARNS (never blocks the manifest) when a fixture's
                   declared module disagrees with the module its own BL item
                   is filed under in rebuild-backlog.md — naming both, since
                   one of the two documents is wrong and bash cannot know
                   which.

Options:
  -h, --help    Show this help message
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

die() { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARN: $*" >&2; }

# ─── Generic JSON helpers (copied verbatim from specclaw-bf-analyze-codebase —
# no shared lib, per repo convention) ─────────────────────────────────────────

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# A JSON string literal, or a bare null for an absent value — so a fixture that
# recorded no outcome/error_code reads back as null rather than as the empty
# string, which a downstream reader would have to guess about.
json_str_or_null() {
  if [ -z "$1" ]; then printf 'null'; else printf '"%s"' "$(json_escape "$1")"; fi
}

json_array_from_lines() {
  local item first=true out=""
  while IFS= read -r item; do
    [ -z "$item" ] && continue
    if $first; then first=false; else out="${out}, "; fi
    out="${out}\"$(json_escape "$item")\""
  done
  printf '%s' "$out"
}

# Validate (best-effort) and emit a JSON object to stdout — same tolerant
# pattern every collect-style script in this plugin already uses.
emit_json() {
  local output="$1"
  if command -v jq &>/dev/null; then
    if printf '%s' "$output" | jq . >/dev/null 2>&1; then
      printf '%s\n' "$output"
    else
      warn "JSON validation failed, outputting best-effort"
      printf '%s\n' "$output"
    fi
  else
    printf '%s\n' "$output"
  fi
}

# ─── Known supplementary analysis documents (soft inputs; only
# domain-model.md is a hard prerequisite) ─────────────────────────────────────

SUPP_DOCS=(codebase-report.md architecture.md functional-spec.md rebuild-backlog.md)

# ─── Scenario-block parsing (scenarios.md) ───────────────────────────────────
# Same "one block per file, keyed by ID" technique specclaw-bf-clarify uses for
# CQ-NNN blocks, applied to scenarios.md's "### GM-NNN" blocks. Read-only here
# (record never rewrites scenarios.md) — used to build the deterministic
# checklist harness-collect hands the agent, and the seam/rule/backlog-item
# metadata record cross-references against each fixture.

# A block runs from its "### GM-NNN" heading to the next such heading OR the
# next "## " section heading, whichever comes first. Without that second stop
# condition the LAST scenario in the document silently swallows every trailing
# section ("## No Legacy Behaviour Exists", "## Rule Coverage Check") into its
# own block — which put that unrelated prose inside the scenario's
# scenario_content_hash (so an edit to the coverage check marked the last
# fixture SUPERSEDED) and let a MOD-### mentioned in the coverage check read
# back as that scenario's own declared module. Same stop condition
# specclaw-bf-rebuild-collect's split_blocks already carries.
split_scenario_blocks() {
  local file="$1" outdir="$2"
  [ -f "$file" ] || return 0
  awk -v dir="$outdir" '
    /^### GM-[0-9]+/ {
      match($0, /GM-[0-9]+/)
      id = substr($0, RSTART, RLENGTH)
      outfile = dir "/" id ".md"
    }
    /^## / && !/^### GM-[0-9]+/ { id = "" }
    id != "" { print $0 >> outfile }
  ' "$file"
}

scenario_block_id() {
  basename "$1" .md
}

# NB: the separator alternation must NOT be a bracket expression ([—-]).
# Under a byte-oriented locale/sed build (observed on this toolchain even with
# LC_CTYPE=C.UTF-8) a POSIX bracket class treats the multi-byte em dash as its
# individual raw bytes and strips only the first one, leaving the other two
# glued to the front of the title. That is invisible in most uses, but it made
# every `case "$(scenario_block_title …)" in WITHDRAWN*)` test silently fail —
# so a tombstone was processed as a real scenario and failed the seam-layer
# check. Same guard specclaw-bf-rebuild-collect's block_title_after_dash
# already carries.
scenario_block_title() {
  head -1 "$1" | sed -E 's/^### GM-[0-9]+[[:space:]]*(—|-)[[:space:]]*//'
}

# Extract a single-line "- **<Label>:** value" field (Seam, Business rules
# pinned, Verifies backlog item, Kind).
#
# An ABSENT field reads as empty, never as a failure. grep exits 1 on no match,
# and under this script's `set -euo pipefail` that status propagated out of an
# unguarded `x="$(scenario_block_field …)"` and killed the run — with no output
# at all, because the death came before anything was printed. Two ways that
# fired, both routine: a WITHDRAWN tombstone declares no Seam layer (and
# `merge-scenarios` creates tombstones itself, so `collect` broke on the very
# next run), and a live scenario omitting an optional field took `record` down
# the same way.
#
# It is the READER's job to say what the line holds, not to judge whether
# holding nothing is acceptable — that is decided per field by the caller, and
# `record` already hard-fails on a missing Seam layer with a message naming the
# valid values. That check sits AFTER this call, so the unguarded version was
# what kept it from ever running. Do not "tidy" the `|| true` away: it restores
# validation rather than suppressing it. Same `{ …; } || true` shape
# scenario_block_modules below already uses.
scenario_block_field() {
  local file="$1" label="$2"
  { grep -m1 -- "^- \*\*${label}:\*\*" "$file" 2>/dev/null \
    | sed -E "s/^- \*\*${label}:\*\* *//" | sed -E 's/[[:space:]]+$//'; } || true
}

# Every MOD-### token in a scenario's own "- **Modules:**" field, comma-
# joined. Declared once by the design agent (from the module map's own DR
# ownership) and copied verbatim from here on — never re-derived from this
# scenario's prose, and never inferred from its rules at record time, exactly
# like `seam_layer`. An empty value is legal and means the project has no
# module map yet.
#
# The field is named `Modules`, not `Module(s)`, deliberately: several field
# readers in this plugin interpolate the label into an ERE, where `(s)` parses
# as a capture group and the strip silently fails, leaving the label glued to
# the value. A paren-free label cannot be got wrong by any of them.
scenario_block_modules() {
  local file="$1"
  { scenario_block_field "$file" "Modules" \
    | grep -oE 'MOD-[0-9]{3}' | awk '!seen[$0]++' | paste -sd, -; } || true
}

# Comma-joined id list -> JSON array body.
csv_to_json_array() {
  local raw="$1" out="" first=true item
  local -a _items=()
  IFS=',' read -ra _items <<< "$raw"
  for item in ${_items[@]+"${_items[@]}"}; do
    item="${item#"${item%%[![:space:]]*}"}"
    item="${item%"${item##*[![:space:]]}"}"
    [ -z "$item" ] && continue
    if $first; then first=false; else out="${out}, "; fi
    out="${out}\"$(json_escape "$item")\""
  done
  printf '%s' "$out"
}

# The module map's own Status line, verbatim ("PROPOSED — ..." or
# "CONFIRMED by <name>, <date>"). Reported, never normalized.
read_module_map_status() {
  local map_file="$1"
  [ -f "$map_file" ] || { printf ''; return 0; }
  { grep -m1 -- '^\*\*Status:\*\*' "$map_file" 2>/dev/null \
    | sed -E 's/^\*\*Status:\*\* *//' | sed -E 's/[[:space:]]+$//'; } || true
}

# The module-map counterpart of scenario_block_title. Same em-dash guard: the
# separator alternation must NOT be a bracket expression, for the reason given
# above scenario_block_title. `tr -d '\r'` is what the record path already
# applies to this heading, and is load-bearing here: on a CRLF module map a
# WITHDRAWN heading otherwise reads as a live title and the tombstone is
# processed as a real module.
module_block_title() {
  head -1 "$1" | sed -E 's/^### MOD-[0-9]+[[:space:]]*(—|-)[[:space:]]*//' | tr -d '\r'
}

# The subset of <MOD-*.md file>... whose heading is not a WITHDRAWN tombstone.
#
# Co-ownership is a claim a LIVE module makes. A withdrawn module's
# "(co-owned with MOD-###)" is a stale claim left behind by a module that no
# longer exists, and honouring it makes the named live module accountable for
# a rule that nothing owns any more -- it reaches manifest.json's module_ids,
# which is what /specclaw:bf-replay --module joins on, so the live module is
# then asked to replay a rule its own section never mentions.
#
# One function, both callers: collect and record each filter their file list
# through this before coowned_pairs sees it, so the two paths cannot drift
# apart on which modules are eligible to declare co-ownership. The per-module
# WITHDRAWN tests further down each path are left exactly as they were.
non_withdrawn_module_files() { # <MOD-*.md file>...
  local nwf
  for nwf in "$@"; do
    case "$(module_block_title "$nwf")" in
      WITHDRAWN*) ;;
      *) printf '%s\n' "$nwf" ;;
    esac
  done
}

# For every "(co-owned with MOD-###)" annotation across a set of split
# MOD-###.md files, print "<named-module> <DR-id>" — one line per annotation.
# Each annotation pairs with the NEAREST DR-### to its LEFT on the same line:
# "DR-001 and DR-002 (co-owned with MOD-002)" must yield DR-002, the id right
# next to it, not DR-001 — a single regex spanning both cannot express
# "nearest", so this walks left from the annotation and stops at the first
# DR-### it finds.
#
# Shared by `collect` and `record`'s fallback module derivation: a rule
# co-owned by two modules is written on only ONE module's line (the
# documented, minimum-required form), so the OTHER module's own text never
# mentions it — a plain per-module grep would silently miss it there. Fixing
# this once, here, means both callers see the same rule attribution.
coowned_pairs() { # <MOD-*.md file>...
  local cf
  for cf in "$@"; do
    # Scoped to the "Business rules" line, for the same reason the per-module
    # rule grep above it is: a `DR-###` appearing anywhere else in the block
    # (e.g. "Depends on: MOD-001 (needs the invoice balance, DR-001)") is a
    # citation, not an ownership claim. Scanning every line made one sentence
    # mean two things — the citing module correctly did NOT own the rule,
    # while a `(co-owned with MOD-###)` on that same sentence still handed it
    # to the named module. An ownership claim is only legible where ownership
    # is declared.
    awk -v src="$(basename "$cf" .md)" '
      /^- \*\*Business rules:\*\*/ {
        line = $0
        # `pos` is a scan offset into the UNMODIFIED line, never a truncation
        # of it. Consuming the line (line = substr(line, st + ln)) would throw
        # away the text to the LEFT of each annotation, so a second annotation
        # on the same line had no DR-### left of it to pair with and was
        # dropped in silence -- "DR-020 (co-owned with MOD-002, co-owned with
        # MOD-004)" attributed MOD-002 and lost MOD-004 entirely. Keeping the
        # line whole preserves the nearest-DR-to-the-left rule for EVERY
        # annotation, which is what pairs the two ids on
        # "DR-001 (co-owned with MOD-002), DR-002 (co-owned with MOD-003)"
        # separately rather than giving both the same rule.
        pos = 1
        while (match(substr(line, pos), /co-owned with MOD-[0-9][0-9][0-9]/)) {
          st = pos + RSTART - 1
          ln = RLENGTH
          ann = substr(line, st, ln)
          mod = substr(ann, length(ann) - 6)
          before = substr(line, 1, st - 1)
          dr = ""; tmp = before
          while (match(tmp, /DR-[0-9][0-9][0-9]/)) {
            dr = substr(tmp, RSTART, RLENGTH)
            tmp = substr(tmp, RSTART + RLENGTH)
          }
          if (dr != "" && mod != src) print mod, dr
          pos = st + ln
        }
      }
    ' "$cf" 2>/dev/null || true
  # One pair per MOD/DR combination however many times it is declared: the
  # same annotation repeated on two lines, or both modules naming each other,
  # is one ownership fact, not two. Same `!seen[$0]++` idiom the rule greps
  # in this file already use.
  done | awk '!seen[$0]++'
}

# Add the DR-### ids another module declared co-owned with <mod_id> to its
# existing comma-joined rule list, skipping any already present. Reads the
# pairs coowned_pairs() produced, filtered to this module.
apply_coowned_rules() { # <mod_id> <existing-csv-rules> <coowned-pairs-file>
  local mod_id="$1" rules="$2" pairs_file="$3" extra
  while IFS= read -r extra; do
    [ -n "$extra" ] || continue
    case ",${rules}," in
      *",${extra},"*) ;;
      *) rules="${rules:+${rules},}${extra}" ;;
    esac
  done < <(awk -v m="$mod_id" '$1 == m { print $2 }' "$pairs_file" | awk '!seen[$0]++')
  printf '%s' "$rules"
}

# Fingerprint of a scenario's own defining content — used only to detect
# SUPERSEDED (a re-run of design mode changed what this GM-ID means while a
# captured fixture from the OLD definition still sits on disk; fixture
# files are additive and never deleted by any specclaw command, but a
# scenario's own text is free to change under the same ID on a fresh Mode A
# run). Hashing the whole block, not just the rule citation, means any
# textual change to the scenario is caught, never only a rule-number change.
scenario_block_hash() {
  sha256sum "$1" 2>/dev/null | awk '{print $1}'
}

# ─── Fixture JSON field extraction (jq-based, per CONTRACT.md) ──────────────
# Fixtures are produced by whichever stack bf-baseline-designer generated the
# capture harness in this run (per CONTRACT.md — never assumed to be any
# particular language), so parsing them by text-matching against one
# formatting convention breaks the moment a different stack's JSON writer
# wraps lines differently. jq parses the actual structure instead, so field
# layout never matters. A malformed or unreadable fixture is reported (see
# cmd_record) but never aborts the scan.

require_jq() {
  command -v jq >/dev/null 2>&1 \
    || die "jq is required by specclaw-bf-baseline's record subcommand (structural fixture JSON parsing) but was not found on PATH."
}

# The canonical field-path language and the error-outcome contract are defined
# ONCE, in lib/gm-paths.jq, and prepended to this script's jq programs —
# specclaw-bf-replay's compare loads the exact same file. A capture-time
# validator that disagreed with the compare-time matcher about what a path
# means would validate a fixture green and then normalize nothing on every
# replay, which is precisely the failure mode this shared load prevents.
GM_PATHS_JQ=""
load_gm_paths() {
  local lib="$PLUGIN_ROOT/lib/gm-paths.jq"
  [ -f "$lib" ] || die "Shared path-resolution library missing: ${lib}. This ships with the plugin; a missing copy means a broken install, and record will not fall back to a local reimplementation."
  GM_PATHS_JQ="$(cat "$lib")"
}

# ─── Seam layers (templates/CONTRACT.md (i)) ────────────────────────────────
# A closed enum, declared per scenario and copied — never re-derived from the
# seam's prose description, and never defaulted. It is what lets
# specclaw-bf-replay enforce that a replay test exercises the rebuild at the
# layer the fixture was actually captured at.

SEAM_LAYERS=(pure-function service http persistence)

seam_layer_valid() {
  local candidate="$1" l
  for l in "${SEAM_LAYERS[@]}"; do
    [ "$candidate" = "$l" ] && return 0
  done
  return 1
}

fixture_field() {
  local file="$1" field="$2"
  jq -r --arg f "$field" '.[$f] // empty' "$file" 2>/dev/null || true
}

fixture_array_field() {
  local file="$1" field="$2"
  jq -c --arg f "$field" '.[$f] // []' "$file" 2>/dev/null || echo '[]'
}

# ─── Subcommand: collect (design mode, pre-agent) ────────────────────────────

cmd_collect() {
  local specclaw_dir="$1"; shift
  local module_scope=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --module)
        shift
        [ $# -gt 0 ] || die "--module requires a MOD-### id (e.g. --module MOD-002)."
        module_scope="$1"
        ;;
      --module=*) module_scope="${1#--module=}" ;;
      *) die "Unknown option for collect: $1" ;;
    esac
    shift
  done
  if [ -n "$module_scope" ] && ! [[ "$module_scope" =~ ^MOD-[0-9]{3}$ ]]; then
    die "--module expects a MOD-### id (three digits, e.g. MOD-002); got '${module_scope}'."
  fi

  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"

  local specclaw_dir_abs project_root analysis_dir baseline_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  analysis_dir="$specclaw_dir_abs/analysis"
  baseline_dir="$specclaw_dir_abs/baseline"

  local domain_model="$analysis_dir/domain-model.md"
  [ -f "$domain_model" ] || die "No .specclaw/analysis/domain-model.md found — /specclaw:bf-baseline derives its scenarios from that document's numbered business rules and cannot proceed without it. Run /specclaw:bf-domain first."

  local -a docs_present=() docs_missing=()
  local d
  for d in "${SUPP_DOCS[@]}"; do
    if [ -f "$analysis_dir/$d" ]; then
      docs_present+=("$d")
    else
      docs_missing+=("$d")
    fi
  done

  local docs_present_json docs_missing_json
  docs_present_json="$(printf '%s\n' "${docs_present[@]}" | json_array_from_lines)"
  docs_missing_json="$(printf '%s\n' "${docs_missing[@]}" | json_array_from_lines)"

  local clar_present=false pq_present=false
  [ -f "$analysis_dir/clarifications.md" ] && clar_present=true
  [ -f "$analysis_dir/pending-questions.md" ] && pq_present=true

  # ── Module map (soft input) ──────────────────────────────────────────────
  # Present: every scenario declares the module(s) owning the rules it pins,
  # derived from this roster. Absent: scenarios declare no module, exactly as
  # they declare no backlog item when rebuild-backlog.md does not exist. Only
  # --module makes the map a hard requirement.
  local map_file="$analysis_dir/module-map.md"
  local map_present=false map_status="" modules_json="" mfirst=true
  local -a known_mods=()
  if [ -f "$map_file" ]; then
    map_present=true
    map_status="$(read_module_map_status "$map_file")"
    local mworkdir; mworkdir="$(mktemp -d)"
    awk -v dir="$mworkdir" '
      /^### MOD-[0-9]+/ { match($0, /MOD-[0-9]+/); id = substr($0, RSTART, RLENGTH); outfile = dir "/" id ".md" }
      /^## / && !/^### MOD-[0-9]+/ { id = "" }
      id != "" { print $0 >> outfile }
    ' "$map_file"
    shopt -s nullglob
    local -a mod_files=("$mworkdir"/MOD-*.md)
    shopt -u nullglob
    # Co-ownership is reciprocal by construction, not by transcription.
    # "(co-owned with MOD-###)" is the analyst's declaration that the named
    # module owns the rule too, so that module's rule set carries it here
    # whether or not its own section happens to repeat the id. This roster is
    # what scenarios are tagged from and what /specclaw:bf-replay --module
    # signs off against, so deriving the pair from the declaration is what
    # stops a module being signed off without replaying a rule it implements.
    # A one-sided note is no longer a silent single-owner attribution.
    local coown_file="$mworkdir/.coowned"
    local lmf
    local -a live_mod_files=()
    while IFS= read -r lmf; do
      if [ -n "$lmf" ]; then live_mod_files+=("$lmf"); fi
    done < <(non_withdrawn_module_files ${mod_files[@]+"${mod_files[@]}"})
    coowned_pairs ${live_mod_files[@]+"${live_mod_files[@]}"} > "$coown_file"

    local mf mid mname mrules
    for mf in "${mod_files[@]}"; do
      mid="$(basename "$mf" .md)"
      mname="$(head -1 "$mf" | sed -E 's/^### MOD-[0-9]+[[:space:]]*(—|-)[[:space:]]*//')"
      case "$mname" in WITHDRAWN*) ;; *) known_mods+=("$mid") ;; esac
      # Scoped to the "Business rules" line alone, not the whole block: a
      # `DR-###` cited elsewhere (e.g. "Depends on: MOD-006 (session gate,
      # DR-008)") is a citation, not an ownership claim, and must not be
      # attributed to this module.
      mrules="$({ scenario_block_field "$mf" "Business rules" | grep -oE 'DR-[0-9]{3}' | awk '!seen[$0]++' | paste -sd, -; } || true)"
      mrules="$(apply_coowned_rules "$mid" "$mrules" "$coown_file")"
      if $mfirst; then mfirst=false; else modules_json="${modules_json},"; fi
      modules_json="${modules_json}
    {\"mod_id\": \"$(json_escape "$mid")\", \"name\": \"$(json_escape "$mname")\", \"rules\": [$(csv_to_json_array "$mrules")]}"
    done

    rm -rf "$mworkdir"
  fi

  if [ -n "$module_scope" ]; then
    $map_present || die "--module ${module_scope} needs .specclaw/analysis/module-map.md, which does not exist — a module-scoped design has no module definitions to scope to. Run /specclaw:bf-domain first, or run design mode without --module to design the whole corpus."
    local found=false km
    for km in ${known_mods[@]+"${known_mods[@]}"}; do
      [ "$km" = "$module_scope" ] && { found=true; break; }
    done
    $found || die "--module ${module_scope} names no active module in .specclaw/analysis/module-map.md. Active modules: ${known_mods[*]:-none}."
  fi

  # ── Prior scenario roster, for GM-id carry-forward ───────────────────────
  # Read here, before /specclaw:bf-baseline's own archive step moves
  # scenarios.md. GM-NNN ids are permanent: a captured fixture, a manifest
  # entry and (now) a module tag all hang off one, so a re-design that
  # reassigned them would silently re-point every one of those without
  # changing a single hash. ID-level facts only.
  local scenarios_file="$baseline_dir/scenarios.md"
  local prior_scenarios_json="" psfirst=true next_gm_num=1
  if [ -f "$scenarios_file" ]; then
    local sworkdir; sworkdir="$(mktemp -d)"
    split_scenario_blocks "$scenarios_file" "$sworkdir"
    shopt -s nullglob
    local -a sfiles=("$sworkdir"/GM-*.md)
    shopt -u nullglob
    local sf sid stitle srules smods slayer sstatus snum
    for sf in "${sfiles[@]}"; do
      sid="$(scenario_block_id "$sf")"
      snum="${sid#GM-}"; snum=$((10#$snum))
      [ "$snum" -ge "$next_gm_num" ] && next_gm_num=$((snum + 1))
      stitle="$(scenario_block_title "$sf")"
      case "$stitle" in WITHDRAWN*) sstatus="withdrawn" ;; *) sstatus="active" ;; esac
      srules="$({ grep -oE 'DR-[0-9]{3}' "$sf" 2>/dev/null | awk '!seen[$0]++' | paste -sd, -; } || true)"
      smods="$(scenario_block_modules "$sf")"
      slayer="$(scenario_block_field "$sf" "Seam layer")"
      if $psfirst; then psfirst=false; else prior_scenarios_json="${prior_scenarios_json},"; fi
      prior_scenarios_json="${prior_scenarios_json}
    {\"gm_id\": \"$(json_escape "$sid")\", \"title\": \"$(json_escape "$stitle")\", \"status\": \"${sstatus}\", \"rules\": [$(csv_to_json_array "$srules")], \"modules\": [$(csv_to_json_array "$smods")], \"seam_layer\": $(json_str_or_null "$slayer")}"
    done
    rm -rf "$sworkdir"
  fi
  local next_gm_id; next_gm_id="$(printf 'GM-%03d' "$next_gm_num")"

  local output
  output=$(cat <<ENDJSON
{
  "project_root": "$(json_escape "$project_root")",
  "domain_model_path": ".specclaw/analysis/domain-model.md",
  "module_scope": $(json_str_or_null "$module_scope"),
  "module_map": {
    "present": ${map_present},
    "path": ".specclaw/analysis/module-map.md",
    "status": "$(json_escape "$map_status")",
    "confirmed": $(case "$map_status" in CONFIRMED*) printf 'true' ;; *) printf 'false' ;; esac),
    "modules": [${modules_json}
    ]
  },
  "prior_scenarios": [${prior_scenarios_json}
  ],
  "next_gm_id": "$(json_escape "$next_gm_id")",
  "supplementary_docs_present": [${docs_present_json}
  ],
  "supplementary_docs_missing": [${docs_missing_json}
  ],
  "clarifications_md": {"present": ${clar_present}, "path": ".specclaw/analysis/clarifications.md"},
  "pending_questions_md": {"present": ${pq_present}, "path": ".specclaw/analysis/pending-questions.md"}
}
ENDJSON
)
  emit_json "$output"
}

# ─── Subcommand: harness-collect (harness mode, pre-agent) ───────────────────

cmd_harness_collect() {
  local specclaw_dir="$1"; shift
  local module_scope=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --module)
        shift
        [ $# -gt 0 ] || die "--module requires a MOD-### id (e.g. --module MOD-002)."
        module_scope="$1"
        ;;
      --module=*) module_scope="${1#--module=}" ;;
      *) die "Unknown option for harness-collect: $1" ;;
    esac
    shift
  done
  if [ -n "$module_scope" ] && ! [[ "$module_scope" =~ ^MOD-[0-9]{3}$ ]]; then
    die "--module expects a MOD-### id (three digits, e.g. MOD-002); got '${module_scope}'."
  fi

  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"

  local specclaw_dir_abs project_root baseline_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  baseline_dir="$specclaw_dir_abs/baseline"

  local seams_file="$baseline_dir/seams.md"
  local scenarios_file="$baseline_dir/scenarios.md"
  if ! { [ -f "$seams_file" ] && [ -f "$scenarios_file" ]; }; then
    die "No .specclaw/baseline/seams.md and scenarios.md found — run /specclaw:bf-baseline (design mode) first, confirm the recommended seam, then re-run with --harness."
  fi

  # Archive any prior harness wholesale (it's a directory, not a single file
  # — same archive-then-replace convention, applied to a directory).
  #
  # NOT under --module: a one-module harness run must leave every other
  # module's generated tests exactly where they are. Archiving the directory
  # and handing the agent one module's scenario list would delete the rest of
  # the harness and then quietly rebuild a fraction of it.
  if [ -z "$module_scope" ]; then
    if [ -d "$baseline_dir/harness" ]; then
      mkdir -p "$baseline_dir/archive"
      mv "$baseline_dir/harness" "$baseline_dir/archive/$(date +%Y-%m-%d-%H%M%S)-harness"
    fi
  fi
  mkdir -p "$baseline_dir/harness"
  mkdir -p "$baseline_dir/fixtures"

  # Deterministic checklist: every GM-NNN ID the agent must implement
  # one-for-one, not re-derive by re-reading scenarios.md's prose. Under
  # --module, only that module's ids — filtered on each scenario's own
  # declared Modules field, never on prose.
  local workdir; workdir="$(mktemp -d)"
  split_scenario_blocks "$scenarios_file" "$workdir"

  shopt -s nullglob
  local -a block_files=("$workdir"/GM-*.md)
  shopt -u nullglob

  local ids_json="" first=true f sid_mods skipped=0 total=0
  for f in "${block_files[@]}"; do
    # A tombstoned scenario is never implemented — it exists only to keep its
    # id claimed.
    case "$(scenario_block_title "$f")" in WITHDRAWN*) continue ;; esac
    total=$((total + 1))
    if [ -n "$module_scope" ]; then
      sid_mods="$(scenario_block_modules "$f")"
      if [[ ",${sid_mods}," != *",${module_scope},"* ]]; then
        skipped=$((skipped + 1))
        continue
      fi
    fi
    if $first; then first=false; else ids_json="${ids_json}, "; fi
    ids_json="${ids_json}\"$(json_escape "$(scenario_block_id "$f")")\""
  done
  rm -rf "$workdir"

  if [ -n "$module_scope" ] && [ -z "$ids_json" ]; then
    die "No scenario in .specclaw/baseline/scenarios.md declares module ${module_scope} — there is nothing to generate a harness for. Run design mode (with --module ${module_scope}) first so those scenarios exist and carry their Modules field."
  fi

  # Under --module the agent is editing INSIDE an existing harness project, so
  # it needs to know what is already there — otherwise it either duplicates a
  # test or reinvents the project layout beside the real one.
  local existing_json="" efirst=true rel
  if [ -n "$module_scope" ] && [ -d "$baseline_dir/harness" ]; then
    while IFS= read -r rel; do
      [ -z "$rel" ] && continue
      if $efirst; then efirst=false; else existing_json="${existing_json}, "; fi
      existing_json="${existing_json}\"$(json_escape "${rel#"$baseline_dir/harness/"}")\""
    done < <(find "$baseline_dir/harness" -type f 2>/dev/null | sort)
  fi

  local output
  output=$(cat <<ENDJSON
{
  "project_root": "$(json_escape "$project_root")",
  "seams_path": ".specclaw/baseline/seams.md",
  "scenarios_path": ".specclaw/baseline/scenarios.md",
  "harness_dir": ".specclaw/baseline/harness",
  "fixtures_dir": ".specclaw/baseline/fixtures",
  "module_scope": $(json_str_or_null "$module_scope"),
  "harness_archived": $(if [ -z "$module_scope" ]; then printf 'true'; else printf 'false'; fi),
  "scenario_ids": [${ids_json}],
  "existing_harness_files": [${existing_json}]
}
ENDJSON
)
  emit_json "$output"

  if [ -n "$module_scope" ]; then
    echo "Module-scoped harness run for ${module_scope}: $(printf '%s' "$ids_json" | grep -o 'GM-' | wc -l | tr -d ' ') of ${total} scenario(s) selected, ${skipped} belong to other modules and were left untouched. The existing harness directory was NOT archived or emptied." >&2
  fi
}

# ─── Subcommand: record (record mode — fully deterministic) ─────────────────

cmd_record() {
  local specclaw_dir="$1"
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"

  local specclaw_dir_abs project_root baseline_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  baseline_dir="$specclaw_dir_abs/baseline"

  local scenarios_file="$baseline_dir/scenarios.md"
  [ -f "$scenarios_file" ] || die "No .specclaw/baseline/scenarios.md found — run /specclaw:bf-baseline (design mode) first."
  require_jq
  load_gm_paths

  local fixtures_dir="$baseline_dir/fixtures"
  local manifest_file="$baseline_dir/manifest.json"
  local archive_dir="$baseline_dir/archive"
  local error_map="$baseline_dir/error-map.md"
  local map_file="$specclaw_dir_abs/analysis/module-map.md"
  local backlog_file="$specclaw_dir_abs/analysis/rebuild-backlog.md"

  # ── The BL-item -> module index, for the trace-line consistency check.
  # MOD -> BL -> DR -> GM is only walkable if the two documents that declare
  # module membership agree: the map owns which module a RULE belongs to, and
  # rebuild-backlog.md owns which module an ITEM is filed under. A fixture
  # derived from the map's rule ownership that lands in a different module
  # than its own BL item means one of the two is wrong, and bash cannot know
  # which — so it names both and warns. Never a hard failure: the manifest is
  # still valid evidence, and blocking it would make a documentation
  # disagreement destroy a capture run.
  # BL_RULES is the same index keyed the other way — each item's own
  # acceptance-basis DR rules — used to fill in a scenario's `Verifies backlog
  # item` when the scenario itself declares none. BEST-EFFORT METADATA ONLY:
  # /specclaw:bf-replay re-derives this join from these same two documents at
  # replay time and never depends on what is stamped here (CONTRACT.md (b)).
  # The point is that a manifest recorded after the backlog exists carries a
  # real BL tag instead of the designer's "not yet backlog-linked" placeholder
  # — not that anything downstream may start trusting the field.
  local -A BL_MODULE=() BL_RULES=()
  if [ -f "$backlog_file" ]; then
    local blworkdir; blworkdir="$(mktemp -d)"
    awk -v dir="$blworkdir" '
      /^### BL-[0-9]+/ { match($0, /BL-[0-9]+/); id = substr($0, RSTART, RLENGTH); outfile = dir "/" id ".md" }
      /^## / && !/^### BL-[0-9]+/ { id = "" }
      id != "" { print $0 >> outfile }
    ' "$backlog_file"
    shopt -s nullglob
    local -a bl_files=("$blworkdir"/BL-*.md)
    shopt -u nullglob
    local blf blid blmod bltitle blrules
    for blf in "${bl_files[@]}"; do
      blid="$(basename "$blf" .md)"
      blmod="$({ grep -m1 -- '^\*\*Module:\*\*' "$blf" 2>/dev/null | grep -oE 'MOD-[0-9]{3}' | head -1; } || true)"
      [ -n "$blmod" ] && BL_MODULE["$blid"]="$blmod"
      # A STRUCK tombstone is an id kept claimed, not an item anything can
      # verify — it must never become a fixture's BL tag.
      bltitle="$(head -1 "$blf" | sed -E 's/^### BL-[0-9]+[[:space:]]*(—|-)[[:space:]]*//' | tr -d '\r')"
      case "$bltitle" in STRUCK*) continue ;; esac
      # The bash-RECOMPUTED lines are dropped before reading DR ids, mirroring
      # exactly what specclaw-bf-replay's own backlog_item_dr_ids and
      # specclaw-bf-rebuild-collect's ITEM_RULES exclude. Copied rather than
      # shared across the three scripts, per repo convention — but the rule
      # must stay identical in all three or the joins disagree.
      blrules="$(tail -n +2 "$blf" | awk '
          /^\*\*Gate:\*\*/ { skip=1; next }
          /^\*\*Verification:\*\*/ { skip=1; next }
          /^\*\*UI fidelity:\*\*/ { skip=1; next }
          /^\*\*Status:\*\* Deferred/ { skip=1; next }
          /^\*\*Status notes \(human-added\):\*\*/ { intail=1; next }
          intail { next }
          /^\*\*Settled constraints/ { skip=0 }
          skip { next }
          { print }
        ' | { grep -oE 'DR-[0-9]{3}' | awk '!seen[$0]++' | paste -sd, -; } || true)"
      [ -n "$blrules" ] && BL_RULES["$blid"]="$blrules"
    done
    rm -rf "$blworkdir"
  fi

  # MOD -> the DR rules that module owns, for filling in a scenario's `Modules`
  # when it declares none. Same best-effort tier as BL_RULES above.
  local -A MOD_RULES=()
  if [ -f "$map_file" ]; then
    local mrworkdir; mrworkdir="$(mktemp -d)"
    awk -v dir="$mrworkdir" '
      /^### MOD-[0-9]+/ { match($0, /MOD-[0-9]+/); id = substr($0, RSTART, RLENGTH); outfile = dir "/" id ".md" }
      /^## / && !/^### MOD-[0-9]+/ { id = "" }
      id != "" { print $0 >> outfile }
    ' "$map_file"
    shopt -s nullglob
    local -a mr_files=("$mrworkdir"/MOD-*.md)
    shopt -u nullglob
    # Reciprocal, same as collect's module_map.modules[].rules: a rule
    # co-owned with this module but only written on the OTHER module's line
    # must still count as this module's too, or a scenario left to this
    # fallback would derive only the annotating module and never its
    # declared co-owner.
    local mr_coown_file="$mrworkdir/.coowned"
    local mrlf
    local -a mr_live_files=()
    while IFS= read -r mrlf; do
      if [ -n "$mrlf" ]; then mr_live_files+=("$mrlf"); fi
    done < <(non_withdrawn_module_files ${mr_files[@]+"${mr_files[@]}"})
    coowned_pairs ${mr_live_files[@]+"${mr_live_files[@]}"} > "$mr_coown_file"
    local mrf mrid mrtitle mrrules
    for mrf in "${mr_files[@]}"; do
      mrid="$(basename "$mrf" .md)"
      mrtitle="$(head -1 "$mrf" | sed -E 's/^### MOD-[0-9]+[[:space:]]*(—|-)[[:space:]]*//' | tr -d '\r')"
      case "$mrtitle" in WITHDRAWN*) continue ;; esac
      # Scoped to the "Business rules" line alone — see the matching comment
      # in cmd_collect above; a DR-### cited only in this module's own
      # "Depends on" rationale is not this module's rule.
      mrrules="$({ scenario_block_field "$mrf" "Business rules" | grep -oE 'DR-[0-9]{3}' | awk '!seen[$0]++' | paste -sd, -; } || true)"
      mrrules="$(apply_coowned_rules "$mrid" "$mrrules" "$mr_coown_file")"
      [ -n "$mrrules" ] && MOD_RULES["$mrid"]="$mrrules"
    done
    rm -rf "$mrworkdir"
  fi

  # Any shared token between two comma-joined id lists.
  csv_intersects() {
    local tok
    local -a _toks=()
    IFS=',' read -ra _toks <<< "$1"
    for tok in ${_toks[@]+"${_toks[@]}"}; do
      [ -z "$tok" ] && continue
      [[ ",$2," == *",${tok},"* ]] && return 0
    done
    return 1
  }

  local plugin_version
  plugin_version="$(jq -r '.version // "unknown"' "$PLUGIN_ROOT/.claude-plugin/plugin.json" 2>/dev/null || echo "unknown")"

  # Prior manifest's per-scenario content hash, read BEFORE archiving —
  # the only way to detect SUPERSEDED (see scenario_block_hash above).
  # Absent for a scenario's first-ever record (nothing to compare against
  # yet), which is correctly treated as "not superseded" below.
  local -A prior_scenario_hash=()
  if [ -f "$manifest_file" ] && jq -e . "$manifest_file" >/dev/null 2>&1; then
    local psid pshash
    while IFS=$'\t' read -r psid pshash; do
      [ -z "$psid" ] && continue
      prior_scenario_hash["$psid"]="$pshash"
    # `tr -d '\r'` is load-bearing, not cosmetic: jq's Windows build emits
    # CRLF, and a trailing \r on the recorded hash means it never equals the
    # freshly computed one — so EVERY scenario reads SUPERSEDED on every
    # re-record, and every replay is held at PASS-PENDING-DECISIONS forever
    # for a reason no one can find. Same guard this script already applies to
    # its other jq-to-read pipes.
    done < <(jq -r '.fixtures[]? | [.scenario_id, (.scenario_content_hash // "")] | @tsv' "$manifest_file" 2>/dev/null | tr -d '\r' || true)
  fi

  local workdir; workdir="$(mktemp -d)"
  split_scenario_blocks "$scenarios_file" "$workdir"

  shopt -s nullglob
  local -a block_files=("$workdir"/GM-*.md)
  shopt -u nullglob

  [ "${#block_files[@]}" -gt 0 ] || { rm -rf "$workdir"; die "no GM-NNN scenarios found in .specclaw/baseline/scenarios.md — nothing to record against."; }

  local fixtures_json="" missing_json="" ffirst=true mfirst=true
  local -a module_warnings=()
  local f id seam seam_layer rules backlog_item fixture_path content_hash scenario_hash status modules
  local captured_at anchor_date commit_sha runtime_version normalized_fields
  local outcome error_code threw resolution_json
  local captured_count=0 missing_count=0 tombstone_count=0
  local verifiable_count=0 provisional_count=0 superseded_count=0

  # Every validation failure across every scenario is collected here and
  # reported together at the end — a human fixing captures wants the whole
  # list in one pass, not one error per re-run. Any entry means no manifest is
  # written and no prior manifest is archived.
  local -a problems=()

  for f in "${block_files[@]}"; do
    id="$(scenario_block_id "$f")"

    # A WITHDRAWN tombstone is an id kept claimed, not a scenario: it declares
    # no seam layer, pins no rule, and can never be captured. Skipping it here
    # is what keeps a tombstone from failing the whole record on the
    # "declares no Seam layer" check — while its id still counts toward the
    # next free GM id, so nothing ever reuses it.
    case "$(scenario_block_title "$f")" in
      WITHDRAWN*) tombstone_count=$((tombstone_count + 1)); continue ;;
    esac

    seam="$(scenario_block_field "$f" "Seam")"
    seam_layer="$(scenario_block_field "$f" "Seam layer")"
    rules="$(scenario_block_field "$f" "Business rules pinned")"
    backlog_item="$(scenario_block_field "$f" "Verifies backlog item")"
    modules="$(scenario_block_modules "$f")"
    fixture_path="$fixtures_dir/${id}.json"
    scenario_hash="sha256:$(scenario_block_hash "$f")"

    # ── Best-effort metadata fill-in ────────────────────────────────────────
    # The pipeline's own order runs /specclaw:bf-baseline (A4) BEFORE
    # /specclaw:bf-rebuild-plan (A5), so on a first design the scenarios
    # genuinely cannot name a backlog item and the designer writes the
    # documented "not yet backlog-linked" placeholder. Every re-record AFTER
    # the backlog exists can do better, and does so here.
    #
    # FILL-IN ONLY, NEVER OVERWRITE: a value the scenario declares itself is a
    # deliberate statement by the design agent and stands verbatim, exactly as
    # CONTRACT.md (l) requires for `Modules`. And absence stays legal — no
    # project is required to have either document at record time, and nothing
    # downstream may require the result: this is metadata, and
    # /specclaw:bf-replay's own join re-derives it from these same documents.
    local rule_toks
    rule_toks="$(printf '%s' "$rules" | { grep -oE 'DR-[0-9]{3}' | awk '!seen[$0]++' | paste -sd, -; } || true)"

    if [ -n "$rule_toks" ] && [ "${#BL_RULES[@]}" -gt 0 ] \
       && ! printf '%s' "$backlog_item" | grep -qE 'BL-[0-9]{3}'; then
      local derived_bls="" blk
      # Sorted, so the recorded value is deterministic across runs rather than
      # dependent on bash's associative-array ordering.
      while IFS= read -r blk; do
        [ -z "$blk" ] && continue
        csv_intersects "$rule_toks" "${BL_RULES[$blk]}" || continue
        derived_bls="${derived_bls}${derived_bls:+, }${blk}"
      done < <(printf '%s\n' "${!BL_RULES[@]}" | sort)
      [ -n "$derived_bls" ] && backlog_item="$derived_bls"
    fi

    if [ -n "$rule_toks" ] && [ "${#MOD_RULES[@]}" -gt 0 ] && [ -z "$modules" ]; then
      local derived_mods="" mrk
      while IFS= read -r mrk; do
        [ -z "$mrk" ] && continue
        csv_intersects "$rule_toks" "${MOD_RULES[$mrk]}" || continue
        derived_mods="${derived_mods}${derived_mods:+,}${mrk}"
      done < <(printf '%s\n' "${!MOD_RULES[@]}" | sort)
      [ -n "$derived_mods" ] && modules="$derived_mods"
    fi

    # A declared module that names nothing in the map is a hard error, on the
    # same grounds as an error_code with no error-map heading: it looks like a
    # decided fact everywhere downstream, while selecting exactly nothing in
    # /specclaw:bf-replay --module. Only checked when the map exists — a
    # project with no module map legitimately declares no modules at all.
    if [ -f "$map_file" ] && [ -n "$modules" ]; then
      local mtok
      while IFS= read -r mtok; do
        [ -z "$mtok" ] && continue
        if ! grep -qE "^### ${mtok}([[:space:]]|$)" "$map_file"; then
          problems+=("${id}: declares module '${mtok}' but .specclaw/analysis/module-map.md has no '### ${mtok}' heading — a module tag naming no module selects nothing in /specclaw:bf-replay --module, silently.")
        fi
      # `printf '%s\n'`, never `printf '%s'`: without the trailing newline
      # `read` returns false on the final (only) line and the loop body never
      # runs at all — which silently disabled this entire check.
      done < <(printf '%s\n' "$modules" | tr ',' '\n')
    elif [ ! -f "$map_file" ] && [ -n "$modules" ]; then
      module_warnings+=("${id}: declares module(s) ${modules}, but .specclaw/analysis/module-map.md does not exist here, so the tag cannot be validated against anything.")
    fi

    # Trace-line consistency (MOD -> BL -> DR -> GM): the scenario's module
    # comes from the map's rule ownership; its BL item's module comes from the
    # backlog. If they disagree, name both — one document is wrong.
    if [ -n "$modules" ] && [ ${#BL_MODULE[@]} -gt 0 ]; then
      local bltok blmod_expected
      bltok="$(printf '%s' "$backlog_item" | { grep -oE 'BL-[0-9]{3}' | head -1; } || true)"
      if [ -n "$bltok" ]; then
        blmod_expected="${BL_MODULE[$bltok]:-}"
        if [ -n "$blmod_expected" ] && [[ ",${modules}," != *",${blmod_expected},"* ]]; then
          module_warnings+=("${id}: scenario declares module(s) ${modules} (from module-map.md's rule ownership) but its own backlog item ${bltok} is filed under ${blmod_expected} in rebuild-backlog.md. One of the two documents is wrong — this is not decided here.")
        fi
      fi
    fi

    # Per CONTRACT.md (i): declared, never derived, never defaulted. Checked
    # for every scenario, captured or not — a scenario with no layer cannot
    # produce a manifest entry that carries one, and silently defaulting it is
    # exactly how a service-layer fixture ends up replayed through HTTP.
    if [ -z "$seam_layer" ]; then
      problems+=("${id}: scenarios.md declares no '- **Seam layer:**' field. Add one of: ${SEAM_LAYERS[*]} — then re-run /specclaw:bf-baseline (design mode) if the whole document predates this field.")
    elif ! seam_layer_valid "$seam_layer"; then
      problems+=("${id}: seam layer '${seam_layer}' is not one of: ${SEAM_LAYERS[*]}.")
    fi

    # Status per templates/CONTRACT.md (c') — computed mechanically from
    # this scenario's own text, same discipline as sanction-check's literal
    # heading grep: never an agent's word for it.
    local provisional_ref=""
    if [ -n "${prior_scenario_hash[$id]:-}" ] && [ "${prior_scenario_hash[$id]}" != "$scenario_hash" ]; then
      status="SUPERSEDED"
    elif grep -qF '⚠ PROVISIONAL' "$f" 2>/dev/null; then
      status="PROVISIONAL"
      # Not part of CONTRACT.md's documented enum — internal plumbing, same
      # tier as content_hash, so specclaw-bf-replay's report can name which
      # PQ/CQ blocks this fixture instead of only stating that one does.
      provisional_ref="$(grep -oE 'PQ-[0-9]+|CQ-[0-9]+' "$f" 2>/dev/null | awk '!seen[$0]++' | paste -sd, - 2>/dev/null || true)"
    else
      status="VERIFIABLE"
    fi

    if [ -f "$fixture_path" ]; then
      captured_count=$((captured_count + 1))
      case "$status" in
        VERIFIABLE) verifiable_count=$((verifiable_count + 1)) ;;
        PROVISIONAL) provisional_count=$((provisional_count + 1)) ;;
        SUPERSEDED) superseded_count=$((superseded_count + 1)) ;;
      esac
      content_hash="sha256:$(sha256sum "$fixture_path" 2>/dev/null | awk '{print $1}')"
      outcome=""; error_code=""; threw="null"; resolution_json="[]"
      if jq -e . "$fixture_path" >/dev/null 2>&1; then
        captured_at="$(fixture_field "$fixture_path" "captured_at")"
        anchor_date="$(fixture_field "$fixture_path" "anchor_date")"
        commit_sha="$(fixture_field "$fixture_path" "legacy_commit_sha")"
        runtime_version="$(fixture_field "$fixture_path" "runtime_version")"
        normalized_fields="$(fixture_array_field "$fixture_path" "normalized_fields")"

        # ── One structural pass over this fixture's own output, via the same
        # shared library specclaw-bf-replay compare uses (CONTRACT.md (g),
        # (b.1), (h)). Everything below is read off that one result. ───────
        # The library and the program must be ONE jq argument (they are
        # concatenated below, no space) — passed as two, jq reads the second
        # as a filename and every check silently reads back null.
        # The output itself goes through a FILE, never --argjson. A golden
        # master of a list, a report, or a paged response is easily tens of
        # KB, and Windows caps a command line at ~32,767 characters — passed
        # through argv, a fat but perfectly valid fixture made this jq die
        # with "Argument list too long", and `record` then reported the
        # fixture as missing outcome/threw/error_code and told the operator to
        # re-capture it. A false finding is worse than a crash: the crash at
        # least announced itself. `|| true` keeps a write failure flowing into
        # the same "could not be analysed" handler below instead of aborting
        # the whole record under `set -e`.
        local facts
        jq -c '.output // null' "$fixture_path" > "$workdir/fixture-output.json" 2>/dev/null || true
        if ! facts="$(jq -n \
              --slurpfile out_in "$workdir/fixture-output.json" \
              --argjson norm "$normalized_fields" \
              "$GM_PATHS_JQ"'
          ($out_in[0]) as $out
          | {
            has_outcome:    gm_has_leaf($out; "outcome"),
            has_threw:      gm_has_leaf($out; "threw"),
            has_error_code: gm_has_leaf($out; "error_code"),
            summary:        gm_outcome_summary($out),
            codes:          gm_declared_codes($out),
            unmapped:       gm_unmapped_rejections($out),
            resolution:     gm_resolution_report($norm; $out)
          }' 2>&1)"; then
          problems+=("${id}: fixture output could not be analysed — ${facts}")
          facts='{}'
        fi

        resolution_json="$(jq -c '.resolution // []' <<< "$facts")"
        outcome="$(jq -r '.summary.outcome // "" | tostring' <<< "$facts")"
        error_code="$(jq -r '.summary.error_code // "" | tostring' <<< "$facts")"
        # Not `// null` — `threw` is legitimately false, and `false // null`
        # would record every non-throwing capture as "nothing recorded".
        threw="$(jq -c 'if has("summary") then .summary.threw else null end' <<< "$facts")"

        # (1) Dead normalization paths. A path matching zero fields normalizes
        # nothing, so the field it names diverges on every single replay —
        # which is how a rebuild with no defects produces a report full of
        # divergences. Never silently accepted.
        local dead
        while IFS= read -r dead; do
          [ -z "$dead" ] && continue
          problems+=("${id}: normalized_fields path ${dead}")
        done < <(jq -r '
          .resolution[]? | select(.matches == 0)
          | "\"" + .path + "\" matched nothing in the captured output"
            + (if (.suggestions | length) > 0
               then " — did you mean " + ([.suggestions[] | "\"" + . + "\""] | join(" or ")) + "?"
               else " (no similarly-named path exists either — check the fixture actually captured this field)" end)
        ' <<< "$facts" 2>/dev/null | tr -d '\r' || true)

        # (2) The error-outcome contract. Required on every fixture: a seam
        # either completed or it did not, and recording that as a business
        # fact is what makes error comparison survive a rebuild onto another
        # framework (CONTRACT.md (b.1)).
        local -a missing_error_fields=()
        [ "$(jq -r '.has_outcome' <<< "$facts")" = "true" ]    || missing_error_fields+=("outcome")
        [ "$(jq -r '.has_threw' <<< "$facts")" = "true" ]      || missing_error_fields+=("threw")
        [ "$(jq -r '.has_error_code' <<< "$facts")" = "true" ] || missing_error_fields+=("error_code")
        if [ "${#missing_error_fields[@]}" -gt 0 ]; then
          problems+=("${id}: fixture output is missing ${missing_error_fields[*]} (CONTRACT.md (b.1)). This fixture predates the semantic error contract — re-run /specclaw:bf-baseline --harness, re-capture, then --record.")
        fi

        # (3) Ask, don't guess: a recorded rejection with no semantic code is
        # legal only when an agent genuinely raised a pending question about
        # it, which is exactly what the scenario's PROVISIONAL marker records.
        if [ "$status" != "PROVISIONAL" ]; then
          local upath
          while IFS= read -r upath; do
            [ -z "$upath" ] && continue
            problems+=("${id}: output.${upath} is null while its outcome is REJECTED, but the scenario is not marked PROVISIONAL. Either map the condition to a code in .specclaw/baseline/error-map.md, or raise a pending question and mark the scenario ⚠ PROVISIONAL — never leave a rejection unexplained.")
          done < <(jq -r '.unmapped[]?' <<< "$facts" 2>/dev/null | tr -d '\r' || true)
        fi

        # (4) Every code asserted by a fixture must exist in the project's own
        # error-map.md, verified by literal heading grep — the same discipline
        # sanction-check uses on a CQ citation, and the reason the plugin
        # itself never needs to know a single code.
        # (`tr -d '\r'` on every jq-to-read pipe: jq's Windows build emits
        # CRLF, and a trailing \r silently breaks both the regex below and the
        # grep. Same guard specclaw-bf-rebuild-collect already applies.)
        local code
        while IFS= read -r code; do
          [ -z "$code" ] && continue
          if ! [[ "$code" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
            problems+=("${id}: error_code '${code}' is not SCREAMING_SNAKE (CONTRACT.md (b.1)).")
          elif [ ! -f "$error_map" ]; then
            problems+=("${id}: error_code '${code}' is asserted but .specclaw/baseline/error-map.md does not exist. That document is this project's own error vocabulary — /specclaw:bf-baseline --harness creates it.")
          elif ! grep -qE "^### ${code}([[:space:]]|$)" "$error_map"; then
            problems+=("${id}: error_code '${code}' has no '### ${code}' heading in .specclaw/baseline/error-map.md — an unmapped code is a guess, not a decision.")
          fi
        done < <(jq -r '.codes[]?' <<< "$facts" 2>/dev/null | tr -d '\r' || true)
      else
        problems+=("${id}: fixture at .specclaw/baseline/fixtures/${id}.json is not valid JSON — it cannot be validated or compared. Fix the fixture-writer's output and re-capture.")
        captured_at=""; anchor_date=""; commit_sha=""; runtime_version=""; normalized_fields="[]"
      fi

      if $ffirst; then ffirst=false; else fixtures_json="${fixtures_json},"; fi
      fixtures_json="${fixtures_json}
    {
      \"scenario_id\": \"$(json_escape "$id")\",
      \"seam\": \"$(json_escape "$seam")\",
      \"seam_layer\": \"$(json_escape "$seam_layer")\",
      \"business_rules_pinned\": \"$(json_escape "$rules")\",
      \"verifies_backlog_item\": \"$(json_escape "$backlog_item")\",
      \"module_ids\": [$(csv_to_json_array "$modules")],
      \"fixture_path\": \"$(json_escape ".specclaw/baseline/fixtures/${id}.json")\",
      \"content_hash\": \"$(json_escape "$content_hash")\",
      \"scenario_content_hash\": \"$(json_escape "$scenario_hash")\",
      \"status\": \"$(json_escape "$status")\",
      \"provisional_ref\": \"$(json_escape "$provisional_ref")\",
      \"captured_at\": \"$(json_escape "$captured_at")\",
      \"anchor_date\": \"$(json_escape "$anchor_date")\",
      \"legacy_commit_sha\": \"$(json_escape "$commit_sha")\",
      \"runtime_version\": \"$(json_escape "$runtime_version")\",
      \"outcome\": $(json_str_or_null "$outcome"),
      \"error_code\": $(json_str_or_null "$error_code"),
      \"threw\": ${threw},
      \"normalized_fields\": ${normalized_fields},
      \"normalized_fields_resolved\": ${resolution_json}
    }"
    else
      missing_count=$((missing_count + 1))
      if $mfirst; then mfirst=false; else missing_json="${missing_json}, "; fi
      missing_json="${missing_json}\"$(json_escape "$id")\""
    fi
  done
  rm -rf "$workdir"

  # Refuse to write a manifest, and refuse to archive the prior one, on any
  # validation failure. A half-valid manifest is worse than none: every
  # downstream reader treats it as sealed evidence, and the run that produced
  # it has already thrown away the manifest that was actually correct.
  if [ "${#problems[@]}" -gt 0 ]; then
    local joined
    joined="$(printf '  - %s\n' "${problems[@]}")"
    die "Baseline validation failed — ${#problems[@]} problem(s). manifest.json was NOT written and the existing one was NOT archived:
${joined}"
  fi

  if [ -f "$manifest_file" ]; then
    mkdir -p "$archive_dir"
    mv "$manifest_file" "$archive_dir/$(date +%Y-%m-%d-%H%M%S)-manifest.json"
  fi

  # Tombstones are not scenarios — counting them would report a corpus larger
  # than anything that can ever be captured, and every re-run would look
  # permanently incomplete.
  local total=$(( ${#block_files[@]} - tombstone_count ))
  local output
  output=$(cat <<ENDJSON
{
  "manifest_schema": 3,
  "plugin_version": "$(json_escape "$plugin_version")",
  "project_root": "$(json_escape "$project_root")",
  "generated": "$(date +%Y-%m-%d)",
  "generated_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "total_scenarios": ${total},
  "fixtures": [${fixtures_json}
  ],
  "missing_scenarios": [${missing_json}]
}
ENDJSON
)

  printf '%s\n' "$output" > "$manifest_file"
  emit_json "$output"

  echo "Wrote $manifest_file (${captured_count}/${total} scenarios captured, ${missing_count} missing; of captured: ${verifiable_count} VERIFIABLE, ${provisional_count} PROVISIONAL, ${superseded_count} SUPERSEDED — recapture a SUPERSEDED fixture, its scenario definition changed since capture)" >&2

  # Module consistency findings are WARNs, deliberately reported AFTER the
  # manifest is written: they describe a disagreement between two analysis
  # documents, not a defect in the captured evidence, so they must never cost
  # a capture run its manifest.
  if [ "${#module_warnings[@]}" -gt 0 ]; then
    warn "module consistency — ${#module_warnings[@]} finding(s); the manifest was written and is valid, but these should be reconciled:"
    printf '  - %s\n' "${module_warnings[@]}" >&2
  fi
}

# ─── Subcommand: merge-scenarios (module-scoped design merge) ────────────────
#
# Whole-corpus design mode is unchanged: the agent writes scenarios.md itself
# after the skill archives the prior one, exactly as before. A MODULE-scoped
# design cannot work that way — the agent only drafted one module's scenarios,
# so letting it write the file would delete every other module's blocks and
# break GM-id permanence in one step. So bash owns the merge for that path,
# the same split /specclaw:bf-rebuild-plan uses: agent drafts, bash renders.

cmd_merge_scenarios() {
  local specclaw_dir="$1" draft_file="$2" module_scope="$3"
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"
  [ -f "$draft_file" ] || die "draft file not found: $draft_file"
  [[ "$module_scope" =~ ^MOD-[0-9]{3}$ ]] || die "merge-scenarios expects a MOD-### id (three digits); got '${module_scope}'."

  local specclaw_dir_abs baseline_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  baseline_dir="$specclaw_dir_abs/baseline"
  local scenarios_file="$baseline_dir/scenarios.md"
  [ -f "$scenarios_file" ] || die "No .specclaw/baseline/scenarios.md found — a module-scoped design merges into an existing corpus design. Run /specclaw:bf-baseline (design mode, no --module) first to establish one."

  local workdir; workdir="$(mktemp -d)"
  mkdir -p "$workdir/old" "$workdir/new"
  split_scenario_blocks "$scenarios_file" "$workdir/old"
  split_scenario_blocks "$draft_file" "$workdir/new"

  shopt -s nullglob
  local -a old_files=("$workdir/old"/GM-*.md) new_files=("$workdir/new"/GM-*.md)
  shopt -u nullglob
  [ "${#new_files[@]}" -gt 0 ] || { rm -rf "$workdir"; die "draft ${draft_file} contains no '### GM-NNN' scenario blocks — nothing to merge."; }

  # Every id the draft supplies, and every id the scoped module previously had.
  local drafted_ids="" f id
  for f in "${new_files[@]}"; do drafted_ids="${drafted_ids} $(scenario_block_id "$f")"; done

  local today; today="$(date +%Y-%m-%d)"
  local replaced=0 preserved=0 tombstoned=0 added=0
  local -a tombstones=() shared_kept=() shared_rewritten=()

  # ── Decide an action per existing id, then apply them by STREAMING the
  # original document. A preserved block must come out byte-for-byte
  # identical, including its own trailing blank lines: `record` hashes each
  # scenario's block text to detect SUPERSEDED, so re-emitting an untouched
  # block through split-and-reassemble (which normalizes trailing newlines)
  # would mark another module's already-captured fixtures as needing
  # recapture. A one-module run must cost the other modules nothing at all. ─
  local action_file="$workdir/actions.tsv"; : > "$action_file"
  for f in "${old_files[@]}"; do
    id="$(scenario_block_id "$f")"
    local old_mods; old_mods="$(scenario_block_modules "$f")"

    # Is this scenario shared with a module other than the scoped one? A
    # multi-module scenario pins a flow that crosses a boundary, and a
    # single-module run has NO authority to retire the other module's
    # coverage of it.
    local shared=false omod
    while IFS= read -r omod; do
      [ -z "$omod" ] && continue
      [ "$omod" = "$module_scope" ] && continue
      shared=true
    done < <(printf '%s\n' "$old_mods" | tr ',' '\n')

    local is_tombstone=false
    case "$(scenario_block_title "$f")" in WITHDRAWN*) is_tombstone=true ;; esac

    if [[ " ${drafted_ids} " == *" ${id} "* ]]; then
      printf '%s\tREPLACE\n' "$id" >> "$action_file"
      replaced=$((replaced + 1))
      $shared && shared_rewritten+=("$id")
    elif $is_tombstone; then
      printf '%s\tKEEP\n' "$id" >> "$action_file"
      preserved=$((preserved + 1))
    elif [[ ",${old_mods}," == *",${module_scope},"* ]] && $shared; then
      # Shared, and this run's draft omitted it. KEEP it: retiring a
      # cross-module scenario because a one-module redesign didn't mention it
      # would silently delete another module's proof of a flow spanning both.
      # Reported, never decided here.
      printf '%s\tKEEP\n' "$id" >> "$action_file"
      preserved=$((preserved + 1))
      shared_kept+=("${id} (${old_mods})")
    elif [[ ",${old_mods}," == *",${module_scope},"* ]]; then
      # Owned solely by the scoped module, and this run's draft dropped it.
      # Its id is permanent (CONTRACT.md (c)) — a captured fixture and a
      # manifest entry may already hang off it — so it becomes a tombstone
      # instead of disappearing, and next_gm_id keeps counting past it.
      printf '%s\tTOMBSTONE\n' "$id" >> "$action_file"
      tombstoned=$((tombstoned + 1))
      tombstones+=("$id")
    else
      printf '%s\tKEEP\n' "$id" >> "$action_file"
      preserved=$((preserved + 1))
    fi
  done

  # Tombstone text, written once to a file so awk can splice it in verbatim.
  local tomb_dir="$workdir/tomb"; mkdir -p "$tomb_dir"
  local tid
  for tid in ${tombstones[@]+"${tombstones[@]}"}; do
    cat > "$tomb_dir/${tid}.md" <<TOMBEOF
### ${tid} — WITHDRAWN ${today}, dropped by a module-scoped redesign of ${module_scope}

- **Modules:** ${module_scope}

_This scenario is no longer designed. Its id stays claimed forever so that any manifest entry, fixture, or report still citing it fails loudly rather than silently pointing at a different scenario. If a fixture was already captured for it, that fixture is now orphaned — delete nothing, and recapture under the replacing scenario's own id._

TOMBEOF
  done

  local body_file="$workdir/body.md"
  awk -v actions="$action_file" -v newdir="$workdir/new" -v tombdir="$tomb_dir" '
    BEGIN {
      while ((getline line < actions) > 0) {
        split(line, a, "\t"); act[a[1]] = a[2]
      }
      inscen = 0; cur = ""
    }
    # The Scenarios section only. Everything outside it is handled in bash.
    /^## Scenarios/ { inscen = 1; next }
    inscen && /^## / { inscen = 0 }
    !inscen { next }
    /^### GM-[0-9]+/ {
      match($0, /GM-[0-9]+/); cur = substr($0, RSTART, RLENGTH)
      if (act[cur] == "REPLACE") {
        while ((getline l < (newdir "/" cur ".md")) > 0) print l
        print ""
        next
      }
      if (act[cur] == "TOMBSTONE") {
        while ((getline l < (tombdir "/" cur ".md")) > 0) print l
        next
      }
    }
    # A KEEP block is emitted line-for-line, exactly as it was.
    { if (cur == "" || act[cur] == "KEEP") print }
  ' "$scenarios_file" > "$body_file"

  # Genuinely new ids from the draft, appended in draft order.
  for f in "${new_files[@]}"; do
    id="$(scenario_block_id "$f")"
    [ -f "$workdir/old/${id}.md" ] && continue
    cat "$f" >> "$body_file"
    printf '\n' >> "$body_file"
    added=$((added + 1))
  done

  # The two whole-corpus sections. A module-scoped run did not re-derive
  # either, so they are preserved verbatim with a dated note saying exactly
  # that — the alternative (letting a one-module draft overwrite a corpus-wide
  # coverage check) would turn a partial run into a false all-clear.
  local no_legacy rule_coverage
  no_legacy="$(awk '/^## No Legacy Behaviour Exists/{flag=1;next}/^## /{flag=0}flag' "$scenarios_file" | sed '/./,$!d')"
  rule_coverage="$(awk '/^## Rule Coverage Check/{flag=1;next}/^## /{flag=0}flag' "$scenarios_file" | sed '/./,$!d')"
  local staleness="
_Not re-derived by this run: \`${module_scope}\` was designed in isolation on ${today}, and this section is a whole-corpus finding. Re-run design mode without \`--module\` to recompute it._"

  local header
  header="$(awk '/^## Scenarios/{exit} {print}' "$scenarios_file")"

  mkdir -p "$baseline_dir/archive"
  cp "$scenarios_file" "$baseline_dir/archive/$(date +%Y-%m-%d-%H%M%S)-scenarios.md"

  {
    printf '%s\n' "$header"
    printf '## Scenarios\n\n'
    cat "$body_file"
    printf '## No Legacy Behaviour Exists\n\n'
    printf '%s\n' "${no_legacy:-_None recorded._}"
    printf '%s\n\n' "$staleness"
    printf '## Rule Coverage Check\n\n'
    printf '%s\n' "${rule_coverage:-_Not recorded._}"
    printf '%s\n' "$staleness"
  } > "$scenarios_file"

  rm -rf "$workdir"
  rm -f "$draft_file"

  echo "Merged ${module_scope} into $scenarios_file: ${replaced} scenario(s) replaced, ${added} added, ${preserved} preserved untouched, ${tombstoned} tombstoned.${tombstones[*]+" Tombstoned: ${tombstones[*]}."}" >&2
  if [ "$tombstoned" -gt 0 ]; then
    warn "${tombstoned} scenario id(s) owned solely by ${module_scope} were dropped by this redesign and are now WITHDRAWN tombstones: ${tombstones[*]}. If any had a captured fixture, that fixture is now orphaned — re-run --record to see it drop out of the manifest, and recapture under the replacing scenario's id."
  fi
  if [ "${#shared_kept[@]}" -gt 0 ]; then
    warn "${#shared_kept[@]} cross-module scenario(s) were NOT in this draft and were kept as-is: ${shared_kept[*]}. A ${module_scope}-scoped run cannot retire a scenario another module also depends on — if one of these genuinely should go, re-run design mode without --module so every affected module is re-derived together."
  fi
  if [ "${#shared_rewritten[@]}" -gt 0 ]; then
    warn "${#shared_rewritten[@]} cross-module scenario(s) were REWRITTEN by this ${module_scope}-scoped run: ${shared_rewritten[*]}. They also pin another module's rules, so check that the other module's coverage still holds — and note their fixtures will read SUPERSEDED at the next --record, since the scenario text changed."
  fi
}

# ─── Main ─────────────────────────────────────────────────────────────────────

case "${1:-}" in
  collect)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-baseline collect <specclaw_dir> [--module MOD-###]"
    shift
    cmd_collect "$@"
    ;;
  merge-scenarios)
    [ $# -ge 4 ] || die "Usage: specclaw-bf-baseline merge-scenarios <specclaw_dir> <draft_file> <MOD-###>"
    cmd_merge_scenarios "$2" "$3" "$4"
    ;;
  harness-collect)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-baseline harness-collect <specclaw_dir> [--module MOD-###]"
    shift
    cmd_harness_collect "$@"
    ;;
  record)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-baseline record <specclaw_dir>"
    cmd_record "$2"
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    die "Unknown subcommand: $1. Run specclaw-bf-baseline --help for usage."
    ;;
esac
