#!/usr/bin/env bash
# Regenerate STATUS.md dashboard from current state
# Usage: specclaw-update-status [--integration] <specclaw_dir>

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PARSE_TASKS="$SCRIPT_DIR/specclaw-parse-tasks"

INTEGRATION=0
[ "${1:-}" = "--integration" ] && { INTEGRATION=1; shift; }
SPECCLAW_DIR="$1"
CHANGES_DIR="$SPECCLAW_DIR/changes"
ARCHIVE_DIR="$CHANGES_DIR/archive"

# Read project name from config
PROJECT_NAME=$(grep 'name:' "$SPECCLAW_DIR/config.yaml" | head -1 | sed 's/.*name: *"\(.*\)"/\1/')

# Only integration branches write the committed STATUS.md (057): change
# branches all rewriting it made every parallel merge conflict on it. Elsewhere
# the same dashboard goes inside .git, where nothing can commit it.
status_file() {
  local branch base
  [ "$INTEGRATION" = 1 ] && { echo "$SPECCLAW_DIR/STATUS.md"; return; }
  git -C "$SPECCLAW_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "$SPECCLAW_DIR/STATUS.md"; return; }
  branch="$(git -C "$SPECCLAW_DIR" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  base="$(cfg_val git base_branch)"
  case "$branch" in
    main|master|feature/?*) echo "$SPECCLAW_DIR/STATUS.md"; return ;;
  esac
  [ -n "$branch" ] && [ "$branch" = "$base" ] && { echo "$SPECCLAW_DIR/STATUS.md"; return; }
  git -C "$SPECCLAW_DIR" rev-parse --path-format=absolute --git-path specclaw-STATUS.md
}

# ─── PR state (FR14) ─────────────────────────────────────────────────────────
# A change that is already in review must never render as "awaiting planning".
# Fail-open by contract (NFR2): a missing, unauthenticated, offline, or slow
# `gh`/`az` yields an empty state, never an error — with no PR discoverable the
# dashboard is byte-identical to the pre-FR14 rendering (NFR1).
# `SPECCLAW_STATUS_NO_PR=1` skips the whole block.

PR_LOOKUP=1
[ "${SPECCLAW_STATUS_NO_PR:-0}" = "1" ] && PR_LOOKUP=0
declare -A PR_STATE_CACHE=()

# Read `<section>.<key>` from config.yaml — section-scoped, inline-comment and
# quote stripped. Trimmed-down twin of `yaml_val` in specclaw-build.
cfg_val() {
  local section="$1" key="$2" v
  v=$(sed -n "/^${section}:/,/^[a-zA-Z_]/{s/^[[:space:]][[:space:]]*${key}:[[:space:]]*//p;}" \
    "$SPECCLAW_DIR/config.yaml" 2>/dev/null | head -1 || true)
  if [[ "$v" =~ ([[:space:]]+#) ]]; then v="${v%%"${BASH_REMATCH[1]}"*}"; fi
  v="${v%"${v##*[![:space:]]}"}"
  v="${v#\"}"; v="${v%\"}"; v="${v#\'}"; v="${v%\'}"
  printf '%s' "$v"
}

# Fallback only (FR4): the branch recorded in state.json wins when present. The
# `<branch_prefix><change>` guess silently misses whenever branch naming diverges
# from `git.branch_prefix` — it does in this very repo.
BRANCH_PREFIX="$(cfg_val git branch_prefix)"
BRANCH_PREFIX="${BRANCH_PREFIX:-specclaw/}"

# ─── Recorded phase (FR6/FR7) ────────────────────────────────────────────────
# `changes/<change>/state.json`, written solely by `specclaw-set-phase`, is the
# recorded phase. Reading it is what lets "verified", "PR raised" and "build
# finished" render differently — the checkbox counts below cannot tell them
# apart. Every read is fail-open: absent, unreadable or malformed state falls
# through to the checkbox inference, warns, and still exits 0 (FR7/AC7), which
# keeps output byte-identical for changes that have no state.json (AC6).

# state_field <file> <dotted.path> — same reader as specclaw-set-phase: jq when
# installed, else python3, neither required. Any failure prints nothing.
state_field() {
  local file="$1" path="$2"
  [ -f "$file" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -rc ".${path} // empty" "$file" 2>/dev/null || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json, sys
try:
    v = json.load(open(sys.argv[1]))
    for k in sys.argv[2].split("."):
        v = v[k]
except Exception:
    sys.exit(0)
if v is None:
    sys.exit(0)
sys.stdout.write(v if isinstance(v, str) else json.dumps(v, separators=(",", ":"), ensure_ascii=False))
' "$file" "$path" 2>/dev/null || true
  fi
}

# state_str <file> <path> — a state_field read reduced to its first line, so a
# stray newline in the JSON can break neither a markdown row nor a `gh` argument.
state_str() {
  local v
  v="$(state_field "$1" "$2")"
  printf '%s' "${v%%$'\n'*}"
}

# True when the file parses. With neither interpreter installed nothing can be
# read anyway, so it reports parseable and the empty reads take the fallback.
state_parses() {
  if command -v jq >/dev/null 2>&1; then
    jq -e . "$1" >/dev/null 2>&1
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json, sys; json.load(open(sys.argv[1]))' "$1" >/dev/null 2>&1
  fi
}

# phase_render <state_file> <phase> — sets PHASE_EMOJI and PHASE_TEXT for the
# recorded phase (`🔀` / `pr raised`). The qualifier is the most specific field
# that phase records, falling back to its status; empty when nothing is recorded.
#
# Only `verify` has a more specific field than `status`. `pr` deliberately does
# not: specclaw-set-phase records the PR's disposition *in* `phases.pr.status`
# (raised | merged | closed), so a second `phases.pr.state` read would be dead
# code — nothing writes that field.
PHASE_EMOJI=""
PHASE_TEXT=""
phase_render() {
  local file="$1" phase="$2" qual=""
  case "$phase" in
    proposal) PHASE_EMOJI="📋" ;;
    spec | design | tasks) PHASE_EMOJI="📝" ;;
    verify) PHASE_EMOJI="🔍" ;;
    pr) PHASE_EMOJI="🔀" ;;
    archived) PHASE_EMOJI="✅" ;;
    *) PHASE_EMOJI="🔨" ;;
  esac
  case "$phase" in
    verify) qual="$(state_str "$file" "phases.verify.verdict")" ;;
  esac
  [ -n "$qual" ] || qual="$(state_str "$file" "phases.${phase}.status")"
  PHASE_TEXT="${phase}${qual:+ $qual}"
}

# Bounded invocation (NFR5) — a network call must never stall status generation.
# macOS has no `timeout`: fall back to gtimeout, then a perl alarm, so a stalled
# gh/az call can never hang the dashboard.
pr_bounded() {
  if command -v timeout >/dev/null 2>&1; then timeout 5 "$@"
  elif command -v gtimeout >/dev/null 2>&1; then gtimeout 5 "$@"
  else perl -e 'alarm shift; exec @ARGV' 5 "$@"; fi
}

# One `<updatedAt> <number> <state>` row per PR on the branch, or nothing.
# GitHub via `gh` first, then Azure DevOps via `az`; both optional.
# A tool that timed out once is skipped for the rest of this run, so a stalled
# gh/az (e.g. waiting on a sign-in) costs one timeout, not one per change.
PR_DOWN="${TMPDIR:-/tmp}/specclaw-prdown.$$"
# `|| :` keeps the trap from setting the script's exit status when rm is absent.
trap 'rm -f "$PR_DOWN".* 2>/dev/null || :' EXIT

pr_tool() {
  local tool="$1" out rc
  shift
  [ -e "$PR_DOWN.$tool" ] && return 0
  command -v "$tool" >/dev/null 2>&1 || return 0
  out=$(pr_bounded "$tool" "$@" 2>/dev/null); rc=$?
  case "$rc" in 124|142) : > "$PR_DOWN.$tool" ;; esac
  printf '%s' "$out"
}

pr_rows() {
  local branch="$1" rows=""
  # A project repo with no remote has no pull requests: skip the gh/az lookups.
  # Only a definite answer skips — no git, or no repo, still tries the lookups.
  local root; root="$(cd "$SPECCLAW_DIR/.." && pwd)"
  if command -v git >/dev/null 2>&1 && git -C "$root" rev-parse --git-dir >/dev/null 2>&1 \
    && [ -z "$(git -C "$root" remote 2>/dev/null)" ]; then
    return 0
  fi
  rows=$(pr_tool gh pr list --head "$branch" --state all --limit 20 --json number,state,updatedAt \
    --template '{{range .}}{{.updatedAt}} {{.number}} {{.state}}{{"\n"}}{{end}}')
  if [ -z "$rows" ]; then
    rows=$(pr_tool az repos pr list --source-branch "refs/heads/$branch" --status all \
      --query '[].[creationDate,pullRequestId,status]' -o tsv)
  fi
  printf '%s' "$rows"
}

# pr_state_for <change> [branch] — `PR #123 open` for the most recently updated
# PR on the change's branch, rendering its real state (edge case 15: a merged PR
# reads as merged, never as open). Empty when nothing is discoverable. Memoised
# per run. `branch` is the one recorded in state.json when there is one (FR6);
# only without it do we fall back to guessing from `git.branch_prefix`.
pr_state_for() {
  local change="$1" branch="${2:-}" newest state rendered=""
  [ "$PR_LOOKUP" = "1" ] || return 0
  if [ -n "${PR_STATE_CACHE[$change]+set}" ]; then
    printf '%s' "${PR_STATE_CACHE[$change]}"
    return 0
  fi
  [ -n "$branch" ] || branch="${BRANCH_PREFIX}${change}"
  # ISO-8601 timestamps sort lexically, so `sort -r | head -1` is the newest PR.
  # `|| true`: a no-match grep in this pipeline must not abort the script ([L2]).
  newest=$(pr_rows "$branch" | tr '\t' ' ' | grep -v '^[[:space:]]*$' | sort -r | head -1 || true)
  if [ -n "$newest" ]; then
    # shellcheck disable=SC2086  # deliberate split of the "<ts> <num> <state>" row
    set -- $newest
    if [ "$#" -ge 3 ]; then
      state=$(printf '%s' "$3" | tr '[:upper:]' '[:lower:]')
      rendered="PR #$2 $state"
    fi
  fi
  PR_STATE_CACHE["$change"]="$rendered"
  printf '%s' "$rendered"
}

# ─── Folder ordering (FR5a, FR16) ────────────────────────────────────────────
# Glob order is lexical, so `010-a` is listed before `002-b`. Emit basenames in
# numeric order by their leading `NNN-` prefix instead, and put unnumbered
# folders *after* every numbered one rather than interleaving them at position
# zero — mid-migration a reader expects legacy folders last, not first (AC17).
#
# FR5a — a leading digit run is an ordinal only when the name does NOT also
# match `YYYY-MM-DD-`. The legacy archive prefix `2026-07-22-build-engine`
# otherwise reads as change number 2026 and sorts ahead of every real ordinal;
# this repo has 26 such folders, so getting it wrong reorders the whole archive.
# The exclusion is deliberately narrow — the full date shape only — so a genuine
# ordinal like `2026-some-slug` still counts as numbered.
#
# The prefix is only ever handed to `sort -n`, never to `$(( ))`: `$((08))` is a
# bash syntax error, and a sort-based ordering sidesteps that trap entirely.
#
# This function is duplicated verbatim in specclaw-update-status and
# specclaw-reconcile — keep the two byte-identical so a diff proves they agree.
ordered_dir_names() {
  local dir="$1" d name numbered="" unnumbered=""
  for d in "$dir"/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    if [[ "$name" =~ ^[0-9]+- ]] && ! [[ "$name" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2} ]]; then
      numbered="${numbered}${name}"$'\n'
    else
      unnumbered="${unnumbered}${name}"$'\n'
    fi
  done
  # `-k2` after the numeric key so equal numbers order by name: same input,
  # same listing, every run.
  [ -n "$numbered" ] && printf '%s' "$numbered" | LC_ALL=C sort -t- -k1,1n -k2
  [ -n "$unnumbered" ] && printf '%s' "$unnumbered" | LC_ALL=C sort
  return 0
}

ACTIVE_COUNT=0
COMPLETED_COUNT=0
UNNUMBERED_COUNT=0
ACTIVE_LINES=""
PENDING_LINES=""
COMPLETED_LINES=""

# Scan active changes. The ordering is collected up front rather than piped in:
# the loop body accumulates the counters and line buffers above, which a
# subshell drops, and its `gh`/`az` calls keep an untouched stdin.
ORDERED_CHANGES=()
while IFS= read -r name; do ORDERED_CHANGES+=("$name"); done \
  < <(ordered_dir_names "$CHANGES_DIR")
for change_name in "${ORDERED_CHANGES[@]+"${ORDERED_CHANGES[@]}"}"; do
  change_dir="$CHANGES_DIR/$change_name/"
  [ -d "$change_dir" ] || continue
  [ "$(basename "$change_dir")" = "archive" ] && continue

  # FR17: an unnumbered folder is a supported steady state, so this is counted
  # for a hint below, never treated as an error. Same FR5a test as
  # ordered_dir_names above — a `2026-07-22-` legacy prefix is a date, not an
  # ordinal, so such a folder is unnumbered and belongs in this count.
  if ! [[ "$change_name" =~ ^[0-9]+- ]] || [[ "$change_name" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2} ]]; then
    UNNUMBERED_COUNT=$((UNNUMBERED_COUNT + 1))
  fi

  # FR7: a state file that exists but cannot be read is reported once and then
  # ignored — this loop must degrade, never abort (the script exits 0 either way).
  state_file="$change_dir/state.json"
  phase=""
  state_branch=""
  state_size=""
  elapsed=""
  ledger=""
  if [ -f "$state_file" ]; then
    if [ -r "$state_file" ] && state_parses "$state_file"; then
      phase="$(state_str "$state_file" phase)"
      state_branch="$(state_str "$state_file" branch)"
      state_size="$(state_str "$state_file" size)"
    else
      echo "specclaw-update-status: WARN: unreadable state.json for ${change_name}; falling back to task inference" >&2
    fi
  fi
  # A change still at `proposal` has not started: it keeps its Pending Proposals
  # placement below rather than being promoted into Active by its own state file.
  [ "$phase" = "proposal" ] && phase=""
  [ -n "$phase" ] && phase_render "$state_file" "$phase"

  # The size glyph (change 036) renders only when a size is actually RECORDED.
  # `architectural` is also what an absent size reads as everywhere else, so
  # glyphing the default would stamp a declared-looking ▣ on every change that
  # predates sizes — a claim nobody made.
  size_glyph=""
  case "$state_size" in
    spike)         size_glyph=" ⚡" ;;
    bounded)       size_glyph=" ▫" ;;
    architectural) size_glyph=" ▣" ;;
  esac

  # Elapsed, from the change's timing ledger (change 028). A stuck change is
  # visible at a glance rather than by opening its log.
  elapsed=""
  ledger="$change_dir/timeline.jsonl"
  if [ -f "$ledger" ]; then
    first_ts="$(sed -n 's/.*"ts":\([0-9][0-9]*\).*/\1/p' "$ledger" 2>/dev/null | head -1)"
    last_ts="$(sed -n 's/.*"ts":\([0-9][0-9]*\).*/\1/p' "$ledger" 2>/dev/null | tail -1)"
    if [ -n "$first_ts" ] && [ -n "$last_ts" ] && [ "$last_ts" -gt "$first_ts" ] 2>/dev/null; then
      secs=$((last_ts - first_ts))
      if [ "$secs" -ge 3600 ]; then elapsed=" | $((secs / 3600))h$(( (secs % 3600) / 60 ))m"
      elif [ "$secs" -ge 60 ]; then elapsed=" | $((secs / 60))m"
      else elapsed=" | ${secs}s"; fi
    fi
  fi

  pr_state="$(pr_state_for "$change_name" "$state_branch")"

  tasks_file="$change_dir/tasks.md"
  if [ -f "$change_dir/change.md" ] && grep -qE '^- \[.\] .T[0-9]+.' "$change_dir/change.md"; then
    tasks_file="$change_dir/change.md"
  fi
  if [ -f "$tasks_file" ]; then
    # `t_done`, not `done`: `read -r done ...` reads to shellcheck as the `done`
    # loop keyword (SC1010), and a variable that shadows a keyword is a trap
    # waiting for the next editor of this block.
    # 4th field (deferred, change 038) must still be read even though it's
    # unused here — a 3-var read would fold it into `failed` instead.
    read -r t_done total failed deferred <<<"$("$PARSE_TASKS" --count "$tasks_file" || echo '0 0 0 0')"
    total=${total:-0}
    t_done=${t_done:-0}
    failed=${failed:-0}
    deferred=${deferred:-0}

    if [ "$total" -gt 0 ]; then
      pct=$((t_done * 100 / total))
    else
      pct=0
    fi

    if [ -n "$phase" ]; then
      # FR6: the recorded phase leads, the counts stay as the progress detail —
      # `🔀 pr open — 11/11 tasks (100%)` instead of an indistinguishable 🔨.
      status_emoji="$PHASE_EMOJI"
      [ "$failed" -gt 0 ] && status_emoji="⚠️"
      phase_prefix="$PHASE_TEXT | "
    else
      status_emoji="🔨"
      [ "$failed" -gt 0 ] && status_emoji="⚠️"
      [ "$t_done" -eq "$total" ] && [ "$total" -gt 0 ] && status_emoji="✅"
      phase_prefix=""
    fi

    ACTIVE_LINES="${ACTIVE_LINES}\n- $status_emoji **$change_name**$size_glyph — $phase_prefix$t_done/$total tasks ($pct%) ${failed:+| $failed failed}${pr_state:+ | $pr_state}${elapsed}"
    ACTIVE_COUNT=$((ACTIVE_COUNT + 1))
  elif [ -n "$phase" ]; then
    # Phase recorded before tasks.md exists (mid-plan), or a PR on a change that
    # never had one. AC5: this renders without consulting the network at all.
    ACTIVE_LINES="${ACTIVE_LINES}\n- $PHASE_EMOJI **$change_name**$size_glyph — $PHASE_TEXT${pr_state:+ | $pr_state}${elapsed}"
    ACTIVE_COUNT=$((ACTIVE_COUNT + 1))
  elif [ -n "$pr_state" ]; then
    # Unplanned but already in review — in flight, not "awaiting planning" (AC15).
    ACTIVE_LINES="${ACTIVE_LINES}\n- 🔀 **$change_name**$size_glyph — $pr_state"
    ACTIVE_COUNT=$((ACTIVE_COUNT + 1))
  elif [ -f "$change_dir/proposal.md" ] || [ -f "$change_dir/change.md" ]; then
    PENDING_LINES="${PENDING_LINES}\n- 📋 **$change_name**$size_glyph — proposal ready, awaiting planning"
  fi
done

# Scan archived changes. state.json travels with the directory into archive/
# (edge case 7); archived rows are terminal, so it is deliberately not read here
# — nothing under archive/ can affect this listing, malformed or not.
if [ -d "$ARCHIVE_DIR" ]; then
  ORDERED_ARCHIVED=()
  while IFS= read -r name; do ORDERED_ARCHIVED+=("$name"); done \
    < <(ordered_dir_names "$ARCHIVE_DIR")
  for arch_name in "${ORDERED_ARCHIVED[@]+"${ORDERED_ARCHIVED[@]}"}"; do
    [ -d "$ARCHIVE_DIR/$arch_name" ] || continue
    # FR8 backfills archive/ too, so an unnumbered archived folder is part of
    # what /specclaw-extras:renumber would fix and belongs in the FR17 count. On this
    # repo that is 26 `YYYY-MM-DD-` folders the FR5a rule correctly calls
    # unnumbered; counting only active changes would under-report by that much.
    if ! [[ "$arch_name" =~ ^[0-9]+- ]] || [[ "$arch_name" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2} ]]; then
      UNNUMBERED_COUNT=$((UNNUMBERED_COUNT + 1))
    fi
    COMPLETED_LINES="${COMPLETED_LINES}\n- ✅ **$arch_name**"
    COMPLETED_COUNT=$((COMPLETED_COUNT + 1))
  done
fi

TOTAL=$((ACTIVE_COUNT + COMPLETED_COUNT))

# FR17: one hint, only while there is something to hint about. Zero unnumbered
# folders emits nothing at all — not a blank line, not a placeholder (AC18) —
# and a backfill therefore clears it without any "already asked" flag.
HINT_LINE=""
HINT_TEXT=""
if [ "$UNNUMBERED_COUNT" -gt 0 ]; then
  noun="changes"
  [ "$UNNUMBERED_COUNT" -eq 1 ] && noun="change"
  HINT_TEXT="${UNNUMBERED_COUNT} unnumbered ${noun} · run \`/specclaw-extras:renumber\` to order them"
  HINT_LINE=$'\n\n'"_${HINT_TEXT}_"
fi

STATUS_FILE="$(status_file)"
cat > "$STATUS_FILE" << EOF
# 🦞 SpecClaw Dashboard

**Project:** $PROJECT_NAME
**Last Updated:** $(date -u +"%Y-%m-%d %H:%M UTC")$HINT_LINE

## Active Changes

$([ -n "$ACTIVE_LINES" ] && echo -e "$ACTIVE_LINES" || echo "_No active changes._")

## Pending Proposals

$([ -n "$PENDING_LINES" ] && echo -e "$PENDING_LINES" || echo "_None._")

## Recently Completed

$([ -n "$COMPLETED_LINES" ] && echo -e "$COMPLETED_LINES" || echo "_None._")

## Stats

- **Total changes:** $TOTAL
- **Active:** $ACTIVE_COUNT
- **Completed:** $COMPLETED_COUNT
EOF

echo "OK: Updated $STATUS_FILE"
# The hint also goes to stdout so `/specclaw:status` surfaces it whether it
# reads the file or the run's output. Silent when the count is zero (AC18).
[ -n "$HINT_TEXT" ] && echo "$HINT_TEXT"
exit 0
