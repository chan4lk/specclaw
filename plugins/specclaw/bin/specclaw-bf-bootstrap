#!/usr/bin/env bash
# specclaw-bf-bootstrap — the target-foundation stage's deterministic half.
#
# Creates NOTHING itself under the application source tree. The scaffold is
# generated by the bf-bootstrap-architect agent, in whatever stack decisions.md
# names, exactly as bf-baseline-designer generates harness code and
# bf-replay-mapper generates replay tests. THERE IS NO PER-STACK TEMPLATE IN
# THIS PLUGIN and there will not be one.
#
# What this script owns is everything that must be mechanical:
#   - which target decisions are REQUIRED, and refusing to proceed without one
#   - detecting an already-existing foundation, and never scaffolding over it
#   - the foundation-only gate, over the agent's own declared census
#   - running the declared smoke checks and recording their real results
#   - computing foundation_ready, and writing bootstrap-manifest.json
#   - answering /specclaw:propose's foundation gate
#
# Bash + coreutils + jq (required — the declaration and the manifest are nested
# JSON, like specclaw-bf-replay's pipeline files).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# ─── Helpers ──────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: specclaw-bf-bootstrap <subcommand> [options]

Subcommands:
  collect       <specclaw_dir>
                Phase 0 + Phase 1. Validates that this repo can be bootstrapped
                at all (a rebuild-backlog.md is present — the marker that this
                is a rebuild target), resolves every REQUIRED target decision
                from decisions.md's literal `### SQ-0NN —` headings (falling
                back to clarifications.md's `## Not Applicable` section, which
                is an equally declared answer), detects whether a foundation
                already exists, and emits one JSON object for the
                bf-bootstrap-architect agent.
                Exits non-zero, naming the exact SQ/CQ ids, when a required
                decision is neither decided nor declared not-applicable. It
                never defaults one — scaffolding a stack nobody chose is the
                failure mode this refusal exists to prevent.

  gate          <specclaw_dir>
                The foundation-only gate. Reads the agent's own declaration
                (.specclaw/bootstrap/.bootstrap-declaration.json) and checks it
                against a closed vocabulary: every created file carries an
                allowed `purpose` (a `capability` purpose is a hard fail), every
                declared route is a health/shell/error/layout route, no
                scaffolded file cites a DR-###/BL-###/SCR-### id, and no TK-
                group outside the declared global import appears.
                STATED LIMIT: this is a declared-census check plus narrow id
                greps. It cannot prove the absence of capability logic. See
                templates/CONTRACT.md (n.4).

  smoke         <specclaw_dir> [--timeout <seconds>]
                Runs each smoke check the declaration names, from the project
                root, capturing a capped log per check under
                .specclaw/bootstrap/smoke/. Every command must terminate on its
                own; one that does not is recorded as FAILED (timed out), never
                left hanging. Writes smoke-results.json. Does not decide
                foundation readiness — `record` does that.

  record        <specclaw_dir>
                Merges the declaration, the gate result and the smoke results
                into .specclaw/bootstrap/bootstrap-manifest.json, computing
                foundation_ready mechanically (every pillar present or
                absent-by-decision, every required smoke check PASS or SKIPPED
                with a reason, gate PASS). Never agent-asserted. Archives any
                prior manifest first, and — like every other collector here —
                writes nothing at all if validation fails.

  foundation-check <specclaw_dir>
                The gate /specclaw:propose reads. Prints
                {applicable, foundation_ready, reason, manifest, ...}.
                INERT BY DEFAULT: no rebuild-backlog.md means
                {"applicable": false} and propose behaves exactly as it always
                has, so no greenfield project ever sees this.

  not-applicable <specclaw_dir> --reason <text> --declared-by <name, YYYY-MM-DD>
                Records, once, that this repo is not a rebuild target (e.g. you
                are proposing an ordinary change inside the LEGACY repo, which
                also carries a rebuild-backlog.md). Writes a manifest whose
                not_applicable field carries the reason and the namer, so the
                propose gate passes on a declaration rather than on a guess.

Options:
  -h, --help    Show this help message
EOF
}

die() { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARN: $*" >&2; }

require_jq() {
  command -v jq >/dev/null 2>&1 \
    || die "jq is required by specclaw-bf-bootstrap (the declaration and manifest are nested JSON) but was not found on PATH."
}

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

emit_json() {
  local output="$1"
  if command -v jq >/dev/null 2>&1; then
    if printf '%s' "$output" | jq . >/dev/null 2>&1; then
      printf '%s\n' "$output"
      return 0
    fi
    warn "JSON validation failed, outputting best-effort"
  fi
  printf '%s\n' "$output"
}

# `tr -d '\r'` is load-bearing, not cosmetic — the same guard, for the same
# reason, that specclaw-bf-baseline documents on every one of its jq-to-read
# pipes: jq's Windows build emits CRLF, so the LAST field of an @tsv row (and
# every scalar captured in a command substitution) arrives with a trailing \r.
# That silently defeats string equality — a `purpose` of "shell\r" matches no
# entry in a closed vocabulary, and a `foundation_ready` of "true\r" is not
# "true" — which turns every check below into a false positive. Read jq output
# through this and nowhere else.
jqr() { jq -r "$@" | tr -d '\r'; }
jqc() { jq -c "$@" | tr -d '\r'; }

# Every multi-field row jq hands bash is joined on U+001F (unit separator), read
# back with `IFS=$'\x1f'`, and never on a tab. A tab is an IFS *whitespace*
# character, so bash collapses a run of them into one delimiter — which means a
# row whose MIDDLE field is empty (a smoke check with no command, a pillar with
# no reason) silently shifts every later field one position left, and the value
# that lands in the variable you go on to validate belongs to a different
# column entirely. Unit separator is non-whitespace: fields split exactly, and
# empty ones stay empty. It cannot occur in any real field value.

plugin_version_of_this_run() {
  jqr '.version // "unknown"' "$PLUGIN_ROOT/.claude-plugin/plugin.json" 2>/dev/null || echo "unknown"
}

# ─── Schemas and closed vocabularies ─────────────────────────────────────────
#
# Every list below is CLOSED and stack-neutral. A pillar id names a ROLE the
# foundation plays, never a technology — the same discipline CONTRACT.md holds
# for seam layers. An agent that wants a value outside one of these lists is
# telling you the scaffold is doing something a foundation does not do, and the
# gate says so instead of accepting a new word.

BOOTSTRAP_SCHEMA=1
DECLARATION_SCHEMA=1

# The decisions bootstrap consumes and will not proceed without. Bootstrap
# CONSUMES decided architecture; it never decides architecture. A missing one is
# a loud stop naming the exact id, never a default (CONTRACT.md (n.2)).
REQUIRED_DECISIONS="SQ-001 SQ-002 SQ-003 SQ-004 SQ-006 SQ-013 SQ-014"

# Recorded when present, never required — they inform the scaffold's shape
# (paging, ops, browser matrix) but no foundation is blocked on them.
OPTIONAL_DECISIONS="SQ-005 SQ-007 SQ-008 SQ-010 SQ-011 SQ-012"

PILLAR_IDS="frontend-shell frontend-routing api-client backend-solution di config cors error-handling persistence migrations health-check test-frontend test-backend theme-plumbing"
PILLAR_STATUSES="present absent-by-decision failed"

# Why `build` and `docs` are allowed purposes: a foundation legitimately creates
# package manifests, lockfiles, solution files and a README explaining how to
# run the thing. Omitting them would make the gate fail on exactly the files it
# requires the scaffold to have.
FILE_PURPOSES="shell routing api-client di config cors error-handling persistence migrations health test-harness theme build docs"

# A route the foundation may create. Everything else is a BL capability, which
# is the whole boundary this gate enforces.
ROUTE_KINDS="health shell error layout"
SCREEN_KINDS="shell error layout"

SMOKE_CHECK_IDS="frontend-build frontend-start api-build api-start db-connect migrations-infra frontend-to-api test-frontend test-backend"

SMOKE_TIMEOUT_DEFAULT=300
SMOKE_LOG_TAIL_LINES=120

# ─── Paths ────────────────────────────────────────────────────────────────────

bootstrap_dir()     { printf '%s/bootstrap' "$1"; }
manifest_path()     { printf '%s/bootstrap/bootstrap-manifest.json' "$1"; }
declaration_path()  { printf '%s/bootstrap/.bootstrap-declaration.json' "$1"; }
gate_path()         { printf '%s/bootstrap/gate-results.json' "$1"; }
smoke_path()        { printf '%s/bootstrap/smoke-results.json' "$1"; }
plan_path()         { printf '%s/bootstrap/bootstrap-plan.md' "$1"; }

resolve_specclaw_dir() {
  local d="$1"
  [ -d "$d" ] || die "specclaw directory not found: $d"
  (cd "$d" && pwd)
}

# ─── Reading declared decisions ──────────────────────────────────────────────
#
# Heading-anchored, exactly as sanction-check verifies a sanctioning CQ: a
# `### SQ-0NN —` heading only ever appears under decisions.md's `## Decisions`
# section, never under `## Outstanding Questions` (which lists unanswered ids as
# plain bullets). So this cannot mistake an open question for a decided one —
# which a whole-file grep for the id absolutely would.

decision_text_of() {
  local decisions_file="$1" id="$2"
  [ -f "$decisions_file" ] || { printf ''; return 0; }
  local block
  block="$(awk -v id="$id" '
    $0 ~ ("^### " id "([^0-9]|$)") { cap=1; next }
    cap && /^### / { cap=0 }
    cap { print }
  ' "$decisions_file" 2>/dev/null || true)"
  [ -n "$block" ] || { printf ''; return 0; }
  local decision
  decision="$(printf '%s\n' "$block" \
    | grep -m1 -- '^- \*\*Decision:\*\*' \
    | sed -E 's/^- \*\*Decision:\*\* *//' | sed -E 's/[[:space:]]+$//' || true)"
  # A heading with an empty Decision line is NOT an answer. Reading it as one
  # would let an id that was transcribed but never decided satisfy the gate.
  case "$decision" in
    ''|'⚠ not recorded'|'not recorded'|TBD|tbd) printf '' ;;
    *) printf '%s' "$decision" ;;
  esac
}

# "Not applicable" is an answer, and it is declared in exactly one place:
# clarifications.md's own `## Not Applicable` section, written by
# /specclaw:bf-clarify and never re-evaluated afterwards. A project with no
# server side genuinely has no backend stack to decide, and refusing to
# bootstrap it would be demanding a decision that does not exist.
declared_not_applicable() {
  local clar_file="$1" id="$2"
  [ -f "$clar_file" ] || return 1
  awk '/^## Not Applicable/{flag=1;next} /^## /{flag=0} flag' "$clar_file" 2>/dev/null \
    | grep -qE "(^|[^A-Z0-9-])${id}([^0-9]|$)" || return 1
  return 0
}

# One decision's resolved state as a JSON object. `source` is what makes the
# claim checkable later: a reader can open the named file and see it.
decision_json() {
  local decisions_file="$1" clar_file="$2" id="$3" decisions_rel="$4" clar_rel="$5"
  local text
  text="$(decision_text_of "$decisions_file" "$id")"
  if [ -n "$text" ]; then
    printf '{"id": "%s", "resolved": true, "decision": "%s", "source": "%s"}' \
      "$id" "$(json_escape "$text")" "$(json_escape "$decisions_rel")"
    return 0
  fi
  if declared_not_applicable "$clar_file" "$id"; then
    printf '{"id": "%s", "resolved": true, "decision": "not applicable", "source": "%s"}' \
      "$id" "$(json_escape "$clar_rel")"
    return 0
  fi
  printf '{"id": "%s", "resolved": false, "decision": null, "source": null}' "$id"
}

# ─── Existing-foundation detection ───────────────────────────────────────────
#
# Deliberately NOT a stack sniff. Globbing for package.json/*.csproj/go.mod
# here would be the one thing this plugin never does — CONTRACT.md keeps every
# stack name out of the plugin, and a hard-coded manifest list would go stale
# the first time someone rebuilds into a stack nobody thought of.
#
# Instead: the ONE thing bash can honestly say is whether this repo contains
# tracked source files outside .specclaw/ at all. "Some files exist that are
# not specclaw artifacts" is a true statement about any stack; deciding whether
# they constitute an application foundation is the AGENT's judgement, made by
# reading them, and a hard stop when the answer is yes and no manifest exists.
# ─── The prototype gate (REINTERPRET only) ──────────────────────────────────
#
# Two facts bootstrap needs about the redesign prototype, and nothing else:
# whether this project has one at all, and whether it is approved.
#
# The policy is read HERE, locally, before anything is shelled out. That is
# deliberate: a project that is not REINTERPRET must behave exactly as it did
# before this gate existed, including on an installation where
# specclaw-bf-prototype is absent entirely. Reading SQ-013 first means the
# common case never depends on the new binary being present.
#
# When the project IS REINTERPRET, the gate fails CLOSED. A verifier that
# cannot be run, cannot be parsed, or reports anything other than ready leaves
# PROTOTYPE_GATE_READY false with a stated reason. "I could not check" is not
# "it is fine" — the whole point of the gate is that production work does not
# start on an unapproved design, and an unreadable check proves nothing about
# approval.

PROTOTYPE_GATE_APPLICABLE="false"
PROTOTYPE_GATE_READY="false"
PROTOTYPE_GATE_REASON=""

prototype_gate_state() {
  local specclaw_dir_abs="$1" item="${2:-}"
  PROTOTYPE_GATE_APPLICABLE="false"
  PROTOTYPE_GATE_READY="false"
  PROTOTYPE_GATE_REASON=""

  local decisions_file="$specclaw_dir_abs/analysis/decisions.md"
  local policy=""
  case "$(decision_text_of "$decisions_file" "SQ-013")" in
    *THEME-ONLY*)  policy="THEME-ONLY" ;;
    *FAITHFUL*)    policy="FAITHFUL" ;;
    *REINTERPRET*) policy="REINTERPRET" ;;
    *)             policy="UNDECIDED" ;;
  esac
  [ "$policy" = "REINTERPRET" ] || return 0

  PROTOTYPE_GATE_APPLICABLE="true"

  local proto_bin="$SCRIPT_DIR/specclaw-bf-prototype"
  if [ ! -x "$proto_bin" ]; then
    proto_bin="$(command -v specclaw-bf-prototype 2>/dev/null || true)"
  fi
  if [ -z "$proto_bin" ] || [ ! -x "$proto_bin" ]; then
    PROTOTYPE_GATE_REASON="this project is REINTERPRET, but specclaw-bf-prototype could not be found, so the prototype approval cannot be verified. Update the plugin installation."
    return 0
  fi

  local out
  out="$("$proto_bin" verify "$specclaw_dir_abs" ${item:+--item "$item"} 2>/dev/null || true)"
  if [ -z "$out" ] || ! printf '%s' "$out" | jq -e . >/dev/null 2>&1; then
    PROTOTYPE_GATE_REASON="the prototype verifier produced no readable result, so the approval cannot be confirmed."
    return 0
  fi

  local applicable ready reason
  applicable="$(printf '%s' "$out" | jqr '.applicable // false')"
  ready="$(printf '%s' "$out" | jqr '.ready // false')"
  reason="$(printf '%s' "$out" | jqr '.reason // ""')"

  # The verifier reading its own copy of decisions.md and concluding "not
  # applicable" while we read REINTERPRET means the two disagree about the
  # policy. Fail closed and say so rather than silently deferring to it.
  if [ "$applicable" != "true" ]; then
    PROTOTYPE_GATE_REASON="${reason:-the prototype verifier reports this project has no prototype stage, but decisions.md records SQ-013 as REINTERPRET}"
    return 0
  fi

  if [ "$ready" = "true" ]; then
    PROTOTYPE_GATE_READY="true"
    if [ -n "$item" ]; then
      local item_ready item_reason
      item_ready="$(printf '%s' "$out" | jqr '.item_ready // false')"
      item_reason="$(printf '%s' "$out" | jqr '.item_reason // ""')"
      if [ "$item_ready" != "true" ]; then
        PROTOTYPE_GATE_READY="false"
        PROTOTYPE_GATE_REASON="$item_reason"
      fi
    fi
    return 0
  fi

  PROTOTYPE_GATE_REASON="${reason:-the prototype is not recorded ready}"
  return 0
}

# ─── Tree hashing, for the --adopt refusal (PD-05) ──────────────────────────
#
# Same algorithm specclaw-bf-prototype uses, copied verbatim rather than
# shared: this repo has no shared lib, and the two must agree exactly or the
# comparison below silently never matches.

bootstrap_tree_file_list() {
  local root="$1"
  [ -d "$root" ] || return 0
  ( cd "$root" && find . -type f -print 2>/dev/null | sed 's|^\./||' ) | while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "/$f/" in
      */node_modules/*|*/vendor/*|*/dist/*|*/build/*|*/out/*|*/coverage/*) continue ;;
    esac
    case "$f" in
      .*|*/.*) continue ;;
    esac
    printf '%s\n' "$f"
  done | LC_ALL=C sort
}

bootstrap_sha256_of() {
  local file="$1" out=""
  if command -v sha256sum >/dev/null 2>&1; then
    out="$(sha256sum "$file" 2>/dev/null | awk '{print $1}' || true)"
  elif command -v shasum >/dev/null 2>&1; then
    out="$(shasum -a 256 "$file" 2>/dev/null | awk '{print $1}' || true)"
  fi
  printf '%s' "$out"
}

bootstrap_tree_hash_of() {
  local root="$1" listing="" f h
  [ -d "$root" ] || { printf ''; return 0; }
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    h="$(bootstrap_sha256_of "$root/$f")"
    listing="${listing}${f}	${h}
"
  done < <(bootstrap_tree_file_list "$root")
  [ -n "$listing" ] || { printf ''; return 0; }
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$listing" | sha256sum 2>/dev/null | awk '{print $1}' || true
  elif command -v shasum >/dev/null 2>&1; then
    printf '%s' "$listing" | shasum -a 256 2>/dev/null | awk '{print $1}' || true
  fi
}

tracked_non_specclaw_count() {
  local project_root="$1"
  if git -C "$project_root" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$project_root" ls-files 2>/dev/null \
      | grep -vE '^\.specclaw/' | grep -cvE '^\.(git|github)/' || true
  else
    # No git: fall back to a plain walk, excluding the same paths. Reported as
    # a count only; nothing infers a stack from it.
    find "$project_root" -type f \
      -not -path "*/.specclaw/*" -not -path "*/.git/*" -not -path "*/.github/*" \
      2>/dev/null | wc -l | tr -d ' '
  fi
}

# ─── Subcommand: collect ─────────────────────────────────────────────────────

cmd_collect() {
  require_jq
  local specclaw_dir_abs; specclaw_dir_abs="$(resolve_specclaw_dir "$1")"
  local project_root; project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  local analysis_dir="$specclaw_dir_abs/analysis"
  local backlog_file="$analysis_dir/rebuild-backlog.md"
  local decisions_file="$analysis_dir/decisions.md"
  local clar_file="$analysis_dir/clarifications.md"
  local module_map="$analysis_dir/module-map.md"
  local manifest; manifest="$(manifest_path "$specclaw_dir_abs")"

  # ── Phase 0a: is this repo a rebuild target at all? ─────────────────────
  # rebuild-backlog.md is the marker, for the same reason bypass-check uses it:
  # it is the document the Phase B copy set puts in the new repo, and without
  # it there is no target architecture to bootstrap toward.
  [ -f "$backlog_file" ] || die "No ${backlog_file#"$project_root"/} in this repo.
/specclaw:bf-bootstrap creates the target application foundation for a brownfield
rebuild, from the architecture the rebuild already decided — so it needs the
rebuild backlog to be present here.
  - If this IS the rebuild target repo: copy the Phase A artifacts in first (see
    docs/rebuild-workflow.md's Phase B copy set), then re-run.
  - If this is NOT a rebuild target: you do not need this command at all."

  [ -f "$decisions_file" ] || die "No ${decisions_file#"$project_root"/}.
Bootstrap consumes decided architecture — it never decides architecture — so the
decision record is a hard requirement, not an optional input. Run
/specclaw:bf-clarify --resolve in the legacy repo and copy decisions.md across
(docs/rebuild-workflow.md's Phase B copy set)."

  # ── Phase 1: resolve every required decision ───────────────────────────
  local decisions_rel=".specclaw/analysis/decisions.md"
  local clar_rel=".specclaw/analysis/clarifications.md"
  local required_json="" optional_json="" unresolved="" id first=true
  for id in $REQUIRED_DECISIONS; do
    local dj; dj="$(decision_json "$decisions_file" "$clar_file" "$id" "$decisions_rel" "$clar_rel")"
    if $first; then first=false; else required_json="${required_json}, "; fi
    required_json="${required_json}${dj}"
    case "$dj" in *'"resolved": false'*) unresolved="${unresolved}${unresolved:+ }${id}" ;; esac
  done
  first=true
  for id in $OPTIONAL_DECISIONS; do
    local dj; dj="$(decision_json "$decisions_file" "$clar_file" "$id" "$decisions_rel" "$clar_rel")"
    if $first; then first=false; else optional_json="${optional_json}, "; fi
    optional_json="${optional_json}${dj}"
  done

  # THE LOUD STOP. Named ids, the exact command that answers them, and no
  # default anywhere. Ask-don't-guess applies to scaffolding exactly as it
  # applies to analysis: a foundation built on a stack nobody chose is worse
  # than no foundation, because everything after it inherits the guess.
  if [ -n "$unresolved" ]; then
    local pretty=""
    for id in $unresolved; do pretty="${pretty}  - ${id}"$'\n'; done
    die "Required target decisions are not resolved:
${pretty}Each one must either carry a decided \`### <id> —\` block with a non-empty
\`- **Decision:**\` line in ${decisions_rel}, or be declared not-applicable in
${clar_rel}'s \`## Not Applicable\` section. Bootstrap consumes decided
architecture — it never picks a stack, a database, or a UI policy on your
behalf.
Answer them with /specclaw:bf-clarify (then --resolve) and re-copy
decisions.md, or record the decision directly in ${decisions_rel} if it was
made in this repo.
Nothing has been created."
  fi

  # ── Phase 1b: the eighth precondition, REINTERPRET only. ────────────────
  # A project that redesigns its interface does not start the new repo until a
  # named client stakeholder has approved the redesign, screen by screen, in a
  # throwaway prototype. Scaffolding first would mean the application exists
  # before anybody agreed what it looks like or what it does — and by the time
  # the approval arrives, the thing it is approving has already been built.
  # Inert under every other policy: prototype_gate_state returns applicable
  # false and this block is a no-op.
  prototype_gate_state "$specclaw_dir_abs"
  if [ "$PROTOTYPE_GATE_APPLICABLE" = "true" ] && [ "$PROTOTYPE_GATE_READY" != "true" ]; then
    die "REINTERPRET project: prototype not approved. Run bf-prototype --record in the legacy repo until it prints PROTOTYPE: READY, then copy prototype-map.md + prototype-manifest.json + screens/ together and re-run.
Reason: ${PROTOTYPE_GATE_REASON}
Nothing has been created."
  fi

  # ── Phase 0b: does a foundation already exist? ──────────────────────────
  local mode="fresh" prior_manifest_json="null" prior_ready="false"
  local source_file_count; source_file_count="$(tracked_non_specclaw_count "$project_root")"
  [ -n "$source_file_count" ] || source_file_count=0
  if [ -f "$manifest" ]; then
    if jq -e . "$manifest" >/dev/null 2>&1; then
      prior_ready="$(jqr '.foundation_ready // false' "$manifest")"
      prior_manifest_json="$(jqc '{bootstrap_schema, plugin_version, generated_at,
                                     foundation_ready, not_applicable,
                                     stack, pillars, smoke}' "$manifest")"
      # A recorded foundation that is READY is a no-op to re-run, exactly as
      # specclaw-ensure-init is on an initialized project. One that has a
      # failed or absent pillar is gap-filled — and only those pillars.
      if [ "$prior_ready" = "true" ]; then mode="recorded-ready"; else mode="gap-fill"; fi
    else
      warn "A bootstrap manifest exists at ${manifest#"$project_root"/} but is not valid JSON. Treating this run as a gap-fill and leaving the old file in place for you to inspect."
      mode="gap-fill"
    fi
  elif [ "$source_file_count" -gt 0 ]; then
    # NEVER scaffold over an application somebody already wrote. The count is
    # all bash knows; whether these files are a foundation is the agent's
    # judgement, and the skill turns a "yes" into a stop that offers --adopt.
    mode="adopt-candidate"
  fi

  local pillar_json="" ; pillar_json="$(printf '%s' "$PILLAR_IDS" | tr ' ' '\n' | jq -R -s 'split("\n") | map(select(length>0))')"

  emit_json "$(jq -n \
    --arg mode "$mode" \
    --arg project_root "$project_root" \
    --arg plugin_version "$(plugin_version_of_this_run)" \
    --arg backlog "${backlog_file#"$project_root"/}" \
    --arg decisions "$decisions_rel" \
    --argjson clarifications_present "$([ -f "$clar_file" ] && echo true || echo false)" \
    --argjson module_map_present "$([ -f "$module_map" ] && echo true || echo false)" \
    --argjson ui_inventory_present "$([ -f "$specclaw_dir_abs/ui/ui-inventory.md" ] && echo true || echo false)" \
    --argjson design_tokens_present "$([ -f "$specclaw_dir_abs/ui/design-tokens.json" ] && echo true || echo false)" \
    --argjson required "[${required_json}]" \
    --argjson optional "[${optional_json}]" \
    --argjson pillar_ids "$pillar_json" \
    --argjson source_file_count "$source_file_count" \
    --argjson prior_manifest "$prior_manifest_json" \
    --arg declaration_path ".specclaw/bootstrap/.bootstrap-declaration.json" \
    --arg plan_path ".specclaw/bootstrap/bootstrap-plan.md" \
    --arg declaration_schema "$DECLARATION_SCHEMA" \
    --arg file_purposes "$FILE_PURPOSES" \
    --arg route_kinds "$ROUTE_KINDS" \
    --arg screen_kinds "$SCREEN_KINDS" \
    --arg smoke_check_ids "$SMOKE_CHECK_IDS" \
    --arg pillar_statuses "$PILLAR_STATUSES" \
    '{
      mode: $mode,
      project_root: $project_root,
      plugin_version: $plugin_version,
      inputs: {
        rebuild_backlog: $backlog,
        decisions: $decisions,
        clarifications_present: $clarifications_present,
        module_map_present: $module_map_present,
        ui_inventory_present: $ui_inventory_present,
        design_tokens_present: $design_tokens_present
      },
      decisions_required: $required,
      decisions_optional: $optional,
      existing_source_file_count: $source_file_count,
      prior_manifest: $prior_manifest,
      write_to: { declaration: $declaration_path, plan: $plan_path },
      vocabulary: {
        declaration_schema: ($declaration_schema | tonumber),
        pillar_ids: $pillar_ids,
        pillar_statuses: ($pillar_statuses | split(" ")),
        file_purposes: ($file_purposes | split(" ")),
        route_kinds: ($route_kinds | split(" ")),
        screen_kinds: ($screen_kinds | split(" ")),
        smoke_check_ids: ($smoke_check_ids | split(" "))
      }
    }')"

  case "$mode" in
    recorded-ready)
      echo "A foundation is already recorded and ready (${manifest#"$project_root"/}). This run is a no-op unless a pillar or smoke check has since regressed — re-run \`gate\` and \`smoke\` to confirm." >&2 ;;
    gap-fill)
      echo "A bootstrap manifest exists but is not ready. This is a GAP-FILL run: only pillars recorded absent/failed may be created, and a pillar already recorded present must not be touched." >&2 ;;
    adopt-candidate)
      echo "No bootstrap manifest, but ${source_file_count} tracked file(s) outside .specclaw/ already exist. This is an ADOPT-CANDIDATE run: do NOT scaffold over an application somebody already wrote — report what is there and let the operator choose --adopt." >&2 ;;
    *)
      echo "Fresh bootstrap: no manifest and no existing source outside .specclaw/. Every required decision is resolved." >&2 ;;
  esac
}

# ─── Declaration loading (shared by gate / smoke / record) ───────────────────

load_declaration() {
  local specclaw_dir_abs="$1" decl
  decl="$(declaration_path "$specclaw_dir_abs")"
  [ -f "$decl" ] || die "No agent declaration at ${decl}.
The bf-bootstrap-architect agent writes it after scaffolding — it is how the
agent states what it created, and this script's whole job is checking that
statement rather than trusting it. Run the agent step first."
  jq -e . "$decl" >/dev/null 2>&1 || die "The agent declaration at ${decl} is not valid JSON."
  local schema; schema="$(jqr '.declaration_schema // empty' "$decl")"
  [ -n "$schema" ] || die "The agent declaration carries no declaration_schema field. Expected ${DECLARATION_SCHEMA}."
  [ "$schema" = "$DECLARATION_SCHEMA" ] || die "The agent declaration is schema ${schema}; this specclaw reads ${DECLARATION_SCHEMA}."
  printf '%s' "$decl"
}

# ─── Subcommand: gate ────────────────────────────────────────────────────────
#
# THE FOUNDATION-ONLY BOUNDARY, ENFORCED RATHER THAN HOPED.
#
# Everything here reads DECLARED data (the agent's own census) plus narrow,
# stack-neutral id greps over the files that census names. What it can prove is
# stated precisely in CONTRACT.md (n.4) — and what it cannot prove is stated
# just as precisely, because a gate that overclaims is worse than no gate.

cmd_gate() {
  require_jq
  local specclaw_dir_abs; specclaw_dir_abs="$(resolve_specclaw_dir "$1")"
  local project_root; project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  local decl; decl="$(load_declaration "$specclaw_dir_abs")"

  local -a problems=() checks=()
  local n_checked=0

  add_check() {
    # $1 name, $2 result, $3 detail
    checks+=("$(jq -n --arg n "$1" --arg r "$2" --arg d "$3" '{check:$n, result:$r, detail:$d}')")
  }

  # ── Check 1: every pillar is a known id with a known status, and a
  # non-present pillar states a reason. A silently skipped pillar is how a
  # foundation ends up half-built and nobody notices. ─────────────────────
  local bad_pillars="" bad_status="" no_reason=""
  local pid pstatus preason
  while IFS=$'\x1f' read -r pid pstatus preason; do
    [ -z "$pid" ] && continue
    case " ${PILLAR_IDS} " in *" ${pid} "*) ;; *) bad_pillars="${bad_pillars}${bad_pillars:+, }${pid}" ;; esac
    case " ${PILLAR_STATUSES} " in *" ${pstatus} "*) ;; *) bad_status="${bad_status}${bad_status:+, }${pid}=${pstatus}" ;; esac
    if [ "$pstatus" != "present" ] && [ -z "$preason" ]; then
      no_reason="${no_reason}${no_reason:+, }${pid}"
    fi
  done < <(jqr '(.pillars // [])[] | [.id // "", .status // "", (.reason // "")] | join("")' "$decl")

  if [ -n "$bad_pillars" ]; then
    problems+=("Unknown pillar id(s): ${bad_pillars}. The vocabulary is closed and stack-neutral: ${PILLAR_IDS}.")
    add_check "pillar-vocabulary" "FAIL" "unknown: ${bad_pillars}"
  else
    add_check "pillar-vocabulary" "PASS" "every declared pillar id is in the closed set"
  fi
  [ -n "$bad_status" ] && problems+=("Pillar(s) with an unknown status: ${bad_status}. Allowed: ${PILLAR_STATUSES}.")
  [ -n "$no_reason" ] && problems+=("Pillar(s) not \`present\` with no stated reason: ${no_reason}. An absent pillar is either decided away, with the decision named, or it is a failure — never a silent skip.")
  n_checked=$((n_checked + 1))

  # ── Check 2: every created file carries an allowed purpose. `capability` is
  # the boundary: it is exactly what a BL item creates and bootstrap must not.
  local bad_purpose="" capability_files=""
  local fpath fpurpose
  while IFS=$'\x1f' read -r fpath fpurpose; do
    [ -z "$fpath" ] && continue
    if [ "$fpurpose" = "capability" ]; then
      capability_files="${capability_files}${capability_files:+, }${fpath}"
      continue
    fi
    case " ${FILE_PURPOSES} " in
      *" ${fpurpose} "*) ;;
      *) bad_purpose="${bad_purpose}${bad_purpose:+, }${fpath} (purpose: ${fpurpose:-<none>})" ;;
    esac
  done < <(jqr '(.files_created // [])[] | [.path // "", .purpose // ""] | join("")' "$decl")

  if [ -n "$capability_files" ]; then
    problems+=("File(s) declared with purpose \`capability\`: ${capability_files}. A capability belongs to its BL item, starting at /specclaw:propose — the foundation stage may not implement one.")
    add_check "no-capability-files" "FAIL" "${capability_files}"
  else
    add_check "no-capability-files" "PASS" "no file declares a capability purpose"
  fi
  [ -n "$bad_purpose" ] && problems+=("File(s) with a purpose outside the closed set: ${bad_purpose}. Allowed: ${FILE_PURPOSES}.")
  n_checked=$((n_checked + 1))

  # ── Check 3: routes and screens. Exactly one health endpoint is allowed to
  # exist purely to prove connectivity; everything else must be shell/error/
  # layout. A second endpoint is a capability wearing a foundation's clothes.
  local bad_routes="" health_n=0
  local rroute rkind
  while IFS=$'\x1f' read -r rroute rkind; do
    [ -z "$rroute" ] && continue
    case " ${ROUTE_KINDS} " in
      *" ${rkind} "*) ;;
      *) bad_routes="${bad_routes}${bad_routes:+, }${rroute} (kind: ${rkind:-<none>})"; continue ;;
    esac
    [ "$rkind" = "health" ] && health_n=$((health_n + 1))
  done < <(jqr '(.route_census // [])[] | [.route // "", .kind // ""] | join("")' "$decl")

  if [ -n "$bad_routes" ]; then
    problems+=("Route(s) outside the foundation's allowed kinds: ${bad_routes}. Allowed kinds: ${ROUTE_KINDS} — anything else is a BL capability endpoint.")
    add_check "route-census" "FAIL" "${bad_routes}"
  elif [ "$health_n" -gt 1 ]; then
    problems+=("${health_n} health-check routes declared. One exists to prove connectivity; more than one is a surface nobody asked for.")
    add_check "route-census" "FAIL" "${health_n} health routes"
  else
    add_check "route-census" "PASS" "${health_n} health route(s), every other route shell/error/layout"
  fi

  local bad_screens="" sscreen skind
  while IFS=$'\x1f' read -r sscreen skind; do
    [ -z "$sscreen" ] && continue
    case " ${SCREEN_KINDS} " in
      *" ${skind} "*) ;;
      *) bad_screens="${bad_screens}${bad_screens:+, }${sscreen} (kind: ${skind:-<none>})" ;;
    esac
  done < <(jqr '(.screen_census // [])[] | [.screen // "", .kind // ""] | join("")' "$decl")
  if [ -n "$bad_screens" ]; then
    problems+=("Screen(s) outside the foundation's allowed kinds: ${bad_screens}. Allowed: ${SCREEN_KINDS}. A BL item's screen belongs to that item.")
    add_check "screen-census" "FAIL" "${bad_screens}"
  else
    add_check "screen-census" "PASS" "every declared screen is shell/error/layout"
  fi
  n_checked=$((n_checked + 2))

  # ── Check 4: no scaffolded file cites a DR-###, BL-### or SCR-### id.
  #
  # HONEST LIMIT, stated here and in CONTRACT.md (n.4): this is necessary, not
  # sufficient. A rule implemented WITHOUT citing its DR id passes this grep.
  # It is still worth running, because the plugin's own citation discipline
  # means an agent implementing a rule tends to cite it — and because a
  # scaffold that names a specific screen or backlog item is unambiguously
  # over the line.
  local id_hits=""
  local scan_file
  while IFS= read -r scan_file; do
    [ -z "$scan_file" ] && continue
    local abs="$project_root/$scan_file"
    [ -f "$abs" ] || continue
    local hit
    hit="$(grep -oE '\b(DR|BL|SCR)-[0-9]{3}\b' "$abs" 2>/dev/null | sort -u | paste -sd, - || true)"
    [ -n "$hit" ] && id_hits="${id_hits}${id_hits:+; }${scan_file}: ${hit}"
  done < <(jqr '(.files_created // [])[] | .path // empty' "$decl")

  if [ -n "$id_hits" ]; then
    problems+=("Scaffolded file(s) cite a rule/item/screen id: ${id_hits}. A foundation implements no business rule, no backlog item and no legacy screen, so it has nothing to cite.")
    add_check "no-rule-or-item-citations" "FAIL" "${id_hits}"
  else
    add_check "no-rule-or-item-citations" "PASS" "no DR-###/BL-###/SCR-### id appears in any created file (necessary, not sufficient — see CONTRACT.md (n.4))"
  fi
  n_checked=$((n_checked + 1))

  # ── Check 5: TK- token groups. Only the groups the declaration says it
  # imported may appear, and per the token-plumbing line those must be
  # `global`-scoped groups. A screen-scoped group in the scaffold is the
  # foundation pre-empting what ui-review.md asks a human to sign per change.
  local declared_tks; declared_tks="$(jqr '(.ui_tokens_imported // [])[]' "$decl" | sort -u | paste -sd' ' - || true)"
  local tk_hits=""
  while IFS= read -r scan_file; do
    [ -z "$scan_file" ] && continue
    local abs="$project_root/$scan_file"
    [ -f "$abs" ] || continue
    local tk
    while IFS= read -r tk; do
      [ -z "$tk" ] && continue
      case " ${declared_tks} " in
        *" ${tk} "*) ;;
        *) tk_hits="${tk_hits}${tk_hits:+; }${scan_file}: ${tk}" ;;
      esac
    done < <(grep -oE '\bTK-[0-9A-Za-z_-]+\b' "$abs" 2>/dev/null | sort -u || true)
  done < <(jqr '(.files_created // [])[] | .path // empty' "$decl")

  if [ -n "$tk_hits" ]; then
    problems+=("Undeclared design-token group(s) in the scaffold: ${tk_hits}. Declared imports: ${declared_tks:-<none>}. Foundation may import global token groups only; a screen-scoped group belongs to the screen-bearing item that ui-review.md holds a human to.")
    add_check "declared-tokens-only" "FAIL" "${tk_hits}"
  else
    add_check "declared-tokens-only" "PASS" "only declared token group(s) appear: ${declared_tks:-none}"
  fi
  n_checked=$((n_checked + 1))

  # ── Check 6: every smoke check the declaration names is a known id. A
  # foundation that invents its own check names cannot be compared across runs.
  local bad_smoke="" sc
  while IFS= read -r sc; do
    [ -z "$sc" ] && continue
    case " ${SMOKE_CHECK_IDS} " in *" ${sc} "*) ;; *) bad_smoke="${bad_smoke}${bad_smoke:+, }${sc}" ;; esac
  done < <(jqr '(.smoke_checks // [])[] | .check // empty' "$decl")
  if [ -n "$bad_smoke" ]; then
    problems+=("Unknown smoke check id(s): ${bad_smoke}. The set is closed: ${SMOKE_CHECK_IDS}.")
    add_check "smoke-vocabulary" "FAIL" "${bad_smoke}"
  else
    add_check "smoke-vocabulary" "PASS" "every declared smoke check id is in the closed set"
  fi
  n_checked=$((n_checked + 1))

  local result="PASS" problems_json="[]"
  if [ "${#problems[@]}" -gt 0 ]; then
    result="FAIL"
    problems_json="$(printf '%s\n' "${problems[@]}" | jq -R -s 'split("\n") | map(select(length>0))')"
  fi

  local checks_json="[]"
  [ "${#checks[@]}" -gt 0 ] && checks_json="$(printf '%s\n' "${checks[@]}" | jq -s '.')"

  mkdir -p "$(bootstrap_dir "$specclaw_dir_abs")"
  jq -n --arg result "$result" --argjson checks "$checks_json" --argjson problems "$problems_json" \
    --argjson n "$n_checked" \
    '{result: $result, checks_run: $n, checks: $checks, problems: $problems,
      limits: "Declared-census check plus DR/BL/SCR/TK id greps over the files the census names. It cannot prove the absence of capability logic — a rule implemented without citing its DR id passes. See templates/CONTRACT.md (n.4)."}' \
    > "$(gate_path "$specclaw_dir_abs")"

  if [ "$result" = "FAIL" ]; then
    local joined; joined="$(printf '  - %s\n' "${problems[@]}")"
    echo "Foundation-only gate: FAIL (${#problems[@]} problem(s)). Nothing was recorded." >&2
    printf '%s\n' "$joined" >&2
    echo "Fix the scaffold (or the declaration, if it misdescribes it) and re-run \`gate\`." >&2
    return 1
  fi
  echo "Foundation-only gate: PASS (${n_checked} checks). Limit: declared-census + id greps; it cannot prove the absence of capability logic." >&2
  return 0
}

# ─── Subcommand: smoke ───────────────────────────────────────────────────────

cmd_smoke() {
  require_jq
  local specclaw_dir_abs; specclaw_dir_abs="$(resolve_specclaw_dir "$1")"; shift
  local timeout_s="$SMOKE_TIMEOUT_DEFAULT"
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) timeout_s="${2:-}"; shift 2 ;;
      *) die "smoke: unrecognized argument '$1'." ;;
    esac
  done
  case "$timeout_s" in ''|*[!0-9]*) die "smoke: --timeout takes a whole number of seconds (got '${timeout_s}')." ;; esac

  local project_root; project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  local decl; decl="$(load_declaration "$specclaw_dir_abs")"
  local logdir; logdir="$(bootstrap_dir "$specclaw_dir_abs")/smoke"
  mkdir -p "$logdir"

  local have_timeout=false
  command -v timeout >/dev/null 2>&1 && have_timeout=true
  $have_timeout || warn "\`timeout\` is not on PATH — a smoke command that never terminates will hang this step instead of being recorded as timed out. Every declared command is required to terminate on its own."

  local -a results=()
  local check cmd required skip_reason
  while IFS=$'\x1f' read -r check cmd required skip_reason; do
    [ -z "$check" ] && continue
    local log="$logdir/${check}.log"
    if [ -n "$skip_reason" ]; then
      # A SKIPPED check needs a stated reason, always. "Skipped" with no reason
      # is indistinguishable from "never thought about", which is exactly what
      # a foundation manifest must not be able to say.
      printf 'SKIPPED: %s\n' "$skip_reason" > "$log"
      results+=("$(jq -n --arg c "$check" --arg r "SKIPPED" --arg d "$skip_reason" \
        --arg l ".specclaw/bootstrap/smoke/${check}.log" --argjson req "${required:-true}" \
        '{check:$c, result:$r, detail:$d, log:$l, required:$req, command:null}')")
      echo "  SKIPPED  ${check} — ${skip_reason}" >&2
      continue
    fi
    [ -n "$cmd" ] || { warn "smoke check ${check} declares neither a command nor a skip reason — recorded as FAILED."; }

    local rc=0 detail=""
    if [ -z "$cmd" ]; then
      rc=1; detail="no command and no skip reason declared"
      printf 'FAILED: %s\n' "$detail" > "$log"
    else
      set +e
      if $have_timeout; then
        ( cd "$project_root" && timeout "$timeout_s" bash -c "$cmd" ) > "$log" 2>&1
      else
        ( cd "$project_root" && bash -c "$cmd" ) > "$log" 2>&1
      fi
      rc=$?
      set -e
      if [ "$rc" -eq 124 ] && $have_timeout; then
        detail="timed out after ${timeout_s}s — the command did not terminate on its own"
      elif [ "$rc" -ne 0 ]; then
        detail="exit ${rc}; last lines: $(tail -n 5 "$log" 2>/dev/null | tr '\n' ' ' | cut -c1-400)"
      fi
      # Cap the retained log the same way run-tests caps captured output.
      if [ "$(wc -l < "$log" 2>/dev/null || echo 0)" -gt "$SMOKE_LOG_TAIL_LINES" ]; then
        local tmp; tmp="$(mktemp)"
        { echo "[log truncated to the last ${SMOKE_LOG_TAIL_LINES} lines]"; tail -n "$SMOKE_LOG_TAIL_LINES" "$log"; } > "$tmp"
        mv "$tmp" "$log"
      fi
    fi

    local res="PASS"; [ "$rc" -ne 0 ] && res="FAILED"
    results+=("$(jq -n --arg c "$check" --arg r "$res" --arg d "$detail" --arg cm "$cmd" \
      --arg l ".specclaw/bootstrap/smoke/${check}.log" --argjson req "${required:-true}" \
      '{check:$c, result:$r, detail:$d, log:$l, required:$req, command:$cm}')")
    if [ "$res" = "PASS" ]; then echo "  PASS     ${check}" >&2; else echo "  FAILED   ${check} — ${detail}" >&2; fi
  done < <(jqr '(.smoke_checks // [])[]
                  | [ .check // "", .command // "", (if .required == false then "false" else "true" end), (.skip_reason // "") ]
                  | join("")' "$decl")

  local results_json="[]"
  [ "${#results[@]}" -gt 0 ] && results_json="$(printf '%s\n' "${results[@]}" | jq -s '.')"
  jq -n --argjson r "$results_json" --argjson t "$timeout_s" \
    '{timeout_seconds: $t, results: $r,
      summary: { total: ($r|length),
                 passed: ([$r[]|select(.result=="PASS")]|length),
                 failed: ([$r[]|select(.result=="FAILED")]|length),
                 skipped: ([$r[]|select(.result=="SKIPPED")]|length) }}' \
    > "$(smoke_path "$specclaw_dir_abs")"

  local p f s
  p="$(jqr '.summary.passed' "$(smoke_path "$specclaw_dir_abs")")"
  f="$(jqr '.summary.failed' "$(smoke_path "$specclaw_dir_abs")")"
  s="$(jqr '.summary.skipped' "$(smoke_path "$specclaw_dir_abs")")"
  echo "Smoke: ${p} passed, ${f} failed, ${s} skipped. Results in .specclaw/bootstrap/smoke-results.json, logs under .specclaw/bootstrap/smoke/." >&2
  [ "$f" -eq 0 ] || return 1
  return 0
}

# ─── Subcommand: record ──────────────────────────────────────────────────────

cmd_record() {
  require_jq
  local specclaw_dir_abs; specclaw_dir_abs="$(resolve_specclaw_dir "$1")"
  local project_root; project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  local decl; decl="$(load_declaration "$specclaw_dir_abs")"
  local gate_file; gate_file="$(gate_path "$specclaw_dir_abs")"
  local smoke_file; smoke_file="$(smoke_path "$specclaw_dir_abs")"
  local manifest; manifest="$(manifest_path "$specclaw_dir_abs")"
  local plan; plan="$(plan_path "$specclaw_dir_abs")"

  # Same discipline as bf-baseline record: collect EVERY problem in one pass
  # and, if there are any, write no manifest and archive nothing. A run that
  # produced an invalid state must not also destroy the last valid one.
  local -a problems=()

  # ── PD-05: the approved prototype is not a production foundation. ───────
  # --adopt is a skill-level mode, so every adopt path arrives here; this is
  # where the refusal belongs. The prototype is deliberately built in the real
  # target stack, which is exactly what makes it look adoptable — it is a
  # runnable application in the framework and language the rebuild chose. It
  # is still design-acceptance code: no persistence, no auth, sample data, and
  # structured to be read and thrown away rather than extended. Adopting it
  # would make every one of those shortcuts a foundation the real application
  # inherits silently.
  local proto_manifest="$specclaw_dir_abs/prototype/prototype-manifest.json"
  if [ -f "$proto_manifest" ] && jq -e . "$proto_manifest" >/dev/null 2>&1; then
    local proto_hash; proto_hash="$(jqr '.generator.tree_hash // ""' "$proto_manifest")"
    if [ -n "$proto_hash" ]; then
      local candidate_hash; candidate_hash="$(bootstrap_tree_hash_of "$project_root")"
      if [ -n "$candidate_hash" ] && [ "$candidate_hash" = "$proto_hash" ]; then
        problems+=("This is the approved prototype, not a production foundation. Scaffold fresh. The tree in this repo hashes identically to the prototype recorded in .specclaw/prototype/prototype-manifest.json, which means the throwaway prototype was copied here rather than a foundation being created. The prototype exists so a client could approve the design; it is not built to be extended, and adopting it would inherit every shortcut it was allowed to take.")
      fi
    fi
  fi
  [ -f "$gate_file" ]  || problems+=("No gate result at .specclaw/bootstrap/gate-results.json — run \`gate\` first. A manifest recorded without the foundation-only gate would claim a boundary nobody checked.")
  [ -f "$smoke_file" ] || problems+=("No smoke results at .specclaw/bootstrap/smoke-results.json — run \`smoke\` first. A foundation nobody proved starts is not a foundation.")
  [ -f "$plan" ]       || problems+=("No bootstrap plan at .specclaw/bootstrap/bootstrap-plan.md — the agent writes it in Phase 2, and it is the human-readable record of what this scaffold was meant to be.")

  if [ "${#problems[@]}" -eq 0 ]; then
    local gate_result; gate_result="$(jqr '.result // "MISSING"' "$gate_file")"
    [ "$gate_result" = "PASS" ] || problems+=("The foundation-only gate result is ${gate_result}, not PASS. Fix the scaffold and re-run \`gate\`.")

    # A required smoke check that FAILED, or a SKIPPED one with no reason.
    local bad_smoke; bad_smoke="$(jqr '
      [ (.results // [])[]
        | select(((.required != false) and .result == "FAILED")
                 or (.result == "SKIPPED" and ((.detail // "") == "")))
        | .check ] | join(", ")' "$smoke_file")"
    [ -n "$bad_smoke" ] && problems+=("Smoke check(s) failed or were skipped without a reason: ${bad_smoke}. foundation_ready cannot be true while a required connectivity proof is missing.")

    # Pillar completeness: `failed` is never a recordable ready state.
    local failed_pillars; failed_pillars="$(jqr '[ (.pillars // [])[] | select(.status == "failed") | .id ] | join(", ")' "$decl")"
    [ -n "$failed_pillars" ] && problems+=("Pillar(s) recorded \`failed\`: ${failed_pillars}. Either create them (a gap-fill run) or record them \`absent-by-decision\` with the decision named — a failed pillar is not a foundation.")

    # Every required decision must be present in the agent's consumed list. The
    # agent may satisfy one from an accepted ADR in this repo rather than from
    # decisions.md — but it must SAY SO, with a source path, or the manifest
    # cannot show what the scaffold was built on.
    local missing_consumed="" rid
    for rid in $REQUIRED_DECISIONS; do
      jq -e --arg id "$rid" '[(.decisions_consumed // [])[] | select(.id == $id)] | length > 0' "$decl" >/dev/null 2>&1 \
        || missing_consumed="${missing_consumed}${missing_consumed:+, }${rid}"
    done
    [ -n "$missing_consumed" ] && problems+=("The declaration does not record consuming these required decisions: ${missing_consumed}. Every one must appear in decisions_consumed with its own source path, so a reader can check the claim.")

    # A cited source must at least exist. Bash cannot judge whether an ADR is
    # `accepted` in whatever format this repo writes ADRs in — so a source it
    # cannot confirm is a WARN naming it, never a silent pass.
    local src
    while IFS=$'\x1f' read -r rid src; do
      [ -z "$rid" ] && continue
      [ -z "$src" ] && { problems+=("Decision ${rid} is recorded as consumed with no source path."); continue; }
      if [ ! -f "$project_root/$src" ]; then
        problems+=("Decision ${rid} cites source '${src}', which does not exist in this repo.")
      elif ! grep -qE "(^|[^A-Z0-9-])${rid}([^0-9]|$)" "$project_root/$src" 2>/dev/null; then
        warn "Decision ${rid} cites '${src}', which exists but does not mention ${rid}. The citation cannot be confirmed mechanically — a human should check it."
      fi
    done < <(jqr '(.decisions_consumed // [])[] | [.id // "", .source // ""] | join("")' "$decl")
  fi

  if [ "${#problems[@]}" -gt 0 ]; then
    local joined; joined="$(printf '  - %s\n' "${problems[@]}")"
    die "Refusing to record a bootstrap manifest — ${#problems[@]} problem(s), and the prior manifest (if any) is untouched:
${joined}"
  fi

  # Archive-then-replace, same convention every other generated artifact uses.
  if [ -f "$manifest" ]; then
    local archive_dir; archive_dir="$(bootstrap_dir "$specclaw_dir_abs")/archive"
    mkdir -p "$archive_dir"
    mv "$manifest" "$archive_dir/$(date +%Y-%m-%d-%H%M%S)-bootstrap-manifest.json"
  fi

  jq -n \
    --argjson schema "$BOOTSTRAP_SCHEMA" \
    --arg plugin_version "$(plugin_version_of_this_run)" \
    --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg generated "$(date +%Y-%m-%d)" \
    --arg project_root "$project_root" \
    --slurpfile decl "$decl" \
    --slurpfile gate "$gate_file" \
    --slurpfile smoke "$smoke_file" \
    '($decl[0]) as $d | ($gate[0]) as $g | ($smoke[0]) as $s |
     {
       bootstrap_schema: $schema,
       plugin_version: $plugin_version,
       generated: $generated,
       generated_at: $generated_at,
       project_root: $project_root,
       not_applicable: null,
       foundation_ready: true,
       stack: ($d.stack // {}),
       decisions_consumed: ($d.decisions_consumed // []),
       pillars: ($d.pillars // []),
       files_created: ($d.files_created // []),
       route_census: ($d.route_census // []),
       screen_census: ($d.screen_census // []),
       ui_tokens_imported: ($d.ui_tokens_imported // []),
       ui_tokens_skipped_reason: ($d.ui_tokens_skipped_reason // null),
       plan: ".specclaw/bootstrap/bootstrap-plan.md",
       gate: $g,
       smoke: ($s.results // []),
       smoke_summary: ($s.summary // {})
     }' > "$manifest"

  rm -f "$decl"

  local n_pillars n_files
  n_pillars="$(jqr '[.pillars[] | select(.status=="present")] | length' "$manifest")"
  n_files="$(jqr '.files_created | length' "$manifest")"
  echo "Wrote ${manifest#"$project_root"/} — foundation_ready: true (${n_pillars} pillar(s) present, ${n_files} file(s) declared, gate PASS, $(jqr '.smoke_summary.passed' "$manifest") smoke check(s) passed). /specclaw:propose's foundation gate will now pass." >&2
}

# ─── Subcommand: not-applicable ──────────────────────────────────────────────

cmd_not_applicable() {
  require_jq
  local specclaw_dir_abs; specclaw_dir_abs="$(resolve_specclaw_dir "$1")"; shift
  local project_root; project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  local reason="" declared_by=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --reason)      reason="${2:-}"; shift 2 ;;
      --declared-by) declared_by="${2:-}"; shift 2 ;;
      *) die "not-applicable: unrecognized argument '$1'." ;;
    esac
  done
  [ -n "$reason" ] || die "not-applicable: --reason is required. This declaration turns off a precondition gate; an unexplained one is indistinguishable from having skipped the foundation by accident, which is the exact failure this gate exists to catch."
  [ -n "$declared_by" ] || die "not-applicable: --declared-by is required (name, YYYY-MM-DD). Same rule as a bypass's Chosen by — a declaration that switches off a gate is attributable or it is malformed."

  local manifest; manifest="$(manifest_path "$specclaw_dir_abs")"
  if [ -f "$manifest" ]; then
    local existing_na; existing_na="$(jqr '.not_applicable.reason // empty' "$manifest" 2>/dev/null || true)"
    [ -n "$existing_na" ] && { echo "Already declared not-applicable: ${existing_na}. Left unchanged." >&2; return 0; }
    die "A bootstrap manifest already exists at ${manifest#"$project_root"/} and records a real foundation. Refusing to overwrite it with a not-applicable declaration — if that manifest is wrong, move it aside deliberately."
  fi

  mkdir -p "$(bootstrap_dir "$specclaw_dir_abs")"
  jq -n \
    --argjson schema "$BOOTSTRAP_SCHEMA" \
    --arg plugin_version "$(plugin_version_of_this_run)" \
    --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg generated "$(date +%Y-%m-%d)" \
    --arg project_root "$project_root" \
    --arg reason "$reason" \
    --arg declared_by "$declared_by" \
    '{
      bootstrap_schema: $schema, plugin_version: $plugin_version,
      generated: $generated, generated_at: $generated_at, project_root: $project_root,
      not_applicable: {reason: $reason, declared_by: $declared_by},
      foundation_ready: true,
      stack: {}, decisions_consumed: [], pillars: [], files_created: [],
      route_census: [], screen_census: [], ui_tokens_imported: [],
      ui_tokens_skipped_reason: null, plan: null,
      gate: {result: "NOT APPLICABLE", checks_run: 0, checks: [], problems: [],
             limits: "No scaffold was created, so there was no boundary to check."},
      smoke: [], smoke_summary: {total: 0, passed: 0, failed: 0, skipped: 0}
    }' > "$manifest"

  echo "Recorded ${manifest#"$project_root"/}: this repo is not a rebuild target (${reason}), declared by ${declared_by}. /specclaw:propose's foundation gate will pass here from now on." >&2
}

# ─── Subcommand: foundation-check ────────────────────────────────────────────
#
# The gate /specclaw:propose reads, and the whole reason the BL-010 incident
# cannot recur. Read-only, mechanical, and INERT on any project that is not a
# brownfield rebuild — exactly the contract bypass-check already has, so a
# greenfield project never sees a word of this.

cmd_foundation_check() {
  local specclaw_dir_abs; specclaw_dir_abs="$(resolve_specclaw_dir "$1")"
  local project_root; project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  local backlog_file="$specclaw_dir_abs/analysis/rebuild-backlog.md"
  local manifest; manifest="$(manifest_path "$specclaw_dir_abs")"
  local manifest_rel=".specclaw/bootstrap/bootstrap-manifest.json"

  if [ ! -f "$backlog_file" ]; then
    emit_json "{\"applicable\": false, \"foundation_ready\": null, \"reason\": \"no rebuild-backlog.md — this project is not a brownfield rebuild target, so no target foundation is required\", \"manifest\": null, \"not_applicable\": null}"
    return 0
  fi

  if [ ! -f "$manifest" ]; then
    emit_json "{\"applicable\": true, \"foundation_ready\": false, \"reason\": \"$(json_escape "no bootstrap manifest at ${manifest_rel}")\", \"manifest\": null, \"not_applicable\": null, \"remedy\": \"Run /specclaw:bf-bootstrap first. If this repo is not the rebuild target (for example you are proposing an ordinary change inside the LEGACY repo, which also carries a rebuild-backlog.md), record that once with: specclaw-bf-bootstrap not-applicable .specclaw --reason \\\"<why>\\\" --declared-by \\\"<name>, <YYYY-MM-DD>\\\"\"}"
    return 0
  fi

  if ! command -v jq >/dev/null 2>&1 || ! jq -e . "$manifest" >/dev/null 2>&1; then
    # A manifest we cannot read is not a foundation we can vouch for. Failing
    # closed is the only honest option — the alternative is passing a gate on a
    # file nobody could parse.
    emit_json "{\"applicable\": true, \"foundation_ready\": false, \"reason\": \"$(json_escape "${manifest_rel} exists but could not be parsed (is jq installed?)")\", \"manifest\": \"${manifest_rel}\", \"not_applicable\": null, \"remedy\": \"Re-run /specclaw:bf-bootstrap to regenerate it, or inspect the file directly.\"}"
    return 0
  fi

  local schema ready na_reason na_by stack_summary failed_smoke gate_result
  schema="$(jqr '.bootstrap_schema // empty' "$manifest")"
  ready="$(jqr '.foundation_ready // false' "$manifest")"
  na_reason="$(jqr '.not_applicable.reason // empty' "$manifest")"
  na_by="$(jqr '.not_applicable.declared_by // empty' "$manifest")"
  gate_result="$(jqr '.gate.result // "unknown"' "$manifest")"
  failed_smoke="$(jqr '[ (.smoke // [])[] | select(.result == "FAILED") | .check ] | join(", ")' "$manifest")"
  stack_summary="$(jqr '[ (.stack // {}) | to_entries[] | select(.value != null and .value != "") | .value ] | unique | join(" / ")' "$manifest")"

  if [ -z "$schema" ] || [ "$schema" != "$BOOTSTRAP_SCHEMA" ]; then
    emit_json "$(jq -n --arg m "$manifest_rel" --arg s "${schema:-<missing>}" --argjson want "$BOOTSTRAP_SCHEMA" \
      '{applicable: true, foundation_ready: false,
        reason: ("bootstrap manifest schema is " + $s + "; this specclaw reads " + ($want|tostring)),
        manifest: $m, not_applicable: null,
        remedy: "Re-run /specclaw:bf-bootstrap to re-record the manifest under the current schema."}')"
    return 0
  fi

  if [ -n "$na_reason" ]; then
    emit_json "$(jq -n --arg m "$manifest_rel" --arg r "$na_reason" --arg b "$na_by" \
      '{applicable: true, foundation_ready: true,
        reason: "declared not a rebuild target",
        manifest: $m, not_applicable: {reason: $r, declared_by: $b}}')"
    return 0
  fi

  if [ "$ready" != "true" ]; then
    emit_json "$(jq -n --arg m "$manifest_rel" --arg g "$gate_result" --arg f "$failed_smoke" \
      '{applicable: true, foundation_ready: false,
        reason: ("the recorded foundation is not ready (gate: " + $g
                 + (if $f == "" then "" else "; failed smoke checks: " + $f end) + ")"),
        manifest: $m, not_applicable: null,
        remedy: "Re-run /specclaw:bf-bootstrap — it gap-fills only the pillars recorded absent or failed and leaves every present pillar untouched."}')"
    return 0
  fi

  if [ -n "$failed_smoke" ]; then
    # foundation_ready true with a failed smoke check should be impossible —
    # record refuses to write it. If it happens anyway the file has been
    # hand-edited, and the honest answer is to say so rather than pass.
    emit_json "$(jq -n --arg m "$manifest_rel" --arg f "$failed_smoke" \
      '{applicable: true, foundation_ready: false,
        reason: ("the manifest claims foundation_ready but records failed smoke check(s): " + $f
                 + " — record never writes that combination, so this file has been edited by hand"),
        manifest: $m, not_applicable: null,
        remedy: "Re-run /specclaw:bf-bootstrap to re-record it from a real gate and a real smoke run."}')"
    return 0
  fi

  emit_json "$(jq -n --arg m "$manifest_rel" --arg s "$stack_summary" \
    --slurpfile mf "$manifest" \
    '($mf[0]) as $f |
     {applicable: true, foundation_ready: true,
      reason: ("foundation recorded " + ($f.generated // "unknown") + (if $s == "" then "" else " (" + $s + ")" end)),
      manifest: $m, not_applicable: null,
      stack: ($f.stack // {}),
      pillars_present: ([ ($f.pillars // [])[] | select(.status == "present") | .id ]),
      pillars_absent_by_decision: ([ ($f.pillars // [])[] | select(.status == "absent-by-decision") | .id ])}')"
}

# ─── Main ─────────────────────────────────────────────────────────────────────

case "${1:-}" in
  collect)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-bootstrap collect <specclaw_dir>"
    cmd_collect "$2"
    ;;
  gate)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-bootstrap gate <specclaw_dir>"
    cmd_gate "$2"
    ;;
  smoke)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-bootstrap smoke <specclaw_dir> [--timeout <seconds>]"
    shift
    cmd_smoke "$@"
    ;;
  record)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-bootstrap record <specclaw_dir>"
    cmd_record "$2"
    ;;
  foundation-check)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-bootstrap foundation-check <specclaw_dir>"
    cmd_foundation_check "$2"
    ;;
  not-applicable)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-bootstrap not-applicable <specclaw_dir> --reason <text> --declared-by <name, YYYY-MM-DD>"
    shift
    cmd_not_applicable "$@"
    ;;
  -h|--help)
    usage
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    die "Unknown subcommand: $1. Run specclaw-bf-bootstrap --help for usage."
    ;;
esac
