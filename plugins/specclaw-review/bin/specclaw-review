#!/usr/bin/env python3
# specclaw-review — the local review loop: rules, rounds, verdict, memory, learn, stats.
#
# Usage:
#   specclaw-review rules                              print the resolved rulebook
#   specclaw-review classify [--since <sha>]           skip | review, and the files
#   specclaw-review run --change <c> [--since <sha>] [--final]
#                                                      one round; exit 0 clean, 1 open, 3 not run, 4 escalate
#   specclaw-review verdict --change <c> [--pr-line] [--check-head] [--head <sha>]
#                                                      exit 0 only when clean + final pass at HEAD
#                                                      --head: also only when the final pass ran at exactly
#                                                      <sha> (the clean-loop PR status gate); prints the round file
#                                                      (--pr-line, --check-head: accepted for CI snippets; same output)
#   specclaw-review memory query --files <f>... [--budget N] [--k N]
#   specclaw-review memory compact
#   specclaw-review learn [--apply <fp>...] [--import <file>... [--apply]]
#   specclaw-review stats
#   specclaw-review discover [--json]                  read-only scan: governance files, suggested config
#   specclaw-review init                               lazy dirs + .claude/rules guard file
# Exit 2: usage or environment error.
import argparse
import json
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import review_core as rc  # noqa: E402
import review_memory as mem  # noqa: E402


def main(argv):
    p = argparse.ArgumentParser(prog="specclaw-review")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("rules")
    c = sub.add_parser("classify")
    c.add_argument("--since")
    r = sub.add_parser("run")
    r.add_argument("--change", required=True)
    r.add_argument("--since")
    r.add_argument("--final", action="store_true")
    v = sub.add_parser("verdict")
    v.add_argument("--change", required=True)
    v.add_argument("--pr-line", action="store_true")
    v.add_argument("--check-head", action="store_true")
    v.add_argument("--head")
    m = sub.add_parser("memory")
    m.add_argument("action", choices=["query", "compact"])
    m.add_argument("--files", nargs="*", default=[])
    m.add_argument("--budget", type=int)
    m.add_argument("--k", type=int)
    learn = sub.add_parser("learn")
    learn.add_argument("--apply", nargs="*")
    learn.add_argument("--import", dest="imports", nargs="+")
    sub.add_parser("stats")
    dsc = sub.add_parser("discover")
    dsc.add_argument("--json", action="store_true")
    sub.add_parser("init")
    a = p.parse_args(argv)

    try:
        cfg = rc.Config(rc.find_root())
        if a.cmd == "rules":
            book, notes = rc.rulebook(cfg)
            for n in notes:
                print(n, file=sys.stderr)
            print(book)
        elif a.cmd == "classify":
            cls = rc.classify(cfg, a.since)
            print(cls["tier"])
            for f in cls["files"]:
                print(("risky " if f in cls["risky"] else "      ") + f)
        elif a.cmd == "run":
            rec = rc.run_round(cfg, a.change, a.since, a.final)
            c = rec["counts"]
            print(f"round {rec['round']} ({'final, ' if rec['final'] else ''}{rec['model']}): {rec['status']} — "
                  f"{c['blocker']}/{c['major']}/{c['minor']} b/M/m, head {rec['head'][:10]}")
            proof = rec.get("fix_proof")
            if proof:
                print(f"  fix-proof ({proof.get('mode', 'block')}): {rc.proof_note(proof) or 'proven: ' + proof['reason']}")
            for f in rec["findings"]:
                tag = " (pre-existing)" if f.get("pre_existing") else f" (carried: {f['carried']})" if f.get("carried") else ""
                print(f"  {f['severity']}{tag} [{f.get('rule','')}] {f['file']}:{f['line']} {f.get('message','')}")
            if rec.get("error"):
                print(f"  NOT RUN: {rec['error']}", file=sys.stderr)
            return rc.EXIT_BY_STATUS[rec["status"]]
        elif a.cmd == "verdict" and a.head:
            code, line, round_file = rc.verdict_at(cfg, a.change, a.head)
            print(line)
            if round_file:
                print(round_file)
            return code
        elif a.cmd == "verdict":
            code, line = rc.verdict(cfg, a.change)
            print(line)
            return code
        elif a.cmd == "memory":
            if a.action == "query":
                print(mem.query(cfg.mem_dir, a.files, a.budget or cfg.num("memory_budget", 1500),
                                a.k or cfg.num("memory_k", 10)))
            else:
                res = mem.compact(cfg.mem_dir, cfg.root, cfg.num("decay_days", 180), cfg.num("max_entries", 2000))
                print(f"memory: {res['before']} -> {res['after']} entries")
        elif a.cmd == "learn":
            if a.imports:
                print(rc.learn_import(cfg, a.imports, apply=a.apply is not None))
            elif a.apply:
                print(rc.learn_apply(cfg, a.apply))
            else:
                print(rc.learn_propose(cfg))
        elif a.cmd == "stats":
            print(rc.stats(cfg))
        elif a.cmd == "discover":
            d = rc.discover(cfg)
            print(json.dumps(d, indent=1) if a.json else rc.discover_text(d))
        elif a.cmd == "init":
            rc.ensure(cfg)
            print(f"initialised; guard rule written to {rc.install_claude_rule(cfg)}")
    except rc.ReviewError as e:
        print(f"specclaw-review: {e}", file=sys.stderr)
        return e.code
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
