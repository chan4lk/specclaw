#!/usr/bin/env bash
set -euo pipefail

FLEET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SPECCLAW_DIR="${SPECCLAW_DIR:-.specclaw}"
FLEET_TMPDIR="$(umask 077 && mktemp -d)"
trap 'rm -rf "$FLEET_TMPDIR"' EXIT
for lib in "$FLEET_ROOT"/lib/*.sh; do
  # shellcheck source=/dev/null
  source "$lib"
done
[[ -n "${FLEET_TRUSTED_CONFIG:-}${TF_BUILD:-}" ]] || load_local_env
load_fleet_settings

case "${1:-}" in
  onboard) shift; fleet_onboard "$@" ;;
  login) shift; fleet_login "$@" ;;
  dispatch) shift; fleet_dispatch "$@" ;;
  doctor) shift; fleet_doctor "$@" ;;
  trigger) shift; fleet_trigger "$@" ;;
  optin) shift; fleet_optin "$@" ;;
  status) shift; fleet_status "$@" ;;
  feature) shift; fleet_feature "$@" ;;
  report) shift; fleet_report "$@" ;;
  *) die "Usage: specclaw-fleet onboard <upn> --vault <v> | login --agent claude|codex --vault <v> | doctor | feature plan|init|start|advance <module> [--json] | report [<change>...|--feature <module>] [--since ISO] [--json] [--html <file>] [--save] | optin <change>... [--dry-run] | status [<change>...] [--json] [--watch [N>=5]] [--since ISO] [--run <change>=<id>]... [--timeout <min>|<n>s] | trigger <change> [--retry] [--direct] [--create] | dispatch <change> [--agent claude|codex] [--ref <b>] [--vault <v>] [--dry-run] [--force]" ;;
esac
