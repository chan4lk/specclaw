#!/usr/bin/env bash
set -euo pipefail

FLEET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SPECCLAW_DIR="${SPECCLAW_DIR:-.specclaw}"
FLEET_TMPDIR="$(umask 077 && mktemp -d)"
trap 'rm -rf "$FLEET_TMPDIR"' EXIT
for lib in "$FLEET_ROOT"/lib/*.sh; do
  # shellcheck source=/dev/null
  source "$lib"
done
load_fleet_settings

case "${1:-}" in
  onboard) shift; fleet_onboard "$@" ;;
  login) shift; fleet_login "$@" ;;
  dispatch) shift; fleet_dispatch "$@" ;;
  doctor) shift; fleet_doctor "$@" ;;
  trigger) shift; fleet_trigger "$@" ;;
  *) die "Usage: specclaw-fleet onboard <upn> --vault <v> | login --agent claude|codex --vault <v> | doctor | trigger <change> [--retry] [--direct] [--create] | dispatch <change> [--agent claude|codex] [--ref <b>] [--vault <v>] [--dry-run] [--force]" ;;
esac
