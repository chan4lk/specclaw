 "findings": [
  {
   "file": "plugins/specclaw-fleet/lib/workitem.sh",
   "fp": "e2bab14c8f79",
   "in_delta": true,
   "line": 48,
   "message": "`already_handled` removes all whitespace inside a tag (`${tag//[[:space:]]/}`). `has_auto_tag` in consent.sh and `PY_TAGS` in specclaw-azdo-issue only trim the ends. The three copies of tag matching can disagree. Use one rule everywhere, trimming the ends only, so the gate and the claim agree on what counts as `fleet:dispatched` or `fleet:refused`.",
   "original_severity": "minor",
   "pass": "review",
   "pre_existing": false,
   "rule": "B4",
   "scenario": "A work item carries the tag `fleet: dispatched` (with an inner space). `already_handled` normalizes it to `fleet:dispatched` and exits 3, so the change is skipped as handled. `claim` would not treat it as held.",
   "severity": "minor"
  },
  {
   "file": "plugins/specclaw-fleet/bin/specclaw-fleet",
   "fp": "5f24355fc0ea",
   "in_delta": true,
   "line": 17,
   "message": "The usage string for `dispatch` leaves out `--force`. `parse_dispatch_args`, the dispatch SKILL and the README all document it. Add it to the usage text.",
   "original_severity": "minor",
   "pass": "review",
   "pre_existing": false,
   "rule": "B4",
   "scenario": "Running `specclaw-fleet` with no arguments prints usage without `--force`. A user who needs to retry a handled change cannot learn the flag from the CLI.",
   "severity": "minor"
  }
 ],
