   "in_delta": true,
   "line": 66,
   "message": "Two pods for the same change share one bundle folder and use fixed temp names (`work.base.tmp`, `work.bundle.tmp`). One pod's failed save runs `rm -f work.{bundle,base}.tmp` and can delete the other pod's temp file before that pod's `mv`. Both then record `bundle=none`. Fix: give the temp names a per-pod suffix (for example `$HOSTNAME` or `$$`).",
   "original_severity": "minor",
   "pass": "review",
   "pre_existing": false,
   "rule": "B12",
