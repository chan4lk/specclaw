  },
  {
   "file": "plugins/specclaw/hooks/register.tsx",
   "fp": "e8144d928633",
   "in_delta": true,
   "line": 20,
   "message": "The `command.run` handler for `/specclaw-pane` awaits `$.ui.open(...)` with no catch. Every other UI call in the mod falls back to a toast or status, but a rejected `ui.open` here surfaces as a raw command error. Catch it and `notify` (for example, 'specclaw: the pane could not be opened.') so the failure reads the same way as the other UI failures.",
   "original_severity": "minor",
   "pass": "review",
