 "findings": [
  {
   "file": "plugins/specclaw-review/hooks/recall",
   "fp": "18724652da81",
   "in_delta": true,
   "line": 62,
   "message": "Recall reads only tasks.md, spec.md and proposal.md. The default flow is `flow: lean`, which writes `change.md` and none of those three, so the file and word matching never works for a lean change. Read `change.md` as well, in the file-extraction call and in the `words` call. Add a test row for a lean change that has only `change.md`.",
   "original_severity": "major",
   "pass": "review",
   "pre_existing": false,
   "rule": "B1",
   "scenario": "A lean change 010-new has `.specclaw/changes/010-new/change.md` naming `src/pay/export.py`. Review memory holds a lesson for that file. `/specclaw:plan 010-new` gives `files=[]` and `words=set()`. The memory lesson and the similar lessons from other changes are never recalled, so only the change's own lessons can appear. The tests use only the full-flow `proposal.md`, so this goes unnoticed.",
   "severity": "major"
  },
  {
   "file": "plugins/specclaw-review/lib/review_core.py",
   "fp": "bd8960c8ca94",
   "in_delta": true,
   "line": 733,
   "message": "One proven test clears every carried blocker and major. `fix_proof` only checks that some changed test fails on the base and passes on HEAD. It never ties a test to a finding. A `--since` diff does not contain the files of the unfixed findings, so the model cannot see them again. Carry each finding unless a proven test relates to its file, or at least report which findings the proof covers.",
   "original_severity": "major",
   "pass": "review",
   "pre_existing": false,
   "rule": "B1",
   "scenario": "Round 1 reports majors in a.py and b.py. The fix commit changes a.py and adds a test that fails on the base and passes on HEAD. The proof is `proven`, so `carried=[]`. The `--since` diff has no b.py, so the model reports nothing for it. The round exits 0 with b.py's major unfixed and unproven.",
   "severity": "major"
  }
 ],
