   "file": "plugins/specclaw-review/lib/review_core.py",
   "fp": "36400fbb536b",
   "in_delta": true,
   "line": 203,
   "message": "The fix for the Windows cp1252 decode failure in `git()` and `find_root()` ships with no test. Nothing in the diff drives either helper with non-ASCII output. Add a table-driven test that runs the real `git` helper in a temp repo and fails without `encoding=\"utf-8\"`. Cover a non-ASCII diff body, a non-ASCII file name in `git diff --name-only`, and a non-ASCII repo path through `find_root`. Also include a file with invalid UTF-8 bytes, to pin the `errors=\"replace\"` behaviour.",
   "original_severity": "major",
   "pass": "review",
   "pre_existing": false,
   "rule": "B2",
   "scenario": "Commit a file containing '\u00e9' or '\u65e5\u672c\u8a9e', then call `rc.git(root, 'diff', ...)` on Windows. Before the fix, stdout was None or the decode raised, and the caller crashed. If `encoding=` is reverted, every existing test stays green, because none of them use non-ASCII content.",
   "severity": "major",
   "unclassified": false
  }
 ],
